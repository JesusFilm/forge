{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["STRAPI_API_TOKEN", "NEXT_PUBLIC_GRAPHQL_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    },
    "format": {
      "outputs": []
    },
    "validate": {
      "dependsOn": ["^validate"]
    }
  }
}
