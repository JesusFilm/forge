{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    },
    "format": {
      "outputs": []
    },
    "validate": {
      "dependsOn": ["^validate"]
    },
    "fetch-secrets": {
      "cache": false,
      "outputs": [".env"]
    },
    "data-import-check": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "PROD_BASE_URL",
        "PROD_DATA_SNAPSHOT_SECRET",
        "NODE_ENV"
      ]
    },
    "@forge/admin-graphql#generate": {
      "inputs": ["../../apps/admin/schema.graphql"],
      "outputs": ["src/admin-graphql-env.d.ts"]
    },
    "schema:print": {
      "inputs": [
        "src/graphql/**/*.ts",
        "src/domain/**/*.ts",
        "src/scripts/print-schema.ts",
        "src/auth/permissions.ts"
      ],
      "outputs": ["schema.graphql"]
    }
  }
}
