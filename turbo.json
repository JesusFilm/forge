{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    },
    "format": {
      "outputs": []
    },
    "validate": {
      "dependsOn": ["^validate"]
    },
    "fetch-secrets": {
      "cache": false,
      "outputs": [".env.development.local"]
    },
    "generate": {
      "inputs": ["../../apps/cms/schema.graphql"],
      "outputs": ["src/graphql-env.d.ts"]
    }
  }
}
