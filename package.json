{
  "name": "forge",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev --parallel",
    "fetch-secrets": "turbo run fetch-secrets",
    "dev:web": "turbo run dev --filter=@forge/web",
    "dev:cms": "turbo run dev --filter=@forge/cms",
    "dev:mobile": "pnpm --filter @forge/mobile run start",
    "seed:cms": "pnpm --filter @forge/cms run seed",
    "lint:mobile": "pnpm --filter @forge/mobile run lint -- --max-warnings=0",
    "test:mobile": "pnpm --filter @forge/mobile run test",
    "typecheck:mobile": "pnpm --filter @forge/mobile run typecheck",
    "build:mobile": "pnpm --filter @forge/mobile run build",
    "codegen": "pnpm --filter @forge/graphql run generate",
    "check:generated": "pnpm --filter @forge/graphql run generate && git diff --exit-code packages/graphql/src/graphql-env.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "turbo": "^2.8.9",
    "typescript-eslint": "^8.56.0"
  }
}
