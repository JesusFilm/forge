# Expo environment variables for @forge/expo
# Copy this file to .env (or .env.development / .env.staging / .env.production)
# and fill in the values for your target environment.
# Never commit .env files with real values.
# All EXPO_PUBLIC_* values are embedded in the client bundle at build time.

# ── Development (local Strapi) ────────────────────────────────────────────────
# iOS simulator reaches host via localhost; Android emulator uses 10.0.2.2.
EXPO_PUBLIC_GRAPHQL_URL_ANDROID=http://10.0.2.2:1337/graphql
EXPO_PUBLIC_GRAPHQL_URL_IOS=http://localhost:1337/graphql

# ── Staging ───────────────────────────────────────────────────────────────────
# Uncomment and set when pointing at a shared staging CMS.
# EXPO_PUBLIC_GRAPHQL_URL_IOS=https://cms-stage.example.com/graphql
# EXPO_PUBLIC_GRAPHQL_URL_ANDROID=https://cms-stage.example.com/graphql

# ── Production ────────────────────────────────────────────────────────────────
# Uncomment and set when pointing at production CMS.
# EXPO_PUBLIC_GRAPHQL_URL_IOS=https://cms.example.com/graphql
# EXPO_PUBLIC_GRAPHQL_URL_ANDROID=https://cms.example.com/graphql

# ── Optional: Strapi read token ───────────────────────────────────────────────
# Required only if Strapi is configured to restrict public read access.
# WARNING: This value is embedded in the client bundle (EXPO_PUBLIC_*).
# Use a read-only token with minimal scope. Never use a full-access or
# production secret here.
# EXPO_PUBLIC_STRAPI_TOKEN=
