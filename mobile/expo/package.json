{
  "name": "@forge/expo",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build": "echo 'Expo app has no production bundle step; use expo export or EAS when needed.'"
  },
  "dependencies": {
    "@apollo/client": "^4.1.6",
    "@hebcal/hdate": "^0.21.1",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "expo": "~55.0.6",
    "expo-linear-gradient": "^55.0.8",
    "expo-status-bar": "~55.0.4",
    "expo-video": "~55.0.10",
    "graphql": "^16.13.1",
    "react": "19.2.4",
    "react-native": "0.84.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "~4.24.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@babel/runtime": "^7.28.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.2.14",
    "eslint": ">=8.10",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|@hebcal))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "private": true
}
