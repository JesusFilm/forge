# Pull dev secrets from Doppler:
# pnpm fetch-secrets

# Mux
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# AI (OpenRouter)
OPENROUTER_API_KEY=

# Railway S3-compatible Object Storage
RAILWAY_S3_ENDPOINT=
RAILWAY_S3_REGION=auto
RAILWAY_S3_BUCKET=
RAILWAY_S3_ACCESS_KEY_ID=
RAILWAY_S3_SECRET_ACCESS_KEY=

# Strapi CMS
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=

# Workflow (https://useworkflow.dev/) — optional
WORKFLOW_API_KEY=

# API Authentication — optional in dev, required in production
MANAGER_API_KEY=

# Public
NEXT_PUBLIC_WATCH_URL=
