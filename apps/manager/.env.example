# Pull dev secrets from Doppler:
# pnpm fetch-secrets

# Mux
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# AI (OpenRouter)
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=

# Railway S3-compatible Object Storage. Generic Manager artifacts may use the
# local fallback in development, but Subtitle Quality Lab storage fails closed
# in production unless this complete five-value tuple is configured.
RAILWAY_S3_ENDPOINT=
RAILWAY_S3_REGION=auto
RAILWAY_S3_BUCKET=
RAILWAY_S3_ACCESS_KEY_ID=
RAILWAY_S3_SECRET_ACCESS_KEY=

# Workflow (https://useworkflow.dev/) — optional locally; required for durable
# Subtitle Quality Lab cloud execution.
WORKFLOW_API_KEY=

# Immutable Subtitle Quality Lab build identity. Railway supplies the first;
# other cloud builds may set the second. Production run launch fails closed
# when neither contains a real source revision.
RAILWAY_GIT_COMMIT_SHA=
GIT_COMMIT_SHA=

# API Authentication — optional in dev, required in production
MANAGER_API_KEY=
# MANAGER_BASE_URL=http://localhost:3002
MANAGER_SESSION_SECRET=
AUTH_ISSUER_URL=https://auth.jesusfilm.org
AUTH_MANAGER_CLIENT_ID=jfp_manager_local
# Optional for confidential browser OAuth clients.
# AUTH_MANAGER_CLIENT_SECRET=

# Manager -> Admin session/backend calls. Prefer the Auth OAuth service client,
# which requests both admin:manager-session:validate and admin:manager-backend;
# ADMIN_MANAGER_API_KEY remains the legacy fallback during dual-accept.
# AUTH_MANAGER_SERVICE_CLIENT_ID=jfp_manager_local_session_service
# AUTH_MANAGER_SERVICE_CLIENT_SECRET=
# ADMIN_MANAGER_API_KEY=
# ADMIN_MANAGER_SESSION_URL=http://localhost:3003/api/manager/session
# ADMIN_GRAPHQL_URL=http://localhost:3003/api/graphql
# Short-lived proofs minted only after validating the HttpOnly Manager session.
# The environment must match Admin; the private key must match one public-key
# entry in Admin's SUBTITLE_REVIEW_SESSION_PUBLIC_KEYS JSON keyring.
SUBTITLE_REVIEW_ASSERTION_ENVIRONMENT=local
# SUBTITLE_REVIEW_SESSION_KEY_ID=manager-subtitle-eval-2026-01
# SUBTITLE_REVIEW_SESSION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Manager -> Mastra service calls
MASTRA_BASE_URL=http://localhost:4111
MASTRA_SERVICE_API_KEY=local-mastra-service-key
MASTRA_TRANSCRIPT_EMBEDDING_TIMEOUT_MS=120000
MASTRA_SUBTITLE_ENRICHMENT_TIMEOUT_MS=300000

# admin → manager outbound trigger (feat-119 PR2). Comma-separated
# bearer keys accepted by /api/admin-trigger/{scene-analysis,transcript}.
# Mirrors admin's WORKFLOW_API_KEYS shape so the receiver-side rotation
# is symmetric. Receiver-side env: when admin's MANAGER_TRIGGER_API_KEY
# matches any entry here, the request is authorized.
ADMIN_TRIGGER_API_KEYS=

# Public
NEXT_PUBLIC_WATCH_URL=
