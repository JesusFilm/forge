# Local database. Production database URLs stay in the target secret store.
DATABASE_URL=postgresql://rag:rag_dev@localhost:5434/rag

# Hosted fallback and canonical embedding identity.
OPENROUTER_API_KEY=replace-with-local-secret
EMBED_MODEL_ID=qwen/qwen3-embedding-8b
EMBED_MAX_ATTEMPTS=10
EMBED_TIMEOUT_MS=120000
QUERY_EMBED_MAX_ATTEMPTS=2
QUERY_EMBED_TIMEOUT_MS=4000
# EMBED_QUERY_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query

# Optional JFP gateway primary. Setting EMBED_BASE_URL requires EMBED_API_KEY.
# EMBED_BASE_URL=https://<approved-ai-gateway-host>/v1
# EMBED_API_KEY=replace-with-gateway-secret
# EMBED_WIRE_MODEL_ID=embeddings
# EMBED_TRUNCATE_DIMENSIONS=false

# Language correction and local-only output.
LANG_DETECT_MODEL_ID=google/gemini-2.5-flash-lite
LANG_DETECT_MAX_ATTEMPTS=10
# LANG_DETECT_BASE_URL=http://localhost:11434/v1
# LANGUAGE_SWEEP_OUT_DIR=/absolute/local/path/outside-git

# Required only for Firecrawl-backed source acquisition.
# FIRECRAWL_API_KEY=replace-with-firecrawl-secret

# Railway serving. PORT is injected by Railway in production.
PORT=8080
# JSON map of per-consumer token to source keys. ["*"] grants all sources.
SERVE_BEARER_TOKENS={"replace-with-local-token":["*"]}

# Consumer-perspective smoke.
SMOKE_BASE_URL=http://localhost:8080
SMOKE_TOKEN=replace-with-local-token
SMOKE_MAX_MS=15000

# Production-intent names are injected by Doppler; never copy values here.
# JFRAG_POSTGRESQL_DB_URL=
# JFRAG_OPENROUTER_API_KEY=
# JFRAG_OPENROUTER_EMBED_MODEL_ID=
# JFRAG_SERVE_BEARER_TOKENS=
# JFRAG_ALLOW_PROD_WRITE=0
# JFRAG_EXPECTED_POSTGRES_HOST=production-postgres.example.com
