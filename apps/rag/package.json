{
  "name": "@forge/rag",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "db:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://forge:forge@localhost:5435/forge_rag} prisma generate",
    "db:drift:check": "tsx scripts/check-schema-drift.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:schema:check": "DATABASE_URL=${DATABASE_URL:-postgresql://forge:forge@localhost:5435/forge_rag} prisma validate && vitest run tests/schema.test.mjs tests/schema-drift.test.ts",
    "db:verify": "vitest run --no-file-parallelism tests/database.integration.test.ts tests/adapters.integration.test.ts tests/raw-document-promotion.integration.test.ts",
    "db:copy-corpus": "tsx scripts/copy-corpus.ts",
    "raws:promote": "tsx scripts/promote-raw-documents.ts",
    "raws:verify-promotion": "tsx scripts/verify-raw-document-promotion.ts",
    "acquire": "tsx scripts/acquire.ts",
    "acquire:production": "tsx scripts/acquire.ts --production",
    "index": "tsx scripts/index.ts",
    "index:production": "tsx scripts/index.ts --production",
    "eval": "tsx scripts/eval.ts",
    "eval:production": "tsx scripts/eval-production.ts --target production-read",
    "eval:compare": "tsx scripts/eval-compare.ts",
    "language:sweep": "tsx scripts/language-sweep.ts",
    "language:sweep:production": "tsx scripts/language-sweep.ts --production",
    "depcruise": "depcruise src tests --config .dependency-cruiser.cjs",
    "env:check": "tsx scripts/check-env.ts",
    "env:check:ci": "DATABASE_URL=postgresql://ci:ci@localhost:5432/rag OPENROUTER_API_KEY=ci-placeholder tsx scripts/check-env.ts ci",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "predb:verify": "pnpm db:generate",
    "pretypecheck": "pnpm db:generate",
    "query": "tsx scripts/query.ts",
    "smoke": "tsx scripts/smoke.ts",
    "status:check": "tsx scripts/source-status.ts check",
    "status:set": "tsx scripts/source-status.ts set",
    "status:add-source": "tsx scripts/source-status.ts add-source",
    "status:add-lang": "tsx scripts/source-status.ts add-lang",
    "dashboard:data": "tsx scripts/dashboard-data.ts --target production-read",
    "dashboard:snapshot:validate": "tsx scripts/dashboard-validate-snapshot.ts",
    "dashboard:build": "tsx scripts/dashboard-compile.ts",
    "dashboard:verify": "tsx scripts/dashboard-verify.ts",
    "pages:assemble": "tsx scripts/assemble-pages.ts",
    "status:remove-source": "tsx scripts/source-status.ts remove-source",
    "start": "tsx scripts/serve.ts",
    "test": "pnpm depcruise && vitest run --exclude tests/database.integration.test.ts --exclude tests/adapters.integration.test.ts --exclude tests/raw-document-promotion.integration.test.ts",
    "test:core": "vitest run src/acquisition/core.test.ts src/indexing src/retrieval src/fakes",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@forge/rag-contracts": "workspace:*",
    "@prisma/client": "^6",
    "hono": "catalog:",
    "node-html-parser": "^7.0.1",
    "tinyld": "^1.3.4",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dependency-cruiser": "^17.4.0",
    "prisma": "^6",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "3.2.4"
  }
}
