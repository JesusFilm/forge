AGENTIC_HOST=127.0.0.1
# Railway may set PORT automatically. AGENTIC_PORT takes precedence when set.
AGENTIC_PORT=4111
AGENTIC_SERVICE_API_KEY=replace-with-manager-to-agentic-token
AGENTIC_OPERATOR_API_KEY=replace-with-operator-studio-token
AGENTIC_STORAGE_URL=file:./.mastra/local.db
AGENTIC_MODEL=openai/gpt-5-mini
MANAGER_BASE_URL=http://localhost:3002
MANAGER_AGENTIC_API_KEY=replace-with-agentic-to-manager-token
AGENTIC_MANAGER_REQUEST_TIMEOUT_MS=60000

# Private Railway Studio service only. Manager should proxy this service through
# /api/agentic-studio and inject AGENTIC_OPERATOR_API_KEY server-side. Do not
# copy the local file: storage URL above into a production Studio service; use
# the same durable storage backing the Agentic runtime.
MASTRA_STUDIO_BASE_PATH=/api/agentic-studio
PNPM_CONFIG_PROD=false
HUSKY=0
