# Runtime origin for the standalone Jesus Film Auth service.
AUTH_BASE_URL=http://localhost:3004
# Optional in production when a relying web app needs the Better Auth session
# cookie on sibling/apex watch hosts for server-side session verification.
# Leave unset locally and for relying clients that use OAuth callbacks only.
# AUTH_COOKIE_DOMAIN=.jesusfilm.org
# Optional comma-separated list of additional web origins that can receive
# Better Auth callback redirects after Auth validates a /watch/ callbackURL.
# Production defaults include https://jesusfilm.org, https://www.jesusfilm.org,
# and https://watch.jesusfilm.org. Local defaults include common web dev ports.
# AUTH_WEB_TRUSTED_ORIGINS=

# Required at production runtime. Keep optional during Next build so Railway
# build hosts do not need runtime secrets.
# BETTER_AUTH_SECRET=
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forge_auth

# Upstream identity providers. Configure in Railway/Doppler when enabled.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# OKTA_CLIENT_ID=
# OKTA_CLIENT_SECRET=
# OKTA_ISSUER=

# Mobile native Apple sign-in. Apple has TWO independent credential pairs and
# either alone registers the provider: the web Service ID pair above (browser
# flow) and this bundle-id pair (native sheet). clientId/clientSecret are always
# matched — Apple requires the secret JWT's `sub` to equal the presented
# client_id — so never mix one pair's id with the other's secret.
# The native secret is a pre-built ES256 JWT whose sub is the bundle id; it
# signs the authorization-code exchange and deletion-time token revocation, and
# Apple caps it at 6 months, so it needs a rotation reminder. Set the bundle id
# without the secret to verify native tokens before the exchange credential
# exists (the exchange endpoint degrades on its own).
# APPLE_APP_BUNDLE_ID=org.jesusfilm.forgewatch
# APPLE_NATIVE_CLIENT_SECRET=

# Admin-side watch-data erasure on account deletion. Optional; when unset the
# after-delete hook skips the admin call. The key must be present in admin's
# WATCH_PROGRESS_ADMIN_API_KEYS CSV (receiver-first deploy order).
# ADMIN_WATCH_PROGRESS_BASE_URL=http://localhost:3003
# ADMIN_WATCH_PROGRESS_API_KEY=

# Optional comma-separated OAuth resource audiences. Include Admin Manager
# session URLs when issuing audience-bound service tokens.
# AUTH_VALID_AUDIENCES=http://localhost:3003/api/manager/session

# Changelog OAuth uses the native protected resources
# http://localhost:3000/mcp and https://changelog.jesusfilm.org/mcp. Production
# Changelog scope issuance is intentionally off unless this is explicitly true.
# Do not enable it until supported grant provisioning and revocation are live.
AUTH_CHANGELOG_PRODUCTION_ENABLED=false

# Optional first-party Manager service client secrets used by
# seed-first-party-apps. When unset, the service OAuth clients are seeded
# disabled and can be enabled by rerunning the seed after the secret is set.
# AUTH_MANAGER_SESSION_SERVICE_CLIENT_SECRET_LOCAL=
# AUTH_MANAGER_SESSION_SERVICE_CLIENT_SECRET_PREVIEW=
# AUTH_MANAGER_SESSION_SERVICE_CLIENT_SECRET_STAGING=
# AUTH_MANAGER_SESSION_SERVICE_CLIENT_SECRET_PRODUCTION=

# Agent login handles. The minting key and generated handles are bearer
# credentials for local/preview browser testing.
# AGENT_LOGIN_MINTING_KEY=
# AGENT_LOGIN_CLIENT_ID=jfp_admin_local
# AGENT_LOGIN_REDIRECT_URI=http://localhost:3003/api/auth/callback
# AGENT_LOGIN_SCOPES=openid,profile:read,email:read,admin:access
# AGENT_LOGIN_TTL_SECONDS=1800

# Firebase lazy migration. Auth uses these only to migrate existing Firebase
# users into Better Auth after a failed Better Auth credential sign-in.
# FIREBASE_WEB_API_KEY=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Optional shared rate limit store. Falls back to an in-process limiter locally.
# REDIS_HOST=
# REDIS_PORT=
# REDIS_PASSWORD=
