generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  INVITED   @map("invited")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  DISABLED  @map("disabled")
}

enum RegisteredAppTrustTier {
  FIRST_PARTY @map("first_party")
  PARTNER     @map("partner")
  EXTERNAL    @map("external")
}

enum RegisteredAppOwnerType {
  JESUS_FILM @map("jesus_film")
  PARTNER    @map("partner")
  EXTERNAL   @map("external")
}

enum RegisteredAppStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  ARCHIVED  @map("archived")
}

enum AppEnvironmentKind {
  LOCAL      @map("local")
  PREVIEW    @map("preview")
  STAGING    @map("staging")
  PRODUCTION @map("production")
}

enum ApprovalStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
  REVOKED  @map("revoked")
}

enum GrantSubjectType {
  USER    @map("user")
  SERVICE @map("service")
}

enum TokenFamily {
  USER_DELEGATED     @map("user_delegated")
  CLIENT_CREDENTIALS @map("client_credentials")
}

enum TokenStatus {
  ACTIVE  @map("active")
  EXPIRED @map("expired")
  REVOKED @map("revoked")
}

enum AuditEventSeverity {
  INFO     @map("info")
  WARNING  @map("warning")
  CRITICAL @map("critical")
}

enum UserActorType {
  HUMAN @map("human")
  AGENT @map("agent")
}

model User {
  id               String           @id
  name             String
  email            String
  emailVerified    Boolean          @default(false) @map("email_verified")
  image            String?
  actorType        UserActorType     @default(HUMAN) @map("actor_type")
  membershipStatus MembershipStatus @default(INVITED) @map("membership_status")
  expiresAt        DateTime?        @map("expires_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  sessions    Session[]
  accounts    Account[]
  oauthClients OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens OauthAccessToken[]
  oauthConsents OauthConsent[]
  grants      AppGrant[]
  tokens      TokenRecord[]
  auditEvents AuthAuditEvent[]

  @@unique([email])
  @@index([actorType])
  @@index([expiresAt])
  @@index([membershipStatus])
  @@map("user")
}

model Session {
  id         String   @id
  expiresAt  DateTime @map("expires_at")
  token      String   @unique
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  // "mobile" for sessions created through mobile-only entry points
  clientKind String?  @map("client_kind")
  userId     String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens OauthAccessToken[]

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

model Jwks {
  id         String    @id @default(cuid())
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  alg        String?
  crv        String?
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")

  @@index([createdAt])
  @@map("jwks")
}

model OauthClient {
  id                      String   @id @default(cuid())
  clientId                String   @unique @map("client_id")
  clientSecret            String?  @map("client_secret")
  disabled                Boolean  @default(false)
  skipConsent             Boolean? @map("skip_consent")
  enableEndSession        Boolean? @map("enable_end_session")
  subjectType             String?  @map("subject_type")
  scopes                  String[] @default([])
  userId                  String?  @map("user_id")
  user                    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  name                    String?
  uri                     String?
  icon                    String?
  contacts                String[] @default([])
  tos                     String?
  policy                  String?
  softwareId              String?  @map("software_id")
  softwareVersion         String?  @map("software_version")
  softwareStatement       String?  @map("software_statement")
  redirectUris            String[] @map("redirect_uris")
  postLogoutRedirectUris  String[] @default([]) @map("post_logout_redirect_uris")
  tokenEndpointAuthMethod String?  @map("token_endpoint_auth_method")
  grantTypes              String[] @default([]) @map("grant_types")
  responseTypes           String[] @default([]) @map("response_types")
  public                  Boolean?
  type                    String?
  requirePKCE             Boolean? @map("require_pkce")
  referenceId             String?  @map("reference_id")
  metadata                Json?

  refreshTokens OauthRefreshToken[]
  accessTokens  OauthAccessToken[]
  consents      OauthConsent[]

  @@index([userId])
  @@index([referenceId])
  @@map("oauth_client")
}

model OauthRefreshToken {
  id          String      @id @default(cuid())
  token       String
  clientId    String      @map("client_id")
  client      OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId   String?     @map("session_id")
  session     Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?     @map("reference_id")
  expiresAt   DateTime    @map("expires_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  revoked     DateTime?
  authTime    DateTime?   @map("auth_time")
  scopes      String[]

  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id          String             @id @default(cuid())
  token       String             @unique
  clientId    String             @map("client_id")
  client      OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId   String?            @map("session_id")
  session     Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId      String?            @map("user_id")
  user        User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?            @map("reference_id")
  refreshId   String?            @map("refresh_id")
  refresh     OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: SetNull)
  expiresAt   DateTime           @map("expires_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  scopes      String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id          String      @id @default(cuid())
  clientId    String      @map("client_id")
  client      OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId      String?     @map("user_id")
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?     @map("reference_id")
  scopes      String[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([userId])
  @@index([referenceId])
  @@map("oauth_consent")
}

model RegisteredApp {
  id          String                 @id @default(cuid())
  key         String
  displayName String                 @map("display_name")
  description String?
  trustTier   RegisteredAppTrustTier @map("trust_tier")
  ownerType   RegisteredAppOwnerType @map("owner_type")
  ownerName   String?                @map("owner_name")
  status      RegisteredAppStatus    @default(ACTIVE)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  environments AppEnvironment[]
  grants       AppGrant[]
  tokens       TokenRecord[]
  auditEvents  AuthAuditEvent[]

  @@unique([key])
  @@index([trustTier, status])
  @@map("registered_app")
}

model AppEnvironment {
  id              String             @id @default(cuid())
  appId           String             @map("app_id")
  app             RegisteredApp      @relation(fields: [appId], references: [id], onDelete: Cascade)
  key             String
  kind            AppEnvironmentKind
  clientId        String             @unique @map("client_id")
  clientSecretHash String?           @map("client_secret_hash")
  redirectUris    String[]           @map("redirect_uris")
  allowedOrigins  String[]           @map("allowed_origins")
  defaultScopes   String[]           @default([]) @map("default_scopes")
  status          ApprovalStatus     @default(PENDING)
  autoApprove     Boolean            @default(false) @map("auto_approve")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  grants AppGrant[]
  tokens TokenRecord[]

  @@unique([appId, key])
  @@index([kind, status])
  @@map("app_environment")
}

model Scope {
  id          String   @id @default(cuid())
  key         String
  label       String
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  grants AppGrantScope[]

  @@unique([key])
  @@map("scope")
}

model AppGrant {
  id            String           @id @default(cuid())
  appId         String           @map("app_id")
  app           RegisteredApp    @relation(fields: [appId], references: [id], onDelete: Cascade)
  environmentId String           @map("environment_id")
  environment   AppEnvironment   @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  subjectType   GrantSubjectType @map("subject_type")
  userId        String?          @map("user_id")
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceKey    String?          @map("service_key")
  status        ApprovalStatus   @default(PENDING)
  approvedAt    DateTime?        @map("approved_at")
  revokedAt     DateTime?        @map("revoked_at")
  reason        String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  scopes AppGrantScope[]
  tokens TokenRecord[]

  @@index([appId, status])
  @@index([environmentId, status])
  @@index([userId])
  @@map("app_grant")
}

model AppGrantScope {
  id        String   @id @default(cuid())
  grantId   String   @map("grant_id")
  grant     AppGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  scopeId   String   @map("scope_id")
  scope     Scope    @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([grantId, scopeId])
  @@map("app_grant_scope")
}

model TokenRecord {
  id             String       @id @default(cuid())
  tokenHash      String       @unique @map("token_hash")
  family         TokenFamily
  status         TokenStatus  @default(ACTIVE)
  audience       String
  scopes         String[]     @default([])
  appId          String       @map("app_id")
  app            RegisteredApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  environmentId  String       @map("environment_id")
  environment    AppEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  grantId        String?      @map("grant_id")
  grant          AppGrant?    @relation(fields: [grantId], references: [id], onDelete: SetNull)
  userId         String?      @map("user_id")
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  expiresAt      DateTime     @map("expires_at")
  revokedAt      DateTime?    @map("revoked_at")
  revocationReason String?    @map("revocation_reason")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([appId, environmentId, status])
  @@index([userId, status])
  @@index([expiresAt])
  @@map("token_record")
}

model AuthAuditEvent {
  id            String             @id @default(cuid())
  eventType     String             @map("event_type")
  severity      AuditEventSeverity @default(INFO)
  actorUserId   String?            @map("actor_user_id")
  actorUser     User?              @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  appId         String?            @map("app_id")
  app           RegisteredApp?     @relation(fields: [appId], references: [id], onDelete: SetNull)
  subjectHash   String?            @map("subject_hash")
  ipAddressHash String?            @map("ip_address_hash")
  userAgent     String?            @map("user_agent")
  metadata      Json               @default("{}")
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([actorUserId, createdAt])
  @@index([appId, createdAt])
  @@map("auth_audit_event")
}
