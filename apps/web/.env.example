# Pull dev secrets from Doppler:
# pnpm fetch-secrets
#
## Shared ##
# CMS
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:1337/graphql
INTERNAL_GRAPHQL_URL=http://localhost:1337/graphql
# API token for Strapi GraphQL (shared with CMS STRAPI_INTERNAL_API_TOKEN)
STRAPI_API_TOKEN=
# Preview: GET /api/preview?secret=... enables draft mode (shared with CMS PREVIEW_SECRET)
STRAPI_PREVIEW_SECRET=
# On-demand revalidation: POST /api/revalidate with x-revalidation-secret header
REVALIDATION_SECRET=
# Optional: enables the /demo-search AI experience generator.
# Reuse the same key as apps/cms OPENROUTER_API_KEY — no separate account needed.
OPENROUTER_API_KEY=
# U5 (feat-104) — admin GraphQL URL for the dual-read parity canary. Required;
# host allowlist is warn-only (.jesusfilm.org / .railway.app / .local /
# localhost / 127.0.0.1). Retire when U5 scaffolding retires.
ADMIN_GRAPHQL_URL=http://localhost:4000/api/graphql
# U5 — set to "dual-read" to activate the canary; defaults to "strapi" (off).
# U5b will add "admin-with-fallback" and "admin" values.
FORGE_CONTENT_API=strapi
# U5 — DEV-ONLY parity debug. When set to "1", the dual-read canary's log
# payload includes raw ValueDiff/SemanticDiff field values (diffSamples,
# first 3 diffs). Defense-in-depth: production strips raw values
# unconditionally regardless of this flag (the bridge ALSO checks
# NODE_ENV !== "production"). Leave unset in production. Retire with U5.
FORGE_PARITY_DEBUG=0

## Production ##
# CMS image hostname (e.g. api.example.com)
NEXT_PUBLIC_CMS_HOSTNAME=
NEXT_PUBLIC_CMS_PROTOCOL=https

# Canonical absolute origin used by the watch-page Share modal (Copy Link /
# Copy Embed Code). Must include scheme + host (no trailing slash). Defaults
# to http://localhost:3000 for dev/CI; set to https://jesusfilm.org (or your
# environment's canonical host) in preview/production.
NEXT_PUBLIC_CANONICAL_ORIGIN=https://jesusfilm.org

