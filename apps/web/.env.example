# Pull dev secrets from Doppler:
# pnpm fetch-secrets
#
## Shared ##
# Admin GraphQL
NEXT_PUBLIC_ADMIN_GRAPHQL_URL=http://localhost:3003/api/graphql
INTERNAL_ADMIN_GRAPHQL_URL=http://localhost:3003/api/graphql
# Preview: GET /api/preview?secret=... enables draft mode (shared with CMS PREVIEW_SECRET)
STRAPI_PREVIEW_SECRET=
# On-demand revalidation: POST /api/revalidate with x-revalidation-secret header
REVALIDATION_SECRET=
# Optional: enables the /demo-search AI experience generator.
# Reuse the same key as apps/cms OPENROUTER_API_KEY — no separate account needed.
OPENROUTER_API_KEY=

## Production ##
# CMS image hostname (e.g. api.example.com). Kept while image URLs can still
# point at the legacy CMS asset host.
NEXT_PUBLIC_CMS_HOSTNAME=
NEXT_PUBLIC_CMS_PROTOCOL=https

# Canonical absolute origin used by the watch-page Share modal (Copy Link /
# Copy Embed Code). Must include scheme + host (no trailing slash). Defaults
# to http://localhost:3000 for dev/CI; set to https://jesusfilm.org (or your
# environment's canonical host) in preview/production.
NEXT_PUBLIC_CANONICAL_ORIGIN=https://jesusfilm.org
