# Pull dev secrets from Doppler:
# pnpm fetch-secrets
#
## Shared ##
# Admin GraphQL URL — web's data source post-U22.
# Host allowlist is warn-only (.jesusfilm.org / .railway.app / .local /
# localhost / 127.0.0.1) and hard-rejects auth.jesusfilm.org (PR #909 trap).
ADMIN_GRAPHQL_URL=http://localhost:3003/api/graphql
# Bearer key web's SSR sends to admin so traffic identifies as
# `consumer:<key>` at admin's rate limiter (not public:<egress-ip>).
# Single string OR CSV; web reads the first entry as the outbound bearer.
# Must match an entry in admin's WEB_ADMIN_API_KEYS Doppler value.
WEB_ADMIN_API_KEYS=
# On-demand revalidation: POST /api/revalidate with Authorization: Bearer
# header (admin emits this) OR legacy x-revalidation-secret header.
# Must match admin's WEB_REVALIDATE_TOKEN value.
REVALIDATION_SECRET=
# /api/preview Next draft-mode entry token (Strapi-era surface that
# hasn't migrated yet — out of data-layer-flip scope).
STRAPI_PREVIEW_SECRET=
# Optional: enables the /demo-search AI experience generator.
OPENROUTER_API_KEY=
# Optional: enables the compact YouVersion passage embed under Bible Quotes.
NEXT_PUBLIC_YOUVERSION_APP_KEY=
NEXT_PUBLIC_YOUVERSION_DEFAULT_VERSION_ID=111

## Production ##
# Canonical absolute origin used by the watch-page Share modal (Copy Link /
# Copy Embed Code). Must include scheme + host (no trailing slash). Defaults
# to http://localhost:3000 for dev/CI; set to https://jesusfilm.org (or your
# environment's canonical host) in preview/production.
NEXT_PUBLIC_CANONICAL_ORIGIN=https://jesusfilm.org

## Feature flags ##
# Watch-hero MuxPlayer → MuxVideo migration. When `true`, the watch-page
# HeroPlayer renders `@mux/mux-video-react` (smaller chunk, no cast plugin)
# instead of `@mux/mux-player-react`. Default `false`. See
# docs/plans/2026-05-26-005-refactor-watch-hero-muxplayer-to-muxvideo-beta-plan.md
NEXT_PUBLIC_FORGE_WATCH_HERO_MUX_VIDEO=false
