# Pull dev secrets from Doppler:
# pnpm fetch-secrets
#
## Shared ##
# Admin GraphQL URL — web's data source post-U22.
# Host allowlist is warn-only (.jesusfilm.org / .railway.app / .local /
# localhost / 127.0.0.1) and hard-rejects auth.jesusfilm.org (PR #909 trap).
ADMIN_GRAPHQL_URL=http://localhost:3003/api/graphql
# Bearer key web's SSR sends to admin so traffic identifies as
# `consumer:<key>` at admin's rate limiter (not public:<egress-ip>).
# Single string OR CSV; web reads the first entry as the outbound bearer.
# Must match an entry in admin's WEB_ADMIN_API_KEYS Doppler value.
WEB_ADMIN_API_KEYS=
# Optional narrower key for admin's watch-progress receiver.
# Must match an entry in admin's WATCH_PROGRESS_ADMIN_API_KEYS Doppler value.
# Falls back to WEB_ADMIN_API_KEYS locally when unset.
# WATCH_PROGRESS_ADMIN_API_KEYS=
# On-demand revalidation: POST /api/revalidate with Authorization: Bearer
# header (admin emits this) OR legacy x-revalidation-secret header.
# Must match admin's WEB_REVALIDATE_TOKEN value.
REVALIDATION_SECRET=
# /api/preview Next draft-mode entry token (Strapi-era surface that
# hasn't migrated yet — out of data-layer-flip scope).
STRAPI_PREVIEW_SECRET=
# Optional shared Next.js ISR/Data Cache store. Prefix should be unique when
# sharing Redis.
# REDIS_URL=redis://localhost:6379
# NEXT_CACHE_REDIS_PREFIX=forge:web:next-cache
# Optional: enables the /demo-search AI experience generator.
OPENROUTER_API_KEY=
## Auth / download gate ##
# Shared Jesus Film Auth host. Web local development mirrors Admin and points
# at production Auth so sign-in does not require running apps/auth locally.
WEB_AUTH_BASE_URL=https://auth.jesusfilm.org
# OAuth issuer URL. Defaults to WEB_AUTH_BASE_URL + /api/auth when unset.
# WEB_AUTH_ISSUER_URL=https://auth.jesusfilm.org/api/auth
# First-party Web OAuth client id seeded in apps/auth.
WEB_AUTH_CLIENT_ID=jfp_web_local
# Public origin for Web OAuth callback URL generation.
WEB_BASE_URL=http://localhost:3000
# 32+ character secret for encrypted HttpOnly Web session cookies.
WEB_SESSION_SECRET=

## Production ##
# Environment-specific absolute origin for watch Share modal Copy Link / Copy
# Embed Code. Must include scheme + host (no trailing slash). Defaults to
# http://localhost:3000 for dev/CI. Public SEO canonical <link> + OG URLs do
# not read this value; they always use the indexed www host from routes.ts:
# https://www.jesusfilm.org/watch/...
NEXT_PUBLIC_CANONICAL_ORIGIN=https://www.jesusfilm.org

## Datadog RUM ##
# Optional server APM/log forwarding. Production should point at the shared
# Railway Datadog Agent service over the private network.
DD_AGENT_HOST=
DD_TRACE_AGENT_PORT=8126
DD_AGENT_SYSLOG_PORT=514
DD_SERVICE=forge-web
DD_ENV=development
DD_VERSION=
# Optional production-only incident diagnostics. When enabled, the server logs
# cgroup memory, Node memory, top process RSS, /tmp size, and .next/cache size.
FORGE_MEMORY_DIAGNOSTICS_ENABLED=false
FORGE_MEMORY_DIAGNOSTICS_INTERVAL_MS=60000

# Optional browser RUM. Initialization is disabled unless application id and
# client token are both configured. Site defaults to datadoghq.com; env/version
# fall back to Railway/Vercel/Git envs when present.
NEXT_PUBLIC_DATADOG_APPLICATION_ID=
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=
NEXT_PUBLIC_DATADOG_SITE=datadoghq.com
NEXT_PUBLIC_DATADOG_ENV=development
NEXT_PUBLIC_DATADOG_VERSION=
# Required only when running `pnpm datadog:sourcemaps` after a production build.
DATADOG_API_KEY=

## Google Analytics ##
# Optional GA4 measurement id (for example, G-XXXXXXXXXX). When unset, the
# browser integration renders nothing.
NEXT_PUBLIC_GOOGLE_ANALYTICS_MEASUREMENT_ID=

## Feature flags ##
# Optional LaunchDarkly server-side SDK key. When unset, web falls back to the
# local defaults below and existing NEXT_PUBLIC_* build-time flags.
LAUNCHDARKLY_SDK_KEY=

# Server-side local defaults for LaunchDarkly-backed flag helpers. These do not
# replace the NEXT_PUBLIC_* build-time flags yet; they provide runtime fallback
# for server-side flag reads and future callsite migrations.
FORGE_WATCH_PLAYER_MIGRATION_DEFAULT=false
FORGE_WATCH_CTA_TEXT_COPY_DEFAULT=false
FORGE_WATCH_DOWNLOAD_ACCOUNT_GATE_DEFAULT=false
# Shows the global floating beta tester CTA. Keep false unless testing or
# intentionally rolling out forge.watch.globalBetaTesterCta.
FORGE_WATCH_GLOBAL_BETA_TESTER_CTA_DEFAULT=false
FORGE_WATCH_HIDE_BIBLE_QUOTES_DEFAULT=false
FORGE_WATCH_QUESTION_PANEL_DEFAULT=false
# Enables Algolia-backed video results in the Forge watch search modal.
FORGE_WATCH_ALGOLIA_SEARCH_DEFAULT=false

## Algolia search ##
# Server-only Algolia config for the watch search modal. Use the same app/index
# source as Core Watch. Do not expose these as NEXT_PUBLIC_* values.
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_INDEX=

# Inline watch-player migration. Existing build-time flag; kept for dynamic
# import dead-code elimination until those callsites are intentionally migrated.
NEXT_PUBLIC_FORGE_WATCH_PLAYER_MIGRATION=false
