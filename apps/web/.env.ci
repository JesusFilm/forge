STRAPI_PREVIEW_SECRET=ci-placeholder
REVALIDATION_SECRET=ci-placeholder
# U5 (feat-104) — admin GraphQL URL for the dual-read parity canary.
# CI placeholder; replaced per-env in production. Retire alongside U5.
ADMIN_GRAPHQL_URL=http://localhost:1437/admin/api/graphql
