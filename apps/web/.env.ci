## All Environments ##
# Admin GraphQL URL — web's data source post-U22.
ADMIN_GRAPHQL_URL=http://localhost:1437/admin/api/graphql
# Bearer key web's SSR sends to admin (CONSUMER_BEARER identity).
WEB_ADMIN_API_KEYS=ci-placeholder
# Shared Auth host for server-side download account checks.
WEB_AUTH_BASE_URL=http://localhost:3004
WEB_AUTH_ISSUER_URL=http://localhost:3004/api/auth
WEB_AUTH_CLIENT_ID=jfp_web_local
WEB_BASE_URL=http://localhost:3000
WEB_SESSION_SECRET=ci-web-session-secret-at-least-thirty-two-chars
# LaunchDarkly is not contacted in CI unless this key is provided.
LAUNCHDARKLY_SDK_KEY=
FORGE_WATCH_GLOBAL_BETA_TESTER_CTA_DEFAULT=false
FORGE_WATCH_ALGOLIA_SEARCH_DEFAULT=false
# /api/revalidate token — shared with admin's WEB_REVALIDATE_TOKEN.
REVALIDATION_SECRET=ci-placeholder
# /api/preview Next draft-mode entry token (Strapi-era, not yet migrated).
STRAPI_PREVIEW_SECRET=ci-placeholder
