# Forge Chat env (feat-205). The app boots with NONE of these set — default-off
# mode uses the local stub (buildStubReply) and reaches no backend. Set these
# only to dogfood the Seeker agent end-to-end. Local dev: copy to .env.local.

## Seeker wiring (all optional; required only when the flag is on) ##

# Master flag. Only the literal "true" routes messages to Seeker; unset/"false"
# /anything else keeps the client-side stub. Read server-side in page.tsx
# (force-dynamic), so flipping it on Railway takes effect without a rebuild.
SEEKER_CHAT_ENABLED=false

# Mastra base URL the proxy POSTs /forge-seeker to. Prod: Railway private
# networking (http://<service>.railway.internal:<port>); loopback http for local
# dev; https required otherwise — see hostAllowed() in src/app/api/seeker/route.ts.
SEEKER_MASTRA_BASE_URL=http://localhost:4111

# Service bearer held SERVER-SIDE only (never reaches the browser). Must match
# an entry in Mastra's MASTRA_SERVICE_API_KEYS CSV.
SEEKER_MASTRA_API_KEY=local-mastra-service-key

# Optional SSRF host allowlist (CSV). Unset → the operator-set base host is
# trusted (redirect:"error" + the scheme floor above still apply); set → the
# base host must be in this list or the proxy returns ssrf_blocked.
SEEKER_MASTRA_ALLOWED_HOSTS=

# Optional outbound proxy→Mastra timeout in ms. Defaults to 95000 — strictly
# greater than Mastra's 90s chatTurn ceiling so a route-side timeout returns a
# clean timeout rather than a misclassified network error. A non-numeric, zero,
# or negative value falls back to the default.
SEEKER_TIMEOUT_MS=95000

## Authentication (feat-207; all optional; sign-in stays hidden until ALL set) ##

# Optional sign-in via apps/auth (Better Auth OIDC). Chat is fully usable
# anonymously — these enable the OAuth redirect flow and identity display only,
# gating nothing. PREREQUISITE (out-of-codebase): a chat OAuth client must be
# registered in apps/auth with the `openid` scope and the EXACT redirect URI
# `<CHAT_BASE_URL>/api/auth/callback` for this environment, BEFORE these are set
# here — otherwise sign-in dead-ends in a redirect_uri mismatch at the provider.
# chatAuthConfigured() gates the whole feature: with any of issuer / client id /
# base URL / a real signing secret missing, the "Sign in" affordance is hidden.

# apps/auth issuer, matching admin's AUTH_ISSUER_URL (includes /api/auth). All
# endpoints resolve against its origin via new URL(absolutePath, issuer).
AUTH_ISSUER_URL=https://auth.jesusfilm.org/api/auth

# The chat OAuth client id/secret from the apps/auth registration above.
AUTH_CHAT_CLIENT_ID=
AUTH_CHAT_CLIENT_SECRET=

# Chat's own public origin. The callback redirect URI is derived as
# `<CHAT_BASE_URL>/api/auth/callback`, and post-login return targets are
# validated against this origin (untrusted → chat home).
CHAT_BASE_URL=http://localhost:3200

# Cookie-signing secret — REQUIRED ONLY ON THE AUTH PATH (the default-off
# anonymous deploy needs none). Cookie create/verify fails closed to anonymous
# when this is absent, left as this placeholder, or shorter than 32 chars.
# Generate one with e.g. `openssl rand -base64 32`.
CHAT_SESSION_SECRET=replace-with-a-long-random-secret-min-32-chars

# Optional cookie-name prefix (defaults to forge_chat).
AUTH_COOKIE_PREFIX=forge_chat

## LaunchDarkly (feat-233; both optional; unset → seeker dogfood gate stays off) ##

# Server-side LaunchDarkly SDK key (server-only; never NEXT_PUBLIC_*). Absent →
# no LD connection and the seeker dogfood gate resolves from the local fallback
# chain. Chat's client never sends LD analytics events (sendEvents=false).
LAUNCHDARKLY_SDK_KEY=

# Local-dev-only override for the seeker dogfood gate (forge.chat.seekerDogfood).
# Honored ONLY under `next dev` (NODE_ENV=development) — deployed builds ignore
# it by design, so setting it on Railway has no effect. "true" grants locally.
FORGE_CHAT_SEEKER_DOGFOOD_DEFAULT=
