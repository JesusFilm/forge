# apps/admin env vars (Doppler project: forge-admin)
#
# Unit 1 scaffolding ships a minimal env. Later units add:
#   Unit 2  → DATABASE_URL, DATABASE_URL_SYNC
#   Unit 5  → BETTER_AUTH_SECRET, AUTH_*, FIREBASE_*, FACEBOOK_*, GOOGLE_*, APPLE_*, OKTA_*
#   Unit 9  → CORS_ALLOWED_ORIGINS, GRAPHQL_INTROSPECTION_ENABLED, REDIS_*
#   Unit 10 → CORE_API_URL, CORE_API_TOKEN
#   Unit 11 → WORKFLOW_API_KEYS, WORKFLOW_HMAC_SECRET, RAILWAY_S3_*
#   PR-C    → WEB_ADMIN_API_KEYS (CONSUMER_BEARER)
#   Core sync recurring job → WORKFLOW_TARGET_WORLD, WORKFLOW_POSTGRES_*

NEXT_PUBLIC_APP_NAME=forge-admin

# Unit 2 — Prisma / Postgres
# Main pool: connection_limit=10 + pool_timeout=20
DATABASE_URL=postgresql://forge:forge@localhost:5432/forge_admin?connection_limit=10&pool_timeout=20
# Optional dedicated pool for Core sync workflow (connection_limit=2).
# Falls back to DATABASE_URL if unset.
DATABASE_URL_SYNC=postgresql://forge:forge@localhost:5432/forge_admin?connection_limit=2&pool_timeout=20

# Workflow runtime
# Local development can omit this to use the bundled local world.
# Railway/prod should set the Postgres World explicitly and run:
#   pnpm --filter @forge/admin workflow:setup:postgres
# The setup command is idempotent and creates workflow_runs,
# workflow_events, workflow_steps, workflow_hooks, and stream tables.
# WORKFLOW_TARGET_WORLD="@workflow/world-postgres"
# WORKFLOW_POSTGRES_URL=postgresql://forge:forge@localhost:5432/forge_admin
WORKFLOW_POSTGRES_JOB_PREFIX=forge_admin
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=2
WORKFLOW_POSTGRES_MAX_POOL_SIZE=4

# Core API
CORE_API_URL=
CORE_API_TOKEN=
CORE_API_TIMEOUT_MS=15000
CORE_API_RETRIES=3

# Core sync recurring job
# Bearer token required by /api/core-sync/scheduled.
CORE_SYNC_CRON_SECRET=

# Unit 5 — embedded Better Auth fallback (required in production while
# ADMIN_AUTH_MODE=embedded remains available, min 32 chars).
BETTER_AUTH_SECRET=forge-admin-local-dev-secret-change-me-before-production-00
# Canonical embedded auth host. Keep for rollback while admin still ships its
# local Better Auth route.
# BETTER_AUTH_URL=https://auth.jesusfilm.org
# Legacy shared-cookie mode only. OAuth mode does not require cross-subdomain
# cookies; omit AUTH_COOKIE_DOMAIN for the admin/Auth integration.
# AUTH_COOKIE_DOMAIN=.jesusfilm.org
# Optional local/worktree cookie namespace. Use a unique value when several
# branches run on localhost at once, for example `forge-admin-core-sync`.
# AUTH_COOKIE_PREFIX=forge-admin
# Comma-separated origins allowed to call auth API cross-origin.
# AUTH_TRUSTED_ORIGINS=https://admin.jesusfilm.org,https://web.jesusfilm.org,https://manager.jesusfilm.org

# Jesus Film Auth relying-client mode. Set ADMIN_AUTH_MODE=oauth to send admin
# login through the standalone apps/auth service and create an admin-local
# session after callback.
# ADMIN_AUTH_MODE=oauth
# Better Auth OAuth provider advertises its issuer under /api/auth.
# AUTH_ISSUER_URL=http://localhost:3004/api/auth
# AUTH_ADMIN_CLIENT_ID=jesus-film-admin-local
# Optional when Auth registers admin as a confidential client. The seeded local
# admin client is public + PKCE, so local dev can omit this.
# AUTH_ADMIN_CLIENT_SECRET=
# ADMIN_BASE_URL=http://localhost:3003
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_ISSUER=

# ---------------------------------------------------------------------------
# Local embedding pipeline (run-embeds CLI) — admin reads manager artifacts
# from a SEPARATE bucket than its own (RAILWAY_S3_* above is admin's
# write bucket; MANAGER_ARTIFACTS_S3_* is manager's read-only bucket).
# Pull these from Railway's apps/admin service env to populate locally.
# ---------------------------------------------------------------------------

# Manager artifacts bucket — read-only access to {assetId}/scene-analysis.json
# (R1 input) and {assetId}/embeddings.json (R2 input). Required for the
# local run-embeds CLI to fetch artifacts at workflow runtime.
MANAGER_ARTIFACTS_S3_ENDPOINT=
MANAGER_ARTIFACTS_S3_REGION=
MANAGER_ARTIFACTS_S3_BUCKET=
MANAGER_ARTIFACTS_S3_ACCESS_KEY_ID=
MANAGER_ARTIFACTS_S3_SECRET_ACCESS_KEY=

# feat-119 PR2 — admin → manager outbound enrichment trigger.
# Admin's `triggerManagerEnrichment` GraphQL mutation POSTs to
# `${MANAGER_API_BASE_URL}/api/admin-trigger/{scene-analysis,transcript}`
# with `Authorization: Bearer ${MANAGER_TRIGGER_API_KEY}`. The bearer
# must match an entry in manager's `ADMIN_TRIGGER_API_KEYS` CSV.
# Local dev: http://localhost:3002 (default manager port).
MANAGER_API_BASE_URL=http://localhost:3002
MANAGER_TRIGGER_API_KEY=

# OpenAI / OpenRouter — required ONLY for R1 (scene embeddings) which
# regenerates vectors from scene-analysis text. R2 (transcript embeddings)
# reuses vectors verbatim from manager's embeddings.json artifact and
# needs no API key.
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_TEXT_MODELS=nvidia/nemotron-nano-12b-v2-vl:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,baidu/qianfan-ocr-fast:free,google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,google/gemma-3-27b-it:free,openrouter/free
# OPENROUTER_IMAGE_TEXT_MODEL=google/gemma-4-26b-a4b-it:free
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Bearer allowlists — two disjoint CSVs.
#   WORKFLOW_API_KEYS  → mints WORKFLOW_TRIGGER (manager→admin service triggers).
#   WEB_ADMIN_API_KEYS → mints CONSUMER_BEARER (web/mobile/TV SSR rate-limit bucket).
# Generate fresh per-env keys with `openssl rand -base64 32`. The two
# sets must NOT share any value — admin asserts disjointness at boot.
# WEB_ADMIN_API_KEYS=

# Unit 11 / Media assets — Railway S3-compatible object storage.
# Leave unset for the local filesystem fallback used by normal dev/test runs.
# To exercise production-like object APIs locally, point these at MinIO or
# LocalStack and create the bucket before starting the app.
# RAILWAY_S3_ENDPOINT=http://127.0.0.1:9000
# RAILWAY_S3_REGION=auto
# RAILWAY_S3_BUCKET=forge-admin-local
# RAILWAY_S3_ACCESS_KEY_ID=minioadmin
# RAILWAY_S3_SECRET_ACCESS_KEY=minioadmin
