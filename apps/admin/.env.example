# apps/admin env vars (Doppler project: forge-admin)
#
# Unit 1 scaffolding ships a minimal env. Later units add:
#   Unit 2  → DATABASE_URL, DATABASE_URL_SYNC
#   Unit 5  → ADMIN_SESSION_SECRET, AUTH_*
#   Unit 9  → CORS_ALLOWED_ORIGINS, GRAPHQL_INTROSPECTION_ENABLED, REDIS_*
#   Unit 10 → CORE_API_URL, CORE_API_TOKEN
#   Unit 11 → WORKFLOW_API_KEYS, WORKFLOW_HMAC_SECRET, RAILWAY_S3_*
#   PR-C    → WEB_ADMIN_API_KEYS (CONSUMER_BEARER)
#   Core sync recurring job → WORKFLOW_TARGET_WORLD, WORKFLOW_POSTGRES_*

# Unit 2 — Prisma / Postgres
# Main pool: connection_limit=10 + pool_timeout=20
DATABASE_URL=postgresql://forge:forge@localhost:5432/forge_admin?connection_limit=10&pool_timeout=20
# Optional dedicated pool for Core sync workflow.
# Production starting point: connection_limit=5 + pool_timeout=60, tuned
# against total Postgres capacity and active admin/web/worker replicas.
# Falls back to DATABASE_URL if unset.
DATABASE_URL_SYNC=postgresql://forge:forge@localhost:5432/forge_admin?connection_limit=5&pool_timeout=60

# Workflow runtime
# Local development can omit this to use the bundled local world.
# Railway/prod should set the Postgres World explicitly and run:
#   pnpm --filter @forge/admin workflow:setup:postgres
# The setup command is idempotent and creates workflow_runs,
# workflow_events, workflow_steps, workflow_hooks, and stream tables.
# WORKFLOW_TARGET_WORLD="@workflow/world-postgres"
# WORKFLOW_POSTGRES_URL=postgresql://forge:forge@localhost:5432/forge_admin
WORKFLOW_POSTGRES_JOB_PREFIX=forge_admin
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=2
WORKFLOW_POSTGRES_MAX_POOL_SIZE=4

# Core API
CORE_API_URL=
CORE_API_TOKEN=
CORE_API_TIMEOUT_MS=15000
CORE_API_RETRIES=3

# Core sync recurring job
# Bearer token required by /api/core-sync/scheduled.
CORE_SYNC_CRON_SECRET=

# Unit 5 — Auth relying-client session signing (min 32 chars).
ADMIN_SESSION_SECRET=forge-admin-local-dev-secret-change-me-before-production-00
# Optional local/worktree cookie namespace. Use a unique value when several
# branches run on localhost at once, for example `forge-admin-core-sync`.
# AUTH_COOKIE_PREFIX=forge-admin
# Jesus Film Auth relying-client configuration. Admin dev points at production
# Auth so local admin work does not require running apps/auth.
AUTH_ISSUER_URL=https://auth.jesusfilm.org/api/auth
AUTH_ADMIN_CLIENT_ID=jfp_admin_local
# Optional when Auth registers admin as a confidential client. The seeded local
# admin client is public + PKCE, so local dev can omit this.
# AUTH_ADMIN_CLIENT_SECRET=
ADMIN_BASE_URL=http://localhost:3003
# Optional visitor-facing web origin for admin "open on web" actions.
# Override to http://localhost:3000 when running apps/web locally.
WEB_CANONICAL_ORIGIN=https://www.jesusfilm.org

# Datadog observability (optional locally; required for production telemetry).
DD_API_KEY=
DD_SITE=datadoghq.com
DD_AGENT_HOST=
DD_TRACE_AGENT_PORT=8126
DD_AGENT_SYSLOG_PORT=514
DD_SERVICE=forge-admin
DD_ENV=development
DD_VERSION=
NEXT_PUBLIC_DATADOG_APPLICATION_ID=
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=
NEXT_PUBLIC_DATADOG_SITE=datadoghq.com
NEXT_PUBLIC_DATADOG_ENV=development
NEXT_PUBLIC_DATADOG_VERSION=
DATADOG_API_KEY=
DATADOG_RELEASE_VERSION=

# Manager -> Admin session validation. Admin accepts this Auth-issued OAuth
# service credential during the dual-accept migration, with MANAGER_ADMIN_API_KEY
# remaining as the legacy fallback until cutover.
# AUTH_MANAGER_SERVICE_CLIENT_ID=jfp_manager_local_session_service
# AUTH_MANAGER_SERVICE_CLIENT_SECRET=
# AUTH_MANAGER_SERVICE_AUDIENCE=http://localhost:3003/api/manager/session
# AUTH_MANAGER_SERVICE_ENVIRONMENT=local
# MANAGER_ADMIN_API_KEY=

# Web -> Admin signed-in watch-event validation. Admin introspects
# user-delegated Auth access tokens before accepting watch-event writes.
# Provision a confidential introspection client in Auth; do not reuse
# WEB_ADMIN_API_KEYS or workflow bearer keys.
# AUTH_WEB_USER_INTROSPECTION_CLIENT_ID=
# AUTH_WEB_USER_INTROSPECTION_CLIENT_SECRET=
# AUTH_WEB_USER_CLIENT_IDS=jfp_web_local,jfp_web_preview,jfp_web_staging,jfp_web_production
# AUTH_WEB_USER_TOKEN_ENVIRONMENT=local

# ---------------------------------------------------------------------------
# Local embedding pipeline (run-embeds CLI) — admin reads manager artifacts
# from a SEPARATE bucket than its own (RAILWAY_S3_* above is admin's
# write bucket; MANAGER_ARTIFACTS_S3_* is manager's read-only bucket).
# Pull these from Railway's apps/admin service env to populate locally.
# ---------------------------------------------------------------------------

# Manager artifacts bucket — read-only access to manager-produced artifacts such
# as {assetId}/transcript.json.
# Required for the local run-embeds CLI to fetch artifacts at workflow runtime.
MANAGER_ARTIFACTS_S3_ENDPOINT=
MANAGER_ARTIFACTS_S3_REGION=
MANAGER_ARTIFACTS_S3_BUCKET=
MANAGER_ARTIFACTS_S3_ACCESS_KEY_ID=
MANAGER_ARTIFACTS_S3_SECRET_ACCESS_KEY=

# feat-119 PR2 — admin → manager outbound enrichment trigger.
# Admin's `triggerManagerEnrichment` GraphQL mutation POSTs to
# `${MANAGER_API_BASE_URL}/api/admin-trigger/{scene-analysis,transcript}`
# with `Authorization: Bearer ${MANAGER_TRIGGER_API_KEY}`. The bearer
# must match an entry in manager's `ADMIN_TRIGGER_API_KEYS` CSV.
# Local dev: http://localhost:3002 (default manager port).
MANAGER_API_BASE_URL=http://localhost:3002
MANAGER_TRIGGER_API_KEY=

# Mastra embedding workflows. Admin launches transcript/experience generation in
# Mastra, then receives final vectors through narrow ingest endpoints.
MASTRA_BASE_URL=http://localhost:4111
MASTRA_SERVICE_API_KEY=local-mastra-service-key
MASTRA_GATEWAY_BASE_URL=http://localhost:3005
MASTRA_GATEWAY_ADMIN_API_KEY=local-mastra-gateway-admin-key
MASTRA_TRANSCRIPT_INGEST_API_KEYS=local-admin-transcript-ingest-key
MASTRA_EXPERIENCE_INGEST_API_KEYS=local-admin-experience-ingest-key

# OpenAI / OpenRouter — Admin uses these for live query embeddings and other
# Admin-owned model calls. Background transcript/experience embeddings
# use Mastra provider env.
OPENROUTER_API_PAID_KEY=
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_TEXT_MODELS=nvidia/nemotron-nano-12b-v2-vl:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,baidu/qianfan-ocr-fast:free,google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,google/gemma-3-27b-it:free,openrouter/free
# OPENROUTER_IMAGE_TEXT_MODEL=google/gemma-4-26b-a4b-it:free
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Bearer allowlists — disjoint CSVs.
#   WORKFLOW_API_KEYS  → mints WORKFLOW_TRIGGER (manager→admin service triggers).
#   VIDEO_MAPPER_ADMIN_API_KEYS → mints VIDEO_MAPPER (yt-video-mapper catalog sync).
#   WEB_ADMIN_API_KEYS → mints CONSUMER_BEARER (web/mobile/TV SSR rate-limit bucket).
#   BACKUP_DOWNLOAD_API_KEYS → prod-only signer for video DB backup downloads.
# Generate fresh per-env keys with `openssl rand -base64 32`. No bearer
# allowlist may share a value with another — admin asserts disjointness at boot.
# VIDEO_MAPPER_ADMIN_API_KEYS=
# WEB_ADMIN_API_KEYS=
# BACKUP_DOWNLOAD_API_KEYS=

# Local/staging restore client. The restore:video-db:latest CLI sends this
# bearer to production admin, which returns a short-lived signed S3 download URL.
# BACKUP_DOWNLOAD_API_KEY=
# BACKUP_DOWNLOAD_BASE_URL=https://admin.jesusfilm.org

# Unit 11 / Media assets — Railway S3-compatible object storage.
# Leave unset for the local filesystem fallback used by normal dev/test runs.
# To exercise production-like object APIs locally, point these at MinIO or
# LocalStack and create the bucket before starting the app.
# RAILWAY_S3_ENDPOINT=http://127.0.0.1:9000
# RAILWAY_S3_REGION=auto
# RAILWAY_S3_BUCKET=forge-admin-local
# RAILWAY_S3_ACCESS_KEY_ID=minioadmin
# RAILWAY_S3_SECRET_ACCESS_KEY=minioadmin
