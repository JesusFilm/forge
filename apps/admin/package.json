    "@prisma/client": "^6",
    "@t3-oss/env-nextjs": "^0.13.10",
    "graphql": "16.13.1",
    "graphql-yoga": "5.21.0",
    "next": "^16.1.6",
    "prisma": "^6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.6",
