  osisId       String?    @map("osis_id")
  order        Int?
  chapterStart Int?       @map("chapter_start")
  chapterEnd   Int?       @map("chapter_end")
  verseStart   Int?       @map("verse_start")
  verseEnd     Int?       @map("verse_end")
  syncedAt     DateTime?  @map("synced_at")
  deletedAt    DateTime?  @map("deleted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([videoId])
  @@index([bibleBookId])
  @@index([deletedAt])
  @@map("bible_citation")
}

/// Cached scripture text fetched from an approved remote Bible provider.
model BiblePassageCache {
  id                  String   @id @default(cuid())
  provider            String
  versionId           String   @map("version_id")
  reference           String
  contentFormat       String   @default("text") @map("content_format")
  content             String
  humanReference      String?  @map("human_reference")
  versionAbbreviation String?  @map("version_abbreviation")
  versionTitle        String?  @map("version_title")
  copyright           String
  publisherUrl        String?  @map("publisher_url")
  fetchedAt           DateTime @default(now()) @map("fetched_at")
  expiresAt           DateTime @map("expires_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([provider, versionId, reference, contentFormat])
  @@index([expiresAt])
  @@map("bible_passage_cache")
}

/// A timecoded scene segment of a VideoEdition. Scenes follow the edition's
/// cut, so timecodes attach at edition level (same pattern as VideoSubtitle).
/// Language-agnostic fields only — per-locale descriptions + embeddings live
/// on VideoSceneLocale. Source data: apps/manager's multimodal scene analysis
/// pipeline ({assetId}/scene-analysis.json in Railway S3).
///
/// `videoId` is denormalized from `videoEdition.dubs[].videoId` for
/// "scenes for this video" queries that would otherwise require a two-hop
/// join. If an edition ever moves between videos, re-index.
model VideoScene {
  id             String       @id @default(cuid())
  videoEditionId String       @map("video_edition_id")
  videoEdition   VideoEdition @relation(fields: [videoEditionId], references: [id], onDelete: Cascade)
  videoId        String       @map("video_id")
  video          Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  /// 0-based index within the edition, from manager's scene analysis.
  sceneIndex     Int          @map("scene_index")
  startSeconds   Float        @map("start_seconds")
  endSeconds     Float?       @map("end_seconds")
  /// Chapter title from manager's scene-boundaries output. Nominally
  /// language-agnostic; first-indexed locale wins if drift is observed.
  chapterTitle   String?      @map("chapter_title")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  locales VideoSceneLocale[]

  @@unique([videoEditionId, sceneIndex])
  @@index([videoId])
  @@map("video_scene")
}

/// Per-locale scene description plus historical scene embedding metadata.
/// The scene embedding writer is retired; rows are retained for historical
/// and non-search scene data until feat-199 decides retention/migration.
/// Search and recommendation retrieval are transcript-backed. NEVER expose
/// the vector field in GraphQL (the Pothos type in `src/graphql/types/video.ts`
/// omits it, and `schema.test.ts` asserts no embed/vector/similarity field
/// leaks).
model VideoSceneLocale {
  id                        String                       @id @default(cuid())
  videoSceneId              String                       @map("video_scene_id")
  videoScene                VideoScene                   @relation(fields: [videoSceneId], references: [id], onDelete: Cascade)
  /// IETF BCP-47 locale code, e.g. "en", "fr", "es-419".
  locale                    String
  /// The exact text that was embedded. Stored so a future model upgrade can
  /// re-embed without re-reading manager's S3 artifact.
  sourceText                String                       @map("source_text")
  /// Scene description from manager's multimodal pipeline (per-language).
  description               String
  themes                    String[]                     @default([])
  bibleVerses               String[]                     @default([]) @map("bible_verses")
  demographics              String[]                     @default([])
  spiritualContext          String[]                     @default([]) @map("spiritual_context")
  embedding                 Unsupported("vector(1536)")?
  model                     String                       @default("text-embedding-3-small")
  dimensions                Int                          @default(1536)
  embeddingProvider         String?                      @map("embedding_provider")
  embeddingNativeDimensions Int?                         @map("embedding_native_dimensions")
  embeddingTransformVersion String?                      @map("embedding_transform_version")
  /// Compact provenance for historical Mastra-written scene embeddings.
  /// Nullable for legacy rows written before the Mastra migration.
  sourceArtifactKey         String?                      @map("source_artifact_key")
  sourceArtifactVersion     String?                      @map("source_artifact_version")
  sourceContentHash         String?                      @map("source_content_hash")
  sourceProvider            String?                      @map("source_provider")
  sourceGeneratedAt         DateTime?                    @map("source_generated_at")
  generationMode            String?                      @map("generation_mode")
  mastraRunId               String?                      @map("mastra_run_id")
  generatedAt               DateTime?                    @map("generated_at")
  createdAt                 DateTime                     @default(now()) @map("created_at")
  updatedAt                 DateTime                     @updatedAt @map("updated_at")

  @@unique([videoSceneId, locale])
  @@index([locale])
  @@index([sourceContentHash], map: "video_scene_locale_source_content_hash_idx")
  @@index([mastraRunId], map: "video_scene_locale_mastra_run_id_idx")
  @@map("video_scene_locale")
}

// -----------------------------------------------------------------------------
// Experience and friends
// -----------------------------------------------------------------------------

/// A page-builder Experience. Canonical row holds only non-localized state
/// (`isTemplate`, ownership, archive). Per-locale rows in ExperienceLocale
/// carry the slug, title, blocks, AND the embedding vector — embeddings
/// are per-locale so semantic search matches the user's language without
/// relying on cross-language embedding-model quirks.
model Experience {
  id         String    @id @default(cuid())
  /// True for template Experiences that are cloned to create real ones.
  /// Per Strapi schema this is the ONLY non-localized Experience attribute.
  isTemplate Boolean   @default(false) @map("is_template")
  /// Owner principal id (from the admin Auth SSO user mapping).
  /// Nullable for system-imported templates.
  ownerId    String?   @map("owner_id")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  locales ExperienceLocale[]

  @@index([archivedAt])
  @@index([ownerId])
  @@map("experience")
}

/// Per-locale Experience content. Each locale has its own slug, blocks, and
/// publish lifecycle so editors can ship English while French is still a draft.
///
/// Block schema shape is enforced at the service boundary by the Zod
/// discriminated union in `src/domain/blocks.ts` (Unit 4e). Reads return the
/// JSONB column directly; mutations validate before write.
model ExperienceLocale {
  chatThreads                ExperienceChatThread[] // experience-AI chat (additive)
  id                         String                       @id @default(cuid())
  experienceId               String                       @map("experience_id")
  experience                 Experience                   @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  /// IETF BCP-47 locale code, e.g. "en", "fr", "es-419".
  locale                     String
  /// URL slug (UID-style). Unique within (locale, slug) when published — the
  /// partial unique index lives in raw migration SQL since Prisma doesn't
  /// model partial uniques natively.
  slug                       String
  /// True when this locale is the homepage for its locale.
  isHomepage                 Boolean                      @default(false) @map("is_homepage")
  /// Optional URL path prefix; combines with `slug` to form the canonical path.
  pathSegment                String?                      @map("path_segment")
  title                      String?
  metaDescription            String?                      @map("meta_description")
  ogTitle                    String?                      @map("og_title")
  ogDescription              String?                      @map("og_description")
  /// External media URL for the OG image. Media uploads land in Unit 11
  /// (storage service); this column may later become an FK to a MediaAsset.
  ogImageUrl                 String?                      @map("og_image_url")
  /// Block-based content composition. Validated by the Zod union before write.
  blocks                     Json                         @default("[]")
  /// Per-locale embedding vector. NULL until the experienceEmbedding workflow
  /// runs against this locale's text. Excluded from Pothos types (technical
  /// control — schema test asserts no embed/vector/similarity field leaks).
  /// Search uses raw SQL inside services with `<=>` cosine distance + the
  /// partial HNSW index `WHERE embedding IS NOT NULL`.
  embedding                  Unsupported("vector(1536)")?
  /// Compact provenance for vectors generated by Mastra. These fields are
  /// internal-only and are not exposed via GraphQL.
  embeddingSourceContentHash String?                      @map("embedding_source_content_hash")
  embeddingSourceSummary     String?                      @map("embedding_source_summary")
  embeddingModel             String?                      @map("embedding_model")
  embeddingDimensions        Int?                         @map("embedding_dimensions")
  embeddingProvider          String?                      @map("embedding_provider")
  embeddingNativeDimensions  Int?                         @map("embedding_native_dimensions")
  embeddingTransformVersion  String?                      @map("embedding_transform_version")
  embeddingGenerationMode    String?                      @map("embedding_generation_mode")
  embeddingMastraRunId       String?                      @map("embedding_mastra_run_id")
  embeddingGeneratedAt       DateTime?                    @map("embedding_generated_at")
  status                     LocaleStatus                 @default(DRAFT)
  publishedAt                DateTime?                    @map("published_at")
  createdAt                  DateTime                     @default(now()) @map("created_at")
  updatedAt                  DateTime                     @updatedAt @map("updated_at")

  @@unique([experienceId, locale])
  @@index([locale])
  @@index([status])
  @@index([embeddingSourceContentHash])
  @@index([embeddingMastraRunId])
  @@map("experience_locale")
}

// -----------------------------------------------------------------------------
// Transcript embeddings
// -----------------------------------------------------------------------------

/// Per-edition, per-language transcript index. One row per
/// `(videoEditionId, language)`. Admin owns transcript vector storage and
/// retrieval; Mastra owns chunk planning + embedding provider calls. Holds
/// compact provenance so model upgrades and repair runs can be audited without
/// reading manager transcript source artifacts back from S3.
model VideoTranscript {
  id                        String       @id @default(cuid())
  videoEditionId            String       @map("video_edition_id")
  videoEdition              VideoEdition @relation(fields: [videoEditionId], references: [id], onDelete: Cascade)
  /// Denormalized from the edition's parent video for convenience joins.
  videoId                   String       @map("video_id")
  video                     Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  /// IETF BCP-47 language tag of the source transcript.
  language                  String
  /// Embedding model string as reported by the producing workflow (e.g.
  /// `openai/text-embedding-3-small`). Admin logs a warning on drift;
  /// intentional model replacement must use an explicit ingest mode.
  model                     String
  /// Dimension count. Hard-guarded to 1536 at read time.
  dimensions                Int
  embeddingProvider         String?      @map("embedding_provider")
  embeddingNativeDimensions Int?         @map("embedding_native_dimensions")
  embeddingTransformVersion String?      @map("embedding_transform_version")
  /// Chunking strategy metadata from the producing pipeline.
  chunkingType              String       @map("chunking_type")
  maxChunkTokens            Int          @map("max_chunk_tokens")
  overlapTokens             Int          @map("overlap_tokens")
  totalChunks               Int          @map("total_chunks")
  totalTokens               Int          @map("total_tokens")
  /// Artifact's own `generatedAt` timestamp — NOT admin's insert time.
  generatedAt               DateTime     @map("generated_at")
  /// Compact provenance for Mastra-written transcript embeddings. Nullable so
  /// legacy rows from the pre-Mastra producer remain readable.
  sourceArtifactKey         String?      @map("source_artifact_key")
  sourceKind                String?      @map("source_kind")
  sourceLanguageId          String?      @map("source_language_id")
  sourceLanguageSlug        String?      @map("source_language_slug")
  sourceSubtitleId          String?      @map("source_subtitle_id")
  sourceFormat              String?      @map("source_format")
  sourceUrl                 String?      @map("source_url")
  sourceContentHash         String?      @map("source_content_hash")
  sourceProvider            String?      @map("source_provider")
  sourceGeneratedAt         DateTime?    @map("source_generated_at")
  generationMode            String?      @map("generation_mode")
  mastraRunId               String?      @map("mastra_run_id")
  chunkingVersion           String?      @map("chunking_version")
  createdAt                 DateTime     @default(now()) @map("created_at")
  updatedAt                 DateTime     @updatedAt @map("updated_at")

  chunks VideoTranscriptChunk[]

  @@unique([videoEditionId, language])
  @@index([videoId])
  @@index([language])
  @@index([sourceContentHash], map: "video_transcript_source_content_hash_idx")
  @@index([mastraRunId], map: "video_transcript_mastra_run_id_idx")
  @@map("video_transcript")
}

/// A single chunk of a transcript, including its vector embedding. Vectors
/// are supplied by Mastra and stored by Admin ingest. `language` is
/// denormalized from the parent `VideoTranscript` so per-language partial HNSW
/// indexes filter on the same table (pgvector's planner bypasses HNSW when the
/// WHERE filter column lives on a joined table).
///
/// `embedding` is NEVER exposed in GraphQL (technical control: Pothos
/// field list omits it; `src/graphql/schema.test.ts` asserts no
/// embed/vector/similarity field leaks; and the Prisma client extension
/// in `src/db/client.ts` strips it from default result sets).
model VideoTranscriptChunk {
  id                 String                       @id @default(cuid())
  transcriptId       String                       @map("transcript_id")
  transcript         VideoTranscript              @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  /// Denormalized from `transcript.language`. Indexer keeps the two in sync;
  /// no DB-level CHECK (Postgres doesn't support cross-row checks cleanly).
  language           String
  /// 0-based index within the transcript, stable across re-chunks.
  chunkIndex         Int                          @map("chunk_index")
  /// Opaque chunk identifier from manager's artifact (e.g. "chunk-0").
  /// Preserved for drift audits against the upstream artifact.
  chunkId            String                       @map("chunk_id")
  /// The embedded text, verbatim from the artifact's `chunks[].text`.
  text               String
  /// Raw subtitle/transcript source text for this segment. Nullable for legacy
  /// v1 rows where `text` was the only stored snippet.
  rawSourceText      String?                      @map("raw_source_text")
  /// Full vector input text. v2 rows keep this separate from user/debug
  /// snippets so enriched metadata can be audited without replacing raw text.
  embeddingInputText String?                      @map("embedding_input_text")
  feltNeeds          String[]                     @default([]) @map("felt_needs")
  bibleVerses        String[]                     @default([]) @map("bible_verses")
  contentSummary     String?                      @map("content_summary")
  tone               String?
  demographics       String[]                     @default([])
  spiritualContext   String[]                     @default([]) @map("spiritual_context")
  extractionMetadata Json?                        @map("extraction_metadata")
  /// Estimated token count from manager's chunker.
  tokenCount         Int                          @map("token_count")
  /// Optional timecodes when the chunk came from a segment-aware chunker.
  startSeconds       Float?                       @map("start_seconds")
  endSeconds         Float?                       @map("end_seconds")
  embedding          Unsupported("vector(1536)")?
  model              String                       @default("text-embedding-3-small")
  dimensions         Int                          @default(1536)
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  @@unique([transcriptId, chunkIndex])
  @@index([language])
  @@map("video_transcript_chunk")
}

// -----------------------------------------------------------------------------
// Experience-AI chat (in-admin Mastra runtime) — additive block from the
// feat/admin-ai-chat-thumb-rating branch. Tables created by migrations
// 0029_experience_chat + 0031_chat_message_produced_by.
// -----------------------------------------------------------------------------
enum ExperienceChatMessageRole {
  USER      @map("user")
  ASSISTANT @map("assistant")
  SYSTEM    @map("system")
}

model ExperienceChatThread {
  id                 String           @id @default(cuid())
  experienceLocaleId String           @map("experience_locale_id")
  experienceLocale   ExperienceLocale @relation(fields: [experienceLocaleId], references: [id], onDelete: Cascade)
  title              String
  createdByUserId    String           @map("created_by_user_id")
  createdBy          User             @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  lastMessageAt      DateTime         @default(now()) @map("last_message_at")
  archivedAt         DateTime?        @map("archived_at")

  messages ExperienceChatMessage[]

  @@index([experienceLocaleId, lastMessageAt(sort: Desc)], map: "experience_chat_thread_locale_last_message_idx")
  @@index([createdByUserId], map: "experience_chat_thread_created_by_idx")
  @@map("experience_chat_thread")
}

/// One turn in a chat thread. Assistant turns may carry a snapshot_diff
/// (hybrid RFC-6902 + scalar before/after envelope) and mutations_applied
/// (the validated AI envelope).
model ExperienceChatMessage {
  id               String                    @id @default(cuid())
  threadId         String                    @map("thread_id")
  thread           ExperienceChatThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role             ExperienceChatMessageRole
  content          String
  providerKind     String?                   @map("provider_kind")
  // Producer id (agent or workflow) that emitted this assistant turn.
  // Free-form string instead of a Prisma enum so adding a new agent
  // doesn't require a migration. The closed ratable set lives in
  // src/services/chat-rating.constants.ts; the chat-rating service
  // refuses to rate messages whose producedBy is outside that set.
  // Nullable for historic rows (the column landed in migration
  // 0031_chat_message_produced_by) and for non-assistant turns where it
  // has no meaning.
  producedBy       String?                   @map("produced_by")
  promptTokens     Int?                      @map("prompt_tokens")
  completionTokens Int?                      @map("completion_tokens")
  snapshotDiff     Json?                     @map("snapshot_diff")
  mutationsApplied Json?                     @map("mutations_applied")
  createdAt        DateTime                  @default(now()) @map("created_at")

  @@index([threadId, createdAt(sort: Asc)], map: "experience_chat_message_thread_created_idx")
  @@map("experience_chat_message")
}

