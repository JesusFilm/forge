  READY       @map("ready")
  INVALIDATED @map("invalidated")
  RETIRING    @map("retiring")
  RETIRED     @map("retired")
}

/// Independent pointers prevent evaluation publication from moving serving.
enum WatchSearchCandidatePointerKind {
  EVALUATION @map("evaluation")
