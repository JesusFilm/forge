  name        String
  description String?
  syncedAt    DateTime?  @map("synced_at")
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  videos Video[]

  @@index([deletedAt])
  @@map("video_origin")
}

/// Video edition (e.g. "Director's cut"). Synced from Core.
model VideoEdition {
  id        String     @id @default(cuid())
  coreId    String     @unique @map("core_id")
  source    SourceTier @default(CORE)
  /// Plain `String` (not JSONB locale-map like other reference entities).
  /// Audit Core's actual response shape during Unit 10 sync; if Core
  /// returns a localized name, normalize to JSON.
  name      String
  syncedAt  DateTime?  @map("synced_at")
  deletedAt DateTime?  @map("deleted_at")
  createdAt DateTime   @default(now()) @map("created_at")
