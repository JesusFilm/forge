/// A localized display name for a country. Synced from Core.
model CountryLocale {
  id        String     @id @default(cuid())
  source    SourceTier @default(CORE)
  countryId String     @map("country_id")
  country   Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  locale    String
  value     String
  primary   Boolean    @default(false)
  order     Int?
  syncedAt  DateTime?  @map("synced_at")
  deletedAt DateTime?  @map("deleted_at")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@unique([countryId, locale])
  @@index([locale])
  @@index([deletedAt])
  @@map("country_locale")
}

/// Many-to-many between Country and Language with optional metadata.
model CountryLanguage {
  id              String     @id @default(cuid())
  coreId          String?    @unique @map("core_id")
  source          SourceTier @default(CORE)
  countryId       String     @map("country_id")
  languageId      String     @map("language_id")
  country         Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  language        Language   @relation(fields: [languageId], references: [id], onDelete: Cascade)
  /// Speakers of this language in this country (Core-provided).
  speakers        Int?
  displaySpeakers String?    @map("display_speakers")
  /// Whether Core marks this as a primary language for the country.
  primary         Boolean?   @default(false)
  /// Whether this language is suggested for the country.
  suggested       Boolean?   @default(false)
  /// Core-provided display order within the country.
  order           Int?
  syncedAt        DateTime?  @map("synced_at")
  deletedAt       DateTime?  @map("deleted_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@unique([countryId, languageId])
  @@index([languageId])
  @@index([deletedAt])
  @@map("country_language")
}

/// A keyword tag for video search/filtering. Synced from Core.
model Keyword {
  id         String     @id @default(cuid())
  coreId     String     @unique @map("core_id")
  source     SourceTier @default(CORE)
  value      String
  languageId String?    @map("language_id")
  language   Language?  @relation(fields: [languageId], references: [id], onDelete: SetNull)
  syncedAt   DateTime?  @map("synced_at")
  deletedAt  DateTime?  @map("deleted_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  videos VideoKeyword[]

  @@index([languageId])
  @@index([value])
  @@index([deletedAt])
  @@map("keyword")
}

/// Video origin (production source / studio). Synced from Core.
model VideoOrigin {
  id          String     @id @default(cuid())
  coreId      String     @unique @map("core_id")
  source      SourceTier @default(CORE)
  /// Plain `String` (not JSONB locale-map like other reference entities).
  /// Audit Core's actual response shape during Unit 10 sync; if Core
  /// returns a localized name, normalize to JSON `{ "en": "...", ... }`
