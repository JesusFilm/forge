  REJECTED          @map("rejected")
}

enum WatchSearchCandidateLeaseKind {
  COMPARISON @map("comparison")
  EVALUATION @map("evaluation")
}

/// Execution mode is persisted with each Watch-route monitoring run so a
/// diagnostic dry run can never be mistaken for an alert-producing run.
