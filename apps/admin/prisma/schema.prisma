  @@map("video_edition")
}

/// Mux asset metadata. The `mux_videos.duration` field in the legacy CMS is
/// always 0 — duration lives on `video_dub.length_in_milliseconds`.
model MuxVideo {
  id         String     @id @default(cuid())
  coreId     String?    @unique @map("core_id")
  source     SourceTier @default(CORE)
  assetId    String?    @map("asset_id")
  playbackId String?    @map("playback_id")
  uploadId   String?    @map("upload_id")
  /// Mux reports duration here as 0 — variant.lengthInMilliseconds is canonical.
  duration   Int?
  syncedAt   DateTime?  @map("synced_at")
  deletedAt  DateTime?  @map("deleted_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  dubs             VideoDub[]
  imageDerivatives MuxImageDerivative[]

  @@index([deletedAt])
  @@map("mux_video")
}

/// Generated image metadata for a specific Mux thumbnail recipe. Unlike
/// VideoImage.blurDataUrl, these rows describe derived Mux images such as the
