  @@unique([propertyId, normalizedPath])
  @@index([lifecycle, severity, latestCount(sort: Desc), lastSeenAt(sort: Desc), id])
  @@index([propertyId, lifecycle, severity, lastSeenAt, id])
  @@index([propertyId, lifecycle, lastProbedAt, id])
