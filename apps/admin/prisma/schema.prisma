}

enum WatchRouteAlertVerdict {
  SUPPORTED_ROUTE_FAILURE @map("supported_route_failure")
  PLAUSIBLE_MISSING_ROUTE @map("plausible_missing_route")
}

enum WatchRouteAlertSeverity {
  CRITICAL @map("critical")
  HIGH     @map("high")
  MEDIUM   @map("medium")
}

enum WatchRouteAlertLifecycle {
  OPEN      @map("open")
  RECOVERED @map("recovered")
}

// -----------------------------------------------------------------------------
// Admin access control (Auth SSO relying client)
// -----------------------------------------------------------------------------

model User {
  chatThreadsCreated ExperienceChatThread[] // experience-AI chat (additive)
  id                 String                 @id
  name               String
  email              String
  emailVerified      Boolean                @default(false) @map("email_verified")
  image              String?
  role               UserRole               @default(VIEWER)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  mediaAssets           MediaAsset[]
  mediaFolders          MediaFolder[]
  managerMembership     ManagerMembership?
  partnerApiKeysCreated PartnerApiKey[]    @relation("PartnerApiKeyCreatedBy")
  partnerApiKeysRevoked PartnerApiKey[]    @relation("PartnerApiKeyRevokedBy")

  @@unique([email])
  @@map("user")
}

model ManagerMembership {
  id        String      @id @default(cuid())
  userId    String      @unique @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ManagerRole @default(OPERATOR)
  revokedAt DateTime?   @map("revoked_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([role])
  @@index([revokedAt])
  @@map("manager_membership")
}

// -----------------------------------------------------------------------------
// Partner API key store
// -----------------------------------------------------------------------------

/// External partner credentials for admin's public search surface
/// (`GET /api/search`). One row per issued partner key.
/// The bearer-as-passport composer (`src/auth/search-bearer.ts`) validates
/// presented tokens against this table BEFORE falling through to the legacy
/// `SEARCH_API_KEYS` env-CSV branch. See:
///
/// - Plan: `docs/plans/2026-05-18-001-feat-partner-api-key-store-plan.md`
/// - apps/admin/CLAUDE.md §"Partner API key store"
///
/// Token shape: `jfp_search_<keyId>_<random>`. `keyId` is the operator-visible
/// short identifier surfaced in the per-request structured log
/// (`auth=bearer source=partner keyId=…`). `keyHash` is `sha256(rawToken)`
/// stored as 64-char hex; comparison uses `timingSafeEqual` on decoded
/// buffers. Plaintext is shown to the operator exactly once at issuance
/// and never persisted.
///
/// Revocation is soft (`revokedAt` set, row preserved) — preserves the audit
/// trail of which key was revoked, when, and by whom.
model PartnerApiKey {
  id         String    @id @default(cuid())
  /// Operator-visible short identifier embedded in the token prefix.
  /// 12 chars, URL-safe (no `_` because that's the token-format delimiter).
  keyId      String    @unique @map("key_id")
  /// `sha256(rawToken)` as 64-char hex. Constant-time compared on auth.
  keyHash    String    @unique @map("key_hash")
  /// Human-readable display name shown on the dashboard (the partner org).
  name       String
  /// Primary contact for the partner; used for offboarding handoffs.
  ownerEmail String    @map("owner_email")
  /// Free-form operator note (issuance context, rotation reminders, etc.).
  note       String?
  /// Updated fire-and-forget on every successful partner-bearer auth.
  /// Drives the dashboard's "has this partner integrated yet?" column.
  lastUsedAt DateTime? @map("last_used_at")
  /// Set on revoke; row preserved for audit. `revokedAt IS NULL` means active.
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("PartnerApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  revokedById String? @map("revoked_by_id")
  revokedBy   User?   @relation("PartnerApiKeyRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([revokedAt])
  @@index([lastUsedAt])
  @@index([createdById])
  @@index([revokedById])
  @@map("partner_api_key")
}

// -----------------------------------------------------------------------------
// Core sync infrastructure (Unit 2)
// -----------------------------------------------------------------------------

/// Per-phase watermark for Core API sync.
/// Advanced only when the phase completes with zero errors (see Unit 10).
/// last_synced_at captures the fetch-start time, NOT completion time, so
/// records Core updates during the run are picked up on the next pass.
model SyncState {
  /// Phase identifier, e.g. "languages" | "countries" | "keywords" | "videos" | "video-variants"
  phase        String   @id
  lastSyncedAt DateTime @map("last_synced_at")
  /// Per-run counters: { created, updated, softDeleted, errors, lastRunAt }
  stats        Json     @default("{}")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sync_state")
}

/// DB-backed lock replacing the manager/CMS in-memory `syncInProgress` guard.
/// Claimed synchronously via SELECT ... FOR UPDATE SKIP LOCKED before the
/// workflow steps fire, so cross-instance runs on Railway can't overlap.
/// See docs/solutions/platform/backfill-worker-pattern-manager-20260407.md.
model SyncLock {
  /// Lock key, e.g. "core-sync"
  key        String    @id
  /// Instance or workflow run holding the lock (nullable when unlocked)
  heldBy     String?   @map("held_by")
  acquiredAt DateTime? @map("acquired_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("sync_locks")
}

/// Admin-owned product ledger for workflow runs. Postgres World remains the
/// runtime source of truth; this table adds operator context that can be joined
/// to runtime rows by `runtime_run_id`.
model WorkflowRun {
  id           String             @id @default(cuid())
  runtimeRunId String?            @unique @map("runtime_run_id")
  workflowKey  String             @map("workflow_key")
  workflowName String?            @map("workflow_name")
  trigger      WorkflowRunTrigger
  actorId      String?            @map("actor_id")
  subjectType  String?            @map("subject_type")
  subjectId    String?            @map("subject_id")
  status       WorkflowRunStatus  @default(QUEUED)
  summary      String?
  error        String?
  startedAt    DateTime?          @map("started_at")
  finishedAt   DateTime?          @map("finished_at")
  durationMs   Int?               @map("duration_ms")
  details      Json               @default("{}")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  coreSyncRun CoreSyncRun?

  @@index([workflowKey, createdAt])
  @@index([status, createdAt])
  @@index([trigger, createdAt])
  @@map("workflow_run")
}

/// Process heartbeat written by admin instances that start Workflow's
/// Postgres World runner. Graphile Worker tracks locked jobs, but it does not
/// persist idle workers, so this table is the dashboard's source for
/// "is a worker process alive?"
model WorkflowWorkerHeartbeat {
  workerId     String   @id @map("worker_id")
  service      String   @default("admin")
  status       String   @default("online")
  startedAt    DateTime @default(now()) @map("started_at")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  currentJob   String?  @map("current_job")
  currentRunId String?  @map("current_run_id")
  details      Json     @default("{}")

  @@index([lastSeenAt])
  @@map("workflow_worker_heartbeat")
}

/// Short-lived Admin-owned production search trace. Raw rows are the only place
/// query text may exist, and they expire before the hard 30-day raw retention
/// ceiling. The table deliberately has no bearer, cookie, IP, user-id, key-id,
/// vector, or scoring payload columns.
model SearchTrace {
  id                   String                   @id @default(cuid())
  requestId            String?                  @map("request_id") @db.VarChar(80)
  queryText            String                   @map("query_text") @db.VarChar(1024)
  locale               String                   @db.VarChar(32)
  routeSource          SearchTraceRouteSource   @map("route_source")
  requestedMode        String?                  @map("requested_mode") @db.VarChar(64)
  searchMode           String                   @map("search_mode") @db.VarChar(64)
  resultCount          Int                      @map("result_count")
  latencyBucket        SearchTraceLatencyBucket @map("latency_bucket")
  outcome              SearchTraceOutcome
  traceClass           String                   @default("none") @map("trace_class") @db.VarChar(64)
  queryQualityLabel    String                   @default("unknown_ambiguous") @map("query_quality_label") @db.VarChar(64)
  sensitiveQueryLabel  String                   @default("none") @map("sensitive_query_label") @db.VarChar(64)
  abuseLabel           String                   @default("none") @map("abuse_label") @db.VarChar(64)
  queryLabelSource     String                   @default("rules") @map("query_label_source") @db.VarChar(32)
  queryLabelVersion    String                   @default("search-query-labels/v1") @map("query_label_version") @db.VarChar(64)
  queryLabeledAt       DateTime                 @default(now()) @map("query_labeled_at")
  sampleEligible       Boolean                  @default(true) @map("sample_eligible")
  metadata             Json?                    @map("metadata")
  llmQueryQualityLabel String?                  @map("llm_query_quality_label") @db.VarChar(64)
  llmAbuseLabel        String?                  @map("llm_abuse_label") @db.VarChar(64)
  llmLabelSource       String?                  @map("llm_label_source") @db.VarChar(64)
  llmLabelVersion      String?                  @map("llm_label_version") @db.VarChar(64)
  llmLabelReason       String?                  @map("llm_label_reason") @db.VarChar(256)
  llmLabeledAt         DateTime?                @map("llm_labeled_at")
  startedAt            DateTime                 @map("started_at")
  completedAt          DateTime                 @map("completed_at")
  rawExpiresAt         DateTime                 @map("raw_expires_at")
  createdAt            DateTime                 @default(now()) @map("created_at")

  @@index([rawExpiresAt])
  @@index([createdAt])
  @@index([requestId])
  @@index([locale, createdAt])
  @@index([routeSource, createdAt])
  @@index([outcome, createdAt])
  @@index([sampleEligible, rawExpiresAt, createdAt])
  @@index([queryQualityLabel, sensitiveQueryLabel, abuseLabel, rawExpiresAt, createdAt], map: "search_trace_label_filters_raw_expires_created_idx")
  @@index([llmLabelSource, createdAt], map: "search_trace_llm_label_source_created_at_idx")
  @@map("search_trace")
}

/// Long-lived counters for search trace analysis. Aggregates never contain raw
/// query text, so they may survive raw trace purge.
model SearchTraceAggregate {
  id                  String                   @id @default(cuid())
  bucketStart         DateTime                 @map("bucket_start")
  locale              String                   @db.VarChar(32)
  routeSource         SearchTraceRouteSource   @map("route_source")
  searchMode          String                   @map("search_mode") @db.VarChar(64)
  outcome             SearchTraceOutcome
  traceClass          String                   @default("none") @map("trace_class") @db.VarChar(64)
  latencyBucket       SearchTraceLatencyBucket @map("latency_bucket")
  queryQualityLabel   String                   @default("unknown_ambiguous") @map("query_quality_label") @db.VarChar(64)
  sensitiveQueryLabel String                   @default("none") @map("sensitive_query_label") @db.VarChar(64)
  abuseLabel          String                   @default("none") @map("abuse_label") @db.VarChar(64)
  queryLabelSource    String                   @default("rules") @map("query_label_source") @db.VarChar(32)
  queryLabelVersion   String                   @default("search-query-labels/v1") @map("query_label_version") @db.VarChar(64)
  queryCount          Int                      @default(0) @map("query_count")
  resultCountSum      Int                      @default(0) @map("result_count_sum")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  @@unique([bucketStart, routeSource, locale, searchMode, outcome, traceClass, latencyBucket, queryQualityLabel, sensitiveQueryLabel, abuseLabel], name: "searchTraceAggregateBucketDimsLegacy", map: "search_trace_aggregate_bucket_dims_key")
  @@unique([bucketStart, routeSource, locale, searchMode, outcome, traceClass, latencyBucket, queryQualityLabel, sensitiveQueryLabel, abuseLabel, queryLabelSource, queryLabelVersion], name: "searchTraceAggregateBucketDims", map: "search_trace_aggregate_bucket_label_dims_key")
  @@index([bucketStart])
  @@index([routeSource, bucketStart])
  @@index([outcome, bucketStart])
  @@map("search_trace_aggregate")
}

/// Staged search-eval candidates generated by offline Mastra workflows.
/// Generated rows do not participate in permanent regression gates until a
/// future human-promotion workflow sanitizes and promotes them.
model SearchEvalCandidate {
  id                           String                                @id @default(cuid())
  source                       SearchEvalCandidateSource
  locale                       String                                @db.VarChar(32)
  queryText                    String                                @map("query_text") @db.VarChar(512)
  expectedResultHints          Json                                  @default("[]") @map("expected_result_hints")
  sourceAnchors                Json                                  @default("[]") @map("source_anchors")
  labelProvenance              Json                                  @default("{}") @map("label_provenance")
  generationModel              String                                @map("generation_model") @db.VarChar(128)
  generationProvider           String?                               @map("generation_provider") @db.VarChar(64)
  judgeSummary                 Json?                                 @map("judge_summary")
  promotionStatus              SearchEvalCandidatePromotionStatus    @default(GENERATED) @map("promotion_status")
  sanitizedQueryText           String?                               @map("sanitized_query_text") @db.VarChar(512)
  sanitizedExpectedResultNotes String?                               @map("sanitized_expected_result_notes") @db.VarChar(2048)
  sanitizedSourceAnchors       Json                                  @default("[]") @map("sanitized_source_anchors")
  sanitizationStatus           SearchEvalCandidateSanitizationStatus @default(PENDING) @map("sanitization_status")
  reviewerIdentity             String?                               @map("reviewer_identity") @db.VarChar(256)
  reviewedAt                   DateTime?                             @map("reviewed_at")
  reviewNotes                  String?                               @map("review_notes") @db.VarChar(2048)
  promotedAt                   DateTime?                             @map("promoted_at")
  promotionRunContext          Json                                  @default("{}") @map("promotion_run_context")
  mastraRunId                  String?                               @map("mastra_run_id") @db.VarChar(128)
  dedupeKey                    String                                @unique @map("dedupe_key") @db.VarChar(64)
  retentionExpiresAt           DateTime?                             @map("retention_expires_at")
  generatedAt                  DateTime                              @default(now()) @map("generated_at")
  createdAt                    DateTime                              @default(now()) @map("created_at")
  updatedAt                    DateTime                              @updatedAt @map("updated_at")

  @@index([source, locale, createdAt])
  @@index([promotionStatus, createdAt])
  @@index([promotionStatus, reviewedAt])
  @@index([promotedAt])
  @@index([retentionExpiresAt])
  @@index([mastraRunId])
  @@map("search_eval_candidate")
}

/// One immutable, candidate-owned physical collection tuple. BUILDING rows
/// exist before external resources so failed publication never leaves an
/// ownerless Typesense collection.
model WatchSearchCandidateGeneration {
  id                           String                              @id @db.VarChar(128)
  state                        WatchSearchCandidateGenerationState @default(BUILDING)
  version                      Int                                 @default(0)
  indexContractRevision        String                              @map("application_revision") @db.VarChar(128)
  contentEmbeddingContractId   String                              @map("content_embedding_contract_id") @db.VarChar(128)
  transcriptChunkingVersion    String                              @map("transcript_chunking_version") @db.VarChar(128)
  sourceEpoch                  String                              @map("source_epoch") @db.VarChar(128)
  sourceDigests                Json                                @map("source_digests")
  catalogCollection            String                              @map("catalog_collection") @db.VarChar(255)
  availabilityCollection       String                              @map("availability_collection") @db.VarChar(255)
  lexicalCollection            String                              @map("lexical_collection") @db.VarChar(255)
  transcriptCollection         String                              @map("transcript_collection") @db.VarChar(255)
  transcriptProjectionRevision BigInt                              @map("transcript_projection_revision")
  catalogFields                Json                                @map("catalog_fields")
  availabilityFields           Json                                @map("availability_fields")
  lexicalFields                Json                                @map("lexical_fields")
  transcriptFields             Json                                @map("transcript_fields")
  ownedCollections             Json                                @map("owned_collections")
  sharedCollections            Json                                @map("shared_collections")
  documentCounts               Json                                @default("{}") @map("document_counts")
  capacityEvidence             Json                                @default("{}") @map("capacity_evidence")
  deletionProgress             Json                                @default("{}") @map("deletion_progress")
  validatedAt                  DateTime?                           @map("validated_at")
  invalidatedAt                DateTime?                           @map("invalidated_at")
  invalidationReason           String?                             @map("invalidation_reason") @db.VarChar(2048)
  retiredAt                    DateTime?                           @map("retired_at")
  createdAt                    DateTime                            @default(now()) @map("created_at")
  updatedAt                    DateTime                            @updatedAt @map("updated_at")

  pointers       WatchSearchCandidatePointer[]
  qualifications WatchSearchCandidateQualification[]
  leases         WatchSearchCandidateLease[]

  @@index([state, createdAt])
  @@index([transcriptCollection, transcriptProjectionRevision])
  @@index([transcriptCollection, contentEmbeddingContractId, transcriptChunkingVersion])
  @@map("watch_search_candidate_generation")
}

/// Singleton pointers are versioned CAS records. EVALUATION and SERVING are
/// deliberately separate so publishing a candidate cannot promote it.
model WatchSearchCandidatePointer {
  kind         WatchSearchCandidatePointerKind @id
  generationId String?                         @map("generation_id") @db.VarChar(128)
  generation   WatchSearchCandidateGeneration? @relation(fields: [generationId], references: [id], onDelete: Restrict)
  version      Int                             @default(0)
  updatedAt    DateTime                        @updatedAt @map("updated_at")

  @@index([generationId])
  @@map("watch_search_candidate_pointer")
}

/// Append-only evidence bound to the exact application and index identity.
model WatchSearchCandidateQualification {
  id                           String                                  @id @default(cuid())
  generationId                 String                                  @map("generation_id") @db.VarChar(128)
  generation                   WatchSearchCandidateGeneration          @relation(fields: [generationId], references: [id], onDelete: Restrict)
  status                       WatchSearchCandidateQualificationStatus
  indexContractRevision        String                                  @map("application_revision") @db.VarChar(128)
  contentEmbeddingContractId   String                                  @map("content_embedding_contract_id") @db.VarChar(128)
  transcriptChunkingVersion    String                                  @map("transcript_chunking_version") @db.VarChar(128)
  transcriptCollection         String                                  @map("transcript_collection") @db.VarChar(255)
  transcriptProjectionRevision BigInt                                  @map("transcript_projection_revision")
  qrelsRevision                String                                  @map("qrels_revision") @db.VarChar(128)
  currentBindings              Json                                    @map("current_bindings")
  evidence                     Json
  createdAt                    DateTime                                @default(now()) @map("created_at")

  @@index([generationId, status, createdAt])
  @@map("watch_search_candidate_qualification")
}

/// Renewable, no-queue lease for production comparisons and qualification.
/// Its identity columns pin all members a publisher or cleaner must protect.
model WatchSearchCandidateLease {
  resourceKey                  String                         @id @map("resource_key") @db.VarChar(128)
  kind                         WatchSearchCandidateLeaseKind
  holderToken                  String                         @map("holder_token") @db.VarChar(128)
  generationId                 String                         @map("generation_id") @db.VarChar(128)
  generation                   WatchSearchCandidateGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)
  indexContractRevision        String                         @map("application_revision") @db.VarChar(128)
  contentEmbeddingContractId   String                         @map("content_embedding_contract_id") @db.VarChar(128)
  transcriptChunkingVersion    String                         @map("transcript_chunking_version") @db.VarChar(128)
  transcriptCollection         String                         @map("transcript_collection") @db.VarChar(255)
  transcriptProjectionRevision BigInt                         @map("transcript_projection_revision")
  currentBindings              Json                           @map("current_bindings")
  acquiredAt                   DateTime                       @map("acquired_at")
  renewedAt                    DateTime                       @map("renewed_at")
  expiresAt                    DateTime                       @map("expires_at")

  @@index([generationId, expiresAt])
  @@index([transcriptCollection, transcriptProjectionRevision, expiresAt])
  @@index([transcriptCollection, contentEmbeddingContractId, transcriptChunkingVersion, expiresAt])
  @@index([expiresAt])
  @@map("watch_search_candidate_lease")
}

/// Core Sync-specific detail for the generic workflow ledger. Kept separate so
/// non-Core workflows can use `WorkflowRun` without carrying sync phase fields.
model CoreSyncRun {
  id            String      @id @default(cuid())
  workflowRunId String      @unique @map("workflow_run_id")
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  skippedLock   Boolean     @default(false) @map("skipped_lock")
  incremental   Boolean
  createdCount  Int         @default(0) @map("created_count")
  updatedCount  Int         @default(0) @map("updated_count")
  deletedCount  Int         @default(0) @map("deleted_count")
  errorCount    Int         @default(0) @map("error_count")
  phaseSummary  Json        @default("[]") @map("phase_summary")
  coverageAudit Json?       @map("coverage_audit")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("core_sync_run")
}

/// Manager-facing coverage snapshot history. This preserves the Manager
/// `/api/coverage-snapshots` shape while Admin becomes the backend authority.
model ManagerCoverageSnapshot {
  id                      String   @id @default(cuid())
  date                    DateTime
  computedAt              DateTime @default(now()) @map("computed_at")
  totalVideos             Int      @default(0) @map("total_videos")
  videosWithAiMetadata    Int      @default(0) @map("videos_with_ai_metadata")
  videosWithHumanMetadata Int      @default(0) @map("videos_with_human_metadata")
  subtitlesHumanTotal     Int      @default(0) @map("subtitles_human_total")
  subtitlesAiTotal        Int      @default(0) @map("subtitles_ai_total")
  audioHumanTotal         Int      @default(0) @map("audio_human_total")
  audioAiTotal            Int      @default(0) @map("audio_ai_total")
  languageCoverage        Json     @default("[]") @map("language_coverage")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@unique([date])
  @@index([date])
  @@map("manager_coverage_snapshot")
}

/// Latest admin-owned watch route-admission manifest. This singleton snapshot
/// lets apps/web fetch compact public route sets without asking admin to
/// recompute large aggregate queries per request.
model WatchRouteManifestSnapshot {
  key              String   @id
  version          String
  generatedAt      DateTime @map("generated_at")
  payload          Json
  payloadSizeBytes Int      @map("payload_size_bytes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([generatedAt])
  @@map("watch_route_manifest_snapshot")
}

/// Latest admin-owned Watch hreflang sitemap manifest. This singleton
/// snapshot lets apps/web generate sitemap XML without recomputing the full
/// video-language alternate graph in page render paths.
model WatchSeoManifestSnapshot {
  key              String   @id
  version          String
  generatedAt      DateTime @map("generated_at")
  payload          Json
  payloadSizeBytes Int      @map("payload_size_bytes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([generatedAt])
  @@map("watch_seo_manifest_snapshot")
}

/// Admin-owned persistence for Manager enrichment jobs. Field names mirror the
/// existing Manager JobRecord so Manager can move transport without UI churn.
model ManagerEnrichmentJob {
  id                                 String    @id @default(cuid())
  muxAssetId                         String    @map("mux_asset_id")
  muxPlaybackId                      String?   @map("mux_playback_id")
  videoDocumentId                    String?   @map("video_document_id")
  languages                          String[]  @default([])
  sourceLanguageId                   String?   @map("source_language_id")
  sourceLanguageCode                 String?   @map("source_language_code")
  sourceSelectionReason              String?   @map("source_selection_reason")
  primaryRequestedTargetLanguageCode String?   @map("primary_requested_target_language_code")
  resolvedTargetLanguageCodes        String[]  @default([]) @map("resolved_target_language_codes")
  sourceCollectionTitle              String?   @map("source_collection_title")
  sourceMediaTitle                   String?   @map("source_media_title")
  requestedLanguageAbbreviations     String[]  @default([]) @map("requested_language_abbreviations")
  options                            Json      @default("{}")
  status                             String    @default("pending")
  currentStep                        String?   @map("current_step")
  retries                            Int       @default(0)
  startedAt                          DateTime? @map("started_at")
  completedAt                        DateTime? @map("completed_at")
  artifacts                          Json      @default("{}")
  steps                              Json      @default("[]")
  errors                             Json      @default("[]")
  createdAt                          DateTime  @default(now()) @map("created_at")
  updatedAt                          DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([videoDocumentId])
  @@map("manager_enrichment_job")
}

// -----------------------------------------------------------------------------
// SEO experiment ledger
// -----------------------------------------------------------------------------

/// Singleton operator-controlled mode. Keeping this in Postgres makes dry-run
/// a durable boundary rather than an environment-only convention.
model SeoAutomationState {
  key       String            @id @default("global")
  mode      SeoAutomationMode @default(OFF)
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@map("seo_automation_state")
}

/// One bounded scheduled or manual collection attempt. Provider coverage and
/// dry-run suppression counts remain visible even when one lane is unavailable.
model SeoRun {
  id                       String                   @id @default(cuid())
  idempotencyKey           String                   @unique @map("idempotency_key")
  mode                     SeoAutomationMode
  status                   SeoRunStatus             @default(RUNNING)
  windowStart              DateTime?                @map("window_start")
  windowEnd                DateTime?                @map("window_end")
  providerCoverage         Json                     @default("{}") @map("provider_coverage")
  report                   Json                     @default("{}")
  eligibleCount            Int                      @default(0) @map("eligible_count")
  selectedCount            Int                      @default(0) @map("selected_count")
  wouldProposeCount        Int                      @default(0) @map("would_propose_count")
  proposedCount            Int                      @default(0) @map("proposed_count")
  materializationCount     Int                      @default(0) @map("materialization_count")
  ticketCount              Int                      @default(0) @map("ticket_count")
  experimentCount          Int                      @default(0) @map("experiment_count")
  suppressedOperations     String[]                 @default([]) @map("suppressed_operations")
  executionFenceGeneration Int                      @default(0) @map("execution_fence_generation")
  executionClaimTokenHash  String?                  @map("execution_claim_token_hash")
  executionClaimExpiresAt  DateTime?                @map("execution_claim_expires_at")
  startedAt                DateTime                 @default(now()) @map("started_at")
  completedAt              DateTime?                @map("completed_at")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  observations             SeoEvidenceObservation[]
  proposalVersions         SeoProposalVersion[]

  @@index([status, startedAt])
  @@index([mode, startedAt])
  @@index([status, executionClaimExpiresAt])
  @@map("seo_run")
}

/// Redacted, bounded provider projection. Raw provider bodies, credentials,
/// headers, cookies, signed query strings, and IPs never belong here.
model SeoEvidenceObservation {
  id             String              @id @default(cuid())
  runId          String              @map("run_id")
  run            SeoRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  observationKey String              @map("observation_key")
  provider       SeoEvidenceProvider
  schemaVersion  Int                 @default(1) @map("schema_version")
  scope          Json                @default("{}")
  payload        Json
  citations      Json                @default("[]")
  quality        Json                @default("{}")
  payloadDigest  String              @map("payload_digest")
  retrievedAt    DateTime            @map("retrieved_at")
  expiresAt      DateTime            @map("expires_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  @@unique([runId, observationKey])
  @@index([provider, retrievedAt])
  @@index([expiresAt])
  @@map("seo_evidence_observation")
}

/// Stable semantic proposal identity. Recommendation changes append a new
/// SeoProposalVersion; prior decisions remain bound to their original digest.
model SeoProposal {
  id                  String               @id @default(cuid())
  semanticConflictKey String               @map("semantic_conflict_key")
  lane                SeoProposalLane
  targetType          String               @map("target_type")
  targetId            String?              @map("target_id")
  canonicalUrl        String               @map("canonical_url")
  locale              String
  currentVersion      Int                  @default(1) @map("current_version")
  status              SeoProposalStatus    @default(PROPOSED)
  expiresAt           DateTime             @map("expires_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  versions            SeoProposalVersion[]

  @@index([status, expiresAt, createdAt])
  @@index([semanticConflictKey, status])
  @@index([targetType, targetId, locale])
  @@map("seo_proposal")
}

/// Immutable recommendation payload and exact base/treatment snapshots.
model SeoProposalVersion {
  id                      String                      @id @default(cuid())
  proposalId              String                      @map("proposal_id")
  proposal                SeoProposal                 @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  runId                   String                      @map("run_id")
  run                     SeoRun                      @relation(fields: [runId], references: [id], onDelete: Restrict)
  version                 Int
  idempotencyKey          String                      @unique @map("idempotency_key")
  payloadDigest           String                      @map("payload_digest")
  canonicalIdentityDigest String                      @map("canonical_identity_digest")
  baseContentHash         String?                     @map("base_content_hash")
  intent                  String
  expectedOutcome         String                      @map("expected_outcome")
  risk                    String
  verificationPlan        String                      @map("verification_plan")
  rollbackPlan            String                      @map("rollback_plan")
  editorialDiff           Json?                       @map("editorial_diff")
  engineeringBrief        Json?                       @map("engineering_brief")
  evidence                Json                        @default("[]")
  caveats                 String[]                    @default([])
  affectedFields          String[]                    @default([]) @map("affected_fields")
  payload                 Json
  preChangeSnapshot       Json                        @map("pre_change_snapshot")
  treatmentSnapshot       Json                        @map("treatment_snapshot")
  createdAt               DateTime                    @default(now()) @map("created_at")
  decision                SeoDecision?
  materialization         SeoProposalMaterialization?
  experiment              SeoExperiment?
  ticketOutbox            SeoTicketOutbox?
  approvalNonces          SeoApprovalNonce[]

  @@unique([proposalId, version])
  @@unique([proposalId, payloadDigest])
  @@index([runId, createdAt])
  @@map("seo_proposal_version")
}

/// Consumed delegated Manager approval proofs. Only the hash of the nonce is
/// retained; uniqueness is the cross-replica replay guard.
model SeoApprovalNonce {
  id                String             @id @default(cuid())
  nonceHash         String             @unique @map("nonce_hash")
  keyId             String             @map("key_id")
  environment       String
  audience          String
  actorId           String             @map("actor_id")
  action            SeoDecisionAction
  proposalVersionId String             @map("proposal_version_id")
  proposalVersion   SeoProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)
  expiresAt         DateTime           @map("expires_at")
  consumedAt        DateTime           @default(now()) @map("consumed_at")

  @@index([proposalVersionId, consumedAt])
  @@index([expiresAt])
  @@map("seo_approval_nonce")
}

/// Consumed Mastra workload assertion IDs. Request digest and capability are
/// persisted so a JTI cannot be replayed across endpoints or bodies.
model SeoWorkloadAssertion {
  id            String   @id @default(cuid())
  jtiHash       String   @unique @map("jti_hash")
  keyId         String   @map("key_id")
  environment   String
  audience      String
  capability    String
  requestDigest String   @map("request_digest")
  expiresAt     DateTime @map("expires_at")
  consumedAt    DateTime @default(now()) @map("consumed_at")

  @@index([capability, consumedAt])
  @@index([expiresAt])
  @@map("seo_workload_assertion")
}

model SeoDecision {
  id                  String             @id @default(cuid())
  proposalVersionId   String             @unique @map("proposal_version_id")
  proposalVersion     SeoProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)
  action              SeoDecisionAction
  actorId             String             @map("actor_id")
  overlapAcknowledged Boolean            @default(false) @map("overlap_acknowledged")
  overlapCount        Int                @default(0) @map("overlap_count")
  reason              String?
  confounders         Json               @default("[]")
  decidedAt           DateTime           @default(now()) @map("decided_at")

  @@index([action, decidedAt])
  @@map("seo_decision")
}

model SeoProposalMaterialization {
  id                String                   @id @default(cuid())
  proposalVersionId String                   @unique @map("proposal_version_id")
  proposalVersion   SeoProposalVersion       @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)
  status            SeoMaterializationStatus
  contentRevisionId String?                  @unique @map("content_revision_id")
  contentRevision   ContentRevision?         @relation(fields: [contentRevisionId], references: [id], onDelete: SetNull)
  editorPath        String?                  @map("editor_path")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  @@index([status, updatedAt])
  @@map("seo_proposal_materialization")
}

model SeoExperiment {
  id                        String               @id @default(cuid())
  proposalVersionId         String               @unique @map("proposal_version_id")
  proposalVersion           SeoProposalVersion   @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)
  status                    SeoExperimentStatus  @default(AWAITING_ACTIVATION)
  preChangeSnapshot         Json                 @map("pre_change_snapshot")
  treatmentSnapshot         Json                 @map("treatment_snapshot")
  preChangeHash             String               @map("pre_change_hash")
  treatmentHash             String               @map("treatment_hash")
  expectedActivationHash    String               @map("expected_activation_hash")
  observedActivationHash    String?              @map("observed_activation_hash")
  activatedAt               DateTime?            @map("activated_at")
  measurementStartsAt       DateTime?            @map("measurement_starts_at")
  interimDueAt              DateTime?            @map("interim_due_at")
  finalDueAt                DateTime?            @map("final_due_at")
  evaluationFenceGeneration Int                  @default(0) @map("evaluation_fence_generation")
  evaluationClaimTokenHash  String?              @map("evaluation_claim_token_hash")
  evaluationClaimExpiresAt  DateTime?            @map("evaluation_claim_expires_at")
  confounders               Json                 @default("[]")
  legalHold                 Boolean              @default(false) @map("legal_hold")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  evaluations               SeoEvaluationEvent[]
  lesson                    SeoLesson?

  @@index([status, interimDueAt])
  @@index([status, finalDueAt])
  @@index([status, evaluationClaimExpiresAt])
  @@map("seo_experiment")
}

model SeoEvaluationEvent {
  id             String            @id @default(cuid())
  experimentId   String            @map("experiment_id")
  experiment     SeoExperiment     @relation(fields: [experimentId], references: [id], onDelete: Restrict)
  kind           SeoEvaluationKind
  outcome        String
  metrics        Json              @default("{}")
  evidenceDigest String            @map("evidence_digest")
  confounders    Json              @default("[]")
  observedAt     DateTime          @map("observed_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([experimentId, kind, observedAt])
  @@map("seo_evaluation_event")
}

model SeoTicketOutbox {
  id                String                   @id @default(cuid())
  proposalVersionId String                   @unique @map("proposal_version_id")
  proposalVersion   SeoProposalVersion       @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)
  status            SeoTicketOutboxStatus    @default(PENDING)
  payloadDigest     String                   @map("payload_digest")
  payload           Json
  marker            String                   @unique
  fenceGeneration   Int                      @default(0) @map("fence_generation")
  leaseTokenHash    String?                  @map("lease_token_hash")
  leaseExpiresAt    DateTime?                @map("lease_expires_at")
  attemptCount      Int                      @default(0) @map("attempt_count")
  nextAttemptAt     DateTime?                @map("next_attempt_at")
  remoteId          String?                  @map("remote_id")
  remoteUrl         String?                  @map("remote_url")
  lastErrorCode     String?                  @map("last_error_code")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  attempts          SeoTicketOutboxAttempt[]

  @@index([status, nextAttemptAt, createdAt])
  @@index([leaseExpiresAt])
  @@map("seo_ticket_outbox")
}

model SeoTicketOutboxAttempt {
  id          String          @id @default(cuid())
  outboxId    String          @map("outbox_id")
  outbox      SeoTicketOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  generation  Int
  outcome     String
  detail      Json            @default("{}")
  attemptedAt DateTime        @default(now()) @map("attempted_at")
  expiresAt   DateTime        @map("expires_at")

  @@index([outboxId, attemptedAt])
  @@index([expiresAt])
  @@map("seo_ticket_outbox_attempt")
}

model SeoLesson {
  id             String          @id @default(cuid())
  experimentId   String          @unique @map("experiment_id")
  experiment     SeoExperiment   @relation(fields: [experimentId], references: [id], onDelete: Restrict)
  status         SeoLessonStatus @default(PENDING_REVIEW)
  content        String
  evidenceDigest String          @map("evidence_digest")
  metrics        Json            @default("{}")
  confounders    Json            @default("[]")
  reviewedById   String?         @map("reviewed_by_id")
  reviewedAt     DateTime?       @map("reviewed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("seo_lesson")
}

// -----------------------------------------------------------------------------
// Watch route alert ledger
// -----------------------------------------------------------------------------

/// One idempotent property/window collection attempt. Only a hash of the
/// execution token is stored; generation plus token fence every completion.
model WatchRouteAlertRun {
  id                       String                            @id @default(cuid())
  idempotencyKey           String                            @unique @map("idempotency_key") @db.Char(64)
  propertyId               String                            @map("property_id") @db.VarChar(191)
  origin                   String                            @db.VarChar(255)
  contractVersion          String                            @map("contract_version") @db.VarChar(64)
  mode                     WatchRouteAlertAutomationMode
  status                   WatchRouteAlertRunStatus          @default(RUNNING)
  windowStart              DateTime                          @map("window_start")
  windowEnd                DateTime                          @map("window_end")
  manifestVersion          String?                           @map("manifest_version") @db.VarChar(191)
  report                   Json                              @default("{}")
  actionableCount          Int                               @default(0) @map("actionable_count")
  noiseCount               Int                               @default(0) @map("noise_count")
  executionFenceGeneration Int                               @default(0) @map("execution_fence_generation")
  executionClaimTokenHash  String?                           @map("execution_claim_token_hash") @db.Char(64)
  executionClaimExpiresAt  DateTime?                         @map("execution_claim_expires_at")
  startedAt                DateTime                          @default(now()) @map("started_at")
  completedAt              DateTime?                         @map("completed_at")
  detailExpiresAt          DateTime                          @map("detail_expires_at")
