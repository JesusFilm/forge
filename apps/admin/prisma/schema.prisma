}

/// Generic workflow run lifecycle used by the admin-owned operator ledger.
enum WorkflowRunStatus {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  SKIPPED   @map("skipped")
