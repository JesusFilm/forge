  osisId               String?    @map("osis_id")
  alternateName        String?    @map("alternate_name")
  paratextAbbreviation String?    @map("paratext_abbreviation")
  isNewTestament       Boolean?   @map("is_new_testament")
  /// 1-based canonical order (Genesis = 1).
  order                Int?
  /// "OT" | "NT".
  testament            String?
  syncedAt             DateTime?  @map("synced_at")
  deletedAt            DateTime?  @map("deleted_at")
  createdAt            DateTime   @default(now()) @map("created_at")
