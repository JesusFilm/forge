// Admin app Prisma schema.
//
// Per Unit 4 of docs/plans/2026-04-13-002-feat-admin-app-graphql-postgres-plan.md:
// - Prisma 6.x pinned (7.1.0 has pgvector migration regressions — issue #28867)
// - postgresqlExtensions preview enables [vector] declaration; migration 0001
//   still runs `CREATE EXTENSION IF NOT EXISTS vector;` in raw SQL for
//   determinism across Railway + PG18.
// - Vector columns use `Unsupported("vector(N)")` — no @db.Vector in Prisma
//   core as of 2026 (Prisma issue #26546). Expected: Prisma Studio cannot
//   render these; all vector operations go through raw SQL inside services.
//
// Data model decisions (Unit 4):
// - Per-locale rows for Experience and Video content (independent publish
//   state per locale; per-locale embeddings on ExperienceLocale)
// - JSON `name` column with locale keys for reference data (Language, Country)
//   where only the display name varies — pragmatic given low cardinality
// - Core-sourced rows carry `coreId` (unique), `source` ('core' | 'manager'),
//   and `syncedAt` for drift visibility. The standard `updatedAt` column
//   carries Core's authoritative timestamp on sync — sync passes
//   `updatedAt: coreData.updatedAt` explicitly in the upsert payload;
//   Prisma's `@updatedAt` only auto-fills when the value is omitted.
// - Source 'manager' rows are NEVER overwritten by Core sync (enforced in service)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// Pothos Prisma plugin generator — emits types consumed by src/graphql/builder.ts.
// Binary lives inside @pothos/plugin-prisma (no separate prisma-pothos-types package).
generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "@prisma/client"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// -----------------------------------------------------------------------------
// Shared enums
// -----------------------------------------------------------------------------

/// Provenance of a Core-derived row. `core` rows are read-only at the GraphQL
/// layer in v1 and are NEVER overwritten by Core sync if `source = 'manager'`.
enum SourceTier {
  CORE    @map("core")
  MANAGER @map("manager")
}

/// Per-locale publish state. Editors can publish English while French stays draft.
enum LocaleStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")
}

/// ContentRevision lifecycle. See `ContentRevision` model + CLAUDE.md
/// for the editor flow.
enum RevisionStatus {
  DRAFT      @map("draft") // pending changes; not yet promoted to canonical
  HISTORICAL @map("historical") // snapshot of canonical at a past publish
  DISCARDED  @map("discarded") // draft abandoned without being published
}

/// Provenance of a ContentRevision — distinguishes editor edits from
/// AI-generated suggestions and programmatic system writes.
enum RevisedByKind {
  USER   @map("user")
  AI     @map("ai")
  SYSTEM @map("system")
}

/// Editorial role stored for Auth SSO principals. `SYSTEM` remains an
/// in-process principal only and is never persisted.
enum UserRole {
  ADMIN  @map("ADMIN")
  EDITOR @map("EDITOR")
  VIEWER @map("VIEWER")
}

/// Manager panel authorization role. Auth owns identity; Admin stores the
/// Manager-specific product access grant consumed by apps/manager.
enum ManagerRole {
  OPERATOR @map("OPERATOR")
}

/// Video classification (mirrors Core schema enum).
enum VideoLabel {
  COLLECTION        @map("collection")
  EPISODE           @map("episode")
  FEATURE_FILM      @map("featureFilm")
  SEGMENT           @map("segment")
  SERIES            @map("series")
  SHORT_FILM        @map("shortFilm")
  TRAILER           @map("trailer")
  BEHIND_THE_SCENES @map("behindTheScenes")
}

/// Where the playable media is hosted.
enum VideoSource {
  INTERNAL   @map("internal")
  YOUTUBE    @map("youTube")
  CLOUDFLARE @map("cloudflare")
  MUX        @map("mux")
}

/// Editorial media kind. The first UI slice is image-forward, but the model is
/// generic enough for PDFs, miscellaneous files, and future Mux-backed videos.
enum MediaAssetKind {
  IMAGE @map("image")
  VIDEO @map("video")
  PDF   @map("pdf")
  FILE  @map("file")
}

/// Where the original bytes or playback authority live.
enum MediaAssetBackend {
  LOCAL @map("local")
  S3    @map("s3")
  MUX   @map("mux")
}

/// Processing lifecycle for an editorial media asset.
enum MediaAssetStatus {
  PENDING    @map("pending")
  UPLOADING  @map("uploading")
  PROCESSING @map("processing")
  READY      @map("ready")
  FAILED     @map("failed")
  MISSING    @map("missing")
}

/// Image-specific enrichment lifecycle. Kept separate from MediaAssetStatus so
/// an uploaded image can be storage-ready while derived metadata is still
/// waiting or processing.
enum MediaImageEnrichmentStatus {
  WAITING    @map("waiting")
  PROCESSING @map("processing")
  COMPLETE   @map("complete")
  FAILED     @map("failed")
  SKIPPED    @map("skipped")
}

/// Per-locale localized image metadata lifecycle.
enum MediaAssetLocaleStatus {
  WAITING    @map("waiting")
  PROCESSING @map("processing")
  COMPLETE   @map("complete")
  FAILED     @map("failed")
  SKIPPED    @map("skipped")
}

/// Delivery visibility. Private assets require admin-mediated access; public
/// assets can be exposed through generated preview/download URLs.
enum MediaAssetVisibility {
  PRIVATE @map("private")
  PUBLIC  @map("public")
}

/// Generic workflow run lifecycle used by the admin-owned operator ledger.
enum WorkflowRunStatus {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  SKIPPED   @map("skipped")
  CANCELLED @map("cancelled")
}

/// Source that requested a workflow run.
enum WorkflowRunTrigger {
  MANUAL    @map("manual")
  SCHEDULED @map("scheduled")
  GRAPHQL   @map("graphql")
  USER      @map("user")
  SYSTEM    @map("system")
}

/// Public Admin entry point that produced a production search trace.
enum SearchTraceRouteSource {
  REST    @map("rest")
  GRAPHQL @map("graphql")
}

/// Search execution result from the caller's perspective.
enum SearchTraceOutcome {
  SUCCESS  @map("success")
  DEGRADED @map("degraded")
  FAILED   @map("failed")
}

/// Coarse latency buckets keep trace payloads useful without storing exact
/// per-request timings indefinitely.
enum SearchTraceLatencyBucket {
  LT_100_MS   @map("lt_100ms")
  LT_250_MS   @map("lt_250ms")
  LT_500_MS   @map("lt_500ms")
  LT_1000_MS  @map("lt_1000ms")
  LT_2500_MS  @map("lt_2500ms")
  GTE_2500_MS @map("gte_2500ms")
}

/// Source family for generated search-eval candidates. These are staged
/// candidate inputs only; generated rows are not durable regression truth until
/// a later human-promotion workflow explicitly promotes them.
enum SearchEvalCandidateSource {
  CATALOG        @map("catalog")
  LOCALE_QUALITY @map("locale_quality")
  TRACE          @map("trace")
  SEED           @map("seed")
  USER_SUBMITTED @map("user_submitted")
}

/// Human-promotion lifecycle for generated search-eval candidates.
enum SearchEvalCandidatePromotionStatus {
  GENERATED @map("generated")
  REJECTED  @map("rejected")
  PROMOTED  @map("promoted")
  ARCHIVED  @map("archived")
}

/// Sanitization state for a reviewed search-eval candidate.
enum SearchEvalCandidateSanitizationStatus {
  PENDING   @map("pending")
  SANITIZED @map("sanitized")
  UNSAFE    @map("unsafe")
}

// -----------------------------------------------------------------------------
// Admin access control (Auth SSO relying client)
// -----------------------------------------------------------------------------

model User {
  chatThreadsCreated ExperienceChatThread[] // experience-AI chat (additive)
  id                 String                 @id
  name               String
  email              String
  emailVerified      Boolean                @default(false) @map("email_verified")
  image              String?
  role               UserRole               @default(VIEWER)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  mediaAssets           MediaAsset[]
  mediaFolders          MediaFolder[]
  managerMembership     ManagerMembership?
  partnerApiKeysCreated PartnerApiKey[]    @relation("PartnerApiKeyCreatedBy")
  partnerApiKeysRevoked PartnerApiKey[]    @relation("PartnerApiKeyRevokedBy")

  @@unique([email])
  @@map("user")
}

model ManagerMembership {
  id        String      @id @default(cuid())
  userId    String      @unique @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ManagerRole @default(OPERATOR)
  revokedAt DateTime?   @map("revoked_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([role])
  @@index([revokedAt])
  @@map("manager_membership")
}

// -----------------------------------------------------------------------------
// Partner API key store
// -----------------------------------------------------------------------------

/// External partner credentials for admin's public search surface
/// (`GET /api/search`). One row per issued partner key.
/// The bearer-as-passport composer (`src/auth/search-bearer.ts`) validates
/// presented tokens against this table BEFORE falling through to the legacy
/// `SEARCH_API_KEYS` env-CSV branch. See:
///
/// - Plan: `docs/plans/2026-05-18-001-feat-partner-api-key-store-plan.md`
/// - apps/admin/CLAUDE.md §"Partner API key store"
///
/// Token shape: `jfp_search_<keyId>_<random>`. `keyId` is the operator-visible
/// short identifier surfaced in the per-request structured log
/// (`auth=bearer source=partner keyId=…`). `keyHash` is `sha256(rawToken)`
/// stored as 64-char hex; comparison uses `timingSafeEqual` on decoded
/// buffers. Plaintext is shown to the operator exactly once at issuance
/// and never persisted.
///
/// Revocation is soft (`revokedAt` set, row preserved) — preserves the audit
/// trail of which key was revoked, when, and by whom.
model PartnerApiKey {
  id         String    @id @default(cuid())
  /// Operator-visible short identifier embedded in the token prefix.
  /// 12 chars, URL-safe (no `_` because that's the token-format delimiter).
  keyId      String    @unique @map("key_id")
  /// `sha256(rawToken)` as 64-char hex. Constant-time compared on auth.
  keyHash    String    @unique @map("key_hash")
  /// Human-readable display name shown on the dashboard (the partner org).
  name       String
  /// Primary contact for the partner; used for offboarding handoffs.
  ownerEmail String    @map("owner_email")
  /// Free-form operator note (issuance context, rotation reminders, etc.).
  note       String?
  /// Updated fire-and-forget on every successful partner-bearer auth.
  /// Drives the dashboard's "has this partner integrated yet?" column.
  lastUsedAt DateTime? @map("last_used_at")
  /// Set on revoke; row preserved for audit. `revokedAt IS NULL` means active.
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("PartnerApiKeyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  revokedById String? @map("revoked_by_id")
  revokedBy   User?   @relation("PartnerApiKeyRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([revokedAt])
  @@index([lastUsedAt])
  @@index([createdById])
  @@index([revokedById])
  @@map("partner_api_key")
}

// -----------------------------------------------------------------------------
// Core sync infrastructure (Unit 2)
// -----------------------------------------------------------------------------

/// Per-phase watermark for Core API sync.
/// Advanced only when the phase completes with zero errors (see Unit 10).
/// last_synced_at captures the fetch-start time, NOT completion time, so
/// records Core updates during the run are picked up on the next pass.
model SyncState {
  /// Phase identifier, e.g. "languages" | "countries" | "keywords" | "videos" | "video-variants"
  phase        String   @id
  lastSyncedAt DateTime @map("last_synced_at")
  /// Per-run counters: { created, updated, softDeleted, errors, lastRunAt }
  stats        Json     @default("{}")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sync_state")
}

/// DB-backed lock replacing the manager/CMS in-memory `syncInProgress` guard.
/// Claimed synchronously via SELECT ... FOR UPDATE SKIP LOCKED before the
/// workflow steps fire, so cross-instance runs on Railway can't overlap.
/// See docs/solutions/platform/backfill-worker-pattern-manager-20260407.md.
model SyncLock {
  /// Lock key, e.g. "core-sync"
  key        String    @id
  /// Instance or workflow run holding the lock (nullable when unlocked)
  heldBy     String?   @map("held_by")
  acquiredAt DateTime? @map("acquired_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("sync_locks")
}

/// Admin-owned product ledger for workflow runs. Postgres World remains the
/// runtime source of truth; this table adds operator context that can be joined
/// to runtime rows by `runtime_run_id`.
model WorkflowRun {
  id           String             @id @default(cuid())
  runtimeRunId String?            @unique @map("runtime_run_id")
  workflowKey  String             @map("workflow_key")
  workflowName String?            @map("workflow_name")
  trigger      WorkflowRunTrigger
  actorId      String?            @map("actor_id")
  subjectType  String?            @map("subject_type")
  subjectId    String?            @map("subject_id")
  status       WorkflowRunStatus  @default(QUEUED)
  summary      String?
  error        String?
  startedAt    DateTime?          @map("started_at")
  finishedAt   DateTime?          @map("finished_at")
  durationMs   Int?               @map("duration_ms")
  details      Json               @default("{}")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  coreSyncRun CoreSyncRun?

  @@index([workflowKey, createdAt])
  @@index([status, createdAt])
  @@index([trigger, createdAt])
  @@map("workflow_run")
}

/// Process heartbeat written by admin instances that start Workflow's
/// Postgres World runner. Graphile Worker tracks locked jobs, but it does not
/// persist idle workers, so this table is the dashboard's source for
/// "is a worker process alive?"
model WorkflowWorkerHeartbeat {
  workerId     String   @id @map("worker_id")
  service      String   @default("admin")
  status       String   @default("online")
  startedAt    DateTime @default(now()) @map("started_at")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  currentJob   String?  @map("current_job")
  currentRunId String?  @map("current_run_id")
  details      Json     @default("{}")

  @@index([lastSeenAt])
  @@map("workflow_worker_heartbeat")
}

/// Short-lived Admin-owned production search trace. Raw rows are the only place
/// query text may exist, and they expire before the hard 30-day raw retention
/// ceiling. The table deliberately has no bearer, cookie, IP, user-id, key-id,
/// vector, or scoring payload columns.
model SearchTrace {
  id                   String                   @id @default(cuid())
  requestId            String?                  @map("request_id") @db.VarChar(80)
  queryText            String                   @map("query_text") @db.VarChar(1024)
  locale               String                   @db.VarChar(32)
  routeSource          SearchTraceRouteSource   @map("route_source")
  requestedMode        String?                  @map("requested_mode") @db.VarChar(64)
  searchMode           String                   @map("search_mode") @db.VarChar(64)
  resultCount          Int                      @map("result_count")
  latencyBucket        SearchTraceLatencyBucket @map("latency_bucket")
  outcome              SearchTraceOutcome
  traceClass           String                   @default("none") @map("trace_class") @db.VarChar(64)
  queryQualityLabel    String                   @default("unknown_ambiguous") @map("query_quality_label") @db.VarChar(64)
  sensitiveQueryLabel  String                   @default("none") @map("sensitive_query_label") @db.VarChar(64)
  abuseLabel           String                   @default("none") @map("abuse_label") @db.VarChar(64)
  queryLabelSource     String                   @default("rules") @map("query_label_source") @db.VarChar(32)
  queryLabelVersion    String                   @default("search-query-labels/v1") @map("query_label_version") @db.VarChar(64)
  queryLabeledAt       DateTime                 @default(now()) @map("query_labeled_at")
  sampleEligible       Boolean                  @default(true) @map("sample_eligible")
  metadata             Json?                    @map("metadata")
  llmQueryQualityLabel String?                  @map("llm_query_quality_label") @db.VarChar(64)
  llmAbuseLabel        String?                  @map("llm_abuse_label") @db.VarChar(64)
  llmLabelSource       String?                  @map("llm_label_source") @db.VarChar(64)
  llmLabelVersion      String?                  @map("llm_label_version") @db.VarChar(64)
  llmLabelReason       String?                  @map("llm_label_reason") @db.VarChar(256)
  llmLabeledAt         DateTime?                @map("llm_labeled_at")
  startedAt            DateTime                 @map("started_at")
  completedAt          DateTime                 @map("completed_at")
  rawExpiresAt         DateTime                 @map("raw_expires_at")
  createdAt            DateTime                 @default(now()) @map("created_at")

  @@index([rawExpiresAt])
  @@index([createdAt])
  @@index([requestId])
  @@index([locale, createdAt])
  @@index([routeSource, createdAt])
  @@index([outcome, createdAt])
  @@index([sampleEligible, rawExpiresAt, createdAt])
  @@index([queryQualityLabel, sensitiveQueryLabel, abuseLabel, rawExpiresAt, createdAt], map: "search_trace_label_filters_raw_expires_created_idx")
  @@index([llmLabelSource, createdAt], map: "search_trace_llm_label_source_created_at_idx")
  @@map("search_trace")
}

/// Long-lived counters for search trace analysis. Aggregates never contain raw
/// query text, so they may survive raw trace purge.
model SearchTraceAggregate {
  id                  String                   @id @default(cuid())
  bucketStart         DateTime                 @map("bucket_start")
  locale              String                   @db.VarChar(32)
  routeSource         SearchTraceRouteSource   @map("route_source")
  searchMode          String                   @map("search_mode") @db.VarChar(64)
  outcome             SearchTraceOutcome
  traceClass          String                   @default("none") @map("trace_class") @db.VarChar(64)
  latencyBucket       SearchTraceLatencyBucket @map("latency_bucket")
  queryQualityLabel   String                   @default("unknown_ambiguous") @map("query_quality_label") @db.VarChar(64)
  sensitiveQueryLabel String                   @default("none") @map("sensitive_query_label") @db.VarChar(64)
  abuseLabel          String                   @default("none") @map("abuse_label") @db.VarChar(64)
  queryLabelSource    String                   @default("rules") @map("query_label_source") @db.VarChar(32)
  queryLabelVersion   String                   @default("search-query-labels/v1") @map("query_label_version") @db.VarChar(64)
  queryCount          Int                      @default(0) @map("query_count")
  resultCountSum      Int                      @default(0) @map("result_count_sum")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  @@unique([bucketStart, routeSource, locale, searchMode, outcome, traceClass, latencyBucket, queryQualityLabel, sensitiveQueryLabel, abuseLabel], name: "searchTraceAggregateBucketDimsLegacy", map: "search_trace_aggregate_bucket_dims_key")
  @@unique([bucketStart, routeSource, locale, searchMode, outcome, traceClass, latencyBucket, queryQualityLabel, sensitiveQueryLabel, abuseLabel, queryLabelSource, queryLabelVersion], name: "searchTraceAggregateBucketDims", map: "search_trace_aggregate_bucket_label_dims_key")
  @@index([bucketStart])
  @@index([routeSource, bucketStart])
  @@index([outcome, bucketStart])
  @@map("search_trace_aggregate")
}

/// Staged search-eval candidates generated by offline Mastra workflows.
/// Generated rows do not participate in permanent regression gates until a
/// future human-promotion workflow sanitizes and promotes them.
model SearchEvalCandidate {
  id                           String                                @id @default(cuid())
  source                       SearchEvalCandidateSource
  locale                       String                                @db.VarChar(32)
  queryText                    String                                @map("query_text") @db.VarChar(512)
  expectedResultHints          Json                                  @default("[]") @map("expected_result_hints")
  sourceAnchors                Json                                  @default("[]") @map("source_anchors")
  labelProvenance              Json                                  @default("{}") @map("label_provenance")
  generationModel              String                                @map("generation_model") @db.VarChar(128)
  generationProvider           String?                               @map("generation_provider") @db.VarChar(64)
  judgeSummary                 Json?                                 @map("judge_summary")
  promotionStatus              SearchEvalCandidatePromotionStatus    @default(GENERATED) @map("promotion_status")
  sanitizedQueryText           String?                               @map("sanitized_query_text") @db.VarChar(512)
  sanitizedExpectedResultNotes String?                               @map("sanitized_expected_result_notes") @db.VarChar(2048)
  sanitizedSourceAnchors       Json                                  @default("[]") @map("sanitized_source_anchors")
  sanitizationStatus           SearchEvalCandidateSanitizationStatus @default(PENDING) @map("sanitization_status")
  reviewerIdentity             String?                               @map("reviewer_identity") @db.VarChar(256)
  reviewedAt                   DateTime?                             @map("reviewed_at")
  reviewNotes                  String?                               @map("review_notes") @db.VarChar(2048)
  promotedAt                   DateTime?                             @map("promoted_at")
  promotionRunContext          Json                                  @default("{}") @map("promotion_run_context")
  mastraRunId                  String?                               @map("mastra_run_id") @db.VarChar(128)
  dedupeKey                    String                                @unique @map("dedupe_key") @db.VarChar(64)
  retentionExpiresAt           DateTime?                             @map("retention_expires_at")
  generatedAt                  DateTime                              @default(now()) @map("generated_at")
  createdAt                    DateTime                              @default(now()) @map("created_at")
  updatedAt                    DateTime                              @updatedAt @map("updated_at")

  @@index([source, locale, createdAt])
  @@index([promotionStatus, createdAt])
  @@index([promotionStatus, reviewedAt])
  @@index([promotedAt])
  @@index([retentionExpiresAt])
  @@index([mastraRunId])
  @@map("search_eval_candidate")
}

/// Core Sync-specific detail for the generic workflow ledger. Kept separate so
/// non-Core workflows can use `WorkflowRun` without carrying sync phase fields.
model CoreSyncRun {
  id            String      @id @default(cuid())
  workflowRunId String      @unique @map("workflow_run_id")
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  skippedLock   Boolean     @default(false) @map("skipped_lock")
  incremental   Boolean
  createdCount  Int         @default(0) @map("created_count")
  updatedCount  Int         @default(0) @map("updated_count")
  deletedCount  Int         @default(0) @map("deleted_count")
  errorCount    Int         @default(0) @map("error_count")
  phaseSummary  Json        @default("[]") @map("phase_summary")
  coverageAudit Json?       @map("coverage_audit")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("core_sync_run")
}

/// Manager-facing coverage snapshot history. This preserves the Manager
/// `/api/coverage-snapshots` shape while Admin becomes the backend authority.
model ManagerCoverageSnapshot {
  id                      String   @id @default(cuid())
  date                    DateTime
  computedAt              DateTime @default(now()) @map("computed_at")
  totalVideos             Int      @default(0) @map("total_videos")
  videosWithAiMetadata    Int      @default(0) @map("videos_with_ai_metadata")
  videosWithHumanMetadata Int      @default(0) @map("videos_with_human_metadata")
  subtitlesHumanTotal     Int      @default(0) @map("subtitles_human_total")
  subtitlesAiTotal        Int      @default(0) @map("subtitles_ai_total")
  audioHumanTotal         Int      @default(0) @map("audio_human_total")
  audioAiTotal            Int      @default(0) @map("audio_ai_total")
  languageCoverage        Json     @default("[]") @map("language_coverage")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@unique([date])
  @@index([date])
  @@map("manager_coverage_snapshot")
}

/// Latest admin-owned watch route-admission manifest. This singleton snapshot
/// lets apps/web fetch compact public route sets without asking admin to
/// recompute large aggregate queries per request.
model WatchRouteManifestSnapshot {
  key              String   @id
  version          String
  generatedAt      DateTime @map("generated_at")
  payload          Json
  payloadSizeBytes Int      @map("payload_size_bytes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([generatedAt])
  @@map("watch_route_manifest_snapshot")
}

/// Latest admin-owned Watch hreflang sitemap manifest. This singleton
/// snapshot lets apps/web generate sitemap XML without recomputing the full
/// video-language alternate graph in page render paths.
model WatchSeoManifestSnapshot {
  key              String   @id
  version          String
  generatedAt      DateTime @map("generated_at")
  payload          Json
  payloadSizeBytes Int      @map("payload_size_bytes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([generatedAt])
  @@map("watch_seo_manifest_snapshot")
}

/// Admin-owned persistence for Manager enrichment jobs. Field names mirror the
/// existing Manager JobRecord so Manager can move transport without UI churn.
model ManagerEnrichmentJob {
  id                                 String    @id @default(cuid())
  muxAssetId                         String    @map("mux_asset_id")
  muxPlaybackId                      String?   @map("mux_playback_id")
  videoDocumentId                    String?   @map("video_document_id")
  languages                          String[]  @default([])
  sourceLanguageId                   String?   @map("source_language_id")
  sourceLanguageCode                 String?   @map("source_language_code")
  sourceSelectionReason              String?   @map("source_selection_reason")
  primaryRequestedTargetLanguageCode String?   @map("primary_requested_target_language_code")
  resolvedTargetLanguageCodes        String[]  @default([]) @map("resolved_target_language_codes")
  sourceCollectionTitle              String?   @map("source_collection_title")
  sourceMediaTitle                   String?   @map("source_media_title")
  requestedLanguageAbbreviations     String[]  @default([]) @map("requested_language_abbreviations")
  options                            Json      @default("{}")
  status                             String    @default("pending")
  currentStep                        String?   @map("current_step")
  retries                            Int       @default(0)
  startedAt                          DateTime? @map("started_at")
  completedAt                        DateTime? @map("completed_at")
  artifacts                          Json      @default("{}")
  steps                              Json      @default("[]")
  errors                             Json      @default("[]")
  createdAt                          DateTime  @default(now()) @map("created_at")
  updatedAt                          DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([videoDocumentId])
  @@map("manager_enrichment_job")
}

// -----------------------------------------------------------------------------
// Editor revision history
// -----------------------------------------------------------------------------

/// Append-only revision log for editor-mutable content. One generic table
/// covers all entity types so adding revision tracking to a new entity is
/// a service-layer change, not a migration. See CLAUDE.md for the editor
/// flow, coverage list, and service-layer pattern.
///
/// Status semantics:
/// - `DRAFT`      pending changes; not yet promoted to canonical. At most
///                ONE draft per (entity_type, entity_id) — enforced by a
///                partial unique index in raw migration SQL.
/// - `HISTORICAL` snapshot of canonical state at the moment of a publish.
///                Builds the audit trail for rollback / diff.
/// - `DISCARDED`  draft abandoned without being published.
///
/// Editor flow (PUBLISHED entities):
/// 1. Editor opens published entity → reads canonical
/// 2. Edits → service creates or updates the entity's DRAFT revision;
///    canonical untouched
/// 3. Publish → snapshot canonical to HISTORICAL, apply DRAFT to canonical,
///    delete the DRAFT row
///
/// New content (no canonical yet):
/// - Service creates a stub canonical row with status=DRAFT (using
///   `LocaleStatus`) and minimum required fields
/// - Editor's evolving content lives in a DRAFT revision over the multi-
///   day editing session
/// - First publish: snapshot canonical (stub) → HISTORICAL, apply DRAFT
///   to canonical, flip canonical status to PUBLISHED
///
/// 60-day retention enforced by a Unit 11 useworkflow job:
///   DELETE FROM content_revision WHERE revised_at < NOW() - INTERVAL '60 days'
///
/// Coverage in v1 (entities whose service-layer mutations create revisions):
///   - ExperienceLocale, Experience
///   - VideoLocale, Video, VideoDub
/// Tier 3 (Core-sourced reference data, sync state, join tables) gets no
/// revision tracking — sync timestamps already capture history.
model ContentRevision {
  id            String         @id @default(cuid())
  entityType    String         @map("entity_type")
  entityId      String         @map("entity_id")
  /// Full proposed (DRAFT) or prior-canonical (HISTORICAL) row state.
  snapshot      Json
  status        RevisionStatus
  /// `User.id` of the editor who authored the revision; null for sync/system writes.
  revisedBy     String?        @map("revised_by")
  /// Provenance: USER | AI | SYSTEM.
  revisedByKind RevisedByKind  @map("revised_by_kind")
  /// Optional free-text explaining why; surfaces in diff views and audit logs.
  reason        String?
  revisedAt     DateTime       @default(now()) @map("revised_at")
  /// When a DRAFT was promoted to canonical (HISTORICAL only).
  appliedAt     DateTime?      @map("applied_at")

  @@index([entityType, entityId, status, revisedAt])
  @@index([revisedAt])
  @@map("content_revision")
}

// -----------------------------------------------------------------------------
// Editorial media assets
// -----------------------------------------------------------------------------

/// Canonical editorial asset managed by apps/admin. The asset row is the stable
/// identity used by editors and agents; storage object keys, local paths, Mux
/// upload IDs, and playback IDs are backend-specific implementation details.
///
/// `VideoImage` remains separate: it represents Core/video-derived poster and
/// still metadata. `MediaAsset` is for editorial uploads and reusable files.
model MediaAsset {
  id                          String                     @id @default(cuid())
  kind                        MediaAssetKind
  backend                     MediaAssetBackend
  status                      MediaAssetStatus           @default(PENDING)
  visibility                  MediaAssetVisibility       @default(PRIVATE)
  mimeType                    String                     @map("mime_type")
  byteSize                    BigInt?                    @map("byte_size")
  width                       Int?
  height                      Int?
  durationMs                  BigInt?                    @map("duration_ms")
  blurDataUrl                 String?                    @map("blur_data_url")
  dominantColor               String?                    @map("dominant_color")
  imageEnrichmentStatus       MediaImageEnrichmentStatus @default(WAITING) @map("image_enrichment_status")
  imageEnrichmentErrorCode    String?                    @map("image_enrichment_error_code")
  imageEnrichmentErrorMessage String?                    @map("image_enrichment_error_message")
  imageEnrichmentStartedAt    DateTime?                  @map("image_enrichment_started_at")
  imageEnrichmentCompletedAt  DateTime?                  @map("image_enrichment_completed_at")
  originalFilename            String?                    @map("original_filename")
  checksumSha256              String?                    @map("checksum_sha256")
  objectKey                   String?                    @map("object_key")
  previewObjectKey            String?                    @map("preview_object_key")
  muxAssetId                  String?                    @map("mux_asset_id")
  muxUploadId                 String?                    @map("mux_upload_id")
  muxPlaybackId               String?                    @map("mux_playback_id")
  errorCode                   String?                    @map("error_code")
  errorMessage                String?                    @map("error_message")
  folderId                    String?                    @map("folder_id")
  folder                      MediaFolder?               @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdById                 String?                    @map("created_by_id")
  createdBy                   User?                      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  locales                     MediaAssetLocale[]
  createdAt                   DateTime                   @default(now()) @map("created_at")
  updatedAt                   DateTime                   @updatedAt @map("updated_at")

  @@index([kind, status, updatedAt])
  @@index([backend, status])
  @@index([kind, imageEnrichmentStatus, updatedAt])
  @@index([visibility])
  @@index([folderId, updatedAt])
  @@index([createdById])
  @@map("media_asset")
}

/// Localized display name and alt text for an editorial media asset. Blur data
/// and byte-derived facts stay on MediaAsset; user-facing language varies here.
model MediaAssetLocale {
  id                String                 @id @default(cuid())
  mediaAssetId      String                 @map("media_asset_id")
  mediaAsset        MediaAsset             @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  locale            String
  displayName       String?                @map("display_name")
  altText           String?                @map("alt_text")
  displayNameSource RevisedByKind?         @map("display_name_source")
  altTextSource     RevisedByKind?         @map("alt_text_source")
  displayNameLocked Boolean                @default(false) @map("display_name_locked")
  altTextLocked     Boolean                @default(false) @map("alt_text_locked")
  status            MediaAssetLocaleStatus @default(WAITING)
  errorCode         String?                @map("error_code")
  errorMessage      String?                @map("error_message")
  generatedAt       DateTime?              @map("generated_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@unique([mediaAssetId, locale])
  @@index([locale])
  @@index([status, updatedAt])
  @@map("media_asset_locale")
}

model MediaFolder {
  id          String        @id @default(cuid())
  name        String
  parentId    String?       @map("parent_id")
  parent      MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    MediaFolder[] @relation("MediaFolderTree")
  createdById String?       @map("created_by_id")
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assets      MediaAsset[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([parentId, name])
  @@index([parentId, updatedAt])
  @@index([createdById])
  @@map("media_folder")
}

// -----------------------------------------------------------------------------
// Reference data (Core-sourced; FK targets for Video et al.)
// -----------------------------------------------------------------------------

/// A spoken/written language. Synced from Core.
/// Localized display names live in `LanguageLocale`; `name` remains as a
/// compatibility JSON map during the transition to relation-backed locale UI.
model Language {
  id                   String     @id @default(cuid())
  /// Core API identifier — UNIQUE-indexed for upsert-by-coreId.
  coreId               String     @unique @map("core_id")
  source               SourceTier @default(CORE)
  /// Compatibility JSON map of locale code → name, e.g. {"en": "English"}.
  name                 Json       @default("{}")
  /// IETF BCP-47 language tag (e.g. "en", "es-419").
  bcp47                String?
  iso3                 String?
  slug                 String?    @unique
  audioPreviewValue    String?    @map("audio_preview_value")
  audioPreviewDuration Int?       @map("audio_preview_duration")
  audioPreviewSize     BigInt?    @map("audio_preview_size")
  audioPreviewBitrate  Int?       @map("audio_preview_bitrate")
  audioPreviewCodec    String?    @map("audio_preview_codec")
  /// Last successful sync of this row from Core. The standard `updatedAt`
  /// column on Core-sourced rows carries Core's authoritative timestamp:
  /// sync passes `updatedAt: coreData.updatedAt` explicitly in the upsert
  /// payload (Prisma's `@updatedAt` only auto-fills when omitted), so the
  /// stale-write guard `WHERE EXCLUDED.updated_at > existing.updated_at`
  /// works against Core's timeline. See CLAUDE.md.
  syncedAt             DateTime?  @map("synced_at")
  deletedAt            DateTime?  @map("deleted_at")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  // Reverse relations
  keywords           Keyword[]
  locales            LanguageLocale[]
  videoDubs          VideoDub[]
  videoLocales       VideoLocale[]
  watchEvents        WatchEvent[]
  videoSubtitles     VideoSubtitle[]
  studyQuestions     VideoStudyQuestion[]
  generatedQuestions VideoGeneratedQuestion[]
  countryLanguages   CountryLanguage[]
  videosAsPrimary    Video[]                  @relation("VideoPrimaryLanguage")
  fallbackLanguages  LanguageFallback[]       @relation("LanguageFallbackSource")
  fallbackFor        LanguageFallback[]       @relation("LanguageFallbackTarget")

  @@index([deletedAt])
  @@map("language")
}

/// Curated language fallback graph for Watch search and language-aware
/// playback surfaces. Rows are directional because a helpful fallback for one
/// language may not be equally helpful in reverse.
model LanguageFallback {
  id                 String     @id @default(cuid())
  source             SourceTier @default(CORE)
  sourceLanguageId   String     @map("source_language_id")
  fallbackLanguageId String     @map("fallback_language_id")
  sourceLanguage     Language   @relation("LanguageFallbackSource", fields: [sourceLanguageId], references: [id], onDelete: Cascade)
  fallbackLanguage   Language   @relation("LanguageFallbackTarget", fields: [fallbackLanguageId], references: [id], onDelete: Cascade)
  priority           Int        @default(100)
  reason             String?
  syncedAt           DateTime?  @map("synced_at")
  deletedAt          DateTime?  @map("deleted_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@unique([sourceLanguageId, fallbackLanguageId])
  @@index([sourceLanguageId, priority])
  @@index([fallbackLanguageId])
  @@index([deletedAt])
  @@map("language_fallback")
}

/// Cross-process cache for short-lived query embeddings used by Watch search.
/// The raw query text is not stored; `queryHash` is the SHA-256 hash of the
/// normalized search text plus provider/model/dimension metadata.
model QueryEmbeddingCache {
  id         String   @id @default(cuid())
  provider   String
  model      String
  dimensions Int
  queryHash  String   @map("query_hash")
  embedding  Json
  expiresAt  DateTime @map("expires_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([provider, model, dimensions, queryHash], map: "query_embedding_cache_key")
  @@index([expiresAt])
  @@index([lastUsedAt])
  @@map("query_embedding_cache")
}

/// A localized display name for a language. Synced from Core.
model LanguageLocale {
  id         String     @id @default(cuid())
  source     SourceTier @default(CORE)
  languageId String     @map("language_id")
  language   Language   @relation(fields: [languageId], references: [id], onDelete: Cascade)
  locale     String
  value      String
  primary    Boolean    @default(false)
  order      Int?
  syncedAt   DateTime?  @map("synced_at")
  deletedAt  DateTime?  @map("deleted_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@unique([languageId, locale])
  @@index([locale])
  @@index([deletedAt])
  @@map("language_locale")
}

/// A continent. Synced from Core.
model Continent {
