  paramsHash    String   @map("params_hash")
  params        Json     @default("{}")
  sourceUrl     String   @map("source_url")
  lqipUrl       String   @map("lqip_url")
  blurDataUrl   String   @map("blur_data_url")
  dominantColor String?  @map("dominant_color")
  generatedAt   DateTime @default(now()) @map("generated_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([muxVideoId, purpose, paramsHash])
  @@index([purpose])
  @@map("mux_image_derivative")
}

/// A book of the Bible. Synced from Core.
model BibleBook {
