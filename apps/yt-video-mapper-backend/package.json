{
  "name": "@forge/yt-video-mapper-backend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "postinstall": "DATABASE_URL=${DATABASE_URL:-postgresql://forge:forge@localhost:5432/yt_video_mapper} prisma generate",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://forge:forge@localhost:5432/yt_video_mapper} prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^9.0.0",
    "prisma": "^6",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "3.2.4"
  }
}
