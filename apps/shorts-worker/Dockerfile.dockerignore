# BuildKit per-Dockerfile ignore (applies when building with
# -f apps/shorts-worker/Dockerfile from the repo root). Keeps the huge
# monorepo context out of the daemon — the Dockerfile only COPYies the
# manifests, apps/shorts-worker, packages/devotional-workspace, and
# packages/shorts-compositions.
**/node_modules
**/.env*
**/dist
**/build
**/.next
**/.expo
**/.turbo
**/.tmp
**/bundle
**/coverage
.git
docs
todos
apps/admin
apps/web
apps/mobile
apps/tv
apps/roadmap
apps/manager
apps/mastra
apps/crop-worker
