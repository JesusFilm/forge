REDIS_URL=redis://localhost:6379
FEEDBACK_BASE_URL=http://localhost:3210
FEEDBACK_SESSION_SECRET=replace-with-at-least-32-random-characters
FEEDBACK_GRANT_MODE=enforce
FEEDBACK_PLAY_PACKAGE=org.jesusfilm.tv
FEEDBACK_PLAY_CERT_SHA256=
FEEDBACK_PLAY_ALLOWED_VERSIONS=
FEEDBACK_GOOGLE_SERVICE_ACCOUNT_JSON=
FEEDBACK_APPLE_TEAM_ID=
FEEDBACK_APPLE_KEY_ID=
FEEDBACK_APPLE_PRIVATE_KEY=
FEEDBACK_APPLE_BUNDLE_ID=org.jesusfilm.forgewatch
FEEDBACK_APPLE_ALLOWED_BUILDS=
FEEDBACK_APPLE_DEVICECHECK_ENV=production
FEEDBACK_APPLE_DEVICECHECK_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=web-staging-7801.up.railway.app
FEEDBACK_LINEAR_API_KEY=
FEEDBACK_LINEAR_TEAM_ID=
FEEDBACK_LINEAR_PROJECT_ID=
FEEDBACK_LINEAR_LABEL_ID=

# Development-only simulator receiver. Never enabled by next start/production.
FEEDBACK_LOCAL_ENABLED=false
# Set to this Mac's private LAN IPv4 so a phone can reach the QR URL.
FEEDBACK_LOCAL_BASE_URL=http://192.168.1.25:3210
# Optional; default ../../.local-tools/tv-feedback-captures from this app's cwd.
FEEDBACK_LOCAL_STORAGE_DIR=
# Adds a separate Send to Linear action after local save. Uses server-only
# FEEDBACK_LINEAR_API_KEY / TEAM_ID / PROJECT_ID above; never auto-forwards.
FEEDBACK_LOCAL_LINEAR_ENABLED=false

# Separate hosted simulator entry, disabled unless an authorized public key is set.
# Private signing keys belong in the developer's Keychain, never server/app env.
FEEDBACK_SIMULATOR_SIGNED_ENABLED=false
FEEDBACK_SIMULATOR_AUDIENCE=https://web-staging-7801.up.railway.app
FEEDBACK_SIMULATOR_PUBLIC_KEY=
