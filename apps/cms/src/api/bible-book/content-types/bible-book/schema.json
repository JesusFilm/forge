{
  "kind": "collectionType",
  "collectionName": "bible_books",
  "info": {
    "displayName": "Bible Book",
    "singularName": "bible-book",
    "pluralName": "bible-books",
    "description": "Bible book reference data synced from JesusFilm core API"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "coreId": {
      "type": "string",
      "required": true,
      "unique": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "osisId": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "alternateName": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "paratextAbbreviation": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "isNewTestament": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "order": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "citations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::bible-citation.bible-citation",
      "mappedBy": "bibleBook",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "source": {
      "type": "enumeration",
      "enum": ["core", "manager"],
      "default": "core",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
