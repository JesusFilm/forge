{
  "kind": "collectionType",
  "collectionName": "ai_tasks",
  "info": {
    "singularName": "ai-task",
    "pluralName": "ai-tasks",
    "displayName": "AI Task"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "contentItem": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::content-item.content-item"
    },
    "objective": {
      "type": "enumeration",
      "enum": ["draft", "variant", "translate", "adapt"],
      "required": true
    },
    "targetLocale": { "type": "string" },
    "status": {
      "type": "enumeration",
      "enum": ["queued", "running", "completed", "failed"],
      "default": "queued"
    },
    "requestedBy": { "type": "string", "required": true }
  }
}
