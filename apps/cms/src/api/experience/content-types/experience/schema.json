{
  "kind": "collectionType",
  "collectionName": "experiences",
  "info": {
    "displayName": "Experience",
    "singularName": "experience",
    "pluralName": "experiences",
    "description": "Watch page experience with dynamic content blocks"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "slug": {
      "type": "uid",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "isHomepage": {
      "type": "boolean",
      "default": false,
      "required": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "title": {
      "type": "string",
      "required": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "metaDescription": {
      "type": "text",
      "required": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ogTitle": {
      "type": "string",
      "required": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ogDescription": {
      "type": "text",
      "required": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "pathSegment": {
      "type": "string",
      "required": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ogImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "sections.media-collection",
        "sections.promo-banner",
        "sections.info-blocks",
        "sections.cta",
        "sections.video-hero",
        "sections.container",
        "sections.text",
        "sections.section",
        "sections.related-questions",
        "sections.bible-quotes-carousel",
        "sections.card",
        "sections.easter-dates",
        "sections.advent-countdown",
        "sections.video",
        "sections.video-carousel",
        "sections.navigation-carousel"
      ],
      "required": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
