{
  "kind": "collectionType",
  "collectionName": "video_images",
  "info": {
    "displayName": "Video Image",
    "singularName": "video-image",
    "pluralName": "video-images",
    "description": "Cloudflare image metadata for a video"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "coreId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "cloudflareId": {
      "type": "string"
    },
    "aspectRatio": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "mobileCinematicHigh": {
      "type": "string"
    },
    "mobileCinematicLow": {
      "type": "string"
    },
    "mobileCinematicVeryLow": {
      "type": "string"
    },
    "thumbnail": {
      "type": "string"
    },
    "videoStill": {
      "type": "string"
    },
    "blurhash": {
      "type": "string"
    },
    "video": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::video.video",
      "inversedBy": "images"
    },
    "source": {
      "type": "enumeration",
      "enum": ["core", "manager"],
      "default": "core",
      "required": true
    }
  }
}
