{
  "kind": "collectionType",
  "collectionName": "bible_citations",
  "info": {
    "displayName": "Bible Citation",
    "singularName": "bible-citation",
    "pluralName": "bible-citations",
    "description": "Bible citation reference on a video"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "coreId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "osisId": {
      "type": "string"
    },
    "chapterStart": {
      "type": "integer"
    },
    "chapterEnd": {
      "type": "integer"
    },
    "verseStart": {
      "type": "integer"
    },
    "verseEnd": {
      "type": "integer"
    },
    "order": {
      "type": "integer"
    },
    "bibleBook": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::bible-book.bible-book",
      "inversedBy": "citations"
    },
    "video": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::video.video",
      "inversedBy": "bibleCitations"
    },
    "source": {
      "type": "enumeration",
      "enum": ["core", "manager"],
      "default": "core",
      "required": true
    }
  }
}
