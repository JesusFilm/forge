{
  "kind": "collectionType",
  "collectionName": "video_editions",
  "info": {
    "displayName": "Video Edition",
    "singularName": "video-edition",
    "pluralName": "video-editions",
    "description": "Video edition (e.g. base, dubbed)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "gatewayId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string"
    },
    "variants": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::video-variant.video-variant",
      "mappedBy": "videoEdition"
    },
    "subtitles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::video-subtitle.video-subtitle",
      "mappedBy": "videoEdition"
    },
    "source": {
      "type": "enumeration",
      "enum": ["gateway", "manager"],
      "default": "gateway",
      "required": true
    }
  }
}
