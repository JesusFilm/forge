{
  "kind": "collectionType",
  "collectionName": "enrichment_jobs",
  "info": {
    "displayName": "Enrichment Job",
    "singularName": "enrichment-job",
    "pluralName": "enrichment-jobs",
    "description": "AI video enrichment pipeline job tracked by the manager app"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "video": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::video.video"
    },
    "muxAssetId": {
      "type": "string",
      "required": true
    },
    "muxPlaybackId": {
      "type": "string"
    },
    "languages": {
      "type": "json"
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "running", "completed", "failed"],
      "default": "pending",
      "required": true
    },
    "currentStep": {
      "type": "string"
    },
    "retries": {
      "type": "integer",
      "default": 0
    },
    "startedAt": {
      "type": "datetime"
    },
    "completedAt": {
      "type": "datetime"
    },
    "artifacts": {
      "type": "json"
    },
    "errors": {
      "type": "json"
    },
    "steps": {
      "type": "component",
      "repeatable": true,
      "component": "enrichment.job-step"
    }
  }
}
