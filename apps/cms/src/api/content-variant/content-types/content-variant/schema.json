{
  "kind": "collectionType",
  "collectionName": "content_variants",
  "info": {
    "singularName": "content-variant",
    "pluralName": "content-variants",
    "displayName": "Content Variant"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "contentItem": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::content-item.content-item",
      "inversedBy": "variants"
    },
    "locale": { "type": "string", "required": true },
    "body": { "type": "richtext", "required": true },
    "createdByType": {
      "type": "enumeration",
      "enum": ["human", "ai"],
      "default": "ai"
    },
    "provenance": { "type": "component", "component": "shared.ai-provenance" },
    "qualitySignals": { "type": "component", "component": "shared.quality-signals" },
    "workflowState": { "type": "component", "component": "shared.workflow-state" }
  }
}
