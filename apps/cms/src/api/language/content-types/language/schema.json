{
  "kind": "collectionType",
  "collectionName": "languages",
  "info": {
    "displayName": "Language",
    "singularName": "language",
    "pluralName": "languages",
    "description": "Language synced from JesusFilm gateway"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "gatewayId": {
      "type": "string",
      "required": true,
      "unique": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "bcp47": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "iso3": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "slug": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "source": {
      "type": "enumeration",
      "enum": ["gateway", "manager"],
      "default": "gateway",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "audioPreview": {
      "type": "component",
      "repeatable": false,
      "component": "language.audio-preview",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
