{
  "kind": "collectionType",
  "collectionName": "languages",
  "info": {
    "displayName": "Language",
    "singularName": "language",
    "pluralName": "languages",
    "description": "Language synced from JesusFilm core API"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "coreId": {
      "type": "string",
      "required": true,
      "unique": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "bcp47": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "iso3": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "slug": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "source": {
      "type": "enumeration",
      "enum": ["core", "manager"],
      "default": "core",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "videoVariants": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::video-variant.video-variant",
      "mappedBy": "language",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "videoSubtitles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::video-subtitle.video-subtitle",
      "mappedBy": "language",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "keywords": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::keyword.keyword",
      "mappedBy": "language",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "countryLanguages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::country-language.country-language",
      "mappedBy": "language",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "videosAsPrimaryLanguage": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::video.video",
      "mappedBy": "primaryLanguage",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "audioPreview": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::language-audio-preview.language-audio-preview",
      "mappedBy": "language",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
