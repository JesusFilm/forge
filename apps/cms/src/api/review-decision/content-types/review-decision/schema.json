{
  "kind": "collectionType",
  "collectionName": "review_decisions",
  "info": {
    "singularName": "review-decision",
    "pluralName": "review-decisions",
    "displayName": "Review Decision"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "contentVariant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::content-variant.content-variant"
    },
    "decision": {
      "type": "enumeration",
      "enum": ["approved", "rejected", "changes_requested"],
      "required": true
    },
    "reviewerId": { "type": "string", "required": true },
    "notes": { "type": "text" }
  }
}
