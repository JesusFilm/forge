{
  "kind": "collectionType",
  "collectionName": "ai_revisions",
  "info": {
    "singularName": "ai-revision",
    "pluralName": "ai-revisions",
    "displayName": "AI Revision"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "task": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::ai-task.ai-task"
    },
    "contentVariant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::content-variant.content-variant"
    },
    "revisionNumber": { "type": "integer", "required": true },
    "provider": { "type": "string", "required": true },
    "model": { "type": "string", "required": true },
    "promptTemplateId": { "type": "string", "required": true },
    "promptTemplateVersion": { "type": "string", "required": true },
    "policyVersion": { "type": "string", "required": true },
    "output": { "type": "richtext", "required": true }
  }
}
