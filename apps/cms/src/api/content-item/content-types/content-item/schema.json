{
  "kind": "collectionType",
  "collectionName": "content_items",
  "info": {
    "singularName": "content-item",
    "pluralName": "content-items",
    "displayName": "Content Item"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "locale": { "type": "string", "required": true },
    "title": { "type": "string", "required": true },
    "body": { "type": "richtext", "required": true },
    "workflowState": { "type": "component", "component": "shared.workflow-state" },
    "variants": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::content-variant.content-variant",
      "mappedBy": "contentItem"
    }
  }
}
