{
  "collectionName": "components_sections_sections",
  "info": {
    "displayName": "Section",
    "icon": "layer-group",
    "description": "Wrapper section with background color, optional blur hash, and dynamic content blocks"
  },
  "options": {},
  "attributes": {
    "sectionKey": {
      "type": "string",
      "required": false
    },
    "backgroundColor": {
      "type": "enumeration",
      "enum": ["default", "light", "dark", "primary"],
      "required": false
    },
    "blurHash": {
      "type": "string",
      "required": false
    },
    "backgroundOpacity": {
      "type": "float",
      "min": 0,
      "max": 1,
      "required": false
    },
    "dynamicBackgroundImage": {
      "type": "boolean",
      "default": false,
      "required": false
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "sections.media-collection",
        "sections.text",
        "sections.promo-banner",
        "sections.info-blocks",
        "sections.cta",
        "sections.container",
        "sections.related-questions",
        "sections.bible-quotes-carousel",
        "sections.card",
        "sections.video",
        "sections.video-carousel",
        "sections.quiz-button"
      ],
      "required": false
    }
  }
}
