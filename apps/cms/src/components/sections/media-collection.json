{
  "collectionName": "components_sections_media_collections",
  "info": {
    "displayName": "Media Collection",
    "icon": "grid",
    "description": "Collection of media items with variant display"
  },
  "options": {},
  "attributes": {
    "sectionKey": {
      "type": "string",
      "required": false
    },
    "categoryLabel": {
      "type": "string",
      "required": false
    },
    "variant": {
      "type": "enumeration",
      "enum": ["carousel", "grid", "collection", "hero", "player"],
      "required": true
    },
    "itemsSource": {
      "type": "enumeration",
      "enum": ["manual", "routeVideoChildren"],
      "default": "manual",
      "required": false
    },
    "title": {
      "type": "string",
      "required": false
    },
    "subtitle": {
      "type": "string",
      "required": false
    },
    "description": {
      "type": "text",
      "required": false
    },
    "ctaLink": {
      "type": "string",
      "required": false
    },
    "ctaLabel": {
      "type": "string",
      "required": false
    },
    "showItemNumbers": {
      "type": "boolean",
      "default": false,
      "required": false
    },
    "footerText": {
      "type": "string",
      "required": false
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "sections.media-collection-item",
      "required": false
    }
  }
}
