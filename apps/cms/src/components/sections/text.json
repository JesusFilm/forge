{
  "collectionName": "components_sections_texts",
  "info": {
    "displayName": "Text",
    "icon": "file",
    "description": "Rich or plain text block with optional title and subtitle (heading → subtitle → body)"
  },
  "options": {},
  "attributes": {
    "sectionKey": {
      "type": "string",
      "required": false
    },
    "heading": {
      "type": "string",
      "required": false
    },
    "headingLevel": {
      "type": "enumeration",
      "enum": ["h1", "h2", "h3", "h4", "h5", "h6"],
      "required": false
    },
    "subtitle": {
      "type": "text",
      "required": false
    },
    "contentParagraphs": {
      "type": "json",
      "required": false,
      "description": "Array of plain-text paragraph strings, e.g. [\"First paragraph.\", \"Second paragraph.\"]"
    },
    "variant": {
      "type": "enumeration",
      "enum": ["default", "lead", "small", "featured"],
      "required": false
    }
  }
}
