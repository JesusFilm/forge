{
  "collectionName": "components_sections_container_slots",
  "info": {
    "displayName": "Container Slot",
    "icon": "layout",
    "description": "Single slot with grid span and dynamic content (e.g. media collection, text, related questions, CTA, Bible quotes carousel)"
  },
  "options": {},
  "attributes": {
    "gridSpan": {
      "type": "integer",
      "min": 1,
      "max": 12,
      "required": true,
      "default": 6
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "sections.media-collection",
        "sections.text",
        "sections.related-questions",
        "sections.cta",
        "sections.bible-quotes-carousel",
        "sections.card",
        "sections.easter-dates",
        "sections.video",
        "sections.video-carousel"
      ],
      "required": true
    }
  }
}
