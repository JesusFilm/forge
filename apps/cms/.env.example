# Pull dev secrets from Doppler:
# pnpm fetch-secrets
#
## Shared ##
# Strapi required
# APP_KEYS: generate 4 values, then comma-join (openssl rand -base64 32)
APP_KEYS=key1,key2,key3,key4
# openssl rand -base64 32
ADMIN_JWT_SECRET=
# openssl rand -base64 32
JWT_SECRET=
# openssl rand -hex 16
API_TOKEN_SALT=
# openssl rand -hex 16
TRANSFER_TOKEN_SALT=
# openssl rand -base64 32
ENCRYPTION_KEY=
# openssl rand -hex 32 (startup creates/rotates internal full-access token from this key)
STRAPI_INTERNAL_API_TOKEN=
# Preview: shared secret for Strapi preview handler → web /api/preview?secret=...
# openssl rand -hex 32
PREVIEW_SECRET=
# Revalidation webhook: bootstraps a webhook that POSTs to the web app on content changes
# URL of the Next.js revalidation endpoint (e.g. https://watch.example.com/api/revalidate)
REVALIDATION_WEBHOOK_URL=
# Shared secret sent as x-revalidation-secret header (must match web app's REVALIDATION_SECRET)
# openssl rand -hex 32
REVALIDATION_SECRET=

## Development ##
# Database (PostgreSQL required — matches production)
DATABASE_URL=postgres://strapi:strapi@localhost:5432/strapi

## Production ##
# Railway S3-compatible storage
RAILWAY_S3_ENDPOINT=
RAILWAY_S3_REGION=
RAILWAY_S3_BUCKET=
RAILWAY_S3_ACCESS_KEY_ID=
RAILWAY_S3_SECRET_ACCESS_KEY=
RAILWAY_S3_SIGNED_URL_EXPIRES=900

# Email (Resend)
RESEND_API_KEY=
EMAIL_DEFAULT_FROM=
EMAIL_DEFAULT_REPLY_TO=

## Data Snapshot ##
# Shared secret for the /api/data-snapshot/* endpoints (used by pnpm data-import)
# openssl rand -hex 32
DATA_SNAPSHOT_SECRET=
# Base URL of the production CMS (for pnpm data-import to fetch snapshots)
CMS_PROD_BASE_URL=
