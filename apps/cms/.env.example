## Shared ##
# Strapi required
# APP_KEYS: generate 4 values, then comma-join (openssl rand -base64 32)
APP_KEYS=key1,key2,key3,key4
# openssl rand -base64 32
ADMIN_JWT_SECRET=
# openssl rand -base64 32
JWT_SECRET=
# openssl rand -hex 16
API_TOKEN_SALT=
# openssl rand -hex 16
TRANSFER_TOKEN_SALT=
# openssl rand -base64 32
ENCRYPTION_KEY=
# Generated in Strapi Admin -> Settings -> API Tokens (create full-access token)
STRAPI_INTERNAL_API_TOKEN=
# Preview: shared secret for Strapi preview handler → web /api/preview?secret=...
# openssl rand -hex 32
PREVIEW_SECRET=

## Development ##
# Database (SQLite default for dev)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

## Production ##
# Railway S3-compatible storage
RAILWAY_S3_ENDPOINT=
RAILWAY_S3_REGION=
RAILWAY_S3_BUCKET=
RAILWAY_S3_ACCESS_KEY_ID=
RAILWAY_S3_SECRET_ACCESS_KEY=
RAILWAY_S3_SIGNED_URL_EXPIRES=900

# Email (Resend)
RESEND_API_KEY=
EMAIL_DEFAULT_FROM=
EMAIL_DEFAULT_REPLY_TO=
