# Strapi required (generate with: openssl rand -base64 32)
HOST=0.0.0.0
PORT=1337
APP_KEYS=key1,key2,key3,key4
ADMIN_JWT_SECRET=
# Users & Permissions plugin (API auth)
JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# Database (SQLite default for dev)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Full-access API token for local Strapi (clients use as Bearer token; create in Admin → Settings → API Tokens)
STRAPI_FULL_ACCESS_TOKEN=
# Optional bootstrap token key. On startup, Strapi ensures read-only token "forge-internal-api-token".
STRAPI_INTERNAL_API_TOKEN=

# Railway S3-compatible storage
RAILWAY_S3_ENDPOINT=
RAILWAY_S3_REGION=
RAILWAY_S3_BUCKET=
RAILWAY_S3_ACCESS_KEY_ID=
RAILWAY_S3_SECRET_ACCESS_KEY=
RAILWAY_S3_SIGNED_URL_EXPIRES=900

# Email (Resend)
RESEND_API_KEY=
EMAIL_DEFAULT_FROM=
EMAIL_DEFAULT_REPLY_TO=

# Preview: shared secret for Strapi preview handler → web /api/preview?secret=...
PREVIEW_SECRET=
