# Strapi required (generate with: openssl rand -base64 32)
HOST=0.0.0.0
PORT=1337
APP_KEYS=key1,key2,key3,key4
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# Database (SQLite default for dev)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Web integration (apps/web expects these; set in apps/web/.env)
# Revalidate: web POST /api/revalidate expects x-forge-revalidate-token header (future Strapi webhook on publish)
STRAPI_REVALIDATE_TOKEN=
# Preview: web GET /api/preview?token=... enables draft mode
STRAPI_PREVIEW_TOKEN=

# Scripts / automation (optional; can also set in repo root .env)
# STRAPI_API_TOKEN=  # Create in Admin → Settings → API Tokens (for scripts/upsert-experience.js)
# STRAPI_URL=http://localhost:1337  # Base URL for REST API (default 1337)
