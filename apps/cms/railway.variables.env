# Railway CMS variables template.
# Intended for Railway Template/Raw variable workflows that support `${{...}}`.

HOST=0.0.0.0
PORT=1337
NODE_ENV=production

DATABASE_CLIENT=postgres
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Strapi core secrets
APP_KEYS=${{secret(43, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+/")}}=,${{secret(43, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+/")}}=,${{secret(43, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+/")}}=,${{secret(43, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+/")}}=
ADMIN_JWT_SECRET=${{secret(64, "abcdef0123456789")}}
JWT_SECRET=${{secret(64, "abcdef0123456789")}}
API_TOKEN_SALT=${{secret(64, "abcdef0123456789")}}
TRANSFER_TOKEN_SALT=${{secret(64, "abcdef0123456789")}}
ENCRYPTION_KEY=${{secret(64, "abcdef0123456789")}}
PREVIEW_SECRET=${{secret(64, "abcdef0123456789")}}
STRAPI_INTERNAL_API_TOKEN=${{secret(64, "abcdef0123456789")}}

# Railway S3-compatible storage
RAILWAY_S3_ENDPOINT=
RAILWAY_S3_REGION=
RAILWAY_S3_BUCKET=
RAILWAY_S3_ACCESS_KEY_ID=${{secret(32, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")}}
RAILWAY_S3_SECRET_ACCESS_KEY=${{secret(64, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")}}
RAILWAY_S3_CDN_URL=
RAILWAY_S3_ROOT_PATH=cms
RAILWAY_S3_ACL=private
RAILWAY_S3_SIGNED_URL_EXPIRES=900
RAILWAY_S3_FORCE_PATH_STYLE=true

# Resend
RESEND_API_KEY=
EMAIL_DEFAULT_FROM=
EMAIL_DEFAULT_REPLY_TO=
