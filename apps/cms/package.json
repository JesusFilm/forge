{
  "name": "@forge/cms",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "strapi build",
    "dev": "strapi develop",
    "start": "strapi start",
    "fetch-secrets": "doppler secrets download --project forge-cms --config dev --format env --no-file > .env",
    "seed": "echo \"Easter seed runs during CMS bootstrap in non-production\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run",
    "data-import": "tsx src/scripts/data-import.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.1.6",
    "@aws-sdk/client-s3": "^3.1015.0",
    "@aws-sdk/s3-request-presigner": "3.1015.0",
    "@strapi/plugin-graphql": "5.40.0",
    "@strapi/plugin-users-permissions": "5.40.0",
    "@strapi/provider-upload-aws-s3": "5.40.0",
    "@strapi/strapi": "5.40.0",
    "graphql-tag": "2.12.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "strapi-provider-email-resend": "^1.0.4",
    "pg": "^8.20.0",
    "styled-components": "^6.3.12"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "6.2.1",
    "@graphql-codegen/client-preset": "5.2.4",
    "@graphql-codegen/typescript": "5.0.9",
    "@graphql-codegen/typescript-graphql-request": "7.0.0",
    "@graphql-codegen/typescript-operations": "5.0.9",
    "@graphql-tools/graphql-file-loader": "8.1.12",
    "@graphql-tools/load": "8.1.8",
    "@graphql-typed-document-node/core": "3.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "graphql": "16.13.1",
    "typescript": "^5",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": "24"
  }
}
