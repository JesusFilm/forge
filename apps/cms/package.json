{
  "name": "@forge/cms",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "strapi build",
    "dev": "strapi develop",
    "start": "strapi start",
    "fetch-secrets": "../../scripts/fetch-secrets.sh forge-cms .env",
    "seed": "echo \"Easter seed runs during CMS bootstrap in non-production\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run",
    "data-import": "tsx src/scripts/data-import.ts",
    "data-import-check": "tsx src/scripts/data-import-check.ts",
    "backfill:experience-embeddings": "node src/scripts/backfill-experience-embeddings-cli.js",
    "dump:core-id-mapping": "node src/scripts/dump-core-id-mapping-cli.js"
  },
  "dependencies": {
    "@apollo/client": "^4.1.4",
    "@aws-sdk/client-s3": "^3.1015.0",
    "@aws-sdk/s3-request-presigner": "3.1015.0",
    "@strapi/plugin-graphql": "5.42.1",
    "@strapi/plugin-users-permissions": "5.42.1",
    "@strapi/provider-upload-aws-s3": "5.42.1",
    "@strapi/strapi": "5.42.1",
    "blurhash": "2.0.5",
    "dotenv": "^16.4.0",
    "graphql-tag": "2.12.6",
    "openai": "^4.0.0",
    "pg": "^8.13.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "sharp": "0.34.5",
    "strapi-provider-email-resend": "^1.0.4",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "6.3.1",
    "@graphql-codegen/client-preset": "5.3.0",
    "@graphql-codegen/typescript": "5.0.10",
    "@graphql-codegen/typescript-graphql-request": "7.0.1",
    "@graphql-codegen/typescript-operations": "5.1.0",
    "@graphql-tools/graphql-file-loader": "8.1.13",
    "@graphql-tools/load": "8.1.9",
    "@graphql-typed-document-node/core": "3.2.0",
    "@strapi/design-system": "2.2.0",
    "@types/node": "^25",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/sharp": "0.32.0",
    "graphql": "16.13.1",
    "tsx": "^4.21.0",
    "typescript": "^6",
    "vitest": "4.1.4"
  },
  "engines": {
    "node": "24"
  }
