{
  "name": "@forge/tv",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "ios": "EXPO_TV=1 expo run:ios",
    "android": "EXPO_TV=1 expo run:android",
    "prebuild": "EXPO_TV=1 npx expo prebuild --clean",
    "lint": "eslint .",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "echo 'Expo TV app has no production bundle step; use EAS when needed.'",
    "eas-build-pre-install": "bash scripts/eas-build-pre-install.sh",
    "eas-build-on-success": "bash scripts/eas-build-on-success.sh"
  },
  "dependencies": {
    "@apollo/client": "^4.1.4",
    "@datadog/mobile-react-native": "3.5.2",
    "@expo/vector-icons": "^15.1.1",
    "@forge/admin-graphql": "workspace:*",
    "@forge/watch-url-policy": "workspace:*",
    "@hebcal/hdate": "^0.21.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-tvos/config-tv": "^0.0.13",
    "@t3-oss/env-core": "^0.13.11",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.20",
    "expo-image": "~3.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "^55.0.13",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "graphql": "16.13.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.1.0",
    "react-native": "npm:react-native-tvos@0.81-stable",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/runtime": "^7.28.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.1.17",
    "babel-preset-expo": "^54.0.10",
    "eslint": ">=8.10",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|react-navigation|@react-navigation|@hebcal|@t3-oss|zod|@datadog))"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "private": true
}
