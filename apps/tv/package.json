{
  "name": "@forge/tv",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "ios": "EXPO_TV=1 expo run:ios",
    "android": "EXPO_TV=1 expo run:android",
    "prebuild": "EXPO_TV=1 npx expo prebuild --clean",
    "lint": "eslint .",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "echo 'Expo TV app has no production bundle step; use EAS when needed.'"
  },
  "dependencies": {
    "@apollo/client": "^4.1.4",
    "@forge/graphql": "workspace:*",
    "@hebcal/hdate": "^0.21.1",
    "@react-native-tvos/config-tv": "^0.0.13",
    "@t3-oss/env-core": "^0.13.11",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "^55.0.13",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "graphql": "16.13.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.1.0",
    "react-native": "npm:react-native-tvos@0.81-stable",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.2",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.17",
    "babel-preset-expo": "^55.0.17",
    "eslint": ">=10.2",
    "eslint-config-expo": "~55.0.0",
    "jest": "^30.3.0",
    "jest-expo": "~55.0.16",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|react-navigation|@react-navigation|@hebcal|@t3-oss|zod))"
    ]
  },
  "private": true
}
