{
  "name": "@forge/tv",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "ios": "EXPO_TV=1 expo run:ios",
    "android": "EXPO_TV=1 expo run:android",
    "prebuild": "EXPO_TV=1 npx expo prebuild --clean",
    "lint": "eslint .",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "echo 'Expo TV app has no production bundle step; use EAS when needed.'"
  },
  "dependencies": {
    "@apollo/client": "^4.1.7",
    "@forge/graphql": "workspace:*",
    "@hebcal/hdate": "^0.22.0",
    "@react-native-tvos/config-tv": "^0.1.6",
    "@t3-oss/env-core": "^0.13.11",
    "expo": "~55.0.16",
    "expo-constants": "~55.0.15",
    "expo-dev-client": "~55.0.28",
    "expo-image": "~55.0.9",
    "expo-linear-gradient": "^55.0.13",
    "expo-linking": "~55.0.14",
    "expo-router": "~55.0.13",
    "expo-status-bar": "~55.0.5",
    "expo-video": "~55.0.15",
    "graphql": "16.13.2",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.5",
    "react-native": "npm:react-native-tvos@0.81-stable",
    "react-native-screens": "~4.24.0",
    "react-native-webview": "13.16.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/runtime": "^7.28.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "^54.0.10",
    "eslint": ">=8.10",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|react-navigation|@react-navigation|@hebcal|@t3-oss|zod))"
    ]
  },
  "private": true
}
