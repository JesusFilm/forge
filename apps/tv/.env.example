# apps/tv environment variables.
# Local dev: copy to .env.local (gitignored). Deployed: set via `eas env:create` per profile.
# Feature switches, defaults and restart requirements: README.md.

# Admin GraphQL endpoint (required).
EXPO_PUBLIC_GRAPHQL_URL=https://admin.jesusfilm.org/api/graphql

# Consumer bearer, scoped to the WatchSearch op only. Optional: watchSearch is a
# PUBLIC resolver, so search still works unset — it just falls back to admin's
# coarse per-IP rate-limit bucket instead of the per-device one.
EXPO_PUBLIC_ADMIN_GRAPHQL_TOKEN=

# Apple TV beta style selector (true or 1). False keeps automatic Top Shelf active.
# EAS development/preview enable the selector; production disables it.
EXPO_PUBLIC_TV_TOP_SHELF_PREVIEW_ENABLED=false
# Only exact true enables recommendations (1 does not).
# Recommendation reads use the TV fleet key plus app-private anonymous identity.
EXPO_PUBLIC_TV_RECOMMENDATIONS_ENABLED=true

# Nonempty feedback URL shows feedback menus; empty hides them (not the string false).
# Verified Android TV feedback QR. Cloud project number is public configuration,
# not a credential. The Play Integrity module requires a new native TV build.
EXPO_PUBLIC_TV_FEEDBACK_URL=
# Development TV simulator/emulator only; ignored in Release and on physical TVs.
# Local URL and receiving-server setup: ../tv-feedback/LOCAL-FEEDBACK.md
EXPO_PUBLIC_TV_FEEDBACK_SIMULATOR_ENABLED=false
EXPO_PUBLIC_PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=
# Local receiver QR only in a development TV simulator/emulator build.
# Set the feedback URL to http://<Mac-private-LAN-IP>:3210/tv/local.
# Physical devices and Release native builds cannot enable this mode.
EXPO_PUBLIC_TV_FEEDBACK_SIMULATOR_ENABLED=false

# --- Datadog RUM (optional) ---
# Telemetry is skipped unless BOTH the client token and application id are set.
# Use a Datadog CLIENT TOKEN (pub...), never an API key — this ships in the bundle.
# Site is the MOBILE enum (US1, US3, US5, EU1, AP1, US1_FED), NOT web's "datadoghq.com". US1 = datadoghq.com.
EXPO_PUBLIC_DATADOG_CLIENT_TOKEN=
EXPO_PUBLIC_DATADOG_APPLICATION_ID=
EXPO_PUBLIC_DATADOG_SITE=US1
# Optional override — unset defaults by build type (dev builds -> development, release -> prod).
EXPO_PUBLIC_DATADOG_ENV=
EXPO_PUBLIC_DATADOG_VERSION=

# Build-time only — EAS SECRET-visibility var (NOT EXPO_PUBLIC): the eas-build-on-success hook
# uploads dSYMs to Datadog when this is present (`eas env:create ... --visibility secret`).
# Keyless builds skip the upload and stay green. The expo-datadog plugin stays disabled.
# DATADOG_API_KEY=

# Legacy Profile flag: currently ignored by src/lib/auth/profileFlagState.ts.
# Profile stays hidden on both platforms, including development builds (feat-596).
EXPO_PUBLIC_TV_PROFILE_ENABLED=
