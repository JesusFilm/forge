# apps/tv environment variables.
# Local dev: copy to .env.local (gitignored). Deployed: set via `eas env:create` per profile.

# Admin GraphQL endpoint (required).
EXPO_PUBLIC_GRAPHQL_URL=https://admin.jesusfilm.org/api/graphql

# Consumer bearer, scoped to the SemanticSearch op only (optional; unset = search 401 on prod).
EXPO_PUBLIC_ADMIN_GRAPHQL_TOKEN=

# --- Datadog RUM (optional) ---
# Telemetry is skipped unless BOTH the client token and application id are set.
# Use a Datadog CLIENT TOKEN (pub...), never an API key — this ships in the bundle.
# Site is the MOBILE enum (US1, US3, US5, EU1, AP1, US1_FED), NOT web's "datadoghq.com". US1 = datadoghq.com.
EXPO_PUBLIC_DATADOG_CLIENT_TOKEN=
EXPO_PUBLIC_DATADOG_APPLICATION_ID=
EXPO_PUBLIC_DATADOG_SITE=US1
# Optional override — unset defaults by build type (dev builds -> development, release -> prod).
EXPO_PUBLIC_DATADOG_ENV=
EXPO_PUBLIC_DATADOG_VERSION=

# Build-time only — EAS SECRET-visibility var (NOT EXPO_PUBLIC): the eas-build-on-success hook
# uploads dSYMs to Datadog when this is present (`eas env:create ... --visibility secret`).
# Keyless builds skip the upload and stay green. The expo-datadog plugin stays disabled.
# DATADOG_API_KEY=
