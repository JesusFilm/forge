DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forge_mastra_gateway
MASTRA_SERVICE_API_KEYS=local-mastra-service-key
# Dedicated human-review bearer used only by mastra-gateway's authenticated
# devotional resume route. Must not overlap MASTRA_SERVICE_API_KEYS.
DEVOTIONAL_APPROVAL_API_KEYS=local-devotional-approval-key
DEVOTIONAL_MUSIC_LIBRARY_DIR=
# Dedicated bearer allowlist for the ai-chat lane: the history read routes
# (feat-241) AND /forge-seeker sends (feat-250 — the ONLY bearer that route
# accepts; the shared MASTRA_SERVICE_API_KEYS pool above never reaches
# conversation data). Optional; unset = empty allowlist = the lane routes fail
# closed (401). Must match chat's AI_CHAT_MASTRA_API_KEY and must NOT overlap
# MASTRA_SERVICE_API_KEYS (boot asserts disjointness). The lane also needs
# SEEKER_ROUTE_ENABLED=true to serve.
AI_CHAT_SERVICE_API_KEYS=local-ai-chat-lane-key
MASTRA_STORAGE_DIR=.mastra/storage
# Canonical devotional Workspace. Local development uses
# DEVOTIONAL_WORKSPACE_LOCAL_DIR when this entire dedicated S3 tuple is empty.
# In Railway, reference the dedicated bucket's ENDPOINT/REGION/BUCKET and
# credential variables into these app-level names. Do not reuse RAILWAY_S3_*.
DEVOTIONAL_WORKSPACE_LOCAL_DIR=.mastra/storage/devotional-workspace
DEVOTIONAL_WORKSPACE_PREFIX=devotional
DEVOTIONAL_WORKSPACE_DATABASE_POOL_MAX=3
DEVOTIONAL_WORKSPACE_S3_ENDPOINT=
DEVOTIONAL_WORKSPACE_S3_REGION=
DEVOTIONAL_WORKSPACE_S3_BUCKET=
DEVOTIONAL_WORKSPACE_S3_ACCESS_KEY_ID=
DEVOTIONAL_WORKSPACE_S3_SECRET_ACCESS_KEY=
RAILWAY_S3_ENDPOINT=
RAILWAY_S3_REGION=auto
RAILWAY_S3_BUCKET=
RAILWAY_S3_ACCESS_KEY_ID=
RAILWAY_S3_SECRET_ACCESS_KEY=
ADMIN_TRANSCRIPT_INGEST_URL=http://localhost:3003/api/internal/mastra/transcript-embeddings
ADMIN_MASTRA_TRANSCRIPT_INGEST_API_KEY=local-admin-transcript-ingest-key
ADMIN_EXPERIENCE_INGEST_URL=http://localhost:3003/api/internal/mastra/experience-embeddings
ADMIN_MASTRA_EXPERIENCE_INGEST_API_KEY=local-admin-experience-ingest-key
ADMIN_SEARCH_TRACE_SAMPLE_URL=http://localhost:3003/api/internal/search-traces/sample
ADMIN_SEARCH_EVAL_CATALOG_CONTEXT_URL=http://localhost:3003/api/internal/search-eval/catalog-context
ADMIN_SEARCH_EVAL_CANDIDATES_URL=http://localhost:3003/api/internal/search-eval/candidates
ADMIN_SEARCH_EVAL_SEARCH_URL=http://localhost:3003/api/internal/search-eval/search
ADMIN_SEARCH_EVAL_API_KEY=local-search-eval-key
MASTRA_SEARCH_EVAL_ARTIFACT_DIR=.mastra/storage/search-eval
MASTRA_SEARCH_EVAL_ALLOW_PROD_IMPORT=false
OPENROUTER_API_PAID_KEY=
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EVAL_QUERY_GENERATION_MODEL=anthropic/claude-haiku-4-5
SEARCH_EVAL_JUDGE_MODEL=anthropic/claude-haiku-4-5
SUBTITLE_ENRICHMENT_MODEL=google/gemini-2.5-flash
SUBTITLE_ENRICHMENT_TIMEOUT_MS=120000
SUBTITLE_ENRICHMENT_CONCURRENCY=10
TRANSCRIPT_EMBEDDING_MODEL=openai/text-embedding-3-small
TRANSCRIPT_EMBEDDING_PROVIDER=openai
EXPERIENCE_EMBEDDING_MODEL=openai/text-embedding-3-small
EXPERIENCE_EMBEDDING_PROVIDER=openai
# Firecrawl web data and AI/Christian discovery
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_ALLOWED_HOSTS=api.firecrawl.dev
FIRECRAWL_USER_AGENT=forge-mastra-firecrawl/1.0
FIRECRAWL_TIMEOUT_MS=60000
FIRECRAWL_MAX_SEARCH_RESULTS=5
FIRECRAWL_MAX_MARKDOWN_CHARS=16000
INSTAGRAM_DISCOVERY_ARTIFACT_DIR=.mastra/storage/instagram-discovery
# Daily devotional generator (all optional; defaults run with no extra setup)
DEVOTIONAL_SITE_INGEST_URL=
DEVOTIONAL_SITE_INGEST_API_KEY=
DEVOTIONAL_PARTNER_DOMAINS=
DEVOTIONAL_DEFAULT_VIDEO_ID=
DEVOTIONAL_MODEL=anthropic/claude-haiku-4-5
DEVOTIONAL_SAFETY_MODEL=anthropic/claude-haiku-4-5
DEVOTIONAL_ARTIFACT_DIR=.mastra/storage/daily-devotional
# Optional website integration. Each endpoint is active only when its URL and
# the shared token are both set; incomplete settings never block Mastra startup.
INSTAGRAM_DISCOVERY_SITE_INGEST_URL=
INSTAGRAM_DISCOVERY_SITE_INGEST_TOKEN=
# Optional: read the website-managed trusted source list with the shared token.
# Website clients require HTTPS before sending the shared token.
DISCOVERY_SOURCES_URL=
# Optional YouTube discovery API (HTTPS + host allowlist enforced in production)
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_ALLOWED_HOSTS=www.googleapis.com
YOUTUBE_SEARCH_TIMEOUT_MS=30000
# JesusFilm RAG retrieval service for the seeker agent
JESUSFILM_RAG_BASE_URL=
JESUSFILM_RAG_API_KEY=
JESUSFILM_RAG_ALLOWED_HOSTS=
JESUSFILM_RAG_TIMEOUT_MS=5000
JESUSFILM_RAG_USER_AGENT=forge-mastra-jesusfilm-rag/1.0
# Internal seeker SSE service route (feat-204). Default-off: the route returns
# 404 unless this is exactly "true" (any other value, incl. unset, = disabled).
# Set to true only in a deliberate dogfooding environment.
SEEKER_ROUTE_ENABLED=false
# Seeker gateway model opt-in (feat-237). Default-off: the seeker stays on the
# free-Gemma OpenRouter chain unless AI_GATEWAY_SEEKER_ENABLED is exactly
# "true" AND the gateway key is set (any other value, incl. unset, = off).
# The key is CHAT-scoped (the embeddings key is rejected by the chat model)
# and SHARED with the experience-agent gateway opt-in. Base URL and model id
# default to the production gateway + "coding"; override via the shared
# AI_GATEWAY_CHAT_BASE_URL / AI_GATEWAY_CHAT_MODEL if needed.
AI_GATEWAY_CHAT_API_KEY=
AI_GATEWAY_SEEKER_ENABLED=false
