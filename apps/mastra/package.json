{
  "name": "@forge/mastra",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build --studio",
    "start": "MASTRA_STUDIO_PATH=.mastra/output/studio node .mastra/output/index.mjs",
    "lint": "eslint .",
    "seed:search-eval": "pnpm --dir ../.. exec tsx apps/mastra/src/scripts/seed-search-eval-from-artifact.ts",
    "seed:search-eval:prod": "MASTRA_NATIVE_EVAL_ENVIRONMENT=local pnpm --dir ../.. exec tsx apps/mastra/src/scripts/seed-search-eval-from-artifact.ts --artifact docs/search-eval-baselines/temporary/prod-seed-baseline-2026-06-02-export.json --environment-label local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mastra/core": "1.38.0",
    "@mastra/duckdb": "1.4.1",
    "@mastra/loggers": "1.1.2",
    "@mastra/observability": "1.14.1",
    "@mastra/pg": "1.12.0",
    "mastra": "1.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^9.0.0",
    "typescript": "^5",
    "vitest": "3.2.4"
  }
}
