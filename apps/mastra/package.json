{
  "name": "@forge/mastra",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "PORT=4111 NODE_OPTIONS=\"--import tsx\" mastra dev",
    "build": "mastra build --studio",
    "start": "MASTRA_STUDIO_PATH=.mastra/output/studio node .mastra/output/index.mjs",
    "check:devotional-database-readiness": "pnpm --dir ../.. exec tsx apps/mastra/src/scripts/check-devotional-database-readiness.ts",
    "lint": "eslint .",
    "migrate:database": "pnpm --dir ../.. exec tsx apps/mastra/src/scripts/migrate-mastra-database.ts",
    "migrate:devotional-database": "pnpm --dir ../.. exec tsx apps/mastra/src/scripts/migrate-devotional-database.ts",
    "devo:workspace:migrate": "pnpm --dir ../.. exec tsx apps/mastra/src/scripts/migrate-devotional-workspace.ts",
    "devo:run": "pnpm --dir ../.. exec tsx apps/mastra/src/scripts/run-daily-devotional.ts",
    "devo:segments": "pnpm --dir ../.. exec tsx apps/mastra/src/scripts/build-devotional-video-manifest.ts",
    "erase-user": "pnpm --dir ../.. exec tsx apps/mastra/src/scripts/erase-user.ts",
    "eval:content-embedding-gate": "pnpm --dir ../.. exec tsx apps/mastra/src/scripts/run-content-embedding-search-eval.ts",
    "eval:seeker:answers": "pnpm --dir ../.. exec tsx apps/mastra/src/evals/seeker/run-answers.ts",
    "eval:seeker:judge": "pnpm --dir ../.. exec tsx apps/mastra/src/evals/seeker/run-judge.ts",
    "eval:seeker:report": "pnpm --dir ../.. exec tsx apps/mastra/src/evals/seeker/run-report.ts",
    "eval:seeker:score": "pnpm --dir ../.. exec tsx apps/mastra/src/evals/seeker/run-score.ts",
    "eval:seeker:capture-rag": "pnpm --dir ../.. exec tsx apps/mastra/src/evals/seeker/capture-rag.ts",
    "eval:seeker:loop": "pnpm --dir ../.. exec tsx apps/mastra/src/evals/seeker/run-loop.ts",
    "eval:seeker:gate": "pnpm --dir ../.. exec tsx apps/mastra/src/evals/seeker/run-gate.ts",
    "eval:seeker:experiment": "pnpm --dir ../.. exec tsx apps/mastra/src/evals/seeker/experiments/command.ts",
    "eval:seeker:experiment:run": "pnpm --dir ../.. exec tsx apps/mastra/src/evals/seeker/experiments/command.ts",
    "eval:seeker:experiment:verdict": "pnpm --dir ../.. exec tsx apps/mastra/src/evals/seeker/experiments/cli.ts",
    "eval:seeker:experiment:promote": "pnpm --dir ../.. exec tsx apps/mastra/src/evals/seeker/experiments/cli.ts promote",
    "smoke:followups-pg": "pnpm --dir ../.. exec tsx apps/mastra/src/scripts/followups-pg-smoke.ts",
    "seed:search-eval": "pnpm --dir ../.. exec tsx apps/mastra/src/scripts/seed-search-eval-from-artifact.ts",
    "seed:search-eval:prod": "MASTRA_NATIVE_EVAL_ENVIRONMENT=local pnpm --dir ../.. exec tsx apps/mastra/src/scripts/seed-search-eval-from-artifact.ts --artifact docs/search-eval-baselines/temporary/prod-seed-baseline-2026-06-02-export.json --environment-label local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/google": "3.0.79",
    "@ai-sdk/openai": "3.0.63",
    "@aws-sdk/client-s3": "3.1100.0",
    "@aws-sdk/s3-request-presigner": "3.1100.0",
    "@forge/devotional-workspace": "workspace:*",
    "@forge/experience-schema": "workspace:*",
    "@mastra/core": "1.55.0",
    "@mastra/duckdb": "1.5.2",
    "@mastra/editor": "0.13.9",
    "@mastra/langfuse": "1.4.6",
    "@mastra/loggers": "1.2.0",
    "@mastra/mcp": "1.15.0",
    "@mastra/memory": "1.24.0",
    "@mastra/observability": "1.16.3",
    "@mastra/pg": "1.18.1",
    "@mastra/s3": "0.6.0",
    "@smithy/node-http-handler": "4.9.13",
    "@smithy/util-retry": "4.3.1",
    "ai": "6.0.182",
    "google-auth-library": "10.6.2",
    "jsonrepair": "3.14.0",
    "jose": "^6.1.3",
    "mastra": "1.21.0",
    "ollama-ai-provider-v2": "3.5.1",
    "parse5": "7.3.0",
    "pg": "8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "8.20.0",
    "eslint": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "3.2.4"
  }
}
