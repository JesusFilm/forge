# Auth-owned database used by the developer portal read-only registry views.
AUTH_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forge_auth"

# Public origin for this app.
DEVELOPER_BASE_URL="http://localhost:3006"

# Auth issuer used when OAuth relying-client login is added.
AUTH_ISSUER_URL="http://localhost:3004"
AUTH_DEVELOPER_CLIENT_ID="jfp_developer_local"

# Keep disabled in public production until Developer OAuth login lands.
DEVELOPER_REGISTRY_MODE="readonly"
