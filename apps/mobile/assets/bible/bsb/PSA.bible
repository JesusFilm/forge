{"formatVersion":1,"translationId":"BSB","textDirection":"ltr","bookId":"PSA","bookName":"Psalms","chapters":[{"number":1,"lastVerse":6,"verses":[{"number":1,"lines":[{"text":"Blessed is the man","poem":1},{"text":"who does not walk in the counsel of the wicked,","poem":2},{"text":"or set foot on the path of sinners,","poem":1},{"text":"or sit in the seat of mockers.","poem":2}]},{"number":2,"lines":[{"text":"But his delight is in the Law of the LORD,","poem":1},{"text":"and on His law he meditates day and night.","poem":2}]},{"number":3,"lines":[{"text":"He is like a tree planted by streams of water,","poem":1},{"text":"yielding its fruit in season,","poem":2},{"text":"whose leaf does not wither,","poem":1},{"text":"and who prospers in all he does.","poem":2}]},{"number":4,"lines":[{"text":"Not so the wicked!","poem":1},{"text":"For they are like chaff driven off by the wind.","poem":2}]},{"number":5,"lines":[{"text":"Therefore the wicked will not stand in the judgment,","poem":1},{"text":"nor sinners in the assembly of the righteous.","poem":2}]},{"number":6,"lines":[{"text":"For the LORD guards the path of the righteous,","poem":1},{"text":"but the way of the wicked will perish.","poem":2}]}]},{"number":2,"lastVerse":12,"verses":[{"number":1,"lines":[{"text":"Why do the nations rage","poem":1},{"text":"and the peoples plot in vain?","poem":2}]},{"number":2,"lines":[{"text":"The kings of the earth take their stand","poem":1},{"text":"and the rulers gather together,","poem":2},{"text":"against the LORD","poem":1},{"text":"and against His Anointed One:","poem":2}]},{"number":3,"lines":[{"text":"“Let us break Their chains","poem":1},{"text":"and cast away Their cords.”","poem":2}]},{"number":4,"lines":[{"text":"The One enthroned in heaven laughs;","poem":1},{"text":"the Lord taunts them.","poem":2}]},{"number":5,"lines":[{"text":"Then He rebukes them in His anger,","poem":1},{"text":"and terrifies them in His fury:","poem":2}]},{"number":6,"lines":[{"text":"“I have installed My King on Zion,","poem":1},{"text":"upon My holy mountain.”","poem":2}]},{"number":7,"lines":[{"text":"I will proclaim the decree","poem":1},{"text":"spoken to Me by the LORD:","poem":2},{"text":"“You are My Son;","poem":1},{"text":"today I have become Your Father.","poem":2}]},{"number":8,"lines":[{"text":"Ask Me, and I will make the nations Your inheritance,","poem":1},{"text":"the ends of the earth Your possession.","poem":2}]},{"number":9,"lines":[{"text":"You will break them with an iron scepter;","poem":1},{"text":"You will shatter them like pottery.”","poem":2}]},{"number":10,"lines":[{"text":"Therefore be wise, O kings;","poem":1},{"text":"be admonished, O judges of the earth.","poem":2}]},{"number":11,"lines":[{"text":"Serve the LORD with fear,","poem":1},{"text":"and rejoice with trembling.","poem":2}]},{"number":12,"lines":[{"text":"Kiss the Son, lest He be angry","poem":1},{"text":"and you perish in your rebellion,","poem":2},{"text":"when His wrath ignites in an instant.","poem":2},{"text":"Blessed are all who take refuge in Him.","poem":1}]}]},{"number":3,"lastVerse":8,"verses":[{"number":1,"lines":[{"text":"O LORD, how my foes have increased!","poem":1},{"text":"How many rise up against me!","poem":2}]},{"number":2,"lines":[{"text":"Many say of me,","poem":1},{"text":"“God will not deliver him.”","poem":2},{"text":"Selah"}]},{"number":3,"lines":[{"text":"But You, O LORD, are a shield around me,","poem":1},{"text":"my glory, and the One who lifts my head.","poem":2}]},{"number":4,"lines":[{"text":"To the LORD I cry aloud,","poem":1},{"text":"and He answers me from His holy mountain.","poem":2},{"text":"Selah"}]},{"number":5,"lines":[{"text":"I lie down and sleep;","poem":1},{"text":"I wake again, for the LORD sustains me.","poem":2}]},{"number":6,"lines":[{"text":"I will not fear the myriads","poem":1},{"text":"set against me on every side.","poem":2}]},{"number":7,"lines":[{"text":"Arise, O LORD!","poem":1},{"text":"Save me, O my God!","poem":2},{"text":"Strike all my enemies on the jaw;","poem":1},{"text":"break the teeth of the wicked.","poem":2}]},{"number":8,"lines":[{"text":"Salvation belongs to the LORD;","poem":1},{"text":"may Your blessing be on Your people.","poem":2},{"text":"Selah"}]}]},{"number":4,"lastVerse":8,"verses":[{"number":1,"lines":[{"text":"Answer me when I call,","poem":1},{"text":"O God of my righteousness!","poem":2},{"text":"You have relieved my distress;","poem":1},{"text":"show me grace and hear my prayer.","poem":2}]},{"number":2,"lines":[{"text":"How long, O men, will my honor be maligned?","poem":1},{"text":"How long will you love vanity and seek after lies?","poem":2},{"text":"Selah"}]},{"number":3,"lines":[{"text":"Know that the LORD has set apart the godly for Himself;","poem":1},{"text":"the LORD hears when I call to Him.","poem":2}]},{"number":4,"lines":[{"text":"Be angry, yet do not sin;","poem":1},{"text":"on your bed, search your heart and be still.","poem":2},{"text":"Selah"}]},{"number":5,"lines":[{"text":"Offer the sacrifices of the righteous","poem":1},{"text":"and trust in the LORD.","poem":2}]},{"number":6,"lines":[{"text":"Many ask, “Who can show us the good?”","poem":1},{"text":"Shine the light of Your face upon us, O LORD.","poem":2}]},{"number":7,"lines":[{"text":"You have filled my heart with more joy","poem":1},{"text":"than when grain and new wine abound.","poem":2}]},{"number":8,"lines":[{"text":"I will lie down and sleep in peace,","poem":1},{"text":"for You alone, O LORD, make me dwell in safety.","poem":2}]}]},{"number":5,"lastVerse":12,"verses":[{"number":1,"lines":[{"text":"Give ear to my words, O LORD;","poem":1},{"text":"consider my groaning.","poem":2}]},{"number":2,"lines":[{"text":"Attend to the sound of my cry,","poem":1},{"text":"my King and my God,","poem":2},{"text":"for to You I pray.","poem":2}]},{"number":3,"lines":[{"text":"In the morning, O LORD, You hear my voice;","poem":1},{"text":"at daybreak I lay my plea before You","poem":2},{"text":"and wait in expectation.","poem":2}]},{"number":4,"lines":[{"text":"For You are not a God who delights in wickedness;","poem":1},{"text":"no evil can dwell with You.","poem":2}]},{"number":5,"lines":[{"text":"The boastful cannot stand in Your presence;","poem":1},{"text":"You hate all workers of iniquity.","poem":2}]},{"number":6,"lines":[{"text":"You destroy those who tell lies;","poem":1},{"text":"the LORD abhors the man of bloodshed and deceit.","poem":2}]},{"number":7,"lines":[{"text":"But I will enter Your house","poem":1},{"text":"by the abundance of Your loving devotion;","poem":2},{"text":"in reverence I will bow down","poem":1},{"text":"toward Your holy temple.","poem":2}]},{"number":8,"lines":[{"text":"Lead me, O LORD, in Your righteousness","poem":1},{"text":"because of my enemies;","poem":2},{"text":"make straight Your way before me.","poem":2}]},{"number":9,"lines":[{"text":"For not a word they speak can be trusted;","poem":1},{"text":"destruction lies within them.","poem":2},{"text":"Their throats are open graves;","poem":1},{"text":"their tongues practice deceit.","poem":2}]},{"number":10,"lines":[{"text":"Declare them guilty, O God;","poem":1},{"text":"let them fall by their own devices.","poem":2},{"text":"Drive them out for their many transgressions,","poem":1},{"text":"for they have rebelled against You.","poem":2}]},{"number":11,"lines":[{"text":"But let all who take refuge in You rejoice;","poem":1},{"text":"let them ever shout for joy.","poem":2},{"text":"May You shelter them,","poem":1},{"text":"that those who love Your name may rejoice in You.","poem":2}]},{"number":12,"lines":[{"text":"For surely You, O LORD, bless the righteous;","poem":1},{"text":"You surround them with the shield of Your favor.","poem":2}]}]},{"number":6,"lastVerse":10,"verses":[{"number":1,"lines":[{"text":"O LORD, do not rebuke me in Your anger","poem":1},{"text":"or discipline me in Your wrath.","poem":2}]},{"number":2,"lines":[{"text":"Be merciful to me, O LORD, for I am frail;","poem":1},{"text":"heal me, O LORD, for my bones are in agony.","poem":2}]},{"number":3,"lines":[{"text":"My soul is deeply distressed.","poem":1},{"text":"How long, O LORD, how long?","poem":2}]},{"number":4,"lines":[{"text":"Turn, O LORD, and deliver my soul;","poem":1},{"text":"save me because of Your loving devotion.","poem":2}]},{"number":5,"lines":[{"text":"For there is no mention of You in death;","poem":1},{"text":"who can praise You from Sheol?","poem":2}]},{"number":6,"lines":[{"text":"I am weary from groaning;","poem":1},{"text":"all night I flood my bed with weeping","poem":2},{"text":"and drench my couch with tears.","poem":2}]},{"number":7,"lines":[{"text":"My eyes fail from grief;","poem":1},{"text":"they grow dim because of all my foes.","poem":2}]},{"number":8,"lines":[{"text":"Depart from me, all you workers of iniquity,","poem":1},{"text":"for the LORD has heard my weeping.","poem":2}]},{"number":9,"lines":[{"text":"The LORD has heard my cry for mercy;","poem":1},{"text":"the LORD accepts my prayer.","poem":2}]},{"number":10,"lines":[{"text":"All my enemies will be ashamed and dismayed;","poem":1},{"text":"they will turn back in sudden disgrace.","poem":2}]}]},{"number":7,"lastVerse":17,"verses":[{"number":1,"lines":[{"text":"O LORD my God, I take refuge in You;","poem":1},{"text":"save me and deliver me from all my pursuers,","poem":2}]},{"number":2,"lines":[{"text":"or they will shred my soul like a lion","poem":1},{"text":"and tear me to pieces with no one to rescue me.","poem":2}]},{"number":3,"lines":[{"text":"O LORD my God, if I have done this,","poem":1},{"text":"if injustice is on my hands,","poem":2}]},{"number":4,"lines":[{"text":"if I have rewarded my ally with evil,","poem":1},{"text":"if I have plundered my foe without cause,","poem":2}]},{"number":5,"lines":[{"text":"then may my enemy pursue me and overtake me;","poem":1},{"text":"may he trample me to the ground","poem":2},{"text":"and leave my honor in the dust.","poem":2},{"text":"Selah"}]},{"number":6,"lines":[{"text":"Arise, O LORD, in Your anger;","poem":1},{"text":"rise up against the fury of my enemies.","poem":2},{"text":"Awake, my God, and ordain judgment.","poem":2}]},{"number":7,"lines":[{"text":"Let the assembled peoples gather around You;","poem":1},{"text":"take Your seat over them on high.","poem":2}]},{"number":8,"lines":[{"text":"The LORD judges the peoples;","poem":1},{"text":"vindicate me, O LORD,","poem":2},{"text":"according to my righteousness and integrity.","poem":2}]},{"number":9,"lines":[{"text":"Put an end to the evil of the wicked,","poem":1},{"text":"but establish the righteous,","poem":2},{"text":"O righteous God who searches hearts and minds.","poem":2}]},{"number":10,"lines":[{"text":"My shield is with God,","poem":1},{"text":"who saves the upright in heart.","poem":2}]},{"number":11,"lines":[{"text":"God is a righteous judge","poem":1},{"text":"and a God who feels indignation each day.","poem":2}]},{"number":12,"lines":[{"text":"If one does not repent,","poem":1},{"text":"God will sharpen His sword;","poem":2},{"text":"He has bent and strung His bow.","poem":2}]},{"number":13,"lines":[{"text":"He has prepared His deadly weapons;","poem":1},{"text":"He ordains His arrows with fire.","poem":2}]},{"number":14,"lines":[{"text":"Behold, the wicked man travails with evil;","poem":1},{"text":"he conceives trouble and births falsehood.","poem":2}]},{"number":15,"lines":[{"text":"He has dug a hole and hollowed it out;","poem":1},{"text":"he has fallen into a pit of his own making.","poem":2}]},{"number":16,"lines":[{"text":"His trouble recoils on himself,","poem":1},{"text":"and his violence falls on his own head.","poem":2}]},{"number":17,"lines":[{"text":"I will thank the LORD for His righteousness","poem":1},{"text":"and sing praise to the name of the LORD Most High.","poem":2}]}]},{"number":8,"lastVerse":9,"verses":[{"number":1,"lines":[{"text":"O LORD, our Lord,","poem":1},{"text":"how majestic is Your name in all the earth!","poem":2},{"text":"You have set Your glory","poem":1},{"text":"above the heavens.","poem":2}]},{"number":2,"lines":[{"text":"From the mouths of children and infants","poem":1},{"text":"You have ordained praise","poem":2},{"text":"on account of Your adversaries,","poem":1},{"text":"to silence the enemy and avenger.","poem":2}]},{"number":3,"lines":[{"text":"When I behold Your heavens,","poem":1},{"text":"the work of Your fingers,","poem":2},{"text":"the moon and the stars,","poem":1},{"text":"which You have set in place—","poem":2}]},{"number":4,"lines":[{"text":"what is man that You are mindful of him,","poem":1},{"text":"or the son of man that You care for him?","poem":2}]},{"number":5,"lines":[{"text":"You made him a little lower than the angels;","poem":1},{"text":"You crowned him with glory and honor.","poem":2}]},{"number":6,"lines":[{"text":"You made him ruler of the works of Your hands;","poem":1},{"text":"You have placed everything under his feet:","poem":2}]},{"number":7,"lines":[{"text":"all sheep and oxen,","poem":1},{"text":"and even the beasts of the field,","poem":2}]},{"number":8,"lines":[{"text":"the birds of the air and the fish of the sea,","poem":1},{"text":"all that swim the paths of the seas.","poem":2}]},{"number":9,"lines":[{"text":"O LORD, our Lord,","poem":1},{"text":"how majestic is Your name in all the earth!","poem":2}]}]},{"number":9,"lastVerse":20,"verses":[{"number":1,"lines":[{"text":"I will give thanks to the LORD with all my heart;","poem":1},{"text":"I will recount all Your wonders.","poem":2}]},{"number":2,"lines":[{"text":"I will be glad and rejoice in You;","poem":1},{"text":"I will sing praise to Your name, O Most High.","poem":2}]},{"number":3,"lines":[{"text":"When my enemies retreat,","poem":1},{"text":"they stumble and perish before You.","poem":2}]},{"number":4,"lines":[{"text":"For You have upheld my just cause;","poem":1},{"text":"You sit on Your throne judging righteously.","poem":2}]},{"number":5,"lines":[{"text":"You have rebuked the nations;","poem":1},{"text":"You have destroyed the wicked;","poem":2},{"text":"You have erased their name forever and ever.","poem":2}]},{"number":6,"lines":[{"text":"The enemy has come to eternal ruin,","poem":1},{"text":"and You have uprooted their cities;","poem":2},{"text":"the very memory of them has vanished.","poem":2}]},{"number":7,"lines":[{"text":"But the LORD abides forever;","poem":1},{"text":"He has established His throne for judgment.","poem":2}]},{"number":8,"lines":[{"text":"He judges the world with justice;","poem":1},{"text":"He governs the people with equity.","poem":2}]},{"number":9,"lines":[{"text":"The LORD is a refuge for the oppressed,","poem":1},{"text":"a stronghold in times of trouble.","poem":2}]},{"number":10,"lines":[{"text":"Those who know Your name trust in You,","poem":1},{"text":"for You, O LORD, have not forsaken those who seek You.","poem":2}]},{"number":11,"lines":[{"text":"Sing praises to the LORD, who dwells in Zion;","poem":1},{"text":"proclaim His deeds among the nations.","poem":2}]},{"number":12,"lines":[{"text":"For the Avenger of bloodshed remembers;","poem":1},{"text":"He does not ignore the cry of the afflicted.","poem":2}]},{"number":13,"lines":[{"text":"Be merciful to me, O LORD;","poem":1},{"text":"see how my enemies afflict me!","poem":2},{"text":"Lift me up from the gates of death,","poem":1}]},{"number":14,"lines":[{"text":"that I may declare all Your praises—","poem":2},{"text":"that within the gates of Daughter Zion","poem":1},{"text":"I may rejoice in Your salvation.","poem":2}]},{"number":15,"lines":[{"text":"The nations have fallen into a pit of their making;","poem":1},{"text":"their feet are caught in the net they have hidden.","poem":2}]},{"number":16,"lines":[{"text":"The LORD is known by the justice He brings;","poem":1},{"text":"the wicked are ensnared by the work of their hands.","poem":2},{"text":"Higgaion Selah"}]},{"number":17,"lines":[{"text":"The wicked will return to Sheol—","poem":1},{"text":"all the nations who forget God.","poem":2}]},{"number":18,"lines":[{"text":"For the needy will not always be forgotten;","poem":1},{"text":"nor the hope of the oppressed forever dashed.","poem":2}]},{"number":19,"lines":[{"text":"Rise up, O LORD, do not let man prevail;","poem":1},{"text":"let the nations be judged in Your presence.","poem":2}]},{"number":20,"lines":[{"text":"Lay terror upon them, O LORD;","poem":1},{"text":"let the nations know they are but men.","poem":2},{"text":"Selah"}]}]},{"number":10,"lastVerse":18,"verses":[{"number":1,"lines":[{"text":"Why, O LORD, do You stand far off?","poem":1},{"text":"Why do You hide in times of trouble?","poem":2}]},{"number":2,"lines":[{"text":"In pride the wicked pursue the needy;","poem":1},{"text":"let them be caught in the schemes they devise.","poem":2}]},{"number":3,"lines":[{"text":"For the wicked man boasts in the cravings of his heart;","poem":1},{"text":"he blesses the greedy and reviles the LORD.","poem":2}]},{"number":4,"lines":[{"text":"In his pride the wicked man does not seek Him;","poem":1},{"text":"in all his schemes there is no God.","poem":2}]},{"number":5,"lines":[{"text":"He is secure in his ways at all times;","poem":1},{"text":"Your lofty judgments are far from him;","poem":2},{"text":"he sneers at all his foes.","poem":2}]},{"number":6,"lines":[{"text":"He says to himself, “I will not be moved;","poem":1},{"text":"from age to age I am free of distress.”","poem":2}]},{"number":7,"lines":[{"text":"His mouth is full of cursing, deceit, and violence;","poem":1},{"text":"trouble and malice are under his tongue.","poem":2}]},{"number":8,"lines":[{"text":"He lies in wait near the villages;","poem":1},{"text":"in ambush he slays the innocent;","poem":2},{"text":"his eyes watch in stealth for the helpless.","poem":2}]},{"number":9,"lines":[{"text":"He lies in wait like a lion in a thicket;","poem":1},{"text":"he lurks to seize the oppressed;","poem":2},{"text":"he catches the lowly in his net.","poem":2}]},{"number":10,"lines":[{"text":"They are crushed and beaten down;","poem":1},{"text":"the helpless fall prey to his strength.","poem":2}]},{"number":11,"lines":[{"text":"He says to himself, “God has forgotten;","poem":1},{"text":"He hides His face and never sees.”","poem":2}]},{"number":12,"lines":[{"text":"Arise, O LORD! Lift up Your hand, O God!","poem":1},{"text":"Do not forget the helpless.","poem":2}]},{"number":13,"lines":[{"text":"Why has the wicked man renounced God?","poem":1},{"text":"He says to himself, “You will never call me to account.”","poem":2}]},{"number":14,"lines":[{"text":"But You have regarded trouble and grief;","poem":1},{"text":"You see to repay it by Your hand.","poem":2},{"text":"The victim entrusts himself to You;","poem":1},{"text":"You are the helper of the fatherless.","poem":2}]},{"number":15,"lines":[{"text":"Break the arm of the wicked and evildoer;","poem":1},{"text":"call him to account for his wickedness","poem":2},{"text":"until none is left to be found.","poem":2}]},{"number":16,"lines":[{"text":"The LORD is King forever and ever;","poem":1},{"text":"the nations perish from His land.","poem":2}]},{"number":17,"lines":[{"text":"You have heard, O LORD, the desire of the humble;","poem":1},{"text":"You will strengthen their hearts.","poem":2},{"text":"You will incline Your ear,","poem":1}]},{"number":18,"lines":[{"text":"to vindicate the fatherless and oppressed,","poem":2},{"text":"that the men of the earth","poem":1},{"text":"may strike terror no more.","poem":2}]}]},{"number":11,"lastVerse":7,"verses":[{"number":1,"lines":[{"text":"In the LORD I take refuge.","poem":1},{"text":"How then can you say to me:","poem":2},{"text":"“Flee like a bird to your mountain!","poem":1}]},{"number":2,"lines":[{"text":"For behold, the wicked bend their bows.","poem":2},{"text":"They set their arrow on the string","poem":1},{"text":"to shoot from the shadows at the upright in heart.","poem":2}]},{"number":3,"lines":[{"text":"If the foundations are destroyed,","poem":1},{"text":"what can the righteous do?”","poem":2}]},{"number":4,"lines":[{"text":"The LORD is in His holy temple;","poem":1},{"text":"the LORD is on His heavenly throne.","poem":2},{"text":"His eyes are watching closely;","poem":1},{"text":"they examine the sons of men.","poem":2}]},{"number":5,"lines":[{"text":"The LORD tests the righteous and the wicked;","poem":1},{"text":"His soul hates the lover of violence.","poem":2}]},{"number":6,"lines":[{"text":"On the wicked He will rain down fiery coals and sulfur;","poem":1},{"text":"a scorching wind will be their portion.","poem":2}]},{"number":7,"lines":[{"text":"For the LORD is righteous; He loves justice.","poem":1},{"text":"The upright will see His face.","poem":2}]}]},{"number":12,"lastVerse":8,"verses":[{"number":1,"lines":[{"text":"Help, O LORD, for the godly are no more;","poem":1},{"text":"the faithful have vanished from among men.","poem":2}]},{"number":2,"lines":[{"text":"They lie to one another;","poem":1},{"text":"they speak with flattering lips and a double heart.","poem":2}]},{"number":3,"lines":[{"text":"May the LORD cut off all flattering lips","poem":1},{"text":"and every boastful tongue.","poem":2}]},{"number":4,"lines":[{"text":"They say, “With our tongues we will prevail.","poem":1},{"text":"We own our lips—who can be our master?”","poem":2}]},{"number":5,"lines":[{"text":"“For the cause of the oppressed","poem":1},{"text":"and for the groaning of the needy,","poem":2},{"text":"I will now arise,” says the LORD.","poem":1},{"text":"“I will bring safety to him who yearns.”","poem":2}]},{"number":6,"lines":[{"text":"The words of the LORD are flawless,","poem":1},{"text":"like silver refined in a furnace,","poem":2},{"text":"like gold purified sevenfold.","poem":2}]},{"number":7,"lines":[{"text":"You, O LORD, will keep us;","poem":1},{"text":"You will forever guard us from this generation.","poem":2}]},{"number":8,"lines":[{"text":"The wicked wander freely,","poem":1},{"text":"and vileness is exalted among men.","poem":2}]}]},{"number":13,"lastVerse":6,"verses":[{"number":1,"lines":[{"text":"How long, O LORD?","poem":1},{"text":"Will You forget me forever?","poem":2},{"text":"How long will You hide Your face from me?","poem":2}]},{"number":2,"lines":[{"text":"How long must I wrestle in my soul,","poem":1},{"text":"with sorrow in my heart each day?","poem":2},{"text":"How long will my enemy dominate me?","poem":2}]},{"number":3,"lines":[{"text":"Consider me and respond, O LORD my God.","poem":1},{"text":"Give light to my eyes, lest I sleep in death,","poem":2}]},{"number":4,"lines":[{"text":"lest my enemy say, “I have overcome him,”","poem":1},{"text":"and my foes rejoice when I fall.","poem":2}]},{"number":5,"lines":[{"text":"But I have trusted in Your loving devotion;","poem":1},{"text":"my heart will rejoice in Your salvation.","poem":2}]},{"number":6,"lines":[{"text":"I will sing to the LORD,","poem":1},{"text":"for He has been good to me.","poem":2}]}]},{"number":14,"lastVerse":7,"verses":[{"number":1,"lines":[{"text":"The fool says in his heart,","poem":1},{"text":"“There is no God.”","poem":2},{"text":"They are corrupt; their acts are vile.","poem":1},{"text":"There is no one who does good.","poem":2}]},{"number":2,"lines":[{"text":"The LORD looks down from heaven","poem":1},{"text":"upon the sons of men","poem":2},{"text":"to see if any understand,","poem":1},{"text":"if any seek God.","poem":2}]},{"number":3,"lines":[{"text":"All have turned away,","poem":1},{"text":"they have together become corrupt;","poem":2},{"text":"there is no one who does good,","poem":1},{"text":"not even one.","poem":2}]},{"number":4,"lines":[{"text":"Will the workers of iniquity never learn?","poem":1},{"text":"They devour my people like bread;","poem":1},{"text":"they refuse to call upon the LORD.","poem":2}]},{"number":5,"lines":[{"text":"There they are, overwhelmed with dread,","poem":1},{"text":"for God is in the company of the righteous.","poem":2}]},{"number":6,"lines":[{"text":"You sinners frustrate the plans of the oppressed,","poem":1},{"text":"yet the LORD is their shelter.","poem":2}]},{"number":7,"lines":[{"text":"Oh, that the salvation of Israel would come from Zion!","poem":1},{"text":"When the LORD restores His captive people,","poem":1},{"text":"let Jacob rejoice, let Israel be glad!","poem":2}]}]},{"number":15,"lastVerse":5,"verses":[{"number":1,"lines":[{"text":"O LORD, who may abide in Your tent?","poem":1},{"text":"Who may dwell on Your holy mountain?","poem":2}]},{"number":2,"lines":[{"text":"He who walks with integrity","poem":1},{"text":"and practices righteousness,","poem":2},{"text":"who speaks the truth from his heart,","poem":2}]},{"number":3,"lines":[{"text":"who has no slander on his tongue,","poem":1},{"text":"who does no harm to his neighbor,","poem":2},{"text":"who casts no scorn on his friend,","poem":2}]},{"number":4,"lines":[{"text":"who despises the vile","poem":1},{"text":"but honors those who fear the LORD,","poem":2},{"text":"who does not revise a costly oath,","poem":2}]},{"number":5,"lines":[{"text":"who lends his money without interest","poem":1},{"text":"and refuses a bribe against the innocent.","poem":2},{"text":"He who does these things","poem":1},{"text":"will never be shaken.","poem":2}]}]},{"number":16,"lastVerse":11,"verses":[{"number":1,"lines":[{"text":"Preserve me, O God,","poem":1},{"text":"for in You I take refuge.","poem":2}]},{"number":2,"lines":[{"text":"I said to the LORD, “You are my Lord;","poem":1},{"text":"apart from You I have no good thing.”","poem":2}]},{"number":3,"lines":[{"text":"As for the saints in the land,","poem":1},{"text":"they are the excellence","poem":2},{"text":"in whom all my delight resides.","poem":2}]},{"number":4,"lines":[{"text":"Sorrows will multiply","poem":1},{"text":"to those who chase other gods.","poem":2},{"text":"I will not pour out their libations of blood,","poem":1},{"text":"or speak their names with my lips.","poem":2}]},{"number":5,"lines":[{"text":"The LORD is my chosen portion and my cup;","poem":1},{"text":"You have made my lot secure.","poem":2}]},{"number":6,"lines":[{"text":"The lines of my boundary have fallen in pleasant places;","poem":1},{"text":"surely my inheritance is delightful.","poem":2}]},{"number":7,"lines":[{"text":"I will bless the LORD who counsels me;","poem":1},{"text":"even at night my conscience instructs me.","poem":2}]},{"number":8,"lines":[{"text":"I have set the LORD always before me.","poem":1},{"text":"Because He is at my right hand, I will not be shaken.","poem":2}]},{"number":9,"lines":[{"text":"Therefore my heart is glad and my tongue rejoices;","poem":1},{"text":"my body also will dwell securely.","poem":2}]},{"number":10,"lines":[{"text":"For You will not abandon my soul to Sheol,","poem":1},{"text":"nor will You let Your Holy One see decay.","poem":2}]},{"number":11,"lines":[{"text":"You have made known to me the path of life;","poem":1},{"text":"You will fill me with joy in Your presence,","poem":2},{"text":"with eternal pleasures at Your right hand.","poem":2}]}]},{"number":17,"lastVerse":15,"verses":[{"number":1,"lines":[{"text":"Hear, O LORD, my righteous plea;","poem":1},{"text":"listen to my cry.","poem":2},{"text":"Give ear to my prayer—","poem":1},{"text":"it comes from lips free of deceit.","poem":2}]},{"number":2,"lines":[{"text":"May my vindication come from Your presence;","poem":1},{"text":"may Your eyes see what is right.","poem":2}]},{"number":3,"lines":[{"text":"You have tried my heart;","poem":1},{"text":"You have visited me in the night.","poem":2},{"text":"You have tested me and found no evil;","poem":1},{"text":"I have resolved not to sin with my mouth.","poem":2}]},{"number":4,"lines":[{"text":"As for the deeds of men—","poem":1},{"text":"by the word of Your lips","poem":2},{"text":"I have avoided the ways of the violent.","poem":2}]},{"number":5,"lines":[{"text":"My steps have held to Your paths;","poem":1},{"text":"my feet have not slipped.","poem":2}]},{"number":6,"lines":[{"text":"I call on You, O God,","poem":1},{"text":"for You will answer me.","poem":2},{"text":"Incline Your ear to me;","poem":1},{"text":"hear my words.","poem":2}]},{"number":7,"lines":[{"text":"Show the wonders of Your loving devotion,","poem":1},{"text":"You who save by Your right hand","poem":2},{"text":"those who seek refuge from their foes.","poem":2}]},{"number":8,"lines":[{"text":"Keep me as the apple of Your eye;","poem":1},{"text":"hide me in the shadow of Your wings","poem":2}]},{"number":9,"lines":[{"text":"from the wicked who assail me,","poem":1},{"text":"from my mortal enemies who surround me.","poem":2}]},{"number":10,"lines":[{"text":"They have closed their callous hearts;","poem":1},{"text":"their mouths speak with arrogance.","poem":2}]},{"number":11,"lines":[{"text":"They have tracked us down, and now surround us;","poem":1},{"text":"their eyes are set to cast us to the ground,","poem":2}]},{"number":12,"lines":[{"text":"like a lion greedy for prey,","poem":1},{"text":"like a young lion lurking in ambush.","poem":2}]},{"number":13,"lines":[{"text":"Arise, O LORD, confront them!","poem":1},{"text":"Bring them to their knees;","poem":2},{"text":"deliver me from the wicked by Your sword,","poem":1}]},{"number":14,"lines":[{"text":"from such men, O LORD, by Your hand—","poem":2},{"text":"from men of the world","poem":1},{"text":"whose portion is in this life.","poem":2},{"text":"May You fill the bellies of Your treasured ones and satisfy their sons,","poem":1},{"text":"so they leave their abundance to their children.","poem":2}]},{"number":15,"lines":[{"text":"As for me, I will behold Your face in righteousness;","poem":1},{"text":"when I awake, I will be satisfied in Your presence.","poem":2}]}]},{"number":18,"lastVerse":50,"verses":[{"number":1,"lines":[{"text":"I love You, O LORD, my strength.","poem":1}]},{"number":2,"lines":[{"text":"The LORD is my rock, my fortress, and my deliverer.","poem":1},{"text":"My God is my rock, in whom I take refuge,","poem":2},{"text":"my shield, and the horn of my salvation,","poem":1},{"text":"my stronghold.","poem":2}]},{"number":3,"lines":[{"text":"I will call upon the LORD, who is worthy to be praised;","poem":1},{"text":"so shall I be saved from my enemies.","poem":2}]},{"number":4,"lines":[{"text":"The cords of death encompassed me;","poem":1},{"text":"the torrents of chaos overwhelmed me.","poem":2}]},{"number":5,"lines":[{"text":"The cords of Sheol entangled me;","poem":1},{"text":"the snares of death confronted me.","poem":2}]},{"number":6,"lines":[{"text":"In my distress I called upon the LORD;","poem":1},{"text":"I cried to my God for help.","poem":2},{"text":"From His temple He heard my voice,","poem":1},{"text":"and my cry for His help reached His ears.","poem":2}]},{"number":7,"lines":[{"text":"Then the earth shook and quaked,","poem":1},{"text":"and the foundations of the mountains trembled;","poem":2},{"text":"they were shaken because He burned with anger.","poem":2}]},{"number":8,"lines":[{"text":"Smoke rose from His nostrils,","poem":1},{"text":"and consuming fire came from His mouth;","poem":2},{"text":"glowing coals blazed forth.","poem":2}]},{"number":9,"lines":[{"text":"He parted the heavens and came down","poem":1},{"text":"with dark clouds beneath His feet.","poem":2}]},{"number":10,"lines":[{"text":"He mounted a cherub and flew;","poem":1},{"text":"He soared on the wings of the wind.","poem":2}]},{"number":11,"lines":[{"text":"He made darkness His hiding place,","poem":1},{"text":"and storm clouds a canopy around Him.","poem":2}]},{"number":12,"lines":[{"text":"From the brightness of His presence","poem":1},{"text":"His clouds advanced—","poem":2},{"text":"hailstones and coals of fire.","poem":2}]},{"number":13,"lines":[{"text":"The LORD thundered from heaven;","poem":1},{"text":"the voice of the Most High resounded—","poem":2},{"text":"hailstones and coals of fire.","poem":2}]},{"number":14,"lines":[{"text":"He shot His arrows and scattered the foes;","poem":1},{"text":"He hurled lightning and routed them.","poem":2}]},{"number":15,"lines":[{"text":"The channels of the sea appeared,","poem":1},{"text":"and the foundations of the world were exposed,","poem":2},{"text":"at Your rebuke, O LORD,","poem":1},{"text":"at the blast of the breath of Your nostrils.","poem":2}]},{"number":16,"lines":[{"text":"He reached down from on high and took hold of me;","poem":1},{"text":"He drew me out of deep waters.","poem":2}]},{"number":17,"lines":[{"text":"He rescued me from my powerful enemy,","poem":1},{"text":"from foes too mighty for me.","poem":2}]},{"number":18,"lines":[{"text":"They confronted me in my day of calamity,","poem":1},{"text":"but the LORD was my support.","poem":2}]},{"number":19,"lines":[{"text":"He brought me out into the open;","poem":1},{"text":"He rescued me because He delighted in me.","poem":2}]},{"number":20,"lines":[{"text":"The LORD has rewarded me according to my righteousness;","poem":1},{"text":"He has repaid me according to the cleanness of my hands.","poem":2}]},{"number":21,"lines":[{"text":"For I have kept the ways of the LORD","poem":1},{"text":"and have not wickedly departed from my God.","poem":2}]},{"number":22,"lines":[{"text":"For all His ordinances are before me;","poem":1},{"text":"I have not disregarded His statutes.","poem":2}]},{"number":23,"lines":[{"text":"And I have been blameless before Him","poem":1},{"text":"and kept myself from iniquity.","poem":2}]},{"number":24,"lines":[{"text":"So the LORD has repaid me according to my righteousness,","poem":1},{"text":"according to the cleanness of my hands in His sight.","poem":2}]},{"number":25,"lines":[{"text":"To the faithful You show Yourself faithful,","poem":1},{"text":"to the blameless You show Yourself blameless;","poem":2}]},{"number":26,"lines":[{"text":"to the pure You show Yourself pure,","poem":1},{"text":"but to the crooked You show Yourself shrewd.","poem":2}]},{"number":27,"lines":[{"text":"For You save an afflicted people,","poem":1},{"text":"but You humble those with haughty eyes.","poem":2}]},{"number":28,"lines":[{"text":"For You, O LORD, light my lamp;","poem":1},{"text":"my God lights up my darkness.","poem":2}]},{"number":29,"lines":[{"text":"For in You I can charge an army,","poem":1},{"text":"and with my God I can scale a wall.","poem":2}]},{"number":30,"lines":[{"text":"As for God, His way is perfect;","poem":1},{"text":"the word of the LORD is flawless.","poem":2},{"text":"He is a shield to all who take refuge in Him.","poem":2}]},{"number":31,"lines":[{"text":"For who is God besides the LORD?","poem":1},{"text":"And who is the Rock except our God?","poem":2}]},{"number":32,"lines":[{"text":"It is God who arms me with strength","poem":1},{"text":"and makes my way clear.","poem":2}]},{"number":33,"lines":[{"text":"He makes my feet like those of a deer","poem":1},{"text":"and stations me upon the heights.","poem":2}]},{"number":34,"lines":[{"text":"He trains my hands for battle;","poem":1},{"text":"my arms can bend a bow of bronze.","poem":2}]},{"number":35,"lines":[{"text":"You have given me Your shield of salvation;","poem":1},{"text":"Your right hand upholds me,","poem":2},{"text":"and Your gentleness exalts me.","poem":2}]},{"number":36,"lines":[{"text":"You broaden the path beneath me","poem":1},{"text":"so that my ankles do not give way.","poem":2}]},{"number":37,"lines":[{"text":"I pursued my enemies and overtook them;","poem":1},{"text":"I did not turn back until they were consumed.","poem":2}]},{"number":38,"lines":[{"text":"I crushed them so they could not rise;","poem":1},{"text":"they have fallen under my feet.","poem":2}]},{"number":39,"lines":[{"text":"You have armed me with strength for battle;","poem":1},{"text":"You have subdued my foes beneath me.","poem":2}]},{"number":40,"lines":[{"text":"You have made my enemies retreat before me;","poem":1},{"text":"I destroyed those who hated me.","poem":2}]},{"number":41,"lines":[{"text":"They cried for help, but there was no one to save them—","poem":1},{"text":"to the LORD, but He did not answer.","poem":2}]},{"number":42,"lines":[{"text":"I ground them as dust in the face of the wind;","poem":1},{"text":"I trampled them like mud in the streets.","poem":2}]},{"number":43,"lines":[{"text":"You have delivered me from the strife of the people;","poem":1},{"text":"You have made me the head of nations;","poem":2},{"text":"a people I had not known shall serve me.","poem":2}]},{"number":44,"lines":[{"text":"When they hear me, they obey me;","poem":1},{"text":"foreigners cower before me.","poem":2}]},{"number":45,"lines":[{"text":"Foreigners lose heart","poem":1},{"text":"and come trembling from their strongholds.","poem":2}]},{"number":46,"lines":[{"text":"The LORD lives, and blessed be my Rock!","poem":1},{"text":"And may the God of my salvation be exalted—","poem":2}]},{"number":47,"lines":[{"text":"the God who avenges me","poem":1},{"text":"and subdues nations beneath me,","poem":2}]},{"number":48,"lines":[{"text":"who delivers me from my enemies.","poem":2},{"text":"You exalt me above my foes;","poem":1},{"text":"You rescue me from violent men.","poem":2}]},{"number":49,"lines":[{"text":"Therefore I will praise You, O LORD, among the nations;","poem":1},{"text":"I will sing praises to Your name.","poem":2}]},{"number":50,"lines":[{"text":"Great salvation He brings to His king.","poem":1},{"text":"He shows loving devotion to His anointed,","poem":2},{"text":"to David and his descendants forever.","poem":2}]}]},{"number":19,"lastVerse":14,"verses":[{"number":1,"lines":[{"text":"The heavens declare the glory of God;","poem":1},{"text":"the skies proclaim the work of His hands.","poem":2}]},{"number":2,"lines":[{"text":"Day after day they pour forth speech;","poem":1},{"text":"night after night they reveal knowledge.","poem":2}]},{"number":3,"lines":[{"text":"Without speech or language,","poem":1},{"text":"without a sound to be heard,","poem":2}]},{"number":4,"lines":[{"text":"their voice has gone out into all the earth,","poem":1},{"text":"their words to the ends of the world.","poem":2},{"text":"In the heavens He has pitched","poem":1},{"text":"a tent for the sun.","poem":2}]},{"number":5,"lines":[{"text":"Like a bridegroom emerging from his chamber,","poem":1},{"text":"like a champion rejoicing to run his course,","poem":2}]},{"number":6,"lines":[{"text":"it rises at one end of the heavens","poem":1},{"text":"and runs its circuit to the other;","poem":2},{"text":"nothing is deprived of its warmth.","poem":2}]},{"number":7,"lines":[{"text":"The Law of the LORD is perfect,","poem":1},{"text":"reviving the soul;","poem":2},{"text":"the testimony of the LORD is trustworthy,","poem":1},{"text":"making wise the simple.","poem":2}]},{"number":8,"lines":[{"text":"The precepts of the LORD are right,","poem":1},{"text":"bringing joy to the heart;","poem":2},{"text":"the commandments of the LORD are radiant,","poem":1},{"text":"giving light to the eyes.","poem":2}]},{"number":9,"lines":[{"text":"The fear of the LORD is pure,","poem":1},{"text":"enduring forever;","poem":2},{"text":"the judgments of the LORD are true,","poem":1},{"text":"being altogether righteous.","poem":2}]},{"number":10,"lines":[{"text":"They are more precious than gold,","poem":1},{"text":"than much pure gold;","poem":2},{"text":"they are sweeter than honey,","poem":1},{"text":"than honey from the comb.","poem":2}]},{"number":11,"lines":[{"text":"By them indeed Your servant is warned;","poem":1},{"text":"in keeping them is great reward.","poem":2}]},{"number":12,"lines":[{"text":"Who can discern his own errors?","poem":1},{"text":"Cleanse me from my hidden faults.","poem":2}]},{"number":13,"lines":[{"text":"Keep Your servant also from willful sins;","poem":1},{"text":"may they not rule over me.","poem":2},{"text":"Then I will be blameless","poem":1},{"text":"and cleansed of great transgression.","poem":2}]},{"number":14,"lines":[{"text":"May the words of my mouth","poem":1},{"text":"and the meditation of my heart","poem":2},{"text":"be pleasing in Your sight,","poem":1},{"text":"O LORD, my Rock and my Redeemer.","poem":2}]}]},{"number":20,"lastVerse":9,"verses":[{"number":1,"lines":[{"text":"May the LORD answer you in the day of trouble;","poem":1},{"text":"may the name of the God of Jacob protect you.","poem":2}]},{"number":2,"lines":[{"text":"May He send you help from the sanctuary","poem":1},{"text":"and sustain you from Zion.","poem":2}]},{"number":3,"lines":[{"text":"May He remember all your gifts","poem":1},{"text":"and look favorably on your burnt offerings.","poem":2},{"text":"Selah"}]},{"number":4,"lines":[{"text":"May He give you the desires of your heart","poem":1},{"text":"and make all your plans succeed.","poem":2}]},{"number":5,"lines":[{"text":"May we shout for joy at your victory","poem":1},{"text":"and raise a banner in the name of our God.","poem":2},{"text":"May the LORD grant all your petitions.","poem":2}]},{"number":6,"lines":[{"text":"Now I know that the LORD saves His anointed;","poem":1},{"text":"He answers him from His holy heaven","poem":2},{"text":"with the saving power of His right hand.","poem":2}]},{"number":7,"lines":[{"text":"Some trust in chariots and others in horses,","poem":1},{"text":"but we trust in the name of the LORD our God.","poem":2}]},{"number":8,"lines":[{"text":"They collapse and fall,","poem":1},{"text":"but we rise up and stand firm.","poem":2}]},{"number":9,"lines":[{"text":"O LORD, save the king.","poem":1},{"text":"Answer us on the day we call.","poem":2}]}]},{"number":21,"lastVerse":13,"verses":[{"number":1,"lines":[{"text":"O LORD, the king rejoices in Your strength.","poem":1},{"text":"How greatly he exults in Your salvation!","poem":2}]},{"number":2,"lines":[{"text":"You have granted his heart’s desire","poem":1},{"text":"and have not withheld the request of his lips.","poem":2},{"text":"Selah"}]},{"number":3,"lines":[{"text":"For You welcomed him with rich blessings;","poem":1},{"text":"You placed on his head a crown of pure gold.","poem":2}]},{"number":4,"lines":[{"text":"He asked You for life, and You granted it—","poem":1},{"text":"length of days, forever and ever.","poem":2}]},{"number":5,"lines":[{"text":"Great is his glory in Your salvation;","poem":1},{"text":"You bestow on him splendor and majesty.","poem":2}]},{"number":6,"lines":[{"text":"For You grant him blessings forever;","poem":1},{"text":"You cheer him with joy in Your presence.","poem":2}]},{"number":7,"lines":[{"text":"For the king trusts in the LORD;","poem":1},{"text":"through the loving devotion of the Most High,","poem":2},{"text":"he will not be shaken.","poem":2}]},{"number":8,"lines":[{"text":"Your hand will apprehend all Your enemies;","poem":1},{"text":"Your right hand will seize those who hate You.","poem":2}]},{"number":9,"lines":[{"text":"You will place them in a fiery furnace","poem":1},{"text":"at the time of Your appearing.","poem":2},{"text":"In His wrath the LORD will engulf them,","poem":1},{"text":"and the fire will consume them.","poem":2}]},{"number":10,"lines":[{"text":"You will wipe their descendants from the earth,","poem":1},{"text":"and their offspring from the sons of men.","poem":2}]},{"number":11,"lines":[{"text":"Though they intend You harm,","poem":1},{"text":"the schemes they devise will not prevail.","poem":2}]},{"number":12,"lines":[{"text":"For You will put them to flight","poem":1},{"text":"when Your bow is trained upon them.","poem":2}]},{"number":13,"lines":[{"text":"Be exalted, O LORD, in Your strength;","poem":1},{"text":"we will sing and praise Your power.","poem":2}]}]},{"number":22,"lastVerse":31,"verses":[{"number":1,"lines":[{"text":"My God, my God,","poem":1},{"text":"why have You forsaken me?","poem":2},{"text":"Why are You so far from saving me,","poem":1},{"text":"so far from my words of groaning?","poem":2}]},{"number":2,"lines":[{"text":"I cry out by day, O my God,","poem":1},{"text":"but You do not answer,","poem":2},{"text":"and by night,","poem":1},{"text":"but I have no rest.","poem":2}]},{"number":3,"lines":[{"text":"Yet You are holy,","poem":1},{"text":"enthroned on the praises of Israel.","poem":2}]},{"number":4,"lines":[{"text":"In You our fathers trusted;","poem":1},{"text":"they trusted and You delivered them.","poem":2}]},{"number":5,"lines":[{"text":"They cried out to You and were set free;","poem":1},{"text":"they trusted in You and were not disappointed.","poem":2}]},{"number":6,"lines":[{"text":"But I am a worm and not a man,","poem":1},{"text":"scorned by men and despised by the people.","poem":2}]},{"number":7,"lines":[{"text":"All who see me mock me;","poem":1},{"text":"they sneer and shake their heads:","poem":2}]},{"number":8,"lines":[{"text":"“He trusts in the LORD,","poem":1},{"text":"let the LORD deliver him;","poem":2},{"text":"let the LORD rescue him,","poem":1},{"text":"since He delights in him.”","poem":2}]},{"number":9,"lines":[{"text":"Yet You brought me forth from the womb;","poem":1},{"text":"You made me secure at my mother’s breast.","poem":2}]},{"number":10,"lines":[{"text":"From birth I was cast upon You;","poem":1},{"text":"from my mother’s womb You have been my God.","poem":2}]},{"number":11,"lines":[{"text":"Be not far from me,","poem":1},{"text":"for trouble is near","poem":2},{"text":"and there is no one to help.","poem":2}]},{"number":12,"lines":[{"text":"Many bulls surround me;","poem":1},{"text":"strong bulls of Bashan encircle me.","poem":2}]},{"number":13,"lines":[{"text":"They open their jaws against me","poem":1},{"text":"like lions that roar and maul.","poem":2}]},{"number":14,"lines":[{"text":"I am poured out like water,","poem":1},{"text":"and all my bones are disjointed.","poem":2},{"text":"My heart is like wax;","poem":1},{"text":"it melts away within me.","poem":2}]},{"number":15,"lines":[{"text":"My strength is dried up like a potsherd,","poem":1},{"text":"and my tongue sticks to the roof of my mouth.","poem":2},{"text":"You lay me in the dust of death.","poem":2}]},{"number":16,"lines":[{"text":"For dogs surround me;","poem":1},{"text":"a band of evil men encircles me;","poem":2},{"text":"they have pierced my hands and feet.","poem":2}]},{"number":17,"lines":[{"text":"I can count all my bones;","poem":1},{"text":"they stare and gloat over me.","poem":2}]},{"number":18,"lines":[{"text":"They divide my garments among them","poem":1},{"text":"and cast lots for my clothing.","poem":2}]},{"number":19,"lines":[{"text":"But You, O LORD, be not far off;","poem":1},{"text":"O my Strength, come quickly to help me.","poem":2}]},{"number":20,"lines":[{"text":"Deliver my soul from the sword,","poem":1},{"text":"my precious life from the power of wild dogs.","poem":2}]},{"number":21,"lines":[{"text":"Save me from the mouth of the lion;","poem":1},{"text":"at the horns of the wild oxen You have answered me!","poem":2}]},{"number":22,"lines":[{"text":"I will proclaim Your name to my brothers;","poem":1},{"text":"I will praise You in the assembly.","poem":2}]},{"number":23,"lines":[{"text":"You who fear the LORD, praise Him!","poem":1},{"text":"All descendants of Jacob, honor Him!","poem":2},{"text":"All offspring of Israel, revere Him!","poem":2}]},{"number":24,"lines":[{"text":"For He has not despised or detested","poem":1},{"text":"the torment of the afflicted.","poem":2},{"text":"He has not hidden His face from him,","poem":1},{"text":"but has attended to his cry for help.","poem":2}]},{"number":25,"lines":[{"text":"My praise for You resounds in the great assembly;","poem":1},{"text":"I will fulfill my vows before those who fear You.","poem":2}]},{"number":26,"lines":[{"text":"The poor will eat and be satisfied;","poem":1},{"text":"those who seek the LORD will praise Him.","poem":2},{"text":"May your hearts live forever!","poem":2}]},{"number":27,"lines":[{"text":"All the ends of the earth","poem":1},{"text":"will remember and turn to the LORD.","poem":2},{"text":"All the families of the nations","poem":1},{"text":"will bow down before Him.","poem":2}]},{"number":28,"lines":[{"text":"For dominion belongs to the LORD","poem":1},{"text":"and He rules over the nations.","poem":2}]},{"number":29,"lines":[{"text":"All the rich of the earth will feast and worship;","poem":1},{"text":"all who go down to the dust will kneel before Him—","poem":2},{"text":"even those unable to preserve their lives.","poem":2}]},{"number":30,"lines":[{"text":"Posterity will serve Him;","poem":1},{"text":"they will declare the Lord to a new generation.","poem":2}]},{"number":31,"lines":[{"text":"They will come and proclaim His righteousness","poem":1},{"text":"to a people yet unborn—","poem":2},{"text":"all that He has done.","poem":2}]}]},{"number":23,"lastVerse":6,"verses":[{"number":1,"lines":[{"text":"The LORD is my shepherd;","poem":1},{"text":"I shall not want.","poem":2}]},{"number":2,"lines":[{"text":"He makes me lie down in green pastures;","poem":1},{"text":"He leads me beside quiet waters.","poem":2}]},{"number":3,"lines":[{"text":"He restores my soul;","poem":1},{"text":"He guides me in the paths of righteousness","poem":2},{"text":"for the sake of His name.","poem":2}]},{"number":4,"lines":[{"text":"Even though I walk through the valley of the shadow of death,","poem":1},{"text":"I will fear no evil,","poem":2},{"text":"for You are with me;","poem":1},{"text":"Your rod and Your staff, they comfort me.","poem":2}]},{"number":5,"lines":[{"text":"You prepare a table before me","poem":1},{"text":"in the presence of my enemies.","poem":2},{"text":"You anoint my head with oil;","poem":1},{"text":"my cup overflows.","poem":2}]},{"number":6,"lines":[{"text":"Surely goodness and mercy will follow me","poem":1},{"text":"all the days of my life,","poem":2},{"text":"and I will dwell in the house of the LORD","poem":1},{"text":"forever.","poem":2}]}]},{"number":24,"lastVerse":10,"verses":[{"number":1,"lines":[{"text":"The earth is the LORD’s, and the fullness thereof,","poem":1},{"text":"the world and all who dwell therein.","poem":2}]},{"number":2,"lines":[{"text":"For He has founded it upon the seas","poem":1},{"text":"and established it upon the waters.","poem":2}]},{"number":3,"lines":[{"text":"Who may ascend the hill of the LORD?","poem":1},{"text":"Who may stand in His holy place?","poem":2}]},{"number":4,"lines":[{"text":"He who has clean hands and a pure heart,","poem":1},{"text":"who does not lift up his soul to an idol","poem":2},{"text":"or swear deceitfully.","poem":2}]},{"number":5,"lines":[{"text":"He will receive blessing from the LORD","poem":1},{"text":"and vindication from the God of his salvation.","poem":2}]},{"number":6,"lines":[{"text":"Such is the generation of those who seek Him,","poem":1},{"text":"who seek Your face, O God of Jacob.","poem":2},{"text":"Selah"}]},{"number":7,"lines":[{"text":"Lift up your heads, O gates!","poem":1},{"text":"Be lifted up, O ancient doors,","poem":2},{"text":"that the King of Glory may enter!","poem":2}]},{"number":8,"lines":[{"text":"Who is this King of Glory?","poem":1},{"text":"The LORD strong and mighty,","poem":2},{"text":"the LORD mighty in battle.","poem":2}]},{"number":9,"lines":[{"text":"Lift up your heads, O gates!","poem":1},{"text":"Be lifted up, O ancient doors,","poem":2},{"text":"that the King of Glory may enter!","poem":2}]},{"number":10,"lines":[{"text":"Who is He, this King of Glory?","poem":1},{"text":"The LORD of Hosts—","poem":2},{"text":"He is the King of Glory.","poem":2},{"text":"Selah"}]}]},{"number":25,"lastVerse":22,"verses":[{"number":1,"lines":[{"text":"To You, O LORD, I lift up my soul;","poem":1}]},{"number":2,"lines":[{"text":"in You, my God, I trust.","poem":2},{"text":"Do not let me be put to shame;","poem":1},{"text":"do not let my enemies exult over me.","poem":2}]},{"number":3,"lines":[{"text":"Surely none who wait for You will be put to shame;","poem":1},{"text":"but those who engage in treachery without cause will be disgraced.","poem":2}]},{"number":4,"lines":[{"text":"Show me Your ways, O LORD;","poem":1},{"text":"teach me Your paths.","poem":2}]},{"number":5,"lines":[{"text":"Guide me in Your truth and teach me,","poem":1},{"text":"for You are the God of my salvation;","poem":2},{"text":"all day long I wait for You.","poem":2}]},{"number":6,"lines":[{"text":"Remember, O LORD, Your compassion and loving devotion,","poem":1},{"text":"for they are from age to age.","poem":2}]},{"number":7,"lines":[{"text":"Remember not the sins of my youth,","poem":1},{"text":"nor my rebellious acts;","poem":2},{"text":"remember me according to Your loving devotion,","poem":1},{"text":"because of Your goodness, O LORD.","poem":2}]},{"number":8,"lines":[{"text":"Good and upright is the LORD;","poem":1},{"text":"therefore He shows sinners the way.","poem":2}]},{"number":9,"lines":[{"text":"He guides the humble in what is right","poem":1},{"text":"and teaches them His way.","poem":2}]},{"number":10,"lines":[{"text":"All the LORD’s ways are loving and faithful","poem":1},{"text":"to those who keep His covenant and His decrees.","poem":2}]},{"number":11,"lines":[{"text":"For the sake of Your name, O LORD,","poem":1},{"text":"forgive my iniquity, for it is great.","poem":2}]},{"number":12,"lines":[{"text":"Who is the man who fears the LORD?","poem":1},{"text":"He will instruct him in the path chosen for him.","poem":2}]},{"number":13,"lines":[{"text":"His soul will dwell in prosperity,","poem":1},{"text":"and his descendants will inherit the land.","poem":2}]},{"number":14,"lines":[{"text":"The LORD confides in those who fear Him,","poem":1},{"text":"and reveals His covenant to them.","poem":2}]},{"number":15,"lines":[{"text":"My eyes are always on the LORD,","poem":1},{"text":"for He will free my feet from the mesh.","poem":2}]},{"number":16,"lines":[{"text":"Turn to me and be gracious,","poem":1},{"text":"for I am lonely and afflicted.","poem":2}]},{"number":17,"lines":[{"text":"The troubles of my heart increase;","poem":1},{"text":"free me from my distress.","poem":2}]},{"number":18,"lines":[{"text":"Consider my affliction and trouble,","poem":1},{"text":"and take away all my sins.","poem":2}]},{"number":19,"lines":[{"text":"Consider my enemies, for they are many,","poem":1},{"text":"and they hate me with vicious hatred.","poem":2}]},{"number":20,"lines":[{"text":"Guard my soul and deliver me;","poem":1},{"text":"let me not be put to shame,","poem":2},{"text":"for I take refuge in You.","poem":2}]},{"number":21,"lines":[{"text":"May integrity and uprightness preserve me,","poem":1},{"text":"because I wait for You.","poem":2}]},{"number":22,"lines":[{"text":"Redeem Israel, O God,","poem":1},{"text":"from all its distress.","poem":2}]}]},{"number":26,"lastVerse":12,"verses":[{"number":1,"lines":[{"text":"Vindicate me, O LORD!","poem":1},{"text":"For I have walked with integrity;","poem":1},{"text":"I have trusted in the LORD without wavering.","poem":2}]},{"number":2,"lines":[{"text":"Test me, O LORD, and try me;","poem":1},{"text":"examine my heart and mind.","poem":2}]},{"number":3,"lines":[{"text":"For Your loving devotion is before my eyes,","poem":1},{"text":"and I have walked in Your truth.","poem":2}]},{"number":4,"lines":[{"text":"I do not sit with deceitful men,","poem":1},{"text":"nor keep company with hypocrites.","poem":2}]},{"number":5,"lines":[{"text":"I hate the mob of evildoers,","poem":1},{"text":"and refuse to sit with the wicked.","poem":2}]},{"number":6,"lines":[{"text":"I wash my hands in innocence","poem":1},{"text":"that I may go about Your altar, O LORD,","poem":2}]},{"number":7,"lines":[{"text":"to raise my voice in thanksgiving","poem":1},{"text":"and declare all Your wonderful works.","poem":2}]},{"number":8,"lines":[{"text":"O LORD, I love the house where You dwell,","poem":1},{"text":"the place where Your glory resides.","poem":2}]},{"number":9,"lines":[{"text":"Do not take my soul away with sinners,","poem":1},{"text":"or my life with men of bloodshed,","poem":2}]},{"number":10,"lines":[{"text":"in whose hands are wicked schemes,","poem":1},{"text":"whose right hands are full of bribes.","poem":2}]},{"number":11,"lines":[{"text":"But I will walk with integrity;","poem":1},{"text":"redeem me and be merciful to me.","poem":2}]},{"number":12,"lines":[{"text":"My feet stand on level ground;","poem":1},{"text":"in the congregations I will bless the LORD.","poem":2}]}]},{"number":27,"lastVerse":14,"verses":[{"number":1,"lines":[{"text":"The LORD is my light and my salvation—","poem":1},{"text":"whom shall I fear?","poem":2},{"text":"The LORD is the stronghold of my life—","poem":1},{"text":"whom shall I dread?","poem":2}]},{"number":2,"lines":[{"text":"When the wicked came upon me to devour my flesh,","poem":1},{"text":"my enemies and foes stumbled and fell.","poem":2}]},{"number":3,"lines":[{"text":"Though an army encamps around me,","poem":1},{"text":"my heart will not fear;","poem":2},{"text":"though a war breaks out against me,","poem":1},{"text":"I will keep my trust.","poem":2}]},{"number":4,"lines":[{"text":"One thing I have asked of the LORD;","poem":1},{"text":"this is what I desire:","poem":2},{"text":"to dwell in the house of the LORD","poem":1},{"text":"all the days of my life,","poem":2},{"text":"to gaze on the beauty of the LORD","poem":1},{"text":"and seek Him in His temple.","poem":2}]},{"number":5,"lines":[{"text":"For in the day of trouble","poem":1},{"text":"He will hide me in His shelter;","poem":2},{"text":"He will conceal me under the cover of His tent;","poem":1},{"text":"He will set me high upon a rock.","poem":2}]},{"number":6,"lines":[{"text":"Then my head will be held high","poem":1},{"text":"above my enemies around me.","poem":2},{"text":"At His tabernacle I will offer sacrifices with shouts of joy;","poem":1},{"text":"I will sing and make music to the LORD.","poem":2}]},{"number":7,"lines":[{"text":"Hear, O LORD, my voice when I call;","poem":1},{"text":"be merciful and answer me.","poem":2}]},{"number":8,"lines":[{"text":"My heart said, “Seek His face.”","poem":1},{"text":"Your face, O LORD, I will seek.","poem":2}]},{"number":9,"lines":[{"text":"Hide not Your face from me,","poem":1},{"text":"nor turn away Your servant in anger.","poem":2},{"text":"You have been my helper;","poem":1},{"text":"do not leave me or forsake me,","poem":2},{"text":"O God of my salvation.","poem":2}]},{"number":10,"lines":[{"text":"Though my father and mother forsake me,","poem":1},{"text":"the LORD will receive me.","poem":2}]},{"number":11,"lines":[{"text":"Teach me Your way, O LORD,","poem":1},{"text":"and lead me on a level path,","poem":2},{"text":"because of my oppressors.","poem":2}]},{"number":12,"lines":[{"text":"Do not hand me over to the will of my foes,","poem":1},{"text":"for false witnesses rise up against me,","poem":2},{"text":"breathing out violence.","poem":2}]},{"number":13,"lines":[{"text":"Still I am certain to see","poem":1},{"text":"the goodness of the LORD","poem":2},{"text":"in the land of the living.","poem":2}]},{"number":14,"lines":[{"text":"Wait patiently for the LORD;","poem":1},{"text":"be strong and courageous.","poem":2},{"text":"Wait patiently for the LORD!","poem":1}]}]},{"number":28,"lastVerse":9,"verses":[{"number":1,"lines":[{"text":"To You, O LORD, I call;","poem":1},{"text":"be not deaf to me, O my Rock.","poem":2},{"text":"For if You remain silent,","poem":1},{"text":"I will be like those descending to the Pit.","poem":2}]},{"number":2,"lines":[{"text":"Hear my cry for mercy","poem":1},{"text":"when I call to You for help,","poem":2},{"text":"when I lift up my hands","poem":1},{"text":"toward Your holy sanctuary.","poem":2}]},{"number":3,"lines":[{"text":"Do not drag me away with the wicked,","poem":1},{"text":"and with the workers of iniquity,","poem":2},{"text":"who speak peace to their neighbors","poem":1},{"text":"while malice is in their hearts.","poem":2}]},{"number":4,"lines":[{"text":"Repay them according to their deeds","poem":1},{"text":"and for their works of evil.","poem":2},{"text":"Repay them for what their hands have done;","poem":1},{"text":"bring back on them what they deserve.","poem":2}]},{"number":5,"lines":[{"text":"Since they show no regard for the works of the LORD","poem":1},{"text":"or what His hands have done,","poem":2},{"text":"He will tear them down","poem":1},{"text":"and never rebuild them.","poem":2}]},{"number":6,"lines":[{"text":"Blessed be the LORD,","poem":1},{"text":"for He has heard my cry for mercy.","poem":2}]},{"number":7,"lines":[{"text":"The LORD is my strength and my shield;","poem":1},{"text":"my heart trusts in Him, and I am helped.","poem":2},{"text":"Therefore my heart rejoices,","poem":1},{"text":"and I give thanks to Him with my song.","poem":2}]},{"number":8,"lines":[{"text":"The LORD is the strength of His people,","poem":1},{"text":"a stronghold of salvation for His anointed.","poem":2}]},{"number":9,"lines":[{"text":"Save Your people and bless Your inheritance;","poem":1},{"text":"shepherd them and carry them forever.","poem":2}]}]},{"number":29,"lastVerse":11,"verses":[{"number":1,"lines":[{"text":"Ascribe to the LORD, O heavenly beings,","poem":1},{"text":"ascribe to the LORD glory and strength.","poem":2}]},{"number":2,"lines":[{"text":"Ascribe to the LORD the glory due His name;","poem":1},{"text":"worship the LORD in the splendor of His holiness.","poem":2}]},{"number":3,"lines":[{"text":"The voice of the LORD is over the waters;","poem":1},{"text":"the God of glory thunders;","poem":2},{"text":"the LORD is heard over many waters.","poem":2}]},{"number":4,"lines":[{"text":"The voice of the LORD is powerful;","poem":1},{"text":"the voice of the LORD is majestic.","poem":2}]},{"number":5,"lines":[{"text":"The voice of the LORD breaks the cedars;","poem":1},{"text":"the LORD shatters the cedars of Lebanon.","poem":2}]},{"number":6,"lines":[{"text":"He makes Lebanon skip like a calf,","poem":1},{"text":"and Sirion like a young wild ox.","poem":2}]},{"number":7,"lines":[{"text":"The voice of the LORD","poem":1},{"text":"strikes with flames of fire.","poem":2}]},{"number":8,"lines":[{"text":"The voice of the LORD shakes the wilderness;","poem":1},{"text":"the LORD shakes the Wilderness of Kadesh.","poem":2}]},{"number":9,"lines":[{"text":"The voice of the LORD twists the oaks","poem":1},{"text":"and strips the forests bare.","poem":2},{"text":"And in His temple all cry, “Glory!”","poem":2}]},{"number":10,"lines":[{"text":"The LORD sits enthroned over the flood;","poem":1},{"text":"the LORD is enthroned as King forever.","poem":2}]},{"number":11,"lines":[{"text":"The LORD gives His people strength;","poem":1},{"text":"the LORD blesses His people with peace.","poem":2}]}]},{"number":30,"lastVerse":12,"verses":[{"number":1,"lines":[{"text":"I will exalt You, O LORD,","poem":1},{"text":"for You have lifted me up","poem":2},{"text":"and have not allowed my foes","poem":1},{"text":"to rejoice over me.","poem":2}]},{"number":2,"lines":[{"text":"O LORD my God, I cried to You for help,","poem":1},{"text":"and You healed me.","poem":2}]},{"number":3,"lines":[{"text":"O LORD, You pulled me up from Sheol;","poem":1},{"text":"You spared me from descending into the Pit.","poem":2}]},{"number":4,"lines":[{"text":"Sing to the LORD, O you His saints,","poem":1},{"text":"and praise His holy name.","poem":2}]},{"number":5,"lines":[{"text":"For His anger is fleeting,","poem":1},{"text":"but His favor lasts a lifetime.","poem":2},{"text":"Weeping may stay the night,","poem":1},{"text":"but joy comes in the morning.","poem":2}]},{"number":6,"lines":[{"text":"In prosperity I said,","poem":1},{"text":"“I will never be shaken.”","poem":2}]},{"number":7,"lines":[{"text":"O LORD, You favored me;","poem":1},{"text":"You made my mountain stand strong.","poem":2},{"text":"When You hid Your face,","poem":1},{"text":"I was dismayed.","poem":2}]},{"number":8,"lines":[{"text":"To You, O LORD, I called,","poem":1},{"text":"and I begged my Lord for mercy:","poem":2}]},{"number":9,"lines":[{"text":"“What gain is there in my bloodshed,","poem":1},{"text":"in my descent to the Pit?","poem":2},{"text":"Will the dust praise You?","poem":1},{"text":"Will it proclaim Your faithfulness?","poem":2}]},{"number":10,"lines":[{"text":"Hear me, O LORD, and have mercy;","poem":1},{"text":"O LORD, be my helper.”","poem":2}]},{"number":11,"lines":[{"text":"You turned my mourning into dancing;","poem":1},{"text":"You peeled off my sackcloth and clothed me with joy,","poem":2}]},{"number":12,"lines":[{"text":"that my heart may sing Your praises and not be silent.","poem":1},{"text":"O LORD my God, I will give thanks forever.","poem":2}]}]},{"number":31,"lastVerse":24,"verses":[{"number":1,"lines":[{"text":"In You, O LORD, I have taken refuge;","poem":1},{"text":"let me never be put to shame;","poem":2},{"text":"save me by Your righteousness.","poem":2}]},{"number":2,"lines":[{"text":"Incline Your ear to me;","poem":1},{"text":"come quickly to my rescue.","poem":2},{"text":"Be my rock of refuge,","poem":1},{"text":"the stronghold of my deliverance.","poem":2}]},{"number":3,"lines":[{"text":"For You are my rock and my fortress;","poem":1},{"text":"lead me and guide me for the sake of Your name.","poem":2}]},{"number":4,"lines":[{"text":"You free me from the net laid out for me,","poem":1},{"text":"for You are my refuge.","poem":2}]},{"number":5,"lines":[{"text":"Into Your hands I commit my spirit;","poem":1},{"text":"You have redeemed me, O LORD, God of truth.","poem":2}]},{"number":6,"lines":[{"text":"I hate those who cling to worthless idols,","poem":1},{"text":"but in the LORD I trust.","poem":2}]},{"number":7,"lines":[{"text":"I will be glad and rejoice in Your loving devotion,","poem":1},{"text":"for You have seen my affliction;","poem":2},{"text":"You have known the anguish of my soul.","poem":2}]},{"number":8,"lines":[{"text":"You have not delivered me to the enemy;","poem":1},{"text":"You have set my feet in the open.","poem":2}]},{"number":9,"lines":[{"text":"Be merciful to me, O LORD,","poem":1},{"text":"for I am in distress;","poem":2},{"text":"my eyes fail from sorrow,","poem":1},{"text":"my soul and body as well.","poem":2}]},{"number":10,"lines":[{"text":"For my life is consumed with grief","poem":1},{"text":"and my years with groaning;","poem":2},{"text":"my iniquity has drained my strength,","poem":1},{"text":"and my bones are wasting away.","poem":2}]},{"number":11,"lines":[{"text":"Among all my enemies I am a disgrace,","poem":1},{"text":"and among my neighbors even more.","poem":2},{"text":"I am dreaded by my friends—","poem":1},{"text":"they flee when they see me on the street.","poem":2}]},{"number":12,"lines":[{"text":"I am forgotten like a dead man, out of mind.","poem":1},{"text":"I am like a broken vessel.","poem":2}]},{"number":13,"lines":[{"text":"For I hear the slander of many;","poem":1},{"text":"there is terror on every side.","poem":2},{"text":"They conspire against me","poem":1},{"text":"and plot to take my life.","poem":2}]},{"number":14,"lines":[{"text":"But I trust in You, O LORD;","poem":1},{"text":"I say, “You are my God.”","poem":2}]},{"number":15,"lines":[{"text":"My times are in Your hands;","poem":1},{"text":"deliver me from my enemies","poem":2},{"text":"and from those who pursue me.","poem":2}]},{"number":16,"lines":[{"text":"Make Your face shine on Your servant;","poem":1},{"text":"save me by Your loving devotion.","poem":2}]},{"number":17,"lines":[{"text":"O LORD, let me not be ashamed,","poem":1},{"text":"for I have called on You.","poem":2},{"text":"Let the wicked be put to shame;","poem":1},{"text":"let them lie silent in Sheol.","poem":2}]},{"number":18,"lines":[{"text":"May lying lips be silenced—","poem":1},{"text":"lips that speak with arrogance against the righteous,","poem":2},{"text":"full of pride and contempt.","poem":2}]},{"number":19,"lines":[{"text":"How great is Your goodness","poem":1},{"text":"which You have laid up for those who fear You,","poem":2},{"text":"which You have bestowed before the sons of men","poem":1},{"text":"on those who take refuge in You!","poem":2}]},{"number":20,"lines":[{"text":"You hide them in the secret place of Your presence","poem":1},{"text":"from the schemes of men.","poem":2},{"text":"You conceal them in Your shelter","poem":1},{"text":"from accusing tongues.","poem":2}]},{"number":21,"lines":[{"text":"Blessed be the LORD,","poem":1},{"text":"for He has shown me His loving devotion","poem":2},{"text":"in a city under siege.","poem":2}]},{"number":22,"lines":[{"text":"In my alarm I said,","poem":1},{"text":"“I am cut off from Your sight!”","poem":2},{"text":"But You heard my plea for mercy","poem":1},{"text":"when I called to You for help.","poem":2}]},{"number":23,"lines":[{"text":"Love the LORD, all His saints.","poem":1},{"text":"The LORD preserves the faithful,","poem":2},{"text":"but fully repays the arrogant.","poem":2}]},{"number":24,"lines":[{"text":"Be strong and courageous,","poem":1},{"text":"all you who hope in the LORD.","poem":2}]}]},{"number":32,"lastVerse":11,"verses":[{"number":1,"lines":[{"text":"Blessed is he whose transgressions are forgiven,","poem":1},{"text":"whose sins are covered.","poem":2}]},{"number":2,"lines":[{"text":"Blessed is the man","poem":1},{"text":"whose iniquity the LORD does not count against him,","poem":2},{"text":"in whose spirit there is no deceit.","poem":2}]},{"number":3,"lines":[{"text":"When I kept silent, my bones became brittle","poem":1},{"text":"from my groaning all day long.","poem":2}]},{"number":4,"lines":[{"text":"For day and night","poem":1},{"text":"Your hand was heavy upon me;","poem":2},{"text":"my strength was drained","poem":1},{"text":"as in the summer heat.","poem":2},{"text":"Selah"}]},{"number":5,"lines":[{"text":"Then I acknowledged my sin to You","poem":1},{"text":"and did not hide my iniquity.","poem":2},{"text":"I said, “I will confess my transgressions to the LORD,”","poem":1},{"text":"and You forgave the guilt of my sin.","poem":2},{"text":"Selah"}]},{"number":6,"lines":[{"text":"Therefore let all the godly pray to You","poem":1},{"text":"while You may be found.","poem":2},{"text":"Surely when great waters rise,","poem":1},{"text":"they will not come near.","poem":2}]},{"number":7,"lines":[{"text":"You are my hiding place.","poem":1},{"text":"You protect me from trouble;","poem":2},{"text":"You surround me with songs of deliverance.","poem":2},{"text":"Selah"}]},{"number":8,"lines":[{"text":"I will instruct you and teach you the way you should go;","poem":1},{"text":"I will give you counsel and watch over you.","poem":2}]},{"number":9,"lines":[{"text":"Do not be like the horse or mule,","poem":1},{"text":"which have no understanding;","poem":2},{"text":"they must be controlled with bit and bridle","poem":1},{"text":"to make them come to you.","poem":2}]},{"number":10,"lines":[{"text":"Many are the sorrows of the wicked,","poem":1},{"text":"but loving devotion surrounds him who trusts in the LORD.","poem":2}]},{"number":11,"lines":[{"text":"Be glad in the LORD and rejoice, O righteous ones;","poem":1},{"text":"shout for joy, all you upright in heart.","poem":2}]}]},{"number":33,"lastVerse":22,"verses":[{"number":1,"lines":[{"text":"Rejoice in the LORD, O righteous ones;","poem":1},{"text":"it is fitting for the upright to praise Him.","poem":2}]},{"number":2,"lines":[{"text":"Praise the LORD with the harp;","poem":1},{"text":"make music to Him with ten strings.","poem":2}]},{"number":3,"lines":[{"text":"Sing to Him a new song;","poem":1},{"text":"play skillfully with a shout of joy.","poem":2}]},{"number":4,"lines":[{"text":"For the word of the LORD is upright,","poem":1},{"text":"and all His work is trustworthy.","poem":2}]},{"number":5,"lines":[{"text":"The LORD loves righteousness and justice;","poem":1},{"text":"the earth is full of His loving devotion.","poem":2}]},{"number":6,"lines":[{"text":"By the word of the LORD the heavens were made,","poem":1},{"text":"and all the stars by the breath of His mouth.","poem":2}]},{"number":7,"lines":[{"text":"He piles up the waters of the sea;","poem":1},{"text":"He puts the depths into storehouses.","poem":2}]},{"number":8,"lines":[{"text":"Let all the earth fear the LORD;","poem":1},{"text":"let all the people of the world revere Him.","poem":2}]},{"number":9,"lines":[{"text":"For He spoke, and it came to be;","poem":1},{"text":"He commanded, and it stood firm.","poem":2}]},{"number":10,"lines":[{"text":"The LORD frustrates the plans of the nations;","poem":1},{"text":"He thwarts the devices of the peoples.","poem":2}]},{"number":11,"lines":[{"text":"The counsel of the LORD stands forever,","poem":1},{"text":"the purposes of His heart to all generations.","poem":2}]},{"number":12,"lines":[{"text":"Blessed is the nation whose God is the LORD,","poem":1},{"text":"the people He has chosen as His inheritance!","poem":2}]},{"number":13,"lines":[{"text":"The LORD looks down from heaven;","poem":1},{"text":"He sees all the sons of men.","poem":2}]},{"number":14,"lines":[{"text":"From His dwelling place He gazes","poem":1},{"text":"on all who inhabit the earth.","poem":2}]},{"number":15,"lines":[{"text":"He shapes the hearts of each;","poem":1},{"text":"He considers all their works.","poem":2}]},{"number":16,"lines":[{"text":"No king is saved by his vast army;","poem":1},{"text":"no warrior is delivered by his great strength.","poem":2}]},{"number":17,"lines":[{"text":"A horse is a vain hope for salvation;","poem":1},{"text":"even its great strength cannot save.","poem":2}]},{"number":18,"lines":[{"text":"Surely the eyes of the LORD are on those who fear Him,","poem":1},{"text":"on those whose hope is in His loving devotion","poem":2}]},{"number":19,"lines":[{"text":"to deliver them from death","poem":1},{"text":"and keep them alive in famine.","poem":2}]},{"number":20,"lines":[{"text":"Our soul waits for the LORD;","poem":1},{"text":"He is our help and our shield.","poem":2}]},{"number":21,"lines":[{"text":"For our hearts rejoice in Him,","poem":1},{"text":"since we trust in His holy name.","poem":2}]},{"number":22,"lines":[{"text":"May Your loving devotion rest on us, O LORD,","poem":1},{"text":"as we put our hope in You.","poem":2}]}]},{"number":34,"lastVerse":22,"verses":[{"number":1,"lines":[{"text":"I will bless the LORD at all times;","poem":1},{"text":"His praise will always be on my lips.","poem":2}]},{"number":2,"lines":[{"text":"My soul boasts in the LORD;","poem":1},{"text":"let the oppressed hear and rejoice.","poem":2}]},{"number":3,"lines":[{"text":"Magnify the LORD with me;","poem":1},{"text":"let us exalt His name together.","poem":2}]},{"number":4,"lines":[{"text":"I sought the LORD, and He answered me;","poem":1},{"text":"He delivered me from all my fears.","poem":2}]},{"number":5,"lines":[{"text":"Those who look to Him are radiant with joy;","poem":1},{"text":"their faces shall never be ashamed.","poem":2}]},{"number":6,"lines":[{"text":"This poor man called out, and the LORD heard him;","poem":1},{"text":"He saved him from all his troubles.","poem":2}]},{"number":7,"lines":[{"text":"The angel of the LORD encamps around those who fear Him,","poem":1},{"text":"and he delivers them.","poem":2}]},{"number":8,"lines":[{"text":"Taste and see that the LORD is good;","poem":1},{"text":"blessed is the man who takes refuge in Him!","poem":2}]},{"number":9,"lines":[{"text":"Fear the LORD, you His saints,","poem":1},{"text":"for those who fear Him lack nothing.","poem":2}]},{"number":10,"lines":[{"text":"Young lions go lacking and hungry,","poem":1},{"text":"but those who seek the LORD lack no good thing.","poem":2}]},{"number":11,"lines":[{"text":"Come, children, listen to me;","poem":1},{"text":"I will teach you the fear of the LORD.","poem":2}]},{"number":12,"lines":[{"text":"Who is the man who delights in life,","poem":1},{"text":"who desires to see good days?","poem":2}]},{"number":13,"lines":[{"text":"Keep your tongue from evil","poem":1},{"text":"and your lips from deceitful speech.","poem":2}]},{"number":14,"lines":[{"text":"Turn away from evil and do good;","poem":1},{"text":"seek peace and pursue it.","poem":2}]},{"number":15,"lines":[{"text":"The eyes of the LORD are on the righteous,","poem":1},{"text":"and His ears are inclined to their cry.","poem":2}]},{"number":16,"lines":[{"text":"But the face of the LORD is against those who do evil,","poem":1},{"text":"to wipe out all memory of them from the earth.","poem":2}]},{"number":17,"lines":[{"text":"The righteous cry out, and the LORD hears;","poem":1},{"text":"He delivers them from all their troubles.","poem":2}]},{"number":18,"lines":[{"text":"The LORD is near to the brokenhearted;","poem":1},{"text":"He saves the contrite in spirit.","poem":2}]},{"number":19,"lines":[{"text":"Many are the afflictions of the righteous,","poem":1},{"text":"but the LORD delivers him from them all.","poem":2}]},{"number":20,"lines":[{"text":"He protects all his bones;","poem":1},{"text":"not one of them will be broken.","poem":2}]},{"number":21,"lines":[{"text":"Evil will slay the wicked,","poem":1},{"text":"and the haters of the righteous will be condemned.","poem":2}]},{"number":22,"lines":[{"text":"The LORD redeems His servants,","poem":1},{"text":"and none who take refuge in Him will be condemned.","poem":2}]}]},{"number":35,"lastVerse":28,"verses":[{"number":1,"lines":[{"text":"Contend with my opponents, O LORD;","poem":1},{"text":"fight against those who fight against me.","poem":2}]},{"number":2,"lines":[{"text":"Take up Your shield and buckler;","poem":1},{"text":"arise and come to my aid.","poem":2}]},{"number":3,"lines":[{"text":"Draw the spear and javelin against my pursuers;","poem":1},{"text":"say to my soul: “I am your salvation.”","poem":2}]},{"number":4,"lines":[{"text":"May those who seek my life","poem":1},{"text":"be disgraced and put to shame;","poem":2},{"text":"may those who plan to harm me","poem":1},{"text":"be driven back and confounded.","poem":2}]},{"number":5,"lines":[{"text":"May they be like chaff in the wind,","poem":1},{"text":"as the angel of the LORD drives them away.","poem":2}]},{"number":6,"lines":[{"text":"May their path be dark and slick,","poem":1},{"text":"as the angel of the LORD pursues.","poem":2}]},{"number":7,"lines":[{"text":"For without cause they laid their net for me;","poem":1},{"text":"without reason they dug a pit for my soul.","poem":2}]},{"number":8,"lines":[{"text":"May ruin befall them by surprise;","poem":1},{"text":"may the net they hid ensnare them;","poem":2},{"text":"may they fall into the hazard they created.","poem":2}]},{"number":9,"lines":[{"text":"Then my soul will rejoice in the LORD","poem":1},{"text":"and exult in His salvation.","poem":2}]},{"number":10,"lines":[{"text":"All my bones will exclaim,","poem":1},{"text":"“Who is like You, O LORD,","poem":2},{"text":"who delivers the afflicted from the aggressor,","poem":1},{"text":"the poor and needy from the robber?”","poem":2}]},{"number":11,"lines":[{"text":"Hostile witnesses come forward;","poem":1},{"text":"they make charges I know nothing about.","poem":2}]},{"number":12,"lines":[{"text":"They repay me evil for good,","poem":1},{"text":"to the bereavement of my soul.","poem":2}]},{"number":13,"lines":[{"text":"Yet when they were ill,","poem":1},{"text":"I put on sackcloth;","poem":2},{"text":"I humbled myself with fasting,","poem":1},{"text":"but my prayers returned unanswered.","poem":2}]},{"number":14,"lines":[{"text":"I paced about","poem":1},{"text":"as for my friend or brother;","poem":2},{"text":"I was bowed down with grief,","poem":1},{"text":"like one mourning for his mother.","poem":2}]},{"number":15,"lines":[{"text":"But when I stumbled, they assembled in glee;","poem":1},{"text":"they gathered together against me.","poem":2},{"text":"Assailants I did not know","poem":1},{"text":"slandered me without ceasing.","poem":2}]},{"number":16,"lines":[{"text":"Like godless jesters at a feast,","poem":1},{"text":"they gnashed their teeth at me.","poem":2}]},{"number":17,"lines":[{"text":"How long, O Lord, will You look on?","poem":1},{"text":"Rescue my soul from their ravages,","poem":2},{"text":"my precious life from these lions.","poem":2}]},{"number":18,"lines":[{"text":"Then I will give You thanks in the great assembly;","poem":1},{"text":"I will praise You among many people.","poem":2}]},{"number":19,"lines":[{"text":"Let not my enemies gloat over me without cause,","poem":1},{"text":"nor those who hate me without reason wink in malice.","poem":2}]},{"number":20,"lines":[{"text":"For they do not speak peace,","poem":1},{"text":"but they devise deceitful schemes","poem":2},{"text":"against those who live quietly in the land.","poem":2}]},{"number":21,"lines":[{"text":"They gape at me and say,","poem":1},{"text":"“Aha, aha! Our eyes have seen!”","poem":2}]},{"number":22,"lines":[{"text":"O LORD, You have seen it; be not silent.","poem":1},{"text":"O Lord, be not far from me.","poem":2}]},{"number":23,"lines":[{"text":"Awake and rise to my defense,","poem":1},{"text":"to my cause, my God and my Lord!","poem":2}]},{"number":24,"lines":[{"text":"Vindicate me by Your righteousness, O LORD my God,","poem":1},{"text":"and do not let them gloat over me.","poem":2}]},{"number":25,"lines":[{"text":"Let them not say in their hearts,","poem":1},{"text":"“Aha, just what we wanted!”","poem":2},{"text":"Let them not say,","poem":1},{"text":"“We have swallowed him up!”","poem":2}]},{"number":26,"lines":[{"text":"May those who gloat in my distress","poem":1},{"text":"be ashamed and confounded;","poem":2},{"text":"may those who exalt themselves over me","poem":1},{"text":"be clothed in shame and reproach.","poem":2}]},{"number":27,"lines":[{"text":"May those who favor my vindication","poem":1},{"text":"shout for joy and gladness;","poem":2},{"text":"may they always say, “Exalted be the LORD","poem":1},{"text":"who delights in His servant’s well-being.”","poem":2}]},{"number":28,"lines":[{"text":"Then my tongue will proclaim Your righteousness","poem":1},{"text":"and Your praises all day long.","poem":2}]}]},{"number":36,"lastVerse":12,"verses":[{"number":1,"lines":[{"text":"An oracle is in my heart","poem":1},{"text":"regarding the transgression of the wicked man:","poem":2},{"text":"There is no fear of God","poem":1},{"text":"before his eyes.","poem":2}]},{"number":2,"lines":[{"text":"For his eyes are too full of conceit","poem":1},{"text":"to detect or hate his own sin.","poem":2}]},{"number":3,"lines":[{"text":"The words of his mouth are wicked and deceitful;","poem":1},{"text":"he has ceased to be wise and well-doing.","poem":2}]},{"number":4,"lines":[{"text":"Even on his bed he plots wickedness;","poem":1},{"text":"he sets himself on a path that is not good;","poem":2},{"text":"he fails to reject evil.","poem":2}]},{"number":5,"lines":[{"text":"Your loving devotion, O LORD, reaches to the heavens,","poem":1},{"text":"Your faithfulness to the clouds.","poem":2}]},{"number":6,"lines":[{"text":"Your righteousness is like the highest mountains;","poem":1},{"text":"Your judgments are like the deepest sea.","poem":2},{"text":"O LORD, You preserve man and beast.","poem":2}]},{"number":7,"lines":[{"text":"How precious is Your loving devotion, O God,","poem":1},{"text":"that the children of men take refuge","poem":2},{"text":"in the shadow of Your wings!","poem":2}]},{"number":8,"lines":[{"text":"They feast on the abundance of Your house,","poem":1},{"text":"and You give them drink from Your river of delights.","poem":2}]},{"number":9,"lines":[{"text":"For with You is the fountain of life;","poem":1},{"text":"in Your light we see light.","poem":2}]},{"number":10,"lines":[{"text":"Extend Your loving devotion to those who know You,","poem":1},{"text":"and Your righteousness to the upright in heart.","poem":2}]},{"number":11,"lines":[{"text":"Let not the foot of the proud come against me,","poem":1},{"text":"nor the hand of the wicked drive me away.","poem":2}]},{"number":12,"lines":[{"text":"There the evildoers lie fallen,","poem":1},{"text":"thrown down and unable to rise.","poem":2}]}]},{"number":37,"lastVerse":40,"verses":[{"number":1,"lines":[{"text":"Do not fret over those who do evil;","poem":1},{"text":"do not envy those who do wrong.","poem":2}]},{"number":2,"lines":[{"text":"For they wither quickly like grass","poem":1},{"text":"and wilt like tender plants.","poem":2}]},{"number":3,"lines":[{"text":"Trust in the LORD and do good;","poem":1},{"text":"dwell in the land and cultivate faithfulness.","poem":2}]},{"number":4,"lines":[{"text":"Delight yourself in the LORD,","poem":1},{"text":"and He will give you the desires of your heart.","poem":2}]},{"number":5,"lines":[{"text":"Commit your way to the LORD;","poem":1},{"text":"trust in Him, and He will do it.","poem":2}]},{"number":6,"lines":[{"text":"He will bring forth your righteousness like the dawn,","poem":1},{"text":"your justice like the noonday sun.","poem":2}]},{"number":7,"lines":[{"text":"Be still before the LORD","poem":1},{"text":"and wait patiently for Him;","poem":2},{"text":"do not fret when men prosper in their ways,","poem":1},{"text":"when they carry out wicked schemes.","poem":2}]},{"number":8,"lines":[{"text":"Refrain from anger and abandon wrath;","poem":1},{"text":"do not fret—it can only bring harm.","poem":2}]},{"number":9,"lines":[{"text":"For the evildoers will be cut off,","poem":1},{"text":"but those who hope in the LORD will inherit the land.","poem":2}]},{"number":10,"lines":[{"text":"Yet a little while, and the wicked will be no more;","poem":1},{"text":"though you look for them, they will not be found.","poem":2}]},{"number":11,"lines":[{"text":"But the meek will inherit the land","poem":1},{"text":"and delight in abundant prosperity.","poem":2}]},{"number":12,"lines":[{"text":"The wicked scheme against the righteous","poem":1},{"text":"and gnash their teeth at them,","poem":2}]},{"number":13,"lines":[{"text":"but the Lord laughs,","poem":1},{"text":"seeing that their day is coming.","poem":2}]},{"number":14,"lines":[{"text":"The wicked have drawn the sword","poem":1},{"text":"and bent the bow","poem":2},{"text":"to bring down the poor and needy,","poem":1},{"text":"to slay those whose ways are upright.","poem":2}]},{"number":15,"lines":[{"text":"But their swords will pierce their own hearts,","poem":1},{"text":"and their bows will be broken.","poem":2}]},{"number":16,"lines":[{"text":"Better is the little of the righteous","poem":1},{"text":"than the abundance of many who are wicked.","poem":2}]},{"number":17,"lines":[{"text":"For the arms of the wicked will be broken,","poem":1},{"text":"but the LORD upholds the righteous.","poem":2}]},{"number":18,"lines":[{"text":"The LORD knows the days of the blameless,","poem":1},{"text":"and their inheritance will last forever.","poem":2}]},{"number":19,"lines":[{"text":"In the time of evil they will not be ashamed,","poem":1},{"text":"and in the days of famine they will be satisfied.","poem":2}]},{"number":20,"lines":[{"text":"But the wicked and enemies of the LORD","poem":1},{"text":"will perish like the glory of the fields.","poem":2},{"text":"They will vanish;","poem":1},{"text":"like smoke they will fade away.","poem":2}]},{"number":21,"lines":[{"text":"The wicked borrow and do not repay,","poem":1},{"text":"but the righteous are gracious and giving.","poem":2}]},{"number":22,"lines":[{"text":"Surely those He blesses will inherit the land,","poem":1},{"text":"but the cursed will be destroyed.","poem":2}]},{"number":23,"lines":[{"text":"The steps of a man are ordered by the LORD","poem":1},{"text":"who takes delight in his journey.","poem":2}]},{"number":24,"lines":[{"text":"Though he falls, he will not be overwhelmed,","poem":1},{"text":"for the LORD is holding his hand.","poem":2}]},{"number":25,"lines":[{"text":"I once was young and now am old,","poem":1},{"text":"yet never have I seen the righteous abandoned","poem":2},{"text":"or their children begging for bread.","poem":2}]},{"number":26,"lines":[{"text":"They are ever generous and quick to lend,","poem":1},{"text":"and their children are a blessing.","poem":2}]},{"number":27,"lines":[{"text":"Turn away from evil and do good,","poem":1},{"text":"so that you will abide forever.","poem":2}]},{"number":28,"lines":[{"text":"For the LORD loves justice","poem":1},{"text":"and will not forsake His saints.","poem":2},{"text":"They are preserved forever,","poem":1},{"text":"but the offspring of the wicked will be cut off.","poem":2}]},{"number":29,"lines":[{"text":"The righteous will inherit the land","poem":1},{"text":"and dwell in it forever.","poem":2}]},{"number":30,"lines":[{"text":"The mouth of the righteous man utters wisdom,","poem":1},{"text":"and his tongue speaks justice.","poem":2}]},{"number":31,"lines":[{"text":"The law of his God is in his heart;","poem":1},{"text":"his steps do not falter.","poem":2}]},{"number":32,"lines":[{"text":"Though the wicked lie in wait for the righteous,","poem":1},{"text":"and seek to slay them,","poem":2}]},{"number":33,"lines":[{"text":"the LORD will not leave them in their power","poem":1},{"text":"or let them be condemned under judgment.","poem":2}]},{"number":34,"lines":[{"text":"Wait for the LORD and keep His way,","poem":1},{"text":"and He will raise you up to inherit the land.","poem":2},{"text":"When the wicked are cut off,","poem":1},{"text":"you will see it.","poem":2}]},{"number":35,"lines":[{"text":"I have seen a wicked, ruthless man","poem":1},{"text":"flourishing like a well-rooted native tree,","poem":2}]},{"number":36,"lines":[{"text":"yet he passed away and was no more;","poem":1},{"text":"though I searched, he could not be found.","poem":2}]},{"number":37,"lines":[{"text":"Consider the blameless and observe the upright,","poem":1},{"text":"for posterity awaits the man of peace.","poem":2}]},{"number":38,"lines":[{"text":"But the transgressors will all be destroyed;","poem":1},{"text":"the future of the wicked will be cut off.","poem":2}]},{"number":39,"lines":[{"text":"The salvation of the righteous is from the LORD;","poem":1},{"text":"He is their stronghold in time of trouble.","poem":2}]},{"number":40,"lines":[{"text":"The LORD helps and delivers them;","poem":1},{"text":"He rescues and saves them from the wicked,","poem":2},{"text":"because they take refuge in Him.","poem":2}]}]},{"number":38,"lastVerse":22,"verses":[{"number":1,"lines":[{"text":"O LORD, do not rebuke me in Your anger","poem":1},{"text":"or discipline me in Your wrath.","poem":2}]},{"number":2,"lines":[{"text":"For Your arrows have pierced me deeply,","poem":1},{"text":"and Your hand has pressed down on me.","poem":2}]},{"number":3,"lines":[{"text":"There is no soundness in my body","poem":1},{"text":"because of Your anger;","poem":2},{"text":"there is no rest in my bones","poem":1},{"text":"because of my sin.","poem":2}]},{"number":4,"lines":[{"text":"For my iniquities have overwhelmed me;","poem":1},{"text":"they are a burden too heavy to bear.","poem":2}]},{"number":5,"lines":[{"text":"My wounds are foul and festering","poem":1},{"text":"because of my sinful folly.","poem":2}]},{"number":6,"lines":[{"text":"I am bent and brought low;","poem":1},{"text":"all day long I go about mourning.","poem":2}]},{"number":7,"lines":[{"text":"For my loins are full of burning pain,","poem":1},{"text":"and no soundness remains in my body.","poem":2}]},{"number":8,"lines":[{"text":"I am numb and badly crushed;","poem":1},{"text":"I groan in anguish of heart.","poem":2}]},{"number":9,"lines":[{"text":"O Lord, my every desire is before You;","poem":1},{"text":"my groaning is not hidden from You.","poem":2}]},{"number":10,"lines":[{"text":"My heart pounds, my strength fails,","poem":1},{"text":"and even the light of my eyes has faded.","poem":2}]},{"number":11,"lines":[{"text":"My beloved and friends shun my disease,","poem":1},{"text":"and my kinsmen stand at a distance.","poem":2}]},{"number":12,"lines":[{"text":"Those who seek my life lay snares;","poem":1},{"text":"those who wish me harm speak destruction,","poem":2},{"text":"plotting deceit all day long.","poem":2}]},{"number":13,"lines":[{"text":"But like a deaf man, I do not hear;","poem":1},{"text":"and like a mute man, I do not open my mouth.","poem":2}]},{"number":14,"lines":[{"text":"I am like a man who cannot hear,","poem":1},{"text":"whose mouth offers no reply.","poem":2}]},{"number":15,"lines":[{"text":"I wait for You, O LORD;","poem":1},{"text":"You will answer, O Lord my God.","poem":2}]},{"number":16,"lines":[{"text":"For I said, “Let them not gloat over me—","poem":1},{"text":"those who taunt me when my foot slips.”","poem":2}]},{"number":17,"lines":[{"text":"For I am ready to fall,","poem":1},{"text":"and my pain is ever with me.","poem":2}]},{"number":18,"lines":[{"text":"Yes, I confess my iniquity;","poem":1},{"text":"I am troubled by my sin.","poem":2}]},{"number":19,"lines":[{"text":"Many are my enemies without cause,","poem":1},{"text":"and many hate me without reason.","poem":2}]},{"number":20,"lines":[{"text":"Those who repay my good with evil","poem":1},{"text":"attack me for pursuing the good.","poem":2}]},{"number":21,"lines":[{"text":"Do not forsake me, O LORD;","poem":1},{"text":"be not far from me, O my God.","poem":2}]},{"number":22,"lines":[{"text":"Come quickly to help me,","poem":1},{"text":"O Lord my Savior.","poem":2}]}]},{"number":39,"lastVerse":13,"verses":[{"number":1,"lines":[{"text":"I said, “I will watch my ways","poem":1},{"text":"so that I will not sin with my tongue;","poem":2},{"text":"I will guard my mouth with a muzzle","poem":1},{"text":"as long as the wicked are present.”","poem":2}]},{"number":2,"lines":[{"text":"I was speechless and still;","poem":1},{"text":"I remained silent, even from speaking good,","poem":2},{"text":"and my sorrow was stirred.","poem":2}]},{"number":3,"lines":[{"text":"My heart grew hot within me;","poem":1},{"text":"as I mused, the fire burned.","poem":2},{"text":"Then I spoke with my tongue:","poem":1}]},{"number":4,"lines":[{"text":"“Show me, O LORD, my end","poem":1},{"text":"and the measure of my days.","poem":2},{"text":"Let me know how fleeting my life is.","poem":2}]},{"number":5,"lines":[{"text":"You, indeed, have made my days as handbreadths,","poem":1},{"text":"and my lifetime as nothing before You.","poem":2},{"text":"Truly each man at his best","poem":1},{"text":"exists as but a breath.","poem":2},{"text":"Selah"}]},{"number":6,"lines":[{"text":"Surely every man goes about like a phantom;","poem":1},{"text":"surely he bustles in vain;","poem":2},{"text":"he heaps up riches","poem":1},{"text":"not knowing who will haul them away.","poem":2}]},{"number":7,"lines":[{"text":"And now, O Lord, for what do I wait?","poem":1},{"text":"My hope is in You.","poem":2}]},{"number":8,"lines":[{"text":"Deliver me from all my transgressions;","poem":1},{"text":"do not make me the reproach of fools.","poem":2}]},{"number":9,"lines":[{"text":"I have become mute;","poem":1},{"text":"I do not open my mouth","poem":2},{"text":"because of what You have done.","poem":2}]},{"number":10,"lines":[{"text":"Remove Your scourge from me;","poem":1},{"text":"I am perishing by the force of Your hand.","poem":2}]},{"number":11,"lines":[{"text":"You discipline and correct a man for his iniquity,","poem":1},{"text":"consuming like a moth what he holds dear;","poem":2},{"text":"surely each man is but a vapor.","poem":2},{"text":"Selah"}]},{"number":12,"lines":[{"text":"Hear my prayer, O LORD,","poem":1},{"text":"and give ear to my cry for help;","poem":2},{"text":"do not be deaf to my weeping.","poem":1},{"text":"For I am a foreigner dwelling with You,","poem":2},{"text":"a stranger like all my fathers.","poem":2}]},{"number":13,"lines":[{"text":"Turn Your gaze away from me,","poem":1},{"text":"that I may again be cheered","poem":2},{"text":"before I depart and am no more.”","poem":2}]}]},{"number":40,"lastVerse":17,"verses":[{"number":1,"lines":[{"text":"I waited patiently for the LORD;","poem":1},{"text":"He inclined to me and heard my cry.","poem":2}]},{"number":2,"lines":[{"text":"He lifted me up from the pit of despair,","poem":1},{"text":"out of the miry clay;","poem":2},{"text":"He set my feet upon a rock,","poem":1},{"text":"and made my footsteps firm.","poem":2}]},{"number":3,"lines":[{"text":"He put a new song in my mouth,","poem":1},{"text":"a hymn of praise to our God.","poem":2},{"text":"Many will see and fear","poem":1},{"text":"and put their trust in the LORD.","poem":2}]},{"number":4,"lines":[{"text":"Blessed is the man","poem":1},{"text":"who has made the LORD his trust,","poem":2},{"text":"who has not turned to the proud,","poem":1},{"text":"nor to those who lapse into falsehood.","poem":2}]},{"number":5,"lines":[{"text":"Many, O LORD my God,","poem":1},{"text":"are the wonders You have done,","poem":2},{"text":"and the plans You have for us—","poem":1},{"text":"none can compare to You—","poem":2},{"text":"if I proclaim and declare them,","poem":1},{"text":"they are more than I can count.","poem":2}]},{"number":6,"lines":[{"text":"Sacrifice and offering You did not desire,","poem":1},{"text":"but my ears You have opened.","poem":2},{"text":"Burnt offerings and sin offerings","poem":1},{"text":"You did not require.","poem":2}]},{"number":7,"lines":[{"text":"Then I said, “Here I am, I have come—","poem":1},{"text":"it is written about me in the scroll:","poem":2}]},{"number":8,"lines":[{"text":"I delight to do Your will, O my God;","poem":1},{"text":"Your law is within my heart.”","poem":2}]},{"number":9,"lines":[{"text":"I proclaim righteousness in the great assembly;","poem":1},{"text":"behold, I do not seal my lips,","poem":2},{"text":"as You, O LORD, do know.","poem":2}]},{"number":10,"lines":[{"text":"I have not covered up Your righteousness in my heart;","poem":1},{"text":"I have declared Your faithfulness and salvation;","poem":2},{"text":"I have not concealed Your loving devotion and faithfulness","poem":1},{"text":"from the great assembly.","poem":2}]},{"number":11,"lines":[{"text":"O LORD, do not withhold Your mercy from me;","poem":1},{"text":"Your loving devotion and faithfulness will always guard me.","poem":2}]},{"number":12,"lines":[{"text":"For evils without number surround me;","poem":1},{"text":"my sins have overtaken me, so that I cannot see.","poem":2},{"text":"They are more than the hairs of my head,","poem":1},{"text":"and my heart has failed within me.","poem":2}]},{"number":13,"lines":[{"text":"Be pleased, O LORD, to deliver me;","poem":1},{"text":"hurry, O LORD, to help me.","poem":2}]},{"number":14,"lines":[{"text":"May those who seek my life","poem":1},{"text":"be ashamed and confounded;","poem":2},{"text":"may those who wish me harm","poem":1},{"text":"be repelled and humiliated.","poem":2}]},{"number":15,"lines":[{"text":"May those who say to me, “Aha, aha!”","poem":1},{"text":"be appalled at their own shame.","poem":2}]},{"number":16,"lines":[{"text":"May all who seek You","poem":1},{"text":"rejoice and be glad in You;","poem":2},{"text":"may those who love Your salvation","poem":1},{"text":"always say, “The LORD be magnified!”","poem":2}]},{"number":17,"lines":[{"text":"But I am poor and needy;","poem":1},{"text":"may the Lord think of me.","poem":2},{"text":"You are my helper and deliverer;","poem":1},{"text":"O my God, do not delay.","poem":2}]}]},{"number":41,"lastVerse":13,"verses":[{"number":1,"lines":[{"text":"Blessed is the one who cares for the poor;","poem":1},{"text":"the LORD will deliver him in the day of trouble.","poem":2}]},{"number":2,"lines":[{"text":"The LORD will protect and preserve him;","poem":1},{"text":"He will bless him in the land","poem":2},{"text":"and refuse to give him over","poem":1},{"text":"to the will of his foes.","poem":2}]},{"number":3,"lines":[{"text":"The LORD will sustain him on his bed of illness","poem":1},{"text":"and restore him from his bed of sickness.","poem":2}]},{"number":4,"lines":[{"text":"I said, “O LORD, be gracious to me;","poem":1},{"text":"heal me, for I have sinned against You.”","poem":2}]},{"number":5,"lines":[{"text":"My enemies say with malice:","poem":1},{"text":"“When will he die and be forgotten?”","poem":2}]},{"number":6,"lines":[{"text":"My visitor speaks falsehood;","poem":1},{"text":"he gathers slander in his heart;","poem":2},{"text":"he goes out and spreads it abroad.","poem":2}]},{"number":7,"lines":[{"text":"All who hate me whisper against me;","poem":1},{"text":"they imagine the worst for me:","poem":2}]},{"number":8,"lines":[{"text":"“A vile disease has been poured into him;","poem":1},{"text":"he will never get up from where he lies!”","poem":2}]},{"number":9,"lines":[{"text":"Even my close friend whom I trusted,","poem":1},{"text":"the one who shared my bread,","poem":2},{"text":"has lifted up his heel against me.","poem":2}]},{"number":10,"lines":[{"text":"But You, O LORD, be gracious to me and raise me up,","poem":1},{"text":"that I may repay them.","poem":2}]},{"number":11,"lines":[{"text":"By this I know that You delight in me,","poem":1},{"text":"for my enemy does not triumph over me.","poem":2}]},{"number":12,"lines":[{"text":"In my integrity You uphold me","poem":1},{"text":"and set me in Your presence forever.","poem":2}]},{"number":13,"lines":[{"text":"Blessed be the LORD, the God of Israel,","poem":1},{"text":"from everlasting to everlasting.","poem":2},{"text":"Amen and Amen.","poem":1}]}]},{"number":42,"lastVerse":11,"verses":[{"number":1,"lines":[{"text":"As the deer pants for streams of water,","poem":1},{"text":"so my soul longs after You, O God.","poem":2}]},{"number":2,"lines":[{"text":"My soul thirsts for God, the living God.","poem":1},{"text":"When shall I come and appear in God’s presence?","poem":2}]},{"number":3,"lines":[{"text":"My tears have been my food","poem":1},{"text":"both day and night,","poem":2},{"text":"while men ask me all day long,","poem":1},{"text":"“Where is your God?”","poem":2}]},{"number":4,"lines":[{"text":"These things come to mind as I pour out my soul:","poem":1},{"text":"how I walked with the multitude,","poem":2},{"text":"leading the festive procession to the house of God","poem":1},{"text":"with shouts of joy and praise.","poem":2}]},{"number":5,"lines":[{"text":"Why are you downcast, O my soul?","poem":1},{"text":"Why the unease within me?","poem":2},{"text":"Put your hope in God, for I will yet praise Him","poem":1},{"text":"for the salvation of His presence.","poem":2}]},{"number":6,"lines":[{"text":"O my God, my soul despairs within me.","poem":1},{"text":"Therefore I remember You","poem":2},{"text":"from the land of Jordan and the peaks of Hermon—","poem":1},{"text":"even from Mount Mizar.","poem":2}]},{"number":7,"lines":[{"text":"Deep calls to deep","poem":1},{"text":"in the roar of Your waterfalls;","poem":2},{"text":"all Your breakers and waves","poem":1},{"text":"have rolled over me.","poem":2}]},{"number":8,"lines":[{"text":"The LORD decrees His loving devotion by day,","poem":1},{"text":"and at night His song is with me","poem":2},{"text":"as a prayer to the God of my life.","poem":2}]},{"number":9,"lines":[{"text":"I say to God my Rock,","poem":1},{"text":"“Why have You forgotten me?","poem":2},{"text":"Why must I walk in sorrow","poem":1},{"text":"because of the enemy’s oppression?”","poem":2}]},{"number":10,"lines":[{"text":"Like the crushing of my bones,","poem":1},{"text":"my enemies taunt me,","poem":2},{"text":"while they say to me all day long,","poem":1},{"text":"“Where is your God?”","poem":2}]},{"number":11,"lines":[{"text":"Why are you downcast, O my soul?","poem":1},{"text":"Why the unease within me?","poem":2},{"text":"Put your hope in God, for I will yet praise Him,","poem":1},{"text":"my Savior and my God.","poem":2}]}]},{"number":43,"lastVerse":5,"verses":[{"number":1,"lines":[{"text":"Vindicate me, O God, and plead my case","poem":1},{"text":"against an ungodly nation;","poem":2},{"text":"deliver me from deceitful and unjust men.","poem":2}]},{"number":2,"lines":[{"text":"For You are the God of my refuge.","poem":1},{"text":"Why have You rejected me?","poem":2},{"text":"Why must I walk in sorrow","poem":1},{"text":"because of the enemy’s oppression?","poem":2}]},{"number":3,"lines":[{"text":"Send out Your light and Your truth;","poem":1},{"text":"let them lead me.","poem":2},{"text":"Let them bring me to Your holy mountain","poem":1},{"text":"and to the place where You dwell.","poem":2}]},{"number":4,"lines":[{"text":"Then I will go to the altar of God,","poem":1},{"text":"to God, my greatest joy.","poem":2},{"text":"I will praise You with the harp,","poem":1},{"text":"O God, my God.","poem":2}]},{"number":5,"lines":[{"text":"Why are you downcast, O my soul?","poem":1},{"text":"Why the unease within me?","poem":2},{"text":"Put your hope in God, for I will yet praise Him,","poem":1},{"text":"my Savior and my God.","poem":2}]}]},{"number":44,"lastVerse":26,"verses":[{"number":1,"lines":[{"text":"We have heard with our ears, O God;","poem":1},{"text":"our fathers have told us","poem":2},{"text":"the work You did in their days,","poem":1},{"text":"in the days of old.","poem":2}]},{"number":2,"lines":[{"text":"With Your hand You drove out the nations","poem":1},{"text":"and planted our fathers there;","poem":2},{"text":"You crushed the peoples","poem":1},{"text":"and cast them out.","poem":2}]},{"number":3,"lines":[{"text":"For it was not by their sword that they took the land;","poem":1},{"text":"their arm did not bring them victory.","poem":2},{"text":"It was by Your right hand,","poem":1},{"text":"Your arm, and the light of Your face,","poem":2},{"text":"because You favored them.","poem":2}]},{"number":4,"lines":[{"text":"You are my King, O God,","poem":1},{"text":"who ordains victories for Jacob.","poem":2}]},{"number":5,"lines":[{"text":"Through You we repel our foes;","poem":1},{"text":"through Your name we trample our enemies.","poem":2}]},{"number":6,"lines":[{"text":"For I do not trust in my bow,","poem":1},{"text":"nor does my sword save me.","poem":2}]},{"number":7,"lines":[{"text":"For You save us from our enemies;","poem":1},{"text":"You put those who hate us to shame.","poem":2}]},{"number":8,"lines":[{"text":"In God we have boasted all day long,","poem":1},{"text":"and Your name we will praise forever.","poem":2},{"text":"Selah"}]},{"number":9,"lines":[{"text":"But You have rejected and humbled us;","poem":1},{"text":"You no longer go forth with our armies.","poem":2}]},{"number":10,"lines":[{"text":"You have made us retreat from the foe,","poem":1},{"text":"and those who hate us have plundered us.","poem":2}]},{"number":11,"lines":[{"text":"You have given us up as sheep to be devoured;","poem":1},{"text":"You have scattered us among the nations.","poem":2}]},{"number":12,"lines":[{"text":"You sell Your people for nothing;","poem":1},{"text":"no profit do You gain from their sale.","poem":2}]},{"number":13,"lines":[{"text":"You have made us a reproach to our neighbors,","poem":1},{"text":"a mockery and derision to those around us.","poem":2}]},{"number":14,"lines":[{"text":"You have made us a byword among the nations,","poem":1},{"text":"a laughingstock among the peoples.","poem":2}]},{"number":15,"lines":[{"text":"All day long my disgrace is before me,","poem":1},{"text":"and shame has covered my face,","poem":2}]},{"number":16,"lines":[{"text":"at the voice of the scorner and reviler,","poem":1},{"text":"because of the enemy, bent on revenge.","poem":2}]},{"number":17,"lines":[{"text":"All this has come upon us,","poem":1},{"text":"though we have not forgotten You","poem":2},{"text":"or betrayed Your covenant.","poem":2}]},{"number":18,"lines":[{"text":"Our hearts have not turned back;","poem":1},{"text":"our steps have not strayed from Your path.","poem":2}]},{"number":19,"lines":[{"text":"But You have crushed us in the lair of jackals;","poem":1},{"text":"You have covered us with deepest darkness.","poem":2}]},{"number":20,"lines":[{"text":"If we had forgotten the name of our God","poem":1},{"text":"or spread out our hands to a foreign god,","poem":2}]},{"number":21,"lines":[{"text":"would not God have discovered,","poem":1},{"text":"since He knows the secrets of the heart?","poem":2}]},{"number":22,"lines":[{"text":"Yet for Your sake we face death all day long;","poem":1},{"text":"we are considered as sheep to be slaughtered.","poem":2}]},{"number":23,"lines":[{"text":"Wake up, O Lord! Why are You sleeping?","poem":1},{"text":"Arise! Do not reject us forever.","poem":2}]},{"number":24,"lines":[{"text":"Why do You hide Your face","poem":1},{"text":"and forget our affliction and oppression?","poem":2}]},{"number":25,"lines":[{"text":"For our soul has sunk to the dust;","poem":1},{"text":"our bodies cling to the earth.","poem":2}]},{"number":26,"lines":[{"text":"Rise up; be our help!","poem":1},{"text":"Redeem us on account of Your loving devotion.","poem":2}]}]},{"number":45,"lastVerse":17,"verses":[{"number":1,"lines":[{"text":"My heart is stirred by a noble theme","poem":1},{"text":"as I recite my verses to the king;","poem":2},{"text":"my tongue is the pen of a skillful writer.","poem":2}]},{"number":2,"lines":[{"text":"You are the most handsome of men;","poem":1},{"text":"grace has anointed your lips;","poem":2},{"text":"therefore God has blessed you forever.","poem":2}]},{"number":3,"lines":[{"text":"Strap your sword at your side, O mighty warrior;","poem":1},{"text":"appear in your majesty and splendor.","poem":2}]},{"number":4,"lines":[{"text":"In your splendor ride forth in victory","poem":1},{"text":"on behalf of truth and humility and justice;","poem":2},{"text":"may your right hand show your awesome deeds.","poem":2}]},{"number":5,"lines":[{"text":"Your arrows pierce the hearts of the king’s foes;","poem":1},{"text":"the nations fall beneath your feet.","poem":2}]},{"number":6,"lines":[{"text":"Your throne, O God, endures forever and ever,","poem":1},{"text":"and justice is the scepter of Your kingdom.","poem":2}]},{"number":7,"lines":[{"text":"You have loved righteousness","poem":1},{"text":"and hated wickedness;","poem":2},{"text":"therefore God, your God, has anointed you","poem":1},{"text":"above your companions with the oil of joy.","poem":2}]},{"number":8,"lines":[{"text":"All your garments are fragrant","poem":1},{"text":"with myrrh and aloes and cassia;","poem":2},{"text":"from palaces of ivory the harps make you glad.","poem":2}]},{"number":9,"lines":[{"text":"The daughters of kings are among your honored women;","poem":1},{"text":"the queen stands at your right hand,","poem":2},{"text":"adorned with the gold of Ophir.","poem":2}]},{"number":10,"lines":[{"text":"Listen, O daughter! Consider and incline your ear:","poem":1},{"text":"Forget your people and your father’s house,","poem":2}]},{"number":11,"lines":[{"text":"and the king will desire your beauty;","poem":1},{"text":"bow to him, for he is your lord.","poem":2}]},{"number":12,"lines":[{"text":"The Daughter of Tyre will come with a gift;","poem":1},{"text":"men of wealth will seek your favor.","poem":2}]},{"number":13,"lines":[{"text":"All glorious is the princess in her chamber;","poem":1},{"text":"her gown is embroidered with gold.","poem":2}]},{"number":14,"lines":[{"text":"In colorful garments she is led to the king;","poem":1},{"text":"her virgin companions are brought before you.","poem":2}]},{"number":15,"lines":[{"text":"They are led in with joy and gladness;","poem":1},{"text":"they enter the palace of the king.","poem":2}]},{"number":16,"lines":[{"text":"Your sons will succeed your fathers;","poem":1},{"text":"you will make them princes throughout the land.","poem":2}]},{"number":17,"lines":[{"text":"I will commemorate your name through all generations;","poem":1},{"text":"therefore the nations will praise you forever and ever.","poem":2}]}]},{"number":46,"lastVerse":11,"verses":[{"number":1,"lines":[{"text":"God is our refuge and strength,","poem":1},{"text":"an ever-present help in times of trouble.","poem":2}]},{"number":2,"lines":[{"text":"Therefore we will not fear,","poem":1},{"text":"though the earth is transformed","poem":2},{"text":"and the mountains are toppled","poem":1},{"text":"into the depths of the seas,","poem":2}]},{"number":3,"lines":[{"text":"though their waters roar and foam","poem":1},{"text":"and the mountains quake in the surge.","poem":2},{"text":"Selah"}]},{"number":4,"lines":[{"text":"There is a river whose streams delight the city of God,","poem":1},{"text":"the holy place where the Most High dwells.","poem":2}]},{"number":5,"lines":[{"text":"God is within her; she will not be moved.","poem":1},{"text":"God will help her when morning dawns.","poem":2}]},{"number":6,"lines":[{"text":"Nations rage, kingdoms crumble;","poem":1},{"text":"the earth melts when He lifts His voice.","poem":2}]},{"number":7,"lines":[{"text":"The LORD of Hosts is with us;","poem":1},{"text":"the God of Jacob is our fortress.","poem":2},{"text":"Selah"}]},{"number":8,"lines":[{"text":"Come, see the works of the LORD,","poem":1},{"text":"who brings devastation upon the earth.","poem":2}]},{"number":9,"lines":[{"text":"He makes wars to cease throughout the earth;","poem":1},{"text":"He breaks the bow and shatters the spear;","poem":2},{"text":"He burns the shields in the fire.","poem":2}]},{"number":10,"lines":[{"text":"“Be still and know that I am God;","poem":1},{"text":"I will be exalted among the nations,","poem":2},{"text":"I will be exalted over the earth.”","poem":2}]},{"number":11,"lines":[{"text":"The LORD of Hosts is with us;","poem":1},{"text":"the God of Jacob is our fortress.","poem":2},{"text":"Selah"}]}]},{"number":47,"lastVerse":9,"verses":[{"number":1,"lines":[{"text":"Clap your hands, all you peoples;","poem":1},{"text":"shout unto God with a voice of triumph.","poem":2}]},{"number":2,"lines":[{"text":"How awesome is the LORD Most High,","poem":1},{"text":"the great King over all the earth!","poem":2}]},{"number":3,"lines":[{"text":"He subdues nations beneath us,","poem":1},{"text":"and peoples under our feet.","poem":2}]},{"number":4,"lines":[{"text":"He chooses our inheritance for us,","poem":1},{"text":"the pride of Jacob, whom He loves.","poem":2},{"text":"Selah"}]},{"number":5,"lines":[{"text":"God has ascended amid shouts of joy,","poem":1},{"text":"the LORD with the sound of the horn.","poem":2}]},{"number":6,"lines":[{"text":"Sing praises to God, sing praises;","poem":1},{"text":"sing praises to our King, sing praises!","poem":2}]},{"number":7,"lines":[{"text":"For God is King of all the earth;","poem":1},{"text":"sing to Him a psalm of praise.","poem":2}]},{"number":8,"lines":[{"text":"God reigns over the nations;","poem":1},{"text":"God is seated on His holy throne.","poem":2}]},{"number":9,"lines":[{"text":"The nobles of the nations have assembled","poem":1},{"text":"as the people of the God of Abraham;","poem":2},{"text":"for the shields of the earth belong to God;","poem":1},{"text":"He is highly exalted.","poem":2}]}]},{"number":48,"lastVerse":14,"verses":[{"number":1,"lines":[{"text":"Great is the LORD,","poem":1},{"text":"and greatly to be praised","poem":2},{"text":"in the city of our God,","poem":1},{"text":"His holy mountain.","poem":2}]},{"number":2,"lines":[{"text":"Beautiful in loftiness,","poem":1},{"text":"the joy of all the earth,","poem":2},{"text":"like the peaks of Zaphon is Mount Zion,","poem":1},{"text":"the city of the great King.","poem":2}]},{"number":3,"lines":[{"text":"God is in her citadels;","poem":1},{"text":"He has shown Himself to be a fortress.","poem":2}]},{"number":4,"lines":[{"text":"For behold, the kings assembled;","poem":1},{"text":"they all advanced together.","poem":2}]},{"number":5,"lines":[{"text":"They saw and were astounded;","poem":1},{"text":"they fled in terror.","poem":2}]},{"number":6,"lines":[{"text":"Trembling seized them there,","poem":1},{"text":"anguish like a woman in labor.","poem":2}]},{"number":7,"lines":[{"text":"With a wind from the east","poem":1},{"text":"You wrecked the ships of Tarshish.","poem":2}]},{"number":8,"lines":[{"text":"As we have heard, so we have seen","poem":1},{"text":"in the city of the LORD of Hosts,","poem":2},{"text":"in the city of our God:","poem":1},{"text":"God will establish her forever.","poem":2},{"text":"Selah"}]},{"number":9,"lines":[{"text":"Within Your temple, O God,","poem":1},{"text":"we contemplate Your loving devotion.","poem":2}]},{"number":10,"lines":[{"text":"Your name, O God, like Your praise,","poem":1},{"text":"reaches to the ends of the earth;","poem":2},{"text":"Your right hand is full of righteousness.","poem":2}]},{"number":11,"lines":[{"text":"Mount Zion is glad,","poem":1},{"text":"the daughters of Judah rejoice,","poem":2},{"text":"on account of Your judgments.","poem":2}]},{"number":12,"lines":[{"text":"March around Zion, encircle her,","poem":1},{"text":"count her towers,","poem":2}]},{"number":13,"lines":[{"text":"consider her ramparts, tour her citadels,","poem":1},{"text":"that you may tell the next generation.","poem":2}]},{"number":14,"lines":[{"text":"For this God is our God forever and ever;","poem":1},{"text":"He will be our guide even till death.","poem":2}]}]},{"number":49,"lastVerse":20,"verses":[{"number":1,"lines":[{"text":"Hear this, all you peoples;","poem":1},{"text":"listen, all inhabitants of the world,","poem":2}]},{"number":2,"lines":[{"text":"both low and high,","poem":1},{"text":"rich and poor alike.","poem":2}]},{"number":3,"lines":[{"text":"My mouth will impart wisdom,","poem":1},{"text":"and the meditation of my heart will bring understanding.","poem":2}]},{"number":4,"lines":[{"text":"I will incline my ear to a proverb;","poem":1},{"text":"I will express my riddle with the harp:","poem":2}]},{"number":5,"lines":[{"text":"Why should I fear in times of trouble,","poem":1},{"text":"when wicked usurpers surround me?","poem":2}]},{"number":6,"lines":[{"text":"They trust in their wealth","poem":1},{"text":"and boast in their great riches.","poem":2}]},{"number":7,"lines":[{"text":"No man can possibly redeem his brother","poem":1},{"text":"or pay his ransom to God.","poem":2}]},{"number":8,"lines":[{"text":"For the redemption of his soul is costly,","poem":1},{"text":"and never can payment suffice,","poem":2}]},{"number":9,"lines":[{"text":"that he should live on forever","poem":1},{"text":"and not see decay.","poem":2}]},{"number":10,"lines":[{"text":"For it is clear that wise men die,","poem":1},{"text":"and the foolish and the senseless both perish","poem":2},{"text":"and leave their wealth to others.","poem":2}]},{"number":11,"lines":[{"text":"Their graves are their eternal homes—","poem":1},{"text":"their dwellings for endless generations—","poem":2},{"text":"even though their lands were their namesakes.","poem":2}]},{"number":12,"lines":[{"text":"But a man, despite his wealth, cannot endure;","poem":1},{"text":"he is like the beasts that perish.","poem":2}]},{"number":13,"lines":[{"text":"This is the fate of the foolish","poem":1},{"text":"and their followers who endorse their sayings.","poem":2},{"text":"Selah"}]},{"number":14,"lines":[{"text":"Like sheep they are destined for Sheol.","poem":1},{"text":"Death will be their shepherd.","poem":2},{"text":"The upright will rule them in the morning,","poem":1},{"text":"and their form will decay in Sheol,","poem":2},{"text":"far from their lofty abode.","poem":2}]},{"number":15,"lines":[{"text":"But God will redeem my life from Sheol,","poem":1},{"text":"for He will surely take me to Himself.","poem":2},{"text":"Selah"}]},{"number":16,"lines":[{"text":"Do not be afraid when a man grows rich,","poem":1},{"text":"when the splendor of his house increases.","poem":2}]},{"number":17,"lines":[{"text":"For when he dies, he will carry nothing away;","poem":1},{"text":"his abundance will not follow him down.","poem":2}]},{"number":18,"lines":[{"text":"Though in his lifetime he blesses his soul—","poem":1},{"text":"and men praise you when you prosper—","poem":2}]},{"number":19,"lines":[{"text":"he will join the generation of his fathers,","poem":1},{"text":"who will never see the light of day.","poem":2}]},{"number":20,"lines":[{"text":"A man who has riches without understanding","poem":1},{"text":"is like the beasts that perish.","poem":2}]}]},{"number":50,"lastVerse":23,"verses":[{"number":1,"lines":[{"text":"The Mighty One, God the LORD,","poem":1},{"text":"speaks and summons the earth","poem":2},{"text":"from where the sun rises to where it sets.","poem":2}]},{"number":2,"lines":[{"text":"From Zion, perfect in beauty,","poem":1},{"text":"God shines forth.","poem":2}]},{"number":3,"lines":[{"text":"Our God approaches and will not be silent!","poem":1},{"text":"Consuming fire precedes Him,","poem":2},{"text":"and a tempest rages around Him.","poem":2}]},{"number":4,"lines":[{"text":"He summons the heavens above,","poem":1},{"text":"and the earth, that He may judge His people:","poem":2}]},{"number":5,"lines":[{"text":"“Gather to Me My saints,","poem":1},{"text":"who made a covenant with Me by sacrifice.”","poem":2}]},{"number":6,"lines":[{"text":"And the heavens proclaim His righteousness,","poem":1},{"text":"for God Himself is Judge.","poem":2},{"text":"Selah"}]},{"number":7,"lines":[{"text":"“Hear, O My people, and I will speak,","poem":1},{"text":"O Israel, and I will testify against you:","poem":2},{"text":"I am God, your God.","poem":2}]},{"number":8,"lines":[{"text":"I do not rebuke you for your sacrifices,","poem":1},{"text":"and your burnt offerings are ever before Me.","poem":2}]},{"number":9,"lines":[{"text":"I have no need for a bull from your stall","poem":1},{"text":"or goats from your pens,","poem":2}]},{"number":10,"lines":[{"text":"for every beast of the forest is Mine—","poem":1},{"text":"the cattle on a thousand hills.","poem":2}]},{"number":11,"lines":[{"text":"I know every bird in the mountains,","poem":1},{"text":"and the creatures of the field are Mine.","poem":2}]},{"number":12,"lines":[{"text":"If I were hungry, I would not tell you,","poem":1},{"text":"for the world is Mine, and the fullness thereof.","poem":2}]},{"number":13,"lines":[{"text":"Do I eat the flesh of bulls,","poem":1},{"text":"or drink the blood of goats?","poem":2}]},{"number":14,"lines":[{"text":"Sacrifice a thank offering to God,","poem":1},{"text":"and fulfill your vows to the Most High.","poem":2}]},{"number":15,"lines":[{"text":"Call upon Me in the day of trouble;","poem":1},{"text":"I will deliver you, and you will honor Me.”","poem":2}]},{"number":16,"lines":[{"text":"To the wicked, however, God says,","poem":1},{"text":"“What right have you to recite My statutes","poem":2},{"text":"and to bear My covenant on your lips?","poem":2}]},{"number":17,"lines":[{"text":"For you hate My instruction","poem":1},{"text":"and cast My words behind you.","poem":2}]},{"number":18,"lines":[{"text":"When you see a thief, you befriend him,","poem":1},{"text":"and throw in your lot with adulterers.","poem":2}]},{"number":19,"lines":[{"text":"You unleash your mouth for evil","poem":1},{"text":"and harness your tongue to deceit.","poem":2}]},{"number":20,"lines":[{"text":"You sit and malign your brother;","poem":1},{"text":"you slander your own mother’s son.","poem":2}]},{"number":21,"lines":[{"text":"You have done these things, and I kept silent;","poem":1},{"text":"you thought I was just like you.","poem":2},{"text":"But now I rebuke you","poem":1},{"text":"and accuse you to your face.","poem":2}]},{"number":22,"lines":[{"text":"Now consider this, you who forget God,","poem":1},{"text":"lest I tear you to pieces,","poem":2},{"text":"with no one to rescue you:","poem":2}]},{"number":23,"lines":[{"text":"He who sacrifices a thank offering honors Me,","poem":1},{"text":"and to him who rightly orders his way,","poem":2},{"text":"I will show the salvation of God.”","poem":2}]}]},{"number":51,"lastVerse":19,"verses":[{"number":1,"lines":[{"text":"Have mercy on me, O God,","poem":1},{"text":"according to Your loving devotion;","poem":2},{"text":"according to Your great compassion,","poem":1},{"text":"blot out my transgressions.","poem":2}]},{"number":2,"lines":[{"text":"Wash me clean of my iniquity","poem":1},{"text":"and cleanse me from my sin.","poem":2}]},{"number":3,"lines":[{"text":"For I know my transgressions,","poem":1},{"text":"and my sin is always before me.","poem":2}]},{"number":4,"lines":[{"text":"Against You, You only, have I sinned","poem":1},{"text":"and done what is evil in Your sight,","poem":2},{"text":"so that You may be proved right when You speak","poem":1},{"text":"and blameless when You judge.","poem":2}]},{"number":5,"lines":[{"text":"Surely I was brought forth in iniquity;","poem":1},{"text":"I was sinful when my mother conceived me.","poem":2}]},{"number":6,"lines":[{"text":"Surely You desire truth in the inmost being;","poem":1},{"text":"You teach me wisdom in the inmost place.","poem":2}]},{"number":7,"lines":[{"text":"Purify me with hyssop, and I will be clean;","poem":1},{"text":"wash me, and I will be whiter than snow.","poem":2}]},{"number":8,"lines":[{"text":"Let me hear joy and gladness;","poem":1},{"text":"let the bones You have crushed rejoice.","poem":2}]},{"number":9,"lines":[{"text":"Hide Your face from my sins","poem":1},{"text":"and blot out all my iniquities.","poem":2}]},{"number":10,"lines":[{"text":"Create in me a clean heart, O God,","poem":1},{"text":"and renew a right spirit within me.","poem":2}]},{"number":11,"lines":[{"text":"Cast me not away from Your presence;","poem":1},{"text":"take not Your Holy Spirit from me.","poem":2}]},{"number":12,"lines":[{"text":"Restore to me the joy of Your salvation,","poem":1},{"text":"and sustain me with a willing spirit.","poem":2}]},{"number":13,"lines":[{"text":"Then I will teach transgressors Your ways,","poem":1},{"text":"and sinners will return to You.","poem":2}]},{"number":14,"lines":[{"text":"Deliver me from bloodguilt, O God,","poem":1},{"text":"the God of my salvation,","poem":2},{"text":"and my tongue will sing of Your righteousness.","poem":2}]},{"number":15,"lines":[{"text":"O Lord, open my lips,","poem":1},{"text":"and my mouth will declare Your praise.","poem":2}]},{"number":16,"lines":[{"text":"For You do not delight in sacrifice, or I would bring it;","poem":1},{"text":"You take no pleasure in burnt offerings.","poem":2}]},{"number":17,"lines":[{"text":"The sacrifices of God are a broken spirit;","poem":1},{"text":"a broken and a contrite heart,","poem":2},{"text":"O God, You will not despise.","poem":2}]},{"number":18,"lines":[{"text":"In Your good pleasure, cause Zion to prosper;","poem":1},{"text":"build up the walls of Jerusalem.","poem":2}]},{"number":19,"lines":[{"text":"Then You will delight in righteous sacrifices,","poem":1},{"text":"in whole burnt offerings;","poem":2},{"text":"then bulls will be offered on Your altar.","poem":2}]}]},{"number":52,"lastVerse":9,"verses":[{"number":1,"lines":[{"text":"Why do you boast of evil, O mighty man?","poem":1},{"text":"The loving devotion of God endures all day long.","poem":2}]},{"number":2,"lines":[{"text":"Your tongue devises destruction","poem":1},{"text":"like a sharpened razor,","poem":2},{"text":"O worker of deceit.","poem":2}]},{"number":3,"lines":[{"text":"You love evil more than good,","poem":1},{"text":"falsehood more than speaking truth.","poem":2},{"text":"Selah"}]},{"number":4,"lines":[{"text":"You love every word that devours,","poem":1},{"text":"O deceitful tongue.","poem":2}]},{"number":5,"lines":[{"text":"Surely God will bring you down to everlasting ruin;","poem":1},{"text":"He will snatch you up and tear you away from your tent;","poem":2},{"text":"He will uproot you from the land of the living.","poem":2},{"text":"Selah"}]},{"number":6,"lines":[{"text":"The righteous will see and fear;","poem":1},{"text":"they will mock the evildoer, saying,","poem":2}]},{"number":7,"lines":[{"text":"“Look at the man","poem":1},{"text":"who did not make God his refuge,","poem":2},{"text":"but trusted in the abundance of his wealth","poem":1},{"text":"and strengthened himself by destruction.”","poem":2}]},{"number":8,"lines":[{"text":"But I am like an olive tree","poem":1},{"text":"flourishing in the house of God;","poem":2},{"text":"I trust in the loving devotion of God","poem":1},{"text":"forever and ever.","poem":2}]},{"number":9,"lines":[{"text":"I will praise You forever,","poem":1},{"text":"because You have done it.","poem":2},{"text":"I will wait on Your name—","poem":1},{"text":"for it is good—","poem":2},{"text":"in the presence of Your saints.","poem":2}]}]},{"number":53,"lastVerse":6,"verses":[{"number":1,"lines":[{"text":"The fool says in his heart,","poem":1},{"text":"“There is no God.”","poem":2},{"text":"They are corrupt; their ways are vile.","poem":1},{"text":"There is no one who does good.","poem":2}]},{"number":2,"lines":[{"text":"God looks down from heaven","poem":1},{"text":"upon the sons of men","poem":2},{"text":"to see if any understand,","poem":1},{"text":"if any seek God.","poem":2}]},{"number":3,"lines":[{"text":"All have turned away,","poem":1},{"text":"they have together become corrupt;","poem":2},{"text":"there is no one who does good,","poem":1},{"text":"not even one.","poem":2}]},{"number":4,"lines":[{"text":"Will the workers of iniquity never learn?","poem":1},{"text":"They devour my people like bread;","poem":1},{"text":"they refuse to call upon God.","poem":2}]},{"number":5,"lines":[{"text":"There they are, overwhelmed with dread,","poem":1},{"text":"where there was nothing to fear.","poem":2},{"text":"For God has scattered the bones","poem":1},{"text":"of those who besieged you.","poem":2},{"text":"You put them to shame,","poem":1},{"text":"for God has despised them.","poem":2}]},{"number":6,"lines":[{"text":"Oh, that the salvation of Israel would come from Zion!","poem":1},{"text":"When God restores His captive people,","poem":1},{"text":"let Jacob rejoice, let Israel be glad!","poem":2}]}]},{"number":54,"lastVerse":7,"verses":[{"number":1,"lines":[{"text":"Save me, O God, by Your name,","poem":1},{"text":"and vindicate me by Your might!","poem":2}]},{"number":2,"lines":[{"text":"Hear my prayer, O God;","poem":1},{"text":"listen to the words of my mouth.","poem":2}]},{"number":3,"lines":[{"text":"For strangers rise up against me,","poem":1},{"text":"and ruthless men seek my life—","poem":2},{"text":"men with no regard for God.","poem":2},{"text":"Selah"}]},{"number":4,"lines":[{"text":"Surely God is my helper;","poem":1},{"text":"the Lord is the sustainer of my soul.","poem":2}]},{"number":5,"lines":[{"text":"He will reward my enemies with evil.","poem":1},{"text":"In Your faithfulness, destroy them.","poem":2}]},{"number":6,"lines":[{"text":"Freely I will sacrifice to You;","poem":1},{"text":"I will praise Your name, O LORD, for it is good.","poem":2}]},{"number":7,"lines":[{"text":"For He has delivered me from every trouble,","poem":1},{"text":"and my eyes have looked in triumph on my foes.","poem":2}]}]},{"number":55,"lastVerse":23,"verses":[{"number":1,"lines":[{"text":"Listen to my prayer, O God,","poem":1},{"text":"and do not ignore my plea.","poem":2}]},{"number":2,"lines":[{"text":"Attend to me and answer me.","poem":1},{"text":"I am restless in my complaint,","poem":2},{"text":"and distraught","poem":1}]},{"number":3,"lines":[{"text":"at the voice of the enemy,","poem":1},{"text":"at the pressure of the wicked.","poem":2},{"text":"For they bring down disaster upon me","poem":1},{"text":"and resent me in their anger.","poem":2}]},{"number":4,"lines":[{"text":"My heart pounds within me,","poem":1},{"text":"and the terrors of death assail me.","poem":2}]},{"number":5,"lines":[{"text":"Fear and trembling grip me,","poem":1},{"text":"and horror has overwhelmed me.","poem":2}]},{"number":6,"lines":[{"text":"I said, “Oh, that I had wings like a dove!","poem":1},{"text":"I would fly away and find rest.","poem":2}]},{"number":7,"lines":[{"text":"How far away I would flee!","poem":1},{"text":"In the wilderness I would remain.","poem":2},{"text":"Selah"}]},{"number":8,"lines":[{"text":"I would hurry to my shelter,","poem":1},{"text":"far from this raging tempest.”","poem":2}]},{"number":9,"lines":[{"text":"O Lord, confuse and confound their speech,","poem":1},{"text":"for I see violence and strife in the city.","poem":2}]},{"number":10,"lines":[{"text":"Day and night they encircle the walls,","poem":1},{"text":"while malice and trouble lie within.","poem":2}]},{"number":11,"lines":[{"text":"Destruction is within;","poem":1},{"text":"oppression and deceit never leave the streets.","poem":2}]},{"number":12,"lines":[{"text":"For it is not an enemy who insults me;","poem":1},{"text":"that I could endure.","poem":2},{"text":"It is not a foe who rises against me;","poem":1},{"text":"from him I could hide.","poem":2}]},{"number":13,"lines":[{"text":"But it is you, a man like myself,","poem":1},{"text":"my companion and close friend.","poem":2}]},{"number":14,"lines":[{"text":"We shared sweet fellowship together;","poem":1},{"text":"we walked with the crowd into the house of God.","poem":2}]},{"number":15,"lines":[{"text":"Let death seize them by surprise;","poem":1},{"text":"let them go down to Sheol alive,","poem":2},{"text":"for evil is with them in their homes.","poem":2}]},{"number":16,"lines":[{"text":"But I call to God,","poem":1},{"text":"and the LORD saves me.","poem":2}]},{"number":17,"lines":[{"text":"Morning, noon, and night, I cry out in distress,","poem":1},{"text":"and He hears my voice.","poem":2}]},{"number":18,"lines":[{"text":"He redeems my soul in peace","poem":1},{"text":"from the battle waged against me,","poem":2},{"text":"even though many oppose me.","poem":2}]},{"number":19,"lines":[{"text":"God will hear and humiliate them—","poem":1},{"text":"the One enthroned for the ages—","poem":2},{"text":"Selah"},{"text":"because they do not change","poem":1},{"text":"and they have no fear of God.","poem":2}]},{"number":20,"lines":[{"text":"My companion attacks his friends;","poem":1},{"text":"he violates his covenant.","poem":2}]},{"number":21,"lines":[{"text":"His speech is smooth as butter,","poem":1},{"text":"but war is in his heart.","poem":2},{"text":"His words are softer than oil,","poem":1},{"text":"yet they are swords unsheathed.","poem":2}]},{"number":22,"lines":[{"text":"Cast your burden upon the LORD","poem":1},{"text":"and He will sustain you;","poem":2},{"text":"He will never let the righteous be shaken.","poem":2}]},{"number":23,"lines":[{"text":"But You, O God, will bring them down","poem":1},{"text":"to the Pit of destruction;","poem":2},{"text":"men of bloodshed and deceit","poem":1},{"text":"will not live out half their days.","poem":2},{"text":"But I will trust in You.","poem":1}]}]},{"number":56,"lastVerse":13,"verses":[{"number":1,"lines":[{"text":"Be merciful to me, O God,","poem":1},{"text":"for men are hounding me;","poem":2},{"text":"all day they press their attack.","poem":2}]},{"number":2,"lines":[{"text":"My enemies pursue me all day long,","poem":1},{"text":"for many proudly assail me.","poem":2}]},{"number":3,"lines":[{"text":"When I am afraid,","poem":1},{"text":"I put my trust in You.","poem":2}]},{"number":4,"lines":[{"text":"In God, whose word I praise—","poem":1},{"text":"in God I trust.","poem":2},{"text":"I will not be afraid.","poem":1},{"text":"What can man do to me?","poem":2}]},{"number":5,"lines":[{"text":"All day long they twist my words;","poem":1},{"text":"all their thoughts are on my demise.","poem":2}]},{"number":6,"lines":[{"text":"They conspire, they lurk,","poem":1},{"text":"they watch my steps","poem":2},{"text":"while they wait to take my life.","poem":2}]},{"number":7,"lines":[{"text":"In spite of such sin, will they escape?","poem":1},{"text":"In Your anger, O God, cast down the nations.","poem":2}]},{"number":8,"lines":[{"text":"You have taken account of my wanderings.","poem":1},{"text":"Put my tears in Your bottle—","poem":2},{"text":"are they not in Your book?","poem":2}]},{"number":9,"lines":[{"text":"Then my enemies will retreat","poem":1},{"text":"on the day I cry for help.","poem":2},{"text":"By this I will know that God is on my side.","poem":2}]},{"number":10,"lines":[{"text":"In God, whose word I praise,","poem":1},{"text":"in the LORD, whose word I praise,","poem":2}]},{"number":11,"lines":[{"text":"in God I trust; I will not be afraid.","poem":1},{"text":"What can man do to me?","poem":2}]},{"number":12,"lines":[{"text":"Your vows are upon me, O God;","poem":1},{"text":"I will render thank offerings to You.","poem":2}]},{"number":13,"lines":[{"text":"For You have delivered my soul from death,","poem":1},{"text":"and my feet from stumbling,","poem":2},{"text":"that I may walk before God","poem":1},{"text":"in the light of life.","poem":2}]}]},{"number":57,"lastVerse":11,"verses":[{"number":1,"lines":[{"text":"Have mercy on me, O God, have mercy,","poem":1},{"text":"for in You my soul takes refuge.","poem":2},{"text":"In the shadow of Your wings I will take shelter","poem":1},{"text":"until the danger has passed.","poem":2}]},{"number":2,"lines":[{"text":"I cry out to God Most High,","poem":1},{"text":"to God who fulfills His purpose for me.","poem":2}]},{"number":3,"lines":[{"text":"He reaches down from heaven and saves me;","poem":1},{"text":"He rebukes those who trample me.","poem":2},{"text":"Selah"},{"text":"God sends forth","poem":1},{"text":"His loving devotion and His truth.","poem":2}]},{"number":4,"lines":[{"text":"My soul is among the lions;","poem":1},{"text":"I lie down with ravenous beasts—","poem":2},{"text":"with men whose teeth are spears and arrows,","poem":1},{"text":"whose tongues are sharp swords.","poem":2}]},{"number":5,"lines":[{"text":"Be exalted, O God, above the heavens;","poem":1},{"text":"may Your glory cover all the earth.","poem":2}]},{"number":6,"lines":[{"text":"They spread a net for my feet;","poem":1},{"text":"my soul was despondent.","poem":2},{"text":"They dug a pit before me,","poem":1},{"text":"but they themselves have fallen into it!","poem":2},{"text":"Selah"}]},{"number":7,"lines":[{"text":"My heart is steadfast, O God, my heart is steadfast.","poem":1},{"text":"I will sing and make music.","poem":2}]},{"number":8,"lines":[{"text":"Awake, my glory!","poem":1},{"text":"Awake, O harp and lyre!","poem":2},{"text":"I will awaken the dawn.","poem":2}]},{"number":9,"lines":[{"text":"I will praise You, O Lord, among the nations;","poem":1},{"text":"I will sing Your praises among the peoples.","poem":2}]},{"number":10,"lines":[{"text":"For Your loving devotion reaches to the heavens,","poem":1},{"text":"and Your faithfulness to the clouds.","poem":2}]},{"number":11,"lines":[{"text":"Be exalted, O God, above the heavens;","poem":1},{"text":"may Your glory cover all the earth.","poem":2}]}]},{"number":58,"lastVerse":11,"verses":[{"number":1,"lines":[{"text":"Do you indeed speak justly, O rulers?","poem":1},{"text":"Do you judge uprightly, O sons of men?","poem":2}]},{"number":2,"lines":[{"text":"No, in your hearts you devise injustice;","poem":1},{"text":"with your hands you mete out violence on the earth.","poem":2}]},{"number":3,"lines":[{"text":"The wicked are estranged from the womb;","poem":1},{"text":"the liars go astray from birth.","poem":2}]},{"number":4,"lines":[{"text":"Their venom is like the venom of a snake,","poem":1},{"text":"like a cobra that shuts its ears,","poem":2}]},{"number":5,"lines":[{"text":"refusing to hear the tune of the charmer","poem":1},{"text":"who skillfully weaves his spell.","poem":2}]},{"number":6,"lines":[{"text":"O God, shatter their teeth in their mouths;","poem":1},{"text":"O LORD, tear out the fangs of the lions.","poem":2}]},{"number":7,"lines":[{"text":"May they vanish","poem":1},{"text":"like water that runs off;","poem":2},{"text":"when they draw the bow,","poem":1},{"text":"may their arrows be blunted.","poem":2}]},{"number":8,"lines":[{"text":"Like a slug that dissolves in its slime,","poem":1},{"text":"like a woman’s stillborn child,","poem":2},{"text":"may they never see the sun.","poem":2}]},{"number":9,"lines":[{"text":"Before your pots can feel the burning thorns—","poem":1},{"text":"whether green or dry—","poem":2},{"text":"He will sweep them away.","poem":2}]},{"number":10,"lines":[{"text":"The righteous will rejoice","poem":1},{"text":"when they see they are avenged;","poem":2},{"text":"they will wash their feet","poem":1},{"text":"in the blood of the wicked.","poem":2}]},{"number":11,"lines":[{"text":"Then men will say,","poem":1},{"text":"“There is surely a reward for the righteous!","poem":2},{"text":"There is surely a God who judges the earth!”","poem":2}]}]},{"number":59,"lastVerse":17,"verses":[{"number":1,"lines":[{"text":"Deliver me from my enemies, O my God;","poem":1},{"text":"protect me from those who rise against me.","poem":2}]},{"number":2,"lines":[{"text":"Deliver me from workers of iniquity,","poem":1},{"text":"and save me from men of bloodshed.","poem":2}]},{"number":3,"lines":[{"text":"See how they lie in wait for me.","poem":1},{"text":"Fierce men conspire against me","poem":2},{"text":"for no transgression or sin of my own, O LORD.","poem":2}]},{"number":4,"lines":[{"text":"For no fault of my own,","poem":1},{"text":"they move swiftly to attack me.","poem":2},{"text":"Arise to help me, and take notice.","poem":2}]},{"number":5,"lines":[{"text":"O LORD God of Hosts, the God of Israel,","poem":1},{"text":"rouse Yourself to punish all the nations;","poem":2},{"text":"show no mercy to the wicked traitors.","poem":2},{"text":"Selah"}]},{"number":6,"lines":[{"text":"They return in the evening, snarling like dogs","poem":1},{"text":"and prowling around the city.","poem":2}]},{"number":7,"lines":[{"text":"See what they spew from their mouths—","poem":1},{"text":"sharp words from their lips:","poem":2},{"text":"“For who can hear us?”","poem":2}]},{"number":8,"lines":[{"text":"But You, O LORD, laugh at them;","poem":1},{"text":"You scoff at all the nations.","poem":2}]},{"number":9,"lines":[{"text":"I will keep watch for You, O my strength,","poem":1},{"text":"because You, O God, are my fortress.","poem":2}]},{"number":10,"lines":[{"text":"My God of loving devotion will come to meet me;","poem":1},{"text":"God will let me stare down my foes.","poem":2}]},{"number":11,"lines":[{"text":"Do not kill them,","poem":1},{"text":"or my people will forget.","poem":2},{"text":"Scatter them by Your power,","poem":1},{"text":"and bring them down,","poem":2},{"text":"O Lord, our shield.","poem":2}]},{"number":12,"lines":[{"text":"By the sins of their mouths","poem":1},{"text":"and the words of their lips,","poem":2},{"text":"let them be trapped in their pride,","poem":1},{"text":"in the curses and lies they utter.","poem":2}]},{"number":13,"lines":[{"text":"Consume them in wrath;","poem":1},{"text":"consume them till they are no more,","poem":2},{"text":"so it may be known to the ends of the earth","poem":1},{"text":"that God rules over Jacob.","poem":2},{"text":"Selah"}]},{"number":14,"lines":[{"text":"They return in the evening,","poem":1},{"text":"snarling like dogs","poem":2},{"text":"and prowling around the city.","poem":2}]},{"number":15,"lines":[{"text":"They scavenge for food,","poem":1},{"text":"and growl if they are not satisfied.","poem":2}]},{"number":16,"lines":[{"text":"But I will sing of Your strength","poem":1},{"text":"and proclaim Your loving devotion in the morning.","poem":2},{"text":"For You are my fortress,","poem":1},{"text":"my refuge in times of trouble.","poem":2}]},{"number":17,"lines":[{"text":"To You, O my strength, I sing praises,","poem":1},{"text":"for You, O God, are my fortress,","poem":2},{"text":"my God of loving devotion.","poem":2}]}]},{"number":60,"lastVerse":12,"verses":[{"number":1,"lines":[{"text":"You have rejected us, O God;","poem":1},{"text":"You have broken us;","poem":2},{"text":"You have been angry;","poem":1},{"text":"restore us!","poem":2}]},{"number":2,"lines":[{"text":"You have shaken the land","poem":1},{"text":"and torn it open.","poem":2},{"text":"Heal its fractures,","poem":1},{"text":"for it is quaking.","poem":2}]},{"number":3,"lines":[{"text":"You have shown Your people hardship;","poem":1},{"text":"we are staggered from the wine You made us drink.","poem":2}]},{"number":4,"lines":[{"text":"You have raised a banner for those who fear You,","poem":1},{"text":"that they may flee the bow.","poem":2},{"text":"Selah"}]},{"number":5,"lines":[{"text":"Respond and save us with Your right hand,","poem":1},{"text":"that Your beloved may be delivered.","poem":2}]},{"number":6,"lines":[{"text":"God has spoken from His sanctuary:","poem":1},{"text":"“I will triumph!","poem":2},{"text":"I will parcel out Shechem","poem":1},{"text":"and apportion the Valley of Succoth.","poem":2}]},{"number":7,"lines":[{"text":"Gilead is Mine, and Manasseh is Mine;","poem":1},{"text":"Ephraim is My helmet, Judah is My scepter.","poem":2}]},{"number":8,"lines":[{"text":"Moab is My washbasin;","poem":1},{"text":"upon Edom I toss My sandal;","poem":2},{"text":"over Philistia I shout in triumph.”","poem":2}]},{"number":9,"lines":[{"text":"Who will bring me to the fortified city?","poem":1},{"text":"Who will lead me to Edom?","poem":2}]},{"number":10,"lines":[{"text":"Have You not rejected us, O God?","poem":1},{"text":"Will You no longer march out, O God, with our armies?","poem":2}]},{"number":11,"lines":[{"text":"Give us aid against the enemy,","poem":1},{"text":"for the help of man is worthless.","poem":2}]},{"number":12,"lines":[{"text":"With God we will perform with valor,","poem":1},{"text":"and He will trample our enemies.","poem":2}]}]},{"number":61,"lastVerse":8,"verses":[{"number":1,"lines":[{"text":"Hear my cry, O God;","poem":1},{"text":"attend to my prayer.","poem":2}]},{"number":2,"lines":[{"text":"From the ends of the earth I call out to You","poem":1},{"text":"whenever my heart is faint.","poem":2},{"text":"Lead me to the rock","poem":1},{"text":"that is higher than I.","poem":2}]},{"number":3,"lines":[{"text":"For You have been my refuge,","poem":1},{"text":"a tower of strength against the enemy.","poem":2}]},{"number":4,"lines":[{"text":"Let me dwell in Your tent forever","poem":1},{"text":"and take refuge in the shelter of Your wings.","poem":2},{"text":"Selah"}]},{"number":5,"lines":[{"text":"For You have heard my vows, O God;","poem":1},{"text":"You have given me the inheritance","poem":2},{"text":"reserved for those who fear Your name.","poem":2}]},{"number":6,"lines":[{"text":"Increase the days of the king’s life;","poem":1},{"text":"may his years span many generations.","poem":2}]},{"number":7,"lines":[{"text":"May he sit enthroned in God’s presence forever;","poem":1},{"text":"appoint Your loving devotion","poem":2},{"text":"and Your faithfulness to guard him.","poem":2}]},{"number":8,"lines":[{"text":"Then I will ever sing praise to Your name","poem":1},{"text":"and fulfill my vows day by day.","poem":2}]}]},{"number":62,"lastVerse":12,"verses":[{"number":1,"lines":[{"text":"In God alone my soul finds rest;","poem":1},{"text":"my salvation comes from Him.","poem":2}]},{"number":2,"lines":[{"text":"He alone is my rock and my salvation.","poem":1},{"text":"He is my fortress;","poem":2},{"text":"I will never be shaken.","poem":2}]},{"number":3,"lines":[{"text":"How long will you threaten a man?","poem":1},{"text":"Will all of you throw him down","poem":2},{"text":"like a leaning wall","poem":1},{"text":"or a tottering fence?","poem":2}]},{"number":4,"lines":[{"text":"They fully intend to cast him down from his lofty perch;","poem":1},{"text":"they delight in lies;","poem":2},{"text":"with their mouths they bless,","poem":1},{"text":"but inwardly they curse.","poem":2},{"text":"Selah"}]},{"number":5,"lines":[{"text":"Rest in God alone, O my soul,","poem":1},{"text":"for my hope comes from Him.","poem":2}]},{"number":6,"lines":[{"text":"He alone is my rock and my salvation;","poem":1},{"text":"He is my fortress; I will not be shaken.","poem":2}]},{"number":7,"lines":[{"text":"My salvation and my honor rest on God, my strong rock;","poem":1},{"text":"my refuge is in God.","poem":2}]},{"number":8,"lines":[{"text":"Trust in Him at all times, O people;","poem":1},{"text":"pour out your hearts before Him.","poem":2},{"text":"God is our refuge.","poem":2},{"text":"Selah"}]},{"number":9,"lines":[{"text":"Lowborn men are but a vapor;","poem":1},{"text":"the exalted are but a lie.","poem":2},{"text":"Weighed on the scale, they go up;","poem":1},{"text":"together they are but a vapor.","poem":2}]},{"number":10,"lines":[{"text":"Place no trust in extortion","poem":1},{"text":"or false hope in stolen goods.","poem":2},{"text":"If your riches increase,","poem":1},{"text":"do not set your heart upon them.","poem":2}]},{"number":11,"lines":[{"text":"God has spoken once;","poem":1},{"text":"I have heard this twice:","poem":2},{"text":"that power belongs to God,","poem":1}]},{"number":12,"lines":[{"text":"and loving devotion to You, O Lord.","poem":2},{"text":"For You will repay each man","poem":1},{"text":"according to his deeds.","poem":2}]}]},{"number":63,"lastVerse":11,"verses":[{"number":1,"lines":[{"text":"O God, You are my God.","poem":1},{"text":"Earnestly I seek You;","poem":2},{"text":"my soul thirsts for You.","poem":2},{"text":"My body yearns for You","poem":1},{"text":"in a dry and weary land without water.","poem":2}]},{"number":2,"lines":[{"text":"So I have seen You in the sanctuary","poem":1},{"text":"and beheld Your power and glory.","poem":2}]},{"number":3,"lines":[{"text":"Because Your loving devotion is better than life,","poem":1},{"text":"my lips will glorify You.","poem":2}]},{"number":4,"lines":[{"text":"So I will bless You as long as I live;","poem":1},{"text":"in Your name I will lift my hands.","poem":2}]},{"number":5,"lines":[{"text":"My soul is satisfied as with the richest of foods;","poem":1},{"text":"with joyful lips my mouth will praise You.","poem":2}]},{"number":6,"lines":[{"text":"When I remember You on my bed,","poem":1},{"text":"I think of You through the watches of the night.","poem":2}]},{"number":7,"lines":[{"text":"For You are my help;","poem":1},{"text":"I will sing for joy in the shadow of Your wings.","poem":2}]},{"number":8,"lines":[{"text":"My soul clings to You;","poem":1},{"text":"Your right hand upholds me.","poem":2}]},{"number":9,"lines":[{"text":"But those who seek my life to destroy it","poem":1},{"text":"will go into the depths of the earth.","poem":2}]},{"number":10,"lines":[{"text":"They will fall to the power of the sword;","poem":1},{"text":"they will become a portion for foxes.","poem":2}]},{"number":11,"lines":[{"text":"But the king will rejoice in God;","poem":1},{"text":"all who swear by Him will exult,","poem":2},{"text":"for the mouths of liars will be shut.","poem":2}]}]},{"number":64,"lastVerse":10,"verses":[{"number":1,"lines":[{"text":"Hear, O God, my voice of complaint;","poem":1},{"text":"preserve my life from dread of the enemy.","poem":2}]},{"number":2,"lines":[{"text":"Hide me from the scheming of the wicked,","poem":1},{"text":"from the mob of workers of iniquity,","poem":2}]},{"number":3,"lines":[{"text":"who sharpen their tongues like swords","poem":1},{"text":"and aim their bitter words like arrows,","poem":2}]},{"number":4,"lines":[{"text":"ambushing the innocent in seclusion,","poem":1},{"text":"shooting suddenly, without fear.","poem":2}]},{"number":5,"lines":[{"text":"They hold fast to their evil purpose;","poem":1},{"text":"they speak of hiding their snares.","poem":2},{"text":"“Who will see them?” they say.","poem":2}]},{"number":6,"lines":[{"text":"They devise injustice and say,","poem":1},{"text":"“We have perfected a secret plan.”","poem":2},{"text":"For the inner man and the heart are mysterious.","poem":2}]},{"number":7,"lines":[{"text":"But God will shoot them with arrows;","poem":1},{"text":"suddenly they will be wounded.","poem":2}]},{"number":8,"lines":[{"text":"They will be made to stumble,","poem":1},{"text":"their own tongues turned against them.","poem":2},{"text":"All who see will shake their heads.","poem":2}]},{"number":9,"lines":[{"text":"Then all mankind will fear","poem":1},{"text":"and proclaim the work of God;","poem":2},{"text":"so they will ponder what He has done.","poem":2}]},{"number":10,"lines":[{"text":"Let the righteous rejoice in the LORD","poem":1},{"text":"and take refuge in Him;","poem":2},{"text":"let all the upright in heart exult.","poem":2}]}]},{"number":65,"lastVerse":13,"verses":[{"number":1,"lines":[{"text":"Praise awaits You, O God, in Zion;","poem":1},{"text":"to You our vows will be fulfilled.","poem":2}]},{"number":2,"lines":[{"text":"O You who listen to prayer,","poem":1},{"text":"all people will come to You.","poem":2}]},{"number":3,"lines":[{"text":"When iniquities prevail against me,","poem":1},{"text":"You atone for our transgressions.","poem":2}]},{"number":4,"lines":[{"text":"Blessed is the one You choose","poem":1},{"text":"and bring near to dwell in Your courts!","poem":2},{"text":"We are filled with the goodness of Your house,","poem":1},{"text":"the holiness of Your temple.","poem":2}]},{"number":5,"lines":[{"text":"With awesome deeds of righteousness You answer us,","poem":1},{"text":"O God of our salvation,","poem":2},{"text":"the hope of all the ends of the earth","poem":1},{"text":"and of the farthest seas.","poem":2}]},{"number":6,"lines":[{"text":"You formed the mountains by Your power,","poem":1},{"text":"having girded Yourself with might.","poem":2}]},{"number":7,"lines":[{"text":"You stilled the roaring of the seas,","poem":1},{"text":"the pounding of their waves,","poem":2},{"text":"and the tumult of the nations.","poem":2}]},{"number":8,"lines":[{"text":"Those who live far away fear Your wonders;","poem":1},{"text":"You make the dawn and sunset shout for joy.","poem":2}]},{"number":9,"lines":[{"text":"You attend to the earth and water it;","poem":1},{"text":"with abundance You enrich it.","poem":2},{"text":"The streams of God are full of water,","poem":1},{"text":"for You prepare our grain","poem":2},{"text":"by providing for the earth.","poem":2}]},{"number":10,"lines":[{"text":"You soak its furrows and level its ridges;","poem":1},{"text":"You soften it with showers and bless its growth.","poem":2}]},{"number":11,"lines":[{"text":"You crown the year with Your bounty,","poem":1},{"text":"and Your paths overflow with plenty.","poem":2}]},{"number":12,"lines":[{"text":"The pastures of the wilderness overflow;","poem":1},{"text":"the hills are robed with joy.","poem":2}]},{"number":13,"lines":[{"text":"The pastures are clothed with flocks,","poem":1},{"text":"and the valleys are decked with grain.","poem":2},{"text":"They shout in triumph;","poem":1},{"text":"indeed, they sing.","poem":2}]}]},{"number":66,"lastVerse":20,"verses":[{"number":1,"lines":[{"text":"Make a joyful noise to God,","poem":1},{"text":"all the earth!","poem":2}]},{"number":2,"lines":[{"text":"Sing the glory of His name;","poem":1},{"text":"make His praise glorious.","poem":2}]},{"number":3,"lines":[{"text":"Say to God, “How awesome are Your deeds!","poem":1},{"text":"So great is Your power","poem":2},{"text":"that Your enemies cower before You.","poem":2}]},{"number":4,"lines":[{"text":"All the earth bows down to You;","poem":1},{"text":"they sing praise to You;","poem":2},{"text":"they sing praise to Your name.”","poem":2},{"text":"Selah"}]},{"number":5,"lines":[{"text":"Come and see the works of God;","poem":1},{"text":"how awesome are His deeds toward mankind.","poem":2}]},{"number":6,"lines":[{"text":"He turned the sea into dry land;","poem":1},{"text":"they passed through the waters on foot;","poem":2},{"text":"there we rejoiced in Him.","poem":2}]},{"number":7,"lines":[{"text":"He rules forever by His power;","poem":1},{"text":"His eyes watch the nations.","poem":2},{"text":"Do not let the rebellious exalt themselves.","poem":2},{"text":"Selah"}]},{"number":8,"lines":[{"text":"Bless our God, O peoples;","poem":1},{"text":"let the sound of His praise be heard.","poem":2}]},{"number":9,"lines":[{"text":"He preserves our lives","poem":1},{"text":"and keeps our feet from slipping.","poem":2}]},{"number":10,"lines":[{"text":"For You, O God, have tested us;","poem":1},{"text":"You have refined us like silver.","poem":2}]},{"number":11,"lines":[{"text":"You led us into the net;","poem":1},{"text":"You laid burdens on our backs.","poem":2}]},{"number":12,"lines":[{"text":"You let men ride over our heads;","poem":1},{"text":"we went through fire and water,","poem":2},{"text":"but You brought us into abundance.","poem":2}]},{"number":13,"lines":[{"text":"I will enter Your house with burnt offerings;","poem":1},{"text":"I will fulfill my vows to You—","poem":2}]},{"number":14,"lines":[{"text":"the vows that my lips promised","poem":1},{"text":"and my mouth spoke in my distress.","poem":2}]},{"number":15,"lines":[{"text":"I will offer You fatlings as burnt offerings,","poem":1},{"text":"with the fragrant smoke of rams;","poem":2},{"text":"I will offer bulls and goats.","poem":2},{"text":"Selah"}]},{"number":16,"lines":[{"text":"Come and listen, all you who fear God,","poem":1},{"text":"and I will declare what He has done for me.","poem":2}]},{"number":17,"lines":[{"text":"I cried out to Him with my mouth","poem":1},{"text":"and praised Him with my tongue.","poem":2}]},{"number":18,"lines":[{"text":"If I had cherished iniquity in my heart,","poem":1},{"text":"the Lord would not have listened.","poem":2}]},{"number":19,"lines":[{"text":"But God has surely heard;","poem":1},{"text":"He has attended to the sound of my prayer.","poem":2}]},{"number":20,"lines":[{"text":"Blessed be God, who has not rejected my prayer","poem":1},{"text":"or withheld from me His loving devotion!","poem":2}]}]},{"number":67,"lastVerse":7,"verses":[{"number":1,"lines":[{"text":"May God be gracious to us and bless us,","poem":1},{"text":"and cause His face to shine upon us,","poem":2},{"text":"Selah"}]},{"number":2,"lines":[{"text":"that Your ways may be known on earth,","poem":1},{"text":"Your salvation among all nations.","poem":2}]},{"number":3,"lines":[{"text":"Let the peoples praise You, O God;","poem":1},{"text":"let all the peoples praise You.","poem":2}]},{"number":4,"lines":[{"text":"Let the nations be glad and sing for joy,","poem":1},{"text":"for You judge the peoples justly","poem":2},{"text":"and lead the nations of the earth.","poem":2},{"text":"Selah"}]},{"number":5,"lines":[{"text":"Let the peoples praise You, O God;","poem":1},{"text":"let all the peoples praise You.","poem":2}]},{"number":6,"lines":[{"text":"The earth has yielded its harvest;","poem":1},{"text":"God, our God, blesses us.","poem":2}]},{"number":7,"lines":[{"text":"God blesses us,","poem":1},{"text":"that all the ends of the earth shall fear Him.","poem":2}]}]},{"number":68,"lastVerse":35,"verses":[{"number":1,"lines":[{"text":"God arises. His enemies are scattered,","poem":1},{"text":"and those who hate Him flee His presence.","poem":2}]},{"number":2,"lines":[{"text":"As smoke is blown away,","poem":1},{"text":"You will drive them out;","poem":2},{"text":"as wax melts before the fire,","poem":1},{"text":"the wicked will perish in the presence of God.","poem":2}]},{"number":3,"lines":[{"text":"But the righteous will be glad","poem":1},{"text":"and rejoice before God;","poem":2},{"text":"they will celebrate with joy.","poem":2}]},{"number":4,"lines":[{"text":"Sing to God!","poem":1},{"text":"Sing praises to His name.","poem":2},{"text":"Exalt Him who rides on the clouds —","poem":1},{"text":"His name is the LORD—","poem":2},{"text":"and rejoice before Him.","poem":2}]},{"number":5,"lines":[{"text":"A father of the fatherless","poem":1},{"text":"and a defender of widows","poem":2},{"text":"is God in His holy habitation.","poem":2}]},{"number":6,"lines":[{"text":"God settles the lonely in families;","poem":1},{"text":"He leads the prisoners out to prosperity,","poem":2},{"text":"but the rebellious dwell in a sun-scorched land.","poem":2}]},{"number":7,"lines":[{"text":"O God, when You went out before Your people,","poem":1},{"text":"when You marched through the wasteland,","poem":2},{"text":"Selah"}]},{"number":8,"lines":[{"text":"the earth shook and the heavens poured down rain","poem":1},{"text":"before God, the One on Sinai,","poem":2},{"text":"before God, the God of Israel.","poem":2}]},{"number":9,"lines":[{"text":"You sent abundant rain, O God;","poem":1},{"text":"You refreshed Your weary inheritance.","poem":2}]},{"number":10,"lines":[{"text":"Your flock settled therein;","poem":1},{"text":"O God, from Your bounty You provided for the poor.","poem":2}]},{"number":11,"lines":[{"text":"The Lord gives the command;","poem":1},{"text":"a great company of women proclaim it:","poem":2}]},{"number":12,"lines":[{"text":"“Kings and their armies flee in haste;","poem":1},{"text":"she who waits at home divides the plunder.","poem":2}]},{"number":13,"lines":[{"text":"Though you lie down among the sheepfolds,","poem":1},{"text":"the wings of the dove are covered with silver,","poem":2},{"text":"and her feathers with shimmering gold.”","poem":2}]},{"number":14,"lines":[{"text":"When the Almighty scattered the kings in the land,","poem":1},{"text":"it was like the snow falling on Zalmon.","poem":2}]},{"number":15,"lines":[{"text":"A mountain of God is Mount Bashan;","poem":1},{"text":"a mountain of many peaks is Mount Bashan.","poem":2}]},{"number":16,"lines":[{"text":"Why do you gaze in envy, O mountains of many peaks?","poem":1},{"text":"This is the mountain God chose for His dwelling,","poem":2},{"text":"where the LORD will surely dwell forever.","poem":2}]},{"number":17,"lines":[{"text":"The chariots of God are tens of thousands—","poem":1},{"text":"thousands of thousands are they;","poem":2},{"text":"the Lord is in His sanctuary","poem":1},{"text":"as He was at Sinai.","poem":2}]},{"number":18,"lines":[{"text":"You have ascended on high;","poem":1},{"text":"You have led captives away.","poem":2},{"text":"You have received gifts from men,","poem":1},{"text":"even from the rebellious,","poem":2},{"text":"that the LORD God may dwell there.","poem":2}]},{"number":19,"lines":[{"text":"Blessed be the Lord,","poem":1},{"text":"who daily bears our burden,","poem":2},{"text":"the God of our salvation.","poem":2},{"text":"Selah"}]},{"number":20,"lines":[{"text":"Our God is a God of deliverance;","poem":1},{"text":"the Lord GOD is our rescuer from death.","poem":2}]},{"number":21,"lines":[{"text":"Surely God will crush the heads of His enemies,","poem":1},{"text":"the hairy crowns of those who persist in guilty ways.","poem":2}]},{"number":22,"lines":[{"text":"The Lord said, “I will retrieve them from Bashan,","poem":1},{"text":"I will bring them up from the depths of the sea,","poem":2}]},{"number":23,"lines":[{"text":"that your foot may be dipped","poem":1},{"text":"in the blood of your foes—","poem":2},{"text":"the tongues of your dogs in the same.”","poem":2}]},{"number":24,"lines":[{"text":"They have seen Your procession, O God—","poem":1},{"text":"the march of my God and King into the sanctuary.","poem":2}]},{"number":25,"lines":[{"text":"The singers lead the way,","poem":1},{"text":"the musicians follow after,","poem":2},{"text":"among the maidens playing tambourines.","poem":2}]},{"number":26,"lines":[{"text":"Bless God in the great congregation;","poem":1},{"text":"bless the LORD from the fountain of Israel.","poem":2}]},{"number":27,"lines":[{"text":"There is Benjamin, the youngest, ruling them,","poem":1},{"text":"the princes of Judah in their company,","poem":2},{"text":"the princes of Zebulun and of Naphtali.","poem":2}]},{"number":28,"lines":[{"text":"Summon Your power, O God;","poem":1},{"text":"show Your strength, O God,","poem":2},{"text":"which You have exerted on our behalf.","poem":2}]},{"number":29,"lines":[{"text":"Because of Your temple at Jerusalem","poem":1},{"text":"kings will bring You gifts.","poem":2}]},{"number":30,"lines":[{"text":"Rebuke the beast in the reeds,","poem":1},{"text":"the herd of bulls among the calves of the nations,","poem":2},{"text":"until it submits, bringing bars of silver.","poem":1},{"text":"Scatter the nations who delight in war.","poem":2}]},{"number":31,"lines":[{"text":"Envoys will arrive from Egypt;","poem":1},{"text":"Cush will stretch out her hands to God.","poem":2}]},{"number":32,"lines":[{"text":"Sing to God, O kingdoms of the earth;","poem":1},{"text":"sing praises to the Lord—","poem":2},{"text":"Selah"}]},{"number":33,"lines":[{"text":"to Him who rides upon the highest heavens of old;","poem":1},{"text":"behold, His mighty voice resounds.","poem":2}]},{"number":34,"lines":[{"text":"Ascribe the power to God,","poem":1},{"text":"whose majesty is over Israel,","poem":2},{"text":"whose strength is in the skies.","poem":2}]},{"number":35,"lines":[{"text":"O God, You are awesome in Your sanctuary;","poem":1},{"text":"the God of Israel Himself","poem":2},{"text":"gives strength and power to His people.","poem":2},{"text":"Blessed be God!","poem":1}]}]},{"number":69,"lastVerse":36,"verses":[{"number":1,"lines":[{"text":"Save me, O God,","poem":1},{"text":"for the waters are up to my neck.","poem":2}]},{"number":2,"lines":[{"text":"I have sunk into the miry depths,","poem":1},{"text":"where there is no footing;","poem":2},{"text":"I have drifted into deep waters,","poem":1},{"text":"where the flood engulfs me.","poem":2}]},{"number":3,"lines":[{"text":"I am weary from my crying;","poem":1},{"text":"my throat is parched.","poem":2},{"text":"My eyes fail,","poem":1},{"text":"looking for my God.","poem":2}]},{"number":4,"lines":[{"text":"Those who hate me without cause","poem":1},{"text":"outnumber the hairs of my head;","poem":2},{"text":"many are those who would destroy me—","poem":1},{"text":"my enemies for no reason.","poem":2},{"text":"Though I did not steal,","poem":1},{"text":"I must repay.","poem":2}]},{"number":5,"lines":[{"text":"You know my folly, O God,","poem":1},{"text":"and my guilt is not hidden from You.","poem":2}]},{"number":6,"lines":[{"text":"May those who hope in You not be ashamed through me,","poem":1},{"text":"O Lord GOD of Hosts;","poem":2},{"text":"may those who seek You not be dishonored through me,","poem":1},{"text":"O God of Israel.","poem":2}]},{"number":7,"lines":[{"text":"For I have endured scorn for Your sake,","poem":1},{"text":"and shame has covered my face.","poem":2}]},{"number":8,"lines":[{"text":"I have become a stranger to my brothers","poem":1},{"text":"and a foreigner to my mother’s sons,","poem":2}]},{"number":9,"lines":[{"text":"because zeal for Your house has consumed me,","poem":1},{"text":"and the insults of those who insult You have fallen on me.","poem":2}]},{"number":10,"lines":[{"text":"I wept and fasted,","poem":1},{"text":"but it brought me reproach.","poem":2}]},{"number":11,"lines":[{"text":"I made sackcloth my clothing,","poem":1},{"text":"and I was sport to them.","poem":2}]},{"number":12,"lines":[{"text":"Those who sit at the gate mock me,","poem":1},{"text":"and I am the song of drunkards.","poem":2}]},{"number":13,"lines":[{"text":"But my prayer to You, O LORD,","poem":1},{"text":"is for a time of favor.","poem":2},{"text":"In Your abundant loving devotion, O God,","poem":1},{"text":"answer me with Your sure salvation.","poem":2}]},{"number":14,"lines":[{"text":"Rescue me from the mire","poem":1},{"text":"and do not let me sink;","poem":2},{"text":"deliver me from my foes","poem":1},{"text":"and out of the deep waters.","poem":2}]},{"number":15,"lines":[{"text":"Do not let the floods engulf me","poem":1},{"text":"or the depths swallow me up;","poem":2},{"text":"let not the Pit close its mouth over me.","poem":2}]},{"number":16,"lines":[{"text":"Answer me, O LORD,","poem":1},{"text":"for Your loving devotion is good;","poem":2},{"text":"turn to me in keeping with Your great compassion.","poem":2}]},{"number":17,"lines":[{"text":"Hide not Your face from Your servant,","poem":1},{"text":"for I am in distress.","poem":2},{"text":"Answer me quickly!","poem":2}]},{"number":18,"lines":[{"text":"Draw near to my soul and redeem me;","poem":1},{"text":"ransom me because of my foes.","poem":2}]},{"number":19,"lines":[{"text":"You know my reproach, my shame and disgrace.","poem":1},{"text":"All my adversaries are before You.","poem":2}]},{"number":20,"lines":[{"text":"Insults have broken my heart,","poem":1},{"text":"and I am in despair.","poem":2},{"text":"I looked for sympathy, but there was none,","poem":1},{"text":"for comforters, but I found no one.","poem":2}]},{"number":21,"lines":[{"text":"They poisoned my food with gall","poem":1},{"text":"and gave me vinegar to quench my thirst.","poem":2}]},{"number":22,"lines":[{"text":"May their table become a snare;","poem":1},{"text":"may it be a retribution and a trap.","poem":2}]},{"number":23,"lines":[{"text":"May their eyes be darkened so they cannot see,","poem":1},{"text":"and their backs be bent forever.","poem":2}]},{"number":24,"lines":[{"text":"Pour out Your wrath upon them,","poem":1},{"text":"and let Your burning anger overtake them.","poem":2}]},{"number":25,"lines":[{"text":"May their place be deserted;","poem":1},{"text":"let there be no one to dwell in their tents.","poem":2}]},{"number":26,"lines":[{"text":"For they persecute the one You struck","poem":1},{"text":"and recount the pain of those You wounded.","poem":2}]},{"number":27,"lines":[{"text":"Add iniquity to their iniquity;","poem":1},{"text":"let them not share in Your righteousness.","poem":2}]},{"number":28,"lines":[{"text":"May they be blotted out of the Book of Life","poem":1},{"text":"and not listed with the righteous.","poem":2}]},{"number":29,"lines":[{"text":"But I am in pain and distress;","poem":1},{"text":"let Your salvation protect me, O God.","poem":2}]},{"number":30,"lines":[{"text":"I will praise God’s name in song","poem":1},{"text":"and exalt Him with thanksgiving.","poem":2}]},{"number":31,"lines":[{"text":"And this will please the LORD more than an ox,","poem":1},{"text":"more than a bull with horns and hooves.","poem":2}]},{"number":32,"lines":[{"text":"The humble will see and rejoice.","poem":1},{"text":"You who seek God, let your hearts be revived!","poem":2}]},{"number":33,"lines":[{"text":"For the LORD listens to the needy","poem":1},{"text":"and does not despise His captive people.","poem":2}]},{"number":34,"lines":[{"text":"Let heaven and earth praise Him,","poem":1},{"text":"the seas and everything that moves in them.","poem":2}]},{"number":35,"lines":[{"text":"For God will save Zion","poem":1},{"text":"and rebuild the cities of Judah,","poem":2},{"text":"that they may dwell there and possess it.","poem":2}]},{"number":36,"lines":[{"text":"The descendants of His servants will inherit it,","poem":1},{"text":"and those who love His name will settle in it.","poem":2}]}]},{"number":70,"lastVerse":5,"verses":[{"number":1,"lines":[{"text":"Make haste, O God, to deliver me!","poem":1},{"text":"Hurry, O LORD, to help me!","poem":2}]},{"number":2,"lines":[{"text":"May those who seek my life","poem":1},{"text":"be ashamed and confounded;","poem":2},{"text":"may those who wish me harm","poem":1},{"text":"be repelled and humiliated.","poem":2}]},{"number":3,"lines":[{"text":"May those who say, “Aha, aha!”","poem":1},{"text":"retreat because of their shame.","poem":2}]},{"number":4,"lines":[{"text":"May all who seek You","poem":1},{"text":"rejoice and be glad in You;","poem":2},{"text":"may those who love Your salvation always say,","poem":1},{"text":"“Let God be magnified!”","poem":2}]},{"number":5,"lines":[{"text":"But I am poor and needy;","poem":1},{"text":"hurry to me, O God.","poem":2},{"text":"You are my help and my deliverer;","poem":1},{"text":"O LORD, do not delay.","poem":2}]}]},{"number":71,"lastVerse":24,"verses":[{"number":1,"lines":[{"text":"In You, O LORD, I have taken refuge;","poem":1},{"text":"let me never be put to shame.","poem":2}]},{"number":2,"lines":[{"text":"In Your justice, rescue and deliver me;","poem":1},{"text":"incline Your ear and save me.","poem":2}]},{"number":3,"lines":[{"text":"Be my rock of refuge,","poem":1},{"text":"where I can always go.","poem":2},{"text":"Give the command to save me,","poem":1},{"text":"for You are my rock and my fortress.","poem":2}]},{"number":4,"lines":[{"text":"Deliver me, O my God, from the hand of the wicked,","poem":1},{"text":"from the grasp of the unjust and ruthless.","poem":2}]},{"number":5,"lines":[{"text":"For You are my hope, O Lord GOD,","poem":1},{"text":"my confidence from my youth.","poem":2}]},{"number":6,"lines":[{"text":"I have leaned on You since birth;","poem":1},{"text":"You pulled me from my mother’s womb.","poem":2},{"text":"My praise is always for You.","poem":2}]},{"number":7,"lines":[{"text":"I have become a portent to many,","poem":1},{"text":"but You are my strong refuge.","poem":2}]},{"number":8,"lines":[{"text":"My mouth is filled with Your praise","poem":1},{"text":"and with Your splendor all day long.","poem":2}]},{"number":9,"lines":[{"text":"Do not discard me in my old age;","poem":1},{"text":"do not forsake me when my strength fails.","poem":2}]},{"number":10,"lines":[{"text":"For my enemies speak against me,","poem":1},{"text":"and those who lie in wait for my life conspire,","poem":2}]},{"number":11,"lines":[{"text":"saying, “God has forsaken him;","poem":1},{"text":"pursue him and seize him,","poem":2},{"text":"for there is no one to rescue him.”","poem":2}]},{"number":12,"lines":[{"text":"Be not far from me, O God.","poem":1},{"text":"Hurry, O my God, to help me.","poem":2}]},{"number":13,"lines":[{"text":"May the accusers of my soul","poem":1},{"text":"be ashamed and consumed;","poem":2},{"text":"may those who seek my harm","poem":1},{"text":"be covered with scorn and disgrace.","poem":2}]},{"number":14,"lines":[{"text":"But I will always hope","poem":1},{"text":"and will praise You more and more.","poem":2}]},{"number":15,"lines":[{"text":"My mouth will declare Your righteousness","poem":1},{"text":"and Your salvation all day long,","poem":2},{"text":"though I cannot know their full measure.","poem":2}]},{"number":16,"lines":[{"text":"I will come in the strength of the Lord GOD;","poem":1},{"text":"I will proclaim Your righteousness—Yours alone.","poem":2}]},{"number":17,"lines":[{"text":"O God, You have taught me from my youth,","poem":1},{"text":"and to this day I proclaim Your marvelous deeds.","poem":2}]},{"number":18,"lines":[{"text":"Even when I am old and gray,","poem":1},{"text":"do not forsake me, O God,","poem":2},{"text":"until I proclaim Your power to the next generation,","poem":1},{"text":"Your might to all who are to come.","poem":2}]},{"number":19,"lines":[{"text":"Your righteousness reaches to the heavens, O God,","poem":1},{"text":"You who have done great things.","poem":2},{"text":"Who, O God, is like You?","poem":2}]},{"number":20,"lines":[{"text":"Though You have shown me many troubles and misfortunes,","poem":1},{"text":"You will revive me once again.","poem":2},{"text":"Even from the depths of the earth","poem":1},{"text":"You will bring me back up.","poem":2}]},{"number":21,"lines":[{"text":"You will increase my honor","poem":1},{"text":"and comfort me once again.","poem":2}]},{"number":22,"lines":[{"text":"So I will praise You with the harp","poem":1},{"text":"for Your faithfulness, O my God;","poem":2},{"text":"I will sing praise to You with the lyre,","poem":1},{"text":"O Holy One of Israel.","poem":2}]},{"number":23,"lines":[{"text":"When I sing praise to You","poem":1},{"text":"my lips will shout for joy,","poem":2},{"text":"along with my soul,","poem":1},{"text":"which You have redeemed.","poem":2}]},{"number":24,"lines":[{"text":"My tongue will indeed proclaim","poem":1},{"text":"Your righteousness all day long,","poem":2},{"text":"for those who seek my harm","poem":1},{"text":"are disgraced and confounded.","poem":2}]}]},{"number":72,"lastVerse":20,"verses":[{"number":1,"lines":[{"text":"Endow the king with Your justice, O God,","poem":1},{"text":"and the son of the king with Your righteousness.","poem":2}]},{"number":2,"lines":[{"text":"May he judge Your people with righteousness","poem":1},{"text":"and Your afflicted with justice.","poem":2}]},{"number":3,"lines":[{"text":"May the mountains bring peace to the people,","poem":1},{"text":"and the hills bring righteousness.","poem":2}]},{"number":4,"lines":[{"text":"May he vindicate the afflicted among the people;","poem":1},{"text":"may he save the children of the needy","poem":2},{"text":"and crush the oppressor.","poem":2}]},{"number":5,"lines":[{"text":"May they fear him as long as the sun shines,","poem":1},{"text":"as long as the moon remains,","poem":2},{"text":"through all generations.","poem":2}]},{"number":6,"lines":[{"text":"May he be like rain that falls on freshly cut grass,","poem":1},{"text":"like spring showers that water the earth.","poem":2}]},{"number":7,"lines":[{"text":"May the righteous flourish in his days","poem":1},{"text":"and prosperity abound","poem":2},{"text":"until the moon is no more.","poem":2}]},{"number":8,"lines":[{"text":"May he rule from sea to sea,","poem":1},{"text":"and from the Euphrates to the ends of the earth.","poem":2}]},{"number":9,"lines":[{"text":"May the nomads bow before him,","poem":1},{"text":"and his enemies lick the dust.","poem":2}]},{"number":10,"lines":[{"text":"May the kings of Tarshish and distant shores bring tribute;","poem":1},{"text":"may the kings of Sheba and Seba offer gifts.","poem":2}]},{"number":11,"lines":[{"text":"May all kings bow down to him","poem":1},{"text":"and all nations serve him.","poem":2}]},{"number":12,"lines":[{"text":"For he will deliver the needy who cry out","poem":1},{"text":"and the afflicted who have no helper.","poem":2}]},{"number":13,"lines":[{"text":"He will take pity on the poor and needy","poem":1},{"text":"and save the lives of the oppressed.","poem":2}]},{"number":14,"lines":[{"text":"He will redeem them from oppression and violence,","poem":1},{"text":"for their blood is precious in his sight.","poem":2}]},{"number":15,"lines":[{"text":"Long may he live!","poem":1},{"text":"May gold from Sheba be given him.","poem":2},{"text":"May people ever pray for him;","poem":1},{"text":"may they bless him all day long.","poem":2}]},{"number":16,"lines":[{"text":"May there be an abundance of grain in the land;","poem":1},{"text":"may it sway atop the hills.","poem":2},{"text":"May its fruit trees flourish like the forests of Lebanon,","poem":1},{"text":"the people of its cities like the grass of the field.","poem":2}]},{"number":17,"lines":[{"text":"May his name endure forever;","poem":1},{"text":"may his name continue as long as the sun shines.","poem":2},{"text":"In him may all nations be blessed;","poem":1},{"text":"may they call him blessed.","poem":2}]},{"number":18,"lines":[{"text":"Blessed be the LORD God, the God of Israel,","poem":1},{"text":"who alone does marvelous deeds.","poem":2}]},{"number":19,"lines":[{"text":"And blessed be His glorious name forever;","poem":1},{"text":"may all the earth be filled with His glory.","poem":2},{"text":"Amen and amen.","poem":1}]},{"number":20,"lines":[{"text":"Thus conclude the prayers of David son of Jesse."}]}]},{"number":73,"lastVerse":28,"verses":[{"number":1,"lines":[{"text":"Surely God is good to Israel,","poem":1},{"text":"to those who are pure in heart.","poem":2}]},{"number":2,"lines":[{"text":"But as for me, my feet had almost stumbled;","poem":1},{"text":"my steps had nearly slipped.","poem":2}]},{"number":3,"lines":[{"text":"For I envied the arrogant","poem":1},{"text":"when I saw the prosperity of the wicked.","poem":2}]},{"number":4,"lines":[{"text":"They have no struggle in their death;","poem":1},{"text":"their bodies are well-fed.","poem":2}]},{"number":5,"lines":[{"text":"They are free of the burdens others carry;","poem":1},{"text":"they are not afflicted like other men.","poem":2}]},{"number":6,"lines":[{"text":"Therefore pride is their necklace;","poem":1},{"text":"a garment of violence covers them.","poem":2}]},{"number":7,"lines":[{"text":"From their prosperity proceeds iniquity;","poem":1},{"text":"the imaginations of their hearts run wild.","poem":2}]},{"number":8,"lines":[{"text":"They mock and speak with malice;","poem":1},{"text":"with arrogance they threaten oppression.","poem":2}]},{"number":9,"lines":[{"text":"They set their mouths against the heavens,","poem":1},{"text":"and their tongues strut across the earth.","poem":2}]},{"number":10,"lines":[{"text":"So their people return to this place","poem":1},{"text":"and drink up waters in abundance.","poem":2}]},{"number":11,"lines":[{"text":"The wicked say, “How can God know?","poem":1},{"text":"Does the Most High have knowledge?”","poem":2}]},{"number":12,"lines":[{"text":"Behold, these are the wicked—","poem":1},{"text":"always carefree as they increase their wealth.","poem":2}]},{"number":13,"lines":[{"text":"Surely in vain I have kept my heart pure;","poem":1},{"text":"in innocence I have washed my hands.","poem":2}]},{"number":14,"lines":[{"text":"For I am afflicted all day long","poem":1},{"text":"and punished every morning.","poem":2}]},{"number":15,"lines":[{"text":"If I had said, “I will speak this way,”","poem":1},{"text":"then I would have betrayed Your children.","poem":2}]},{"number":16,"lines":[{"text":"When I tried to understand all this,","poem":1},{"text":"it was troublesome in my sight","poem":2}]},{"number":17,"lines":[{"text":"until I entered God’s sanctuary;","poem":1},{"text":"then I discerned their end.","poem":2}]},{"number":18,"lines":[{"text":"Surely You set them on slick ground;","poem":1},{"text":"You cast them down into ruin.","poem":2}]},{"number":19,"lines":[{"text":"How suddenly they are laid waste,","poem":1},{"text":"completely swept away by terrors!","poem":2}]},{"number":20,"lines":[{"text":"Like one waking from a dream,","poem":1},{"text":"so You, O Lord, awaken and despise their form.","poem":2}]},{"number":21,"lines":[{"text":"When my heart was grieved","poem":1},{"text":"and I was pierced within,","poem":2}]},{"number":22,"lines":[{"text":"I was senseless and ignorant;","poem":1},{"text":"I was a brute beast before You.","poem":2}]},{"number":23,"lines":[{"text":"Yet I am always with You;","poem":1},{"text":"You hold my right hand.","poem":2}]},{"number":24,"lines":[{"text":"You guide me with Your counsel,","poem":1},{"text":"and later receive me in glory.","poem":2}]},{"number":25,"lines":[{"text":"Whom have I in heaven but You?","poem":1},{"text":"And on earth I desire no one besides You.","poem":2}]},{"number":26,"lines":[{"text":"My flesh and my heart may fail,","poem":1},{"text":"but God is the strength of my heart","poem":2},{"text":"and my portion forever.","poem":2}]},{"number":27,"lines":[{"text":"Those far from You will surely perish;","poem":1},{"text":"You destroy all who are unfaithful to You.","poem":2}]},{"number":28,"lines":[{"text":"But as for me, it is good to draw near to God.","poem":1},{"text":"I have made the Lord GOD my refuge,","poem":2},{"text":"that I may proclaim all Your works.","poem":2}]}]},{"number":74,"lastVerse":23,"verses":[{"number":1,"lines":[{"text":"Why have You rejected us forever, O God?","poem":1},{"text":"Why does Your anger smolder","poem":2},{"text":"against the sheep of Your pasture?","poem":2}]},{"number":2,"lines":[{"text":"Remember Your congregation,","poem":1},{"text":"which You purchased long ago","poem":2},{"text":"and redeemed as the tribe of Your inheritance—","poem":1},{"text":"Mount Zion, where You dwell.","poem":2}]},{"number":3,"lines":[{"text":"Turn Your steps to the everlasting ruins,","poem":1},{"text":"to everything in the sanctuary the enemy has destroyed.","poem":2}]},{"number":4,"lines":[{"text":"Your foes have roared within Your meeting place;","poem":1},{"text":"they have unfurled their banners as signs,","poem":2}]},{"number":5,"lines":[{"text":"like men wielding axes in a thicket of trees","poem":1}]},{"number":6,"lines":[{"text":"and smashing all the carvings with hatchets and picks.","poem":2}]},{"number":7,"lines":[{"text":"They have burned Your sanctuary to the ground;","poem":1},{"text":"they have defiled the dwelling place of Your Name.","poem":2}]},{"number":8,"lines":[{"text":"They said in their hearts,","poem":1},{"text":"“We will crush them completely.”","poem":2},{"text":"They burned down every place","poem":1},{"text":"where God met us in the land.","poem":2}]},{"number":9,"lines":[{"text":"There are no signs for us to see.","poem":1},{"text":"There is no longer any prophet.","poem":2},{"text":"And none of us knows how long this will last.","poem":2}]},{"number":10,"lines":[{"text":"How long, O God, will the enemy taunt You?","poem":1},{"text":"Will the foe revile Your name forever?","poem":2}]},{"number":11,"lines":[{"text":"Why do You withdraw Your strong right hand?","poem":1},{"text":"Stretch it out to destroy them!","poem":2}]},{"number":12,"lines":[{"text":"Yet God is my King from ancient times,","poem":1},{"text":"working salvation on the earth.","poem":2}]},{"number":13,"lines":[{"text":"You divided the sea by Your strength;","poem":1},{"text":"You smashed the heads of the dragons of the sea;","poem":2}]},{"number":14,"lines":[{"text":"You crushed the heads of Leviathan;","poem":1},{"text":"You fed him to the creatures of the desert.","poem":2}]},{"number":15,"lines":[{"text":"You broke open the fountain and the flood;","poem":1},{"text":"You dried up the ever-flowing rivers.","poem":2}]},{"number":16,"lines":[{"text":"The day is Yours, and also the night;","poem":1},{"text":"You established the moon and the sun.","poem":2}]},{"number":17,"lines":[{"text":"You set all the boundaries of the earth;","poem":1},{"text":"You made the summer and winter.","poem":2}]},{"number":18,"lines":[{"text":"Remember how the enemy has mocked You, O LORD,","poem":1},{"text":"how a foolish people has spurned Your name.","poem":2}]},{"number":19,"lines":[{"text":"Do not deliver the soul of Your dove to beasts;","poem":1},{"text":"do not forget the lives of Your afflicted forever.","poem":2}]},{"number":20,"lines":[{"text":"Consider Your covenant,","poem":1},{"text":"for haunts of violence fill the dark places of the land.","poem":2}]},{"number":21,"lines":[{"text":"Do not let the oppressed retreat in shame;","poem":1},{"text":"may the poor and needy praise Your name.","poem":2}]},{"number":22,"lines":[{"text":"Rise up, O God; defend Your cause!","poem":1},{"text":"Remember how the fool mocks You all day long.","poem":2}]},{"number":23,"lines":[{"text":"Do not disregard the clamor of Your adversaries,","poem":1},{"text":"the uproar of Your enemies that ascends continually.","poem":2}]}]},{"number":75,"lastVerse":10,"verses":[{"number":1,"lines":[{"text":"We give thanks to You, O God;","poem":1},{"text":"we give thanks, for Your Name is near.","poem":2},{"text":"The people declare Your wondrous works.","poem":2}]},{"number":2,"lines":[{"text":"“When I choose a time,","poem":1},{"text":"I will judge fairly.","poem":2}]},{"number":3,"lines":[{"text":"When the earth and all its dwellers quake,","poem":1},{"text":"it is I who bear up its pillars.","poem":2},{"text":"Selah"}]},{"number":4,"lines":[{"text":"I say to the proud, ‘Do not boast,’","poem":1},{"text":"and to the wicked, ‘Do not lift up your horn.","poem":2}]},{"number":5,"lines":[{"text":"Do not lift up your horn against heaven","poem":1},{"text":"or speak with an outstretched neck.’”","poem":2}]},{"number":6,"lines":[{"text":"For exaltation comes neither from east nor west,","poem":1},{"text":"nor out of the desert,","poem":2}]},{"number":7,"lines":[{"text":"but it is God who judges;","poem":1},{"text":"He brings down one and exalts another.","poem":2}]},{"number":8,"lines":[{"text":"For a cup is in the hand of the LORD,","poem":1},{"text":"full of foaming wine mixed with spices.","poem":2},{"text":"He pours from His cup,","poem":1},{"text":"and all the wicked of the earth","poem":2},{"text":"drink it down to the dregs.","poem":2}]},{"number":9,"lines":[{"text":"But I will proclaim Him forever;","poem":1},{"text":"I will sing praise to the God of Jacob.","poem":2}]},{"number":10,"lines":[{"text":"“All the horns of the wicked I will cut off,","poem":1},{"text":"but the horns of the righteous will be exalted.”","poem":2}]}]},{"number":76,"lastVerse":12,"verses":[{"number":1,"lines":[{"text":"God is known in Judah;","poem":1},{"text":"His name is great in Israel.","poem":2}]},{"number":2,"lines":[{"text":"His tent is in Salem,","poem":1},{"text":"His dwelling place in Zion.","poem":2}]},{"number":3,"lines":[{"text":"There He shattered the flaming arrows,","poem":1},{"text":"the shield and sword and weapons of war.","poem":2},{"text":"Selah"}]},{"number":4,"lines":[{"text":"You are resplendent with light,","poem":1},{"text":"more majestic than mountains filled with game.","poem":2}]},{"number":5,"lines":[{"text":"The valiant lie plundered; they sleep their last sleep.","poem":1},{"text":"No men of might could lift a hand.","poem":2}]},{"number":6,"lines":[{"text":"At Your rebuke, O God of Jacob,","poem":1},{"text":"both horse and rider lie stunned.","poem":2}]},{"number":7,"lines":[{"text":"You alone are to be feared.","poem":1},{"text":"When You are angry, who can stand before You?","poem":2}]},{"number":8,"lines":[{"text":"From heaven You pronounced judgment,","poem":1},{"text":"and the earth feared and was still","poem":2}]},{"number":9,"lines":[{"text":"when God rose up to judge,","poem":1},{"text":"to save all the lowly of the earth.","poem":2},{"text":"Selah"}]},{"number":10,"lines":[{"text":"Even the wrath of man shall praise You;","poem":1},{"text":"with the survivors of wrath You will clothe Yourself.","poem":2}]},{"number":11,"lines":[{"text":"Make and fulfill your vows to the LORD your God;","poem":1},{"text":"let all the neighboring lands bring tribute","poem":2},{"text":"to Him who is to be feared.","poem":2}]},{"number":12,"lines":[{"text":"He breaks the spirits of princes;","poem":1},{"text":"He is feared by the kings of the earth.","poem":2}]}]},{"number":77,"lastVerse":20,"verses":[{"number":1,"lines":[{"text":"I cried out to God;","poem":1},{"text":"I cried aloud to God to hear me.","poem":2}]},{"number":2,"lines":[{"text":"In the day of trouble I sought the Lord;","poem":1},{"text":"through the night my outstretched hands did not grow weary;","poem":2},{"text":"my soul refused to be comforted.","poem":2}]},{"number":3,"lines":[{"text":"I remembered You, O God, and I groaned;","poem":1},{"text":"I mused and my spirit grew faint.","poem":2},{"text":"Selah"}]},{"number":4,"lines":[{"text":"You have kept my eyes from closing;","poem":1},{"text":"I am too troubled to speak.","poem":2}]},{"number":5,"lines":[{"text":"I considered the days of old,","poem":1},{"text":"the years long in the past.","poem":2}]},{"number":6,"lines":[{"text":"At night I remembered my song;","poem":1},{"text":"in my heart I mused, and my spirit pondered:","poem":2}]},{"number":7,"lines":[{"text":"“Will the Lord spurn us forever","poem":1},{"text":"and never show His favor again?","poem":2}]},{"number":8,"lines":[{"text":"Is His loving devotion gone forever?","poem":1},{"text":"Has His promise failed for all time?","poem":2}]},{"number":9,"lines":[{"text":"Has God forgotten to be gracious?","poem":1},{"text":"Has His anger shut off His compassion?”","poem":2},{"text":"Selah"}]},{"number":10,"lines":[{"text":"So I said, “I am grieved","poem":1},{"text":"that the right hand of the Most High has changed.”","poem":2}]},{"number":11,"lines":[{"text":"I will remember the works of the LORD;","poem":1},{"text":"yes, I will remember Your wonders of old.","poem":2}]},{"number":12,"lines":[{"text":"I will reflect on all You have done","poem":1},{"text":"and ponder Your mighty deeds.","poem":2}]},{"number":13,"lines":[{"text":"Your way, O God, is holy.","poem":1},{"text":"What god is so great as our God?","poem":2}]},{"number":14,"lines":[{"text":"You are the God who works wonders;","poem":1},{"text":"You display Your strength among the peoples.","poem":2}]},{"number":15,"lines":[{"text":"With power You redeemed Your people,","poem":1},{"text":"the sons of Jacob and Joseph.","poem":2},{"text":"Selah"}]},{"number":16,"lines":[{"text":"The waters saw You, O God;","poem":1},{"text":"the waters saw You and swirled;","poem":2},{"text":"even the depths were shaken.","poem":2}]},{"number":17,"lines":[{"text":"The clouds poured down water;","poem":1},{"text":"the skies resounded with thunder;","poem":2},{"text":"Your arrows flashed back and forth.","poem":2}]},{"number":18,"lines":[{"text":"Your thunder resounded in the whirlwind;","poem":1},{"text":"the lightning lit up the world;","poem":2},{"text":"the earth trembled and quaked.","poem":2}]},{"number":19,"lines":[{"text":"Your path led through the sea,","poem":1},{"text":"Your way through the mighty waters,","poem":2},{"text":"but Your footprints were not to be found.","poem":2}]},{"number":20,"lines":[{"text":"You led Your people like a flock","poem":1},{"text":"by the hand of Moses and Aaron.","poem":2}]}]},{"number":78,"lastVerse":72,"verses":[{"number":1,"lines":[{"text":"Give ear, O my people, to my instruction;","poem":1},{"text":"listen to the words of my mouth.","poem":2}]},{"number":2,"lines":[{"text":"I will open my mouth in parables;","poem":1},{"text":"I will utter things hidden from the beginning,","poem":2}]},{"number":3,"lines":[{"text":"that we have heard and known","poem":1},{"text":"and our fathers have relayed to us.","poem":2}]},{"number":4,"lines":[{"text":"We will not hide them from their children","poem":1},{"text":"but will declare to the next generation","poem":2},{"text":"the praises of the LORD and His might","poem":1},{"text":"and the wonders He has performed.","poem":2}]},{"number":5,"lines":[{"text":"For He established a testimony in Jacob","poem":1},{"text":"and appointed a law in Israel,","poem":2},{"text":"which He commanded our fathers","poem":1},{"text":"to teach to their children,","poem":2}]},{"number":6,"lines":[{"text":"that the coming generation would know them—","poem":1},{"text":"even children yet to be born—","poem":2},{"text":"to arise and tell their own children","poem":2}]},{"number":7,"lines":[{"text":"that they should put their confidence in God,","poem":1},{"text":"not forgetting His works,","poem":2},{"text":"but keeping His commandments.","poem":2}]},{"number":8,"lines":[{"text":"Then they will not be like their fathers,","poem":1},{"text":"a stubborn and rebellious generation,","poem":2},{"text":"whose heart was not loyal,","poem":1},{"text":"whose spirit was not faithful to God.","poem":2}]},{"number":9,"lines":[{"text":"The archers of Ephraim","poem":1},{"text":"turned back on the day of battle.","poem":2}]},{"number":10,"lines":[{"text":"They failed to keep God’s covenant","poem":1},{"text":"and refused to live by His law.","poem":2}]},{"number":11,"lines":[{"text":"They forgot what He had done,","poem":1},{"text":"the wonders He had shown them.","poem":2}]},{"number":12,"lines":[{"text":"He worked wonders before their fathers","poem":1},{"text":"in the land of Egypt, in the region of Zoan.","poem":2}]},{"number":13,"lines":[{"text":"He split the sea and brought them through;","poem":1},{"text":"He set the waters upright like a wall.","poem":2}]},{"number":14,"lines":[{"text":"He led them with a cloud by day","poem":1},{"text":"and with a light of fire all night.","poem":2}]},{"number":15,"lines":[{"text":"He split the rocks in the wilderness","poem":1},{"text":"and gave them drink as abundant as the seas.","poem":2}]},{"number":16,"lines":[{"text":"He brought streams from the stone","poem":1},{"text":"and made water flow down like rivers.","poem":2}]},{"number":17,"lines":[{"text":"But they continued to sin against Him,","poem":1},{"text":"rebelling in the desert against the Most High.","poem":2}]},{"number":18,"lines":[{"text":"They willfully tested God","poem":1},{"text":"by demanding the food they craved.","poem":2}]},{"number":19,"lines":[{"text":"They spoke against God, saying,","poem":1},{"text":"“Can God really prepare a table in the wilderness?","poem":2}]},{"number":20,"lines":[{"text":"When He struck the rock, water gushed out","poem":1},{"text":"and torrents raged.","poem":2},{"text":"But can He also give bread","poem":1},{"text":"or supply His people with meat?”","poem":2}]},{"number":21,"lines":[{"text":"Therefore the LORD heard","poem":1},{"text":"and was filled with wrath;","poem":2},{"text":"so a fire was kindled against Jacob,","poem":1},{"text":"and His anger flared against Israel,","poem":2}]},{"number":22,"lines":[{"text":"because they did not believe God","poem":1},{"text":"or rely on His salvation.","poem":2}]},{"number":23,"lines":[{"text":"Yet He commanded the clouds above","poem":1},{"text":"and opened the doors of the heavens.","poem":2}]},{"number":24,"lines":[{"text":"He rained down manna for them to eat;","poem":1},{"text":"He gave them grain from heaven.","poem":2}]},{"number":25,"lines":[{"text":"Man ate the bread of angels;","poem":1},{"text":"He sent them food in abundance.","poem":2}]},{"number":26,"lines":[{"text":"He stirred the east wind from the heavens","poem":1},{"text":"and drove the south wind by His might.","poem":2}]},{"number":27,"lines":[{"text":"He rained meat on them like dust,","poem":1},{"text":"and winged birds like the sand of the sea.","poem":2}]},{"number":28,"lines":[{"text":"He felled them in the midst of their camp,","poem":1},{"text":"all around their dwellings.","poem":2}]},{"number":29,"lines":[{"text":"So they ate and were well filled,","poem":1},{"text":"for He gave them what they craved.","poem":2}]},{"number":30,"lines":[{"text":"Yet before they had filled their desire,","poem":1},{"text":"with the food still in their mouths,","poem":2}]},{"number":31,"lines":[{"text":"God’s anger flared against them,","poem":1},{"text":"and He put to death their strongest","poem":2},{"text":"and subdued the young men of Israel.","poem":2}]},{"number":32,"lines":[{"text":"In spite of all this, they kept on sinning;","poem":1},{"text":"despite His wonderful works, they did not believe.","poem":2}]},{"number":33,"lines":[{"text":"So He ended their days in futility,","poem":1},{"text":"and their years in sudden terror.","poem":2}]},{"number":34,"lines":[{"text":"When He slew them, they would seek Him;","poem":1},{"text":"they repented and searched for God.","poem":2}]},{"number":35,"lines":[{"text":"And they remembered that God was their Rock,","poem":1},{"text":"that God Most High was their Redeemer.","poem":2}]},{"number":36,"lines":[{"text":"But they deceived Him with their mouths,","poem":1},{"text":"and lied to Him with their tongues.","poem":2}]},{"number":37,"lines":[{"text":"Their hearts were disloyal to Him,","poem":1},{"text":"and they were unfaithful to His covenant.","poem":2}]},{"number":38,"lines":[{"text":"And yet He was compassionate;","poem":1},{"text":"He forgave their iniquity and did not destroy them.","poem":2},{"text":"He often restrained His anger","poem":1},{"text":"and did not unleash His full wrath.","poem":2}]},{"number":39,"lines":[{"text":"He remembered that they were but flesh,","poem":1},{"text":"a passing breeze that does not return.","poem":2}]},{"number":40,"lines":[{"text":"How often they disobeyed Him in the wilderness","poem":1},{"text":"and grieved Him in the desert!","poem":2}]},{"number":41,"lines":[{"text":"Again and again they tested God","poem":1},{"text":"and provoked the Holy One of Israel.","poem":2}]},{"number":42,"lines":[{"text":"They did not remember His power —","poem":1},{"text":"the day He redeemed them from the adversary,","poem":2}]},{"number":43,"lines":[{"text":"when He performed His signs in Egypt","poem":1},{"text":"and His wonders in the fields of Zoan.","poem":2}]},{"number":44,"lines":[{"text":"He turned their rivers to blood,","poem":1},{"text":"and from their streams they could not drink.","poem":2}]},{"number":45,"lines":[{"text":"He sent swarms of flies that devoured them,","poem":1},{"text":"and frogs that devastated them.","poem":2}]},{"number":46,"lines":[{"text":"He gave their crops to the grasshopper,","poem":1},{"text":"the fruit of their labor to the locust.","poem":2}]},{"number":47,"lines":[{"text":"He killed their vines with hailstones","poem":1},{"text":"and their sycamore-figs with sleet.","poem":2}]},{"number":48,"lines":[{"text":"He abandoned their cattle to the hail","poem":1},{"text":"and their livestock to bolts of lightning.","poem":2}]},{"number":49,"lines":[{"text":"He unleashed His fury against them,","poem":1},{"text":"wrath, indignation, and calamity—","poem":2},{"text":"a band of destroying angels.","poem":2}]},{"number":50,"lines":[{"text":"He cleared a path for His anger;","poem":1},{"text":"He did not spare them from death","poem":2},{"text":"but delivered their lives to the plague.","poem":2}]},{"number":51,"lines":[{"text":"He struck all the firstborn of Egypt,","poem":1},{"text":"the virility in the tents of Ham.","poem":2}]},{"number":52,"lines":[{"text":"He led out His people like sheep","poem":1},{"text":"and guided them like a flock in the wilderness.","poem":2}]},{"number":53,"lines":[{"text":"He led them safely, so they did not fear,","poem":1},{"text":"but the sea engulfed their enemies.","poem":2}]},{"number":54,"lines":[{"text":"He brought them to His holy land,","poem":1},{"text":"to the mountain His right hand had acquired.","poem":2}]},{"number":55,"lines":[{"text":"He drove out nations before them","poem":1},{"text":"and apportioned their inheritance;","poem":2},{"text":"He settled the tribes of Israel in their tents.","poem":2}]},{"number":56,"lines":[{"text":"But they tested and disobeyed God Most High,","poem":1},{"text":"for they did not keep His decrees.","poem":2}]},{"number":57,"lines":[{"text":"They turned back and were faithless like their fathers,","poem":1},{"text":"twisted like a faulty bow.","poem":2}]},{"number":58,"lines":[{"text":"They enraged Him with their high places","poem":1},{"text":"and provoked His jealousy with their idols.","poem":2}]},{"number":59,"lines":[{"text":"On hearing it, God was furious","poem":1},{"text":"and rejected Israel completely.","poem":2}]},{"number":60,"lines":[{"text":"He abandoned the tabernacle of Shiloh,","poem":1},{"text":"the tent He had pitched among men.","poem":2}]},{"number":61,"lines":[{"text":"He delivered His strength to captivity,","poem":1},{"text":"and His splendor to the hand of the adversary.","poem":2}]},{"number":62,"lines":[{"text":"He surrendered His people to the sword","poem":1},{"text":"because He was enraged by His heritage.","poem":2}]},{"number":63,"lines":[{"text":"Fire consumed His young men,","poem":1},{"text":"and their maidens were left without wedding songs.","poem":2}]},{"number":64,"lines":[{"text":"His priests fell by the sword,","poem":1},{"text":"but their widows could not lament.","poem":2}]},{"number":65,"lines":[{"text":"Then the Lord awoke as from sleep,","poem":1},{"text":"like a mighty warrior overcome by wine.","poem":2}]},{"number":66,"lines":[{"text":"He beat back His foes;","poem":1},{"text":"He put them to everlasting shame.","poem":2}]},{"number":67,"lines":[{"text":"He rejected the tent of Joseph","poem":1},{"text":"and refused the tribe of Ephraim.","poem":2}]},{"number":68,"lines":[{"text":"But He chose the tribe of Judah,","poem":1},{"text":"Mount Zion, which He loved.","poem":2}]},{"number":69,"lines":[{"text":"He built His sanctuary like the heights,","poem":1},{"text":"like the earth He has established forever.","poem":2}]},{"number":70,"lines":[{"text":"He chose David His servant","poem":1},{"text":"and took him from the sheepfolds;","poem":2}]},{"number":71,"lines":[{"text":"from tending the ewes He brought him","poem":1},{"text":"to be shepherd of His people Jacob,","poem":2},{"text":"of Israel His inheritance.","poem":2}]},{"number":72,"lines":[{"text":"So David shepherded them with integrity of heart","poem":1},{"text":"and guided them with skillful hands.","poem":2}]}]},{"number":79,"lastVerse":13,"verses":[{"number":1,"lines":[{"text":"The nations, O God, have invaded Your inheritance;","poem":1},{"text":"they have defiled Your holy temple","poem":2},{"text":"and reduced Jerusalem to rubble.","poem":2}]},{"number":2,"lines":[{"text":"They have given the corpses of Your servants","poem":1},{"text":"as food to the birds of the air,","poem":2},{"text":"the flesh of Your saints to the beasts of the earth.","poem":2}]},{"number":3,"lines":[{"text":"They have poured out their blood like water","poem":1},{"text":"all around Jerusalem,","poem":2},{"text":"and there is no one to bury the dead.","poem":2}]},{"number":4,"lines":[{"text":"We have become a reproach to our neighbors,","poem":1},{"text":"a scorn and derision to those around us.","poem":2}]},{"number":5,"lines":[{"text":"How long, O LORD?","poem":1},{"text":"Will You be angry forever?","poem":2},{"text":"Will Your jealousy burn like fire?","poem":2}]},{"number":6,"lines":[{"text":"Pour out Your wrath on the nations","poem":1},{"text":"that do not acknowledge You,","poem":2},{"text":"on the kingdoms","poem":1},{"text":"that refuse to call on Your name,","poem":2}]},{"number":7,"lines":[{"text":"for they have devoured Jacob","poem":1},{"text":"and devastated his homeland.","poem":2}]},{"number":8,"lines":[{"text":"Do not hold past sins against us;","poem":1},{"text":"let Your compassion come quickly,","poem":2},{"text":"for we are brought low.","poem":2}]},{"number":9,"lines":[{"text":"Help us, O God of our salvation,","poem":1},{"text":"for the glory of Your name;","poem":2},{"text":"deliver us and atone for our sins,","poem":1},{"text":"for the sake of Your name.","poem":2}]},{"number":10,"lines":[{"text":"Why should the nations ask,","poem":1},{"text":"“Where is their God?”","poem":2},{"text":"Before our eyes, make known among the nations","poem":1},{"text":"Your vengeance for the bloodshed of Your servants.","poem":2}]},{"number":11,"lines":[{"text":"May the groans of the captives reach You;","poem":1},{"text":"by the strength of Your arm preserve those condemned to death.","poem":2}]},{"number":12,"lines":[{"text":"Pay back into the laps of our neighbors","poem":1},{"text":"sevenfold the reproach they hurled at You, O Lord.","poem":2}]},{"number":13,"lines":[{"text":"Then we Your people, the sheep of Your pasture,","poem":1},{"text":"will thank You forever;","poem":2},{"text":"from generation to generation","poem":1},{"text":"we will declare Your praise.","poem":2}]}]},{"number":80,"lastVerse":19,"verses":[{"number":1,"lines":[{"text":"Hear us, O Shepherd of Israel,","poem":1},{"text":"who leads Joseph like a flock;","poem":2},{"text":"You who sit enthroned between the cherubim,","poem":1},{"text":"shine forth","poem":2}]},{"number":2,"lines":[{"text":"before Ephraim, Benjamin, and Manasseh.","poem":2},{"text":"Rally Your mighty power","poem":1},{"text":"and come to save us.","poem":2}]},{"number":3,"lines":[{"text":"Restore us, O God,","poem":1},{"text":"and cause Your face to shine upon us,","poem":2},{"text":"that we may be saved.","poem":2}]},{"number":4,"lines":[{"text":"O LORD God of Hosts,","poem":1},{"text":"how long will Your anger smolder","poem":2},{"text":"against the prayers of Your people?","poem":2}]},{"number":5,"lines":[{"text":"You fed them with the bread of tears","poem":1},{"text":"and made them drink the full measure of their tears.","poem":2}]},{"number":6,"lines":[{"text":"You make us contend with our neighbors;","poem":1},{"text":"our enemies mock us.","poem":2}]},{"number":7,"lines":[{"text":"Restore us, O God of Hosts,","poem":1},{"text":"and cause Your face to shine upon us,","poem":2},{"text":"that we may be saved.","poem":2}]},{"number":8,"lines":[{"text":"You uprooted a vine from Egypt;","poem":1},{"text":"You drove out the nations and transplanted it.","poem":2}]},{"number":9,"lines":[{"text":"You cleared the ground for it,","poem":1},{"text":"and it took root and filled the land.","poem":2}]},{"number":10,"lines":[{"text":"The mountains were covered by its shade,","poem":1},{"text":"and the mighty cedars with its branches.","poem":2}]},{"number":11,"lines":[{"text":"It sent out its branches to the Sea,","poem":1},{"text":"and its shoots toward the River.","poem":2}]},{"number":12,"lines":[{"text":"Why have You broken down its walls,","poem":1},{"text":"so that all who pass by pick its fruit?","poem":2}]},{"number":13,"lines":[{"text":"The boar from the forest ravages it,","poem":1},{"text":"and the creatures of the field feed upon it.","poem":2}]},{"number":14,"lines":[{"text":"Return, O God of Hosts, we pray!","poem":1},{"text":"Look down from heaven and see!","poem":2},{"text":"Attend to this vine—","poem":1}]},{"number":15,"lines":[{"text":"the root Your right hand has planted,","poem":2},{"text":"the son You have raised up for Yourself.","poem":2}]},{"number":16,"lines":[{"text":"Your vine has been cut down and burned;","poem":1},{"text":"they perish at the rebuke of Your countenance.","poem":2}]},{"number":17,"lines":[{"text":"Let Your hand be upon the man at Your right hand,","poem":1},{"text":"on the son of man You have raised up for Yourself.","poem":2}]},{"number":18,"lines":[{"text":"Then we will not turn away from You;","poem":1},{"text":"revive us, and we will call on Your name.","poem":2}]},{"number":19,"lines":[{"text":"Restore us, O LORD God of Hosts;","poem":1},{"text":"cause Your face to shine upon us,","poem":2},{"text":"that we may be saved.","poem":2}]}]},{"number":81,"lastVerse":16,"verses":[{"number":1,"lines":[{"text":"Sing for joy to God our strength;","poem":1},{"text":"make a joyful noise to the God of Jacob.","poem":2}]},{"number":2,"lines":[{"text":"Lift up a song, strike the tambourine,","poem":1},{"text":"play the sweet-sounding harp and lyre.","poem":2}]},{"number":3,"lines":[{"text":"Sound the ram’s horn at the New Moon,","poem":1},{"text":"and at the full moon on the day of our Feast.","poem":2}]},{"number":4,"lines":[{"text":"For this is a statute for Israel,","poem":1},{"text":"an ordinance of the God of Jacob.","poem":2}]},{"number":5,"lines":[{"text":"He ordained it as a testimony for Joseph","poem":1},{"text":"when he went out over the land of Egypt,","poem":2},{"text":"where I heard an unfamiliar language:","poem":2}]},{"number":6,"lines":[{"text":"“I relieved his shoulder of the burden;","poem":1},{"text":"his hands were freed from the basket.","poem":2}]},{"number":7,"lines":[{"text":"You called out in distress, and I rescued you;","poem":1},{"text":"I answered you from the cloud of thunder;","poem":2},{"text":"I tested you at the waters of Meribah.","poem":2},{"text":"Selah"}]},{"number":8,"lines":[{"text":"Hear, O My people, and I will warn you:","poem":1},{"text":"O Israel, if only you would listen to Me!","poem":2}]},{"number":9,"lines":[{"text":"There must be no strange god among you,","poem":1},{"text":"nor shall you bow to a foreign god.","poem":2}]},{"number":10,"lines":[{"text":"I am the LORD your God,","poem":1},{"text":"who brought you up out of Egypt.","poem":2},{"text":"Open wide your mouth,","poem":1},{"text":"and I will fill it.","poem":2}]},{"number":11,"lines":[{"text":"But My people would not listen to Me,","poem":1},{"text":"and Israel would not obey Me.","poem":2}]},{"number":12,"lines":[{"text":"So I gave them up to their stubborn hearts","poem":1},{"text":"to follow their own devices.","poem":2}]},{"number":13,"lines":[{"text":"If only My people would listen to Me,","poem":1},{"text":"if Israel would follow My ways,","poem":2}]},{"number":14,"lines":[{"text":"how soon I would subdue their enemies","poem":1},{"text":"and turn My hand against their foes!","poem":2}]},{"number":15,"lines":[{"text":"Those who hate the LORD would feign obedience,","poem":1},{"text":"and their doom would last forever.","poem":2}]},{"number":16,"lines":[{"text":"But I would feed you the finest wheat;","poem":1},{"text":"with honey from the rock I would satisfy you.”","poem":2}]}]},{"number":82,"lastVerse":8,"verses":[{"number":1,"lines":[{"text":"God presides in the divine assembly;","poem":1},{"text":"He renders judgment among the gods:","poem":2}]},{"number":2,"lines":[{"text":"“How long will you judge unjustly","poem":1},{"text":"and show partiality to the wicked?","poem":2},{"text":"Selah"}]},{"number":3,"lines":[{"text":"Defend the cause of the weak and fatherless;","poem":1},{"text":"uphold the rights of the afflicted and oppressed.","poem":2}]},{"number":4,"lines":[{"text":"Rescue the weak and needy;","poem":1},{"text":"save them from the hand of the wicked.","poem":2}]},{"number":5,"lines":[{"text":"They do not know or understand;","poem":1},{"text":"they wander in the darkness;","poem":2},{"text":"all the foundations of the earth are shaken.","poem":2}]},{"number":6,"lines":[{"text":"I have said, ‘You are gods;","poem":1},{"text":"you are all sons of the Most High.’","poem":2}]},{"number":7,"lines":[{"text":"But like mortals you will die,","poem":1},{"text":"and like rulers you will fall.”","poem":2}]},{"number":8,"lines":[{"text":"Arise, O God, judge the earth,","poem":1},{"text":"for all the nations are Your inheritance.","poem":2}]}]},{"number":83,"lastVerse":18,"verses":[{"number":1,"lines":[{"text":"O God, be not silent; be not speechless;","poem":1},{"text":"be not still, O God.","poem":2}]},{"number":2,"lines":[{"text":"See how Your enemies rage,","poem":1},{"text":"how Your foes have reared their heads.","poem":2}]},{"number":3,"lines":[{"text":"With cunning they scheme against Your people","poem":1},{"text":"and conspire against those You cherish,","poem":2}]},{"number":4,"lines":[{"text":"saying, “Come, let us erase them as a nation;","poem":1},{"text":"may the name of Israel be remembered no more.”","poem":2}]},{"number":5,"lines":[{"text":"For with one mind they plot together;","poem":1},{"text":"they form an alliance against You—","poem":2}]},{"number":6,"lines":[{"text":"the tents of Edom and the Ishmaelites,","poem":1},{"text":"of Moab and the Hagrites,","poem":2}]},{"number":7,"lines":[{"text":"of Gebal, Ammon, and Amalek,","poem":1},{"text":"of Philistia with the people of Tyre.","poem":2}]},{"number":8,"lines":[{"text":"Even Assyria has joined them,","poem":1},{"text":"lending strength to the sons of Lot.","poem":2},{"text":"Selah"}]},{"number":9,"lines":[{"text":"Do to them as You did to Midian,","poem":1},{"text":"as to Sisera and Jabin at the River Kishon,","poem":2}]},{"number":10,"lines":[{"text":"who perished at Endor","poem":1},{"text":"and became like dung on the ground.","poem":2}]},{"number":11,"lines":[{"text":"Make their nobles like Oreb and Zeeb,","poem":1},{"text":"and all their princes like Zebah and Zalmunna,","poem":2}]},{"number":12,"lines":[{"text":"who said, “Let us possess for ourselves","poem":1},{"text":"the pastures of God.”","poem":2}]},{"number":13,"lines":[{"text":"Make them like tumbleweed, O my God,","poem":1},{"text":"like chaff before the wind.","poem":2}]},{"number":14,"lines":[{"text":"As fire consumes a forest,","poem":1},{"text":"as a flame sets the mountains ablaze,","poem":2}]},{"number":15,"lines":[{"text":"so pursue them with Your tempest,","poem":1},{"text":"and terrify them with Your storm.","poem":2}]},{"number":16,"lines":[{"text":"Cover their faces with shame,","poem":1},{"text":"that they may seek Your name, O LORD.","poem":2}]},{"number":17,"lines":[{"text":"May they be ever ashamed and terrified;","poem":1},{"text":"may they perish in disgrace.","poem":2}]},{"number":18,"lines":[{"text":"May they know that You alone,","poem":1},{"text":"whose name is the LORD,","poem":2},{"text":"are Most High over all the earth.","poem":2}]}]},{"number":84,"lastVerse":12,"verses":[{"number":1,"lines":[{"text":"How lovely is Your dwelling place,","poem":1},{"text":"O LORD of Hosts!","poem":2}]},{"number":2,"lines":[{"text":"My soul longs, even faints,","poem":1},{"text":"for the courts of the LORD;","poem":2},{"text":"my heart and my flesh cry out","poem":1},{"text":"for the living God.","poem":2}]},{"number":3,"lines":[{"text":"Even the sparrow has found a home,","poem":1},{"text":"and the swallow a nest for herself,","poem":2},{"text":"where she places her young near Your altars,","poem":1},{"text":"O LORD of Hosts, my King and my God.","poem":2}]},{"number":4,"lines":[{"text":"How blessed are those who dwell in Your house!","poem":1},{"text":"They are ever praising You.","poem":2},{"text":"Selah"}]},{"number":5,"lines":[{"text":"Blessed are those whose strength is in You,","poem":1},{"text":"whose hearts are set on pilgrimage.","poem":2}]},{"number":6,"lines":[{"text":"As they pass through the Valley of Baca,","poem":1},{"text":"they make it a place of springs;","poem":2},{"text":"even the autumn rain covers it with pools.","poem":2}]},{"number":7,"lines":[{"text":"They go from strength to strength,","poem":1},{"text":"until each appears before God in Zion.","poem":2}]},{"number":8,"lines":[{"text":"O LORD God of Hosts, hear my prayer;","poem":1},{"text":"give ear, O God of Jacob.","poem":2},{"text":"Selah"}]},{"number":9,"lines":[{"text":"Take notice of our shield, O God,","poem":1},{"text":"and look with favor on the face of Your anointed.","poem":2}]},{"number":10,"lines":[{"text":"For better is one day in Your courts","poem":1},{"text":"than a thousand elsewhere.","poem":2},{"text":"I would rather be a doorkeeper in the house of my God","poem":1},{"text":"than dwell in the tents of the wicked.","poem":2}]},{"number":11,"lines":[{"text":"For the LORD God is a sun and a shield;","poem":1},{"text":"the LORD gives grace and glory;","poem":2},{"text":"He withholds no good thing","poem":1},{"text":"from those who walk with integrity.","poem":2}]},{"number":12,"lines":[{"text":"O LORD of Hosts,","poem":1},{"text":"how blessed is the man who trusts in You!","poem":2}]}]},{"number":85,"lastVerse":13,"verses":[{"number":1,"lines":[{"text":"You showed favor to Your land, O LORD;","poem":1},{"text":"You restored Jacob from captivity.","poem":2}]},{"number":2,"lines":[{"text":"You forgave the iniquity of Your people;","poem":1},{"text":"You covered all their sin.","poem":2},{"text":"Selah"}]},{"number":3,"lines":[{"text":"You withheld all Your fury;","poem":1},{"text":"You turned from Your burning anger.","poem":2}]},{"number":4,"lines":[{"text":"Restore us, O God of our salvation,","poem":1},{"text":"and put away Your displeasure toward us.","poem":2}]},{"number":5,"lines":[{"text":"Will You be angry with us forever?","poem":1},{"text":"Will You draw out Your anger to all generations?","poem":2}]},{"number":6,"lines":[{"text":"Will You not revive us again,","poem":1},{"text":"that Your people may rejoice in You?","poem":2}]},{"number":7,"lines":[{"text":"Show us Your loving devotion, O LORD,","poem":1},{"text":"and grant us Your salvation.","poem":2}]},{"number":8,"lines":[{"text":"I will listen to what God the LORD will say;","poem":1},{"text":"for He will surely speak peace to His people and His saints;","poem":2},{"text":"He will not let them return to folly.","poem":2}]},{"number":9,"lines":[{"text":"Surely His salvation is near to those who fear Him,","poem":1},{"text":"that His glory may dwell in our land.","poem":2}]},{"number":10,"lines":[{"text":"Loving devotion and faithfulness have joined together;","poem":1},{"text":"righteousness and peace have kissed.","poem":2}]},{"number":11,"lines":[{"text":"Faithfulness sprouts from the earth,","poem":1},{"text":"and righteousness looks down from heaven.","poem":2}]},{"number":12,"lines":[{"text":"The LORD will indeed provide what is good,","poem":1},{"text":"and our land will yield its increase.","poem":2}]},{"number":13,"lines":[{"text":"Righteousness will go before Him","poem":1},{"text":"to prepare the way for His steps.","poem":2}]}]},{"number":86,"lastVerse":17,"verses":[{"number":1,"lines":[{"text":"Incline Your ear, O LORD, and answer me,","poem":1},{"text":"for I am poor and needy.","poem":2}]},{"number":2,"lines":[{"text":"Preserve my soul, for I am godly.","poem":1},{"text":"You are my God; save Your servant who trusts in You.","poem":2}]},{"number":3,"lines":[{"text":"Be merciful to me, O Lord,","poem":1},{"text":"for I call to You all day long.","poem":2}]},{"number":4,"lines":[{"text":"Bring joy to Your servant,","poem":1},{"text":"for to You, O Lord, I lift up my soul.","poem":2}]},{"number":5,"lines":[{"text":"For You, O Lord, are kind and forgiving,","poem":1},{"text":"rich in loving devotion to all who call on You.","poem":2}]},{"number":6,"lines":[{"text":"Hear my prayer, O LORD,","poem":1},{"text":"and attend to my plea for mercy.","poem":2}]},{"number":7,"lines":[{"text":"In the day of my distress I call on You,","poem":1},{"text":"because You answer me.","poem":2}]},{"number":8,"lines":[{"text":"O Lord, there is none like You among the gods,","poem":1},{"text":"nor any works like Yours.","poem":2}]},{"number":9,"lines":[{"text":"All the nations You have made","poem":1},{"text":"will come and bow before You, O Lord,","poem":2},{"text":"and they will glorify Your name.","poem":2}]},{"number":10,"lines":[{"text":"For You are great and perform wonders;","poem":1},{"text":"You alone are God.","poem":2}]},{"number":11,"lines":[{"text":"Teach me Your way, O LORD,","poem":1},{"text":"that I may walk in Your truth.","poem":2},{"text":"Give me an undivided heart,","poem":1},{"text":"that I may fear Your name.","poem":2}]},{"number":12,"lines":[{"text":"I will praise You, O Lord my God, with all my heart;","poem":1},{"text":"I will glorify Your name forever.","poem":2}]},{"number":13,"lines":[{"text":"For great is Your loving devotion to me;","poem":1},{"text":"You have delivered me from the depths of Sheol.","poem":2}]},{"number":14,"lines":[{"text":"The arrogant rise against me, O God;","poem":1},{"text":"a band of ruthless men seeks my life;","poem":2},{"text":"they have no regard for You.","poem":2}]},{"number":15,"lines":[{"text":"But You, O Lord, are a compassionate and gracious God,","poem":1},{"text":"slow to anger, abounding in loving devotion and faithfulness.","poem":2}]},{"number":16,"lines":[{"text":"Turn to me and have mercy;","poem":1},{"text":"grant Your strength to Your servant;","poem":2},{"text":"save the son of Your maidservant.","poem":2}]},{"number":17,"lines":[{"text":"Show me a sign of Your goodness,","poem":1},{"text":"that my enemies may see and be ashamed;","poem":2},{"text":"for You, O LORD, have helped me and comforted me.","poem":2}]}]},{"number":87,"lastVerse":7,"verses":[{"number":1,"lines":[{"text":"He has founded His city","poem":1},{"text":"on the holy mountains.","poem":2}]},{"number":2,"lines":[{"text":"The LORD loves the gates of Zion","poem":1},{"text":"more than all the dwellings of Jacob.","poem":2}]},{"number":3,"lines":[{"text":"Glorious things are ascribed to you,","poem":1},{"text":"O city of God.","poem":2},{"text":"Selah"}]},{"number":4,"lines":[{"text":"“I will mention Rahab and Babylon","poem":1},{"text":"among those who know Me—","poem":2},{"text":"along with Philistia, Tyre, and Cush —","poem":1},{"text":"when I say, ‘This one was born in Zion.’”","poem":2}]},{"number":5,"lines":[{"text":"And it will be said of Zion:","poem":1},{"text":"“This one and that one were born in her,","poem":2},{"text":"and the Most High Himself will establish her.”","poem":2}]},{"number":6,"lines":[{"text":"The LORD will record in the register of the peoples:","poem":1},{"text":"“This one was born in Zion.”","poem":2},{"text":"Selah"}]},{"number":7,"lines":[{"text":"Singers and pipers will proclaim,","poem":1},{"text":"“All my springs of joy are in You.”","poem":2}]}]},{"number":88,"lastVerse":18,"verses":[{"number":1,"lines":[{"text":"O LORD, the God of my salvation,","poem":1},{"text":"day and night I cry out before You.","poem":2}]},{"number":2,"lines":[{"text":"May my prayer come before You;","poem":1},{"text":"incline Your ear to my cry.","poem":2}]},{"number":3,"lines":[{"text":"For my soul is full of troubles,","poem":1},{"text":"and my life draws near to Sheol.","poem":2}]},{"number":4,"lines":[{"text":"I am counted among those descending to the Pit.","poem":1},{"text":"I am like a man without strength.","poem":2}]},{"number":5,"lines":[{"text":"I am forsaken among the dead,","poem":1},{"text":"like the slain who lie in the grave,","poem":2},{"text":"whom You remember no more,","poem":1},{"text":"who are cut off from Your care.","poem":2}]},{"number":6,"lines":[{"text":"You have laid me in the lowest Pit,","poem":1},{"text":"in the darkest of the depths.","poem":2}]},{"number":7,"lines":[{"text":"Your wrath weighs heavily upon me;","poem":1},{"text":"all Your waves have submerged me.","poem":2},{"text":"Selah"}]},{"number":8,"lines":[{"text":"You have removed my friends from me;","poem":1},{"text":"You have made me repulsive to them;","poem":2},{"text":"I am confined and cannot escape.","poem":2}]},{"number":9,"lines":[{"text":"My eyes grow dim with grief.","poem":1},{"text":"I call to You daily, O LORD;","poem":2},{"text":"I spread out my hands to You.","poem":2}]},{"number":10,"lines":[{"text":"Do You work wonders for the dead?","poem":1},{"text":"Do departed spirits rise up to praise You?","poem":2},{"text":"Selah"}]},{"number":11,"lines":[{"text":"Can Your loving devotion be proclaimed in the grave,","poem":1},{"text":"Your faithfulness in Abaddon?","poem":2}]},{"number":12,"lines":[{"text":"Will Your wonders be known in the darkness,","poem":1},{"text":"or Your righteousness in the land of oblivion?","poem":2}]},{"number":13,"lines":[{"text":"But to You, O LORD, I cry for help;","poem":1},{"text":"in the morning my prayer comes before You.","poem":2}]},{"number":14,"lines":[{"text":"Why, O LORD, do You reject me?","poem":1},{"text":"Why do You hide Your face from me?","poem":2}]},{"number":15,"lines":[{"text":"From my youth I was afflicted and near death.","poem":1},{"text":"I have borne Your terrors; I am in despair.","poem":2}]},{"number":16,"lines":[{"text":"Your wrath has swept over me;","poem":1},{"text":"Your terrors have destroyed me.","poem":2}]},{"number":17,"lines":[{"text":"All day long they engulf me like water;","poem":1},{"text":"they enclose me on every side.","poem":2}]},{"number":18,"lines":[{"text":"You have removed my beloved and my friend;","poem":1},{"text":"darkness is my closest companion.","poem":2}]}]},{"number":89,"lastVerse":52,"verses":[{"number":1,"lines":[{"text":"I will sing of the loving devotion of the LORD forever;","poem":1},{"text":"with my mouth I will proclaim Your faithfulness to all generations.","poem":2}]},{"number":2,"lines":[{"text":"For I have said, “Loving devotion is built up forever;","poem":1},{"text":"in the heavens You establish Your faithfulness.”","poem":2}]},{"number":3,"lines":[{"text":"You said, “I have made a covenant with My chosen one,","poem":1},{"text":"I have sworn to David My servant:","poem":2}]},{"number":4,"lines":[{"text":"‘I will establish your offspring forever","poem":1},{"text":"and build up your throne for all generations.’”","poem":2},{"text":"Selah"}]},{"number":5,"lines":[{"text":"The heavens praise Your wonders, O LORD—","poem":1},{"text":"Your faithfulness as well—","poem":2},{"text":"in the assembly of the holy ones.","poem":2}]},{"number":6,"lines":[{"text":"For who in the skies can compare with the LORD?","poem":1},{"text":"Who among the heavenly beings is like the LORD?","poem":2}]},{"number":7,"lines":[{"text":"In the council of the holy ones, God is greatly feared,","poem":1},{"text":"and awesome above all who surround Him.","poem":2}]},{"number":8,"lines":[{"text":"O LORD God of Hosts, who is like You?","poem":1},{"text":"O mighty LORD, Your faithfulness surrounds You.","poem":2}]},{"number":9,"lines":[{"text":"You rule the raging sea;","poem":1},{"text":"when its waves mount up, You still them.","poem":2}]},{"number":10,"lines":[{"text":"You crushed Rahab like a carcass;","poem":1},{"text":"You scattered Your enemies with Your mighty arm.","poem":2}]},{"number":11,"lines":[{"text":"The heavens are Yours, and also the earth.","poem":1},{"text":"The earth and its fullness You founded.","poem":2}]},{"number":12,"lines":[{"text":"North and south You created;","poem":1},{"text":"Tabor and Hermon shout for joy at Your name.","poem":2}]},{"number":13,"lines":[{"text":"Mighty is Your arm; strong is Your hand.","poem":1},{"text":"Your right hand is exalted.","poem":2}]},{"number":14,"lines":[{"text":"Righteousness and justice are the foundation of Your throne;","poem":1},{"text":"loving devotion and faithfulness go before You.","poem":2}]},{"number":15,"lines":[{"text":"Blessed are those who know the joyful sound,","poem":1},{"text":"who walk, O LORD, in the light of Your presence.","poem":2}]},{"number":16,"lines":[{"text":"They rejoice in Your name all day long,","poem":1},{"text":"and in Your righteousness they exult.","poem":2}]},{"number":17,"lines":[{"text":"For You are the glory of their strength,","poem":1},{"text":"and by Your favor our horn is exalted.","poem":2}]},{"number":18,"lines":[{"text":"Surely our shield belongs to the LORD,","poem":1},{"text":"and our king to the Holy One of Israel.","poem":2}]},{"number":19,"lines":[{"text":"You once spoke in a vision;","poem":1},{"text":"to Your godly ones You said,","poem":2},{"text":"“I have bestowed help on a warrior;","poem":1},{"text":"I have exalted one chosen from the people.","poem":2}]},{"number":20,"lines":[{"text":"I have found My servant David;","poem":1},{"text":"with My sacred oil I have anointed him.","poem":2}]},{"number":21,"lines":[{"text":"My hand will sustain him;","poem":1},{"text":"surely My arm will strengthen him.","poem":2}]},{"number":22,"lines":[{"text":"No enemy will exact tribute;","poem":1},{"text":"no wicked man will oppress him.","poem":2}]},{"number":23,"lines":[{"text":"I will crush his foes before him","poem":1},{"text":"and strike down those who hate him.","poem":2}]},{"number":24,"lines":[{"text":"My faithfulness and loving devotion will be with him,","poem":1},{"text":"and through My name his horn will be exalted.","poem":2}]},{"number":25,"lines":[{"text":"I will set his hand over the sea,","poem":1},{"text":"and his right hand upon the rivers.","poem":2}]},{"number":26,"lines":[{"text":"He will call to Me, ‘You are my Father,","poem":1},{"text":"my God, the Rock of my salvation.’","poem":2}]},{"number":27,"lines":[{"text":"I will indeed appoint him as My firstborn,","poem":1},{"text":"the highest of the kings of the earth.","poem":2}]},{"number":28,"lines":[{"text":"I will forever preserve My loving devotion for him,","poem":1},{"text":"and My covenant with him will stand fast.","poem":2}]},{"number":29,"lines":[{"text":"I will establish his line forever,","poem":1},{"text":"his throne as long as the heavens endure.","poem":2}]},{"number":30,"lines":[{"text":"If his sons forsake My law","poem":1},{"text":"and do not walk in My judgments,","poem":2}]},{"number":31,"lines":[{"text":"if they violate My statutes","poem":1},{"text":"and fail to keep My commandments,","poem":2}]},{"number":32,"lines":[{"text":"I will attend to their transgression with the rod,","poem":1},{"text":"and to their iniquity with stripes.","poem":2}]},{"number":33,"lines":[{"text":"But I will not withdraw My loving devotion from him,","poem":1},{"text":"nor ever betray My faithfulness.","poem":2}]},{"number":34,"lines":[{"text":"I will not violate My covenant","poem":1},{"text":"or alter the utterance of My lips.","poem":2}]},{"number":35,"lines":[{"text":"Once and for all I have sworn by My holiness—","poem":1},{"text":"I will not lie to David—","poem":2}]},{"number":36,"lines":[{"text":"his offspring shall endure forever,","poem":1},{"text":"and his throne before Me like the sun,","poem":2}]},{"number":37,"lines":[{"text":"like the moon, established forever,","poem":1},{"text":"a faithful witness in the sky.”","poem":2},{"text":"Selah"}]},{"number":38,"lines":[{"text":"Now, however, You have spurned and rejected him;","poem":1},{"text":"You are enraged by Your anointed one.","poem":2}]},{"number":39,"lines":[{"text":"You have renounced the covenant with Your servant","poem":1},{"text":"and sullied his crown in the dust.","poem":2}]},{"number":40,"lines":[{"text":"You have broken down all his walls;","poem":1},{"text":"You have reduced his strongholds to rubble.","poem":2}]},{"number":41,"lines":[{"text":"All who pass by plunder him;","poem":1},{"text":"he has become a reproach to his neighbors.","poem":2}]},{"number":42,"lines":[{"text":"You have exalted the right hand of his foes;","poem":1},{"text":"You have made all his enemies rejoice.","poem":2}]},{"number":43,"lines":[{"text":"You have bent the edge of his sword","poem":1},{"text":"and have not sustained him in battle.","poem":2}]},{"number":44,"lines":[{"text":"You have ended his splendor","poem":1},{"text":"and cast his throne to the ground.","poem":2}]},{"number":45,"lines":[{"text":"You have cut short the days of his youth;","poem":1},{"text":"You have covered him with shame.","poem":2},{"text":"Selah"}]},{"number":46,"lines":[{"text":"How long, O LORD?","poem":1},{"text":"Will You hide Yourself forever?","poem":2},{"text":"Will Your wrath keep burning like fire?","poem":2}]},{"number":47,"lines":[{"text":"Remember the briefness of my lifespan!","poem":1},{"text":"For what futility You have created all men!","poem":2}]},{"number":48,"lines":[{"text":"What man can live and never see death?","poem":1},{"text":"Can he deliver his soul from the power of Sheol?","poem":2},{"text":"Selah"}]},{"number":49,"lines":[{"text":"Where, O Lord, is Your loving devotion of old,","poem":1},{"text":"which You faithfully swore to David?","poem":2}]},{"number":50,"lines":[{"text":"Remember, O Lord, the reproach of Your servants,","poem":1},{"text":"which I bear in my heart from so many people—","poem":2}]},{"number":51,"lines":[{"text":"how Your enemies have taunted, O LORD,","poem":1},{"text":"and have mocked every step of Your anointed one!","poem":2}]},{"number":52,"lines":[{"text":"Blessed be the LORD forever!","poem":1},{"text":"Amen and amen.","poem":1}]}]},{"number":90,"lastVerse":17,"verses":[{"number":1,"lines":[{"text":"Lord, You have been our dwelling place","poem":1},{"text":"through all generations.","poem":2}]},{"number":2,"lines":[{"text":"Before the mountains were born","poem":1},{"text":"or You brought forth the earth and the world,","poem":2},{"text":"from everlasting to everlasting","poem":1},{"text":"You are God.","poem":2}]},{"number":3,"lines":[{"text":"You return man to dust,","poem":1},{"text":"saying, “Return, O sons of mortals.”","poem":2}]},{"number":4,"lines":[{"text":"For in Your sight a thousand years","poem":1},{"text":"are but a day that passes,","poem":2},{"text":"or a watch of the night.","poem":2}]},{"number":5,"lines":[{"text":"You sweep them away in their sleep;","poem":1},{"text":"they are like the new grass of the morning—","poem":2}]},{"number":6,"lines":[{"text":"in the morning it springs up new,","poem":1},{"text":"but by evening it fades and withers.","poem":2}]},{"number":7,"lines":[{"text":"For we are consumed by Your anger","poem":1},{"text":"and terrified by Your wrath.","poem":2}]},{"number":8,"lines":[{"text":"You have set our iniquities before You,","poem":1},{"text":"our secret sins in the light of Your presence.","poem":2}]},{"number":9,"lines":[{"text":"For all our days decline in Your fury;","poem":1},{"text":"we finish our years with a sigh.","poem":2}]},{"number":10,"lines":[{"text":"The length of our days is seventy years—","poem":1},{"text":"or eighty if we are strong—","poem":2},{"text":"yet their pride is but labor and sorrow,","poem":1},{"text":"for they quickly pass, and we fly away.","poem":2}]},{"number":11,"lines":[{"text":"Who knows the power of Your anger?","poem":1},{"text":"Your wrath matches the fear You are due.","poem":2}]},{"number":12,"lines":[{"text":"So teach us to number our days,","poem":1},{"text":"that we may present a heart of wisdom.","poem":2}]},{"number":13,"lines":[{"text":"Return, O LORD! How long will it be?","poem":1},{"text":"Have compassion on Your servants.","poem":2}]},{"number":14,"lines":[{"text":"Satisfy us in the morning with Your loving devotion,","poem":1},{"text":"that we may sing for joy and be glad all our days.","poem":2}]},{"number":15,"lines":[{"text":"Make us glad for as many days as You have afflicted us,","poem":1},{"text":"for as many years as we have seen evil.","poem":2}]},{"number":16,"lines":[{"text":"May Your work be shown to Your servants,","poem":1},{"text":"and Your splendor to their children.","poem":2}]},{"number":17,"lines":[{"text":"May the favor of the Lord our God rest upon us;","poem":1},{"text":"establish for us the work of our hands—","poem":2},{"text":"yes, establish the work of our hands!","poem":2}]}]},{"number":91,"lastVerse":16,"verses":[{"number":1,"lines":[{"text":"He who dwells in the shelter of the Most High","poem":1},{"text":"will abide in the shadow of the Almighty.","poem":2}]},{"number":2,"lines":[{"text":"I will say to the LORD, “You are my refuge and my fortress,","poem":1},{"text":"my God, in whom I trust.”","poem":2}]},{"number":3,"lines":[{"text":"Surely He will deliver you","poem":1},{"text":"from the snare of the fowler,","poem":2},{"text":"and from the deadly plague.","poem":2}]},{"number":4,"lines":[{"text":"He will cover you with His feathers;","poem":1},{"text":"under His wings you will find refuge;","poem":2},{"text":"His faithfulness is a shield and rampart.","poem":2}]},{"number":5,"lines":[{"text":"You will not fear the terror of the night,","poem":1},{"text":"nor the arrow that flies by day,","poem":2}]},{"number":6,"lines":[{"text":"nor the pestilence that stalks in the darkness,","poem":1},{"text":"nor the calamity that destroys at noon.","poem":2}]},{"number":7,"lines":[{"text":"Though a thousand may fall at your side,","poem":1},{"text":"and ten thousand at your right hand,","poem":2},{"text":"no harm will come near you.","poem":2}]},{"number":8,"lines":[{"text":"You will only see it with your eyes","poem":1},{"text":"and witness the punishment of the wicked.","poem":2}]},{"number":9,"lines":[{"text":"Because you have made the LORD your dwelling—","poem":1},{"text":"my refuge, the Most High—","poem":2}]},{"number":10,"lines":[{"text":"no evil will befall you,","poem":1},{"text":"no plague will approach your tent.","poem":2}]},{"number":11,"lines":[{"text":"For He will command His angels concerning you","poem":1},{"text":"to guard you in all your ways.","poem":2}]},{"number":12,"lines":[{"text":"They will lift you up in their hands,","poem":1},{"text":"so that you will not strike your foot against a stone.","poem":2}]},{"number":13,"lines":[{"text":"You will tread on the lion and cobra;","poem":1},{"text":"you will trample the young lion and serpent.","poem":2}]},{"number":14,"lines":[{"text":"“Because he loves Me, I will deliver him;","poem":1},{"text":"because he knows My name, I will protect him.","poem":2}]},{"number":15,"lines":[{"text":"When he calls out to Me,","poem":1},{"text":"I will answer him;","poem":2},{"text":"I will be with him in trouble.","poem":1},{"text":"I will deliver him and honor him.","poem":2}]},{"number":16,"lines":[{"text":"With long life I will satisfy him","poem":1},{"text":"and show him My salvation.”","poem":2}]}]},{"number":92,"lastVerse":15,"verses":[{"number":1,"lines":[{"text":"It is good to praise the LORD,","poem":1},{"text":"and to sing praises to Your name, O Most High,","poem":2}]},{"number":2,"lines":[{"text":"to proclaim Your loving devotion in the morning","poem":1},{"text":"and Your faithfulness at night","poem":2}]},{"number":3,"lines":[{"text":"with the ten-stringed harp","poem":1},{"text":"and the melody of the lyre.","poem":2}]},{"number":4,"lines":[{"text":"For You, O LORD, have made me glad by Your deeds;","poem":1},{"text":"I sing for joy at the works of Your hands.","poem":2}]},{"number":5,"lines":[{"text":"How great are Your works, O LORD,","poem":1},{"text":"how deep are Your thoughts!","poem":2}]},{"number":6,"lines":[{"text":"A senseless man does not know,","poem":1},{"text":"and a fool does not understand,","poem":2}]},{"number":7,"lines":[{"text":"that though the wicked sprout like grass,","poem":1},{"text":"and all evildoers flourish,","poem":2},{"text":"they will be forever destroyed.","poem":2}]},{"number":8,"lines":[{"text":"But You, O LORD, are exalted forever!","poem":1}]},{"number":9,"lines":[{"text":"For surely Your enemies, O LORD,","poem":1},{"text":"surely Your enemies will perish;","poem":2},{"text":"all evildoers will be scattered.","poem":2}]},{"number":10,"lines":[{"text":"But You have exalted my horn like that of a wild ox;","poem":1},{"text":"with fine oil I have been anointed.","poem":2}]},{"number":11,"lines":[{"text":"My eyes see the downfall of my enemies;","poem":1},{"text":"my ears hear the wailing of my wicked foes.","poem":2}]},{"number":12,"lines":[{"text":"The righteous will flourish like a palm tree,","poem":1},{"text":"and grow like a cedar in Lebanon.","poem":2}]},{"number":13,"lines":[{"text":"Planted in the house of the LORD,","poem":1},{"text":"they will flourish in the courts of our God.","poem":2}]},{"number":14,"lines":[{"text":"In old age they will still bear fruit;","poem":1},{"text":"healthy and green they will remain,","poem":2}]},{"number":15,"lines":[{"text":"to proclaim, “The LORD is upright; He is my Rock,","poem":1},{"text":"and in Him there is no unrighteousness.”","poem":2}]}]},{"number":93,"lastVerse":5,"verses":[{"number":1,"lines":[{"text":"The LORD reigns! He is robed in majesty;","poem":1},{"text":"the LORD has clothed and armed Himself with strength.","poem":2},{"text":"The world indeed is firmly established;","poem":1},{"text":"it cannot be moved.","poem":2}]},{"number":2,"lines":[{"text":"Your throne was established long ago;","poem":1},{"text":"You are from all eternity.","poem":2}]},{"number":3,"lines":[{"text":"The floodwaters have risen, O LORD;","poem":1},{"text":"the rivers have raised their voice;","poem":2},{"text":"the seas lift up their pounding waves.","poem":2}]},{"number":4,"lines":[{"text":"Above the roar of many waters—","poem":1},{"text":"the mighty breakers of the sea—","poem":2},{"text":"the LORD on high is majestic.","poem":2}]},{"number":5,"lines":[{"text":"Your testimonies are fully confirmed;","poem":1},{"text":"holiness adorns Your house, O LORD,","poem":2},{"text":"for all the days to come.","poem":2}]}]},{"number":94,"lastVerse":23,"verses":[{"number":1,"lines":[{"text":"O LORD, God of vengeance,","poem":1},{"text":"O God of vengeance, shine forth.","poem":2}]},{"number":2,"lines":[{"text":"Rise up, O Judge of the earth;","poem":1},{"text":"render a reward to the proud.","poem":2}]},{"number":3,"lines":[{"text":"How long will the wicked, O LORD,","poem":1},{"text":"how long will the wicked exult?","poem":2}]},{"number":4,"lines":[{"text":"They pour out arrogant words;","poem":1},{"text":"all workers of iniquity boast.","poem":2}]},{"number":5,"lines":[{"text":"They crush Your people, O LORD;","poem":1},{"text":"they oppress Your heritage.","poem":2}]},{"number":6,"lines":[{"text":"They kill the widow and the foreigner;","poem":1},{"text":"they murder the fatherless.","poem":2}]},{"number":7,"lines":[{"text":"They say, “The LORD does not see;","poem":1},{"text":"the God of Jacob pays no heed.”","poem":2}]},{"number":8,"lines":[{"text":"Take notice, O senseless among the people!","poem":1},{"text":"O fools, when will you be wise?","poem":2}]},{"number":9,"lines":[{"text":"He who affixed the ear, can He not hear?","poem":1},{"text":"He who formed the eye, can He not see?","poem":2}]},{"number":10,"lines":[{"text":"He who admonishes the nations, does He not discipline?","poem":1},{"text":"He who teaches man, does He lack knowledge?","poem":2}]},{"number":11,"lines":[{"text":"The LORD knows the thoughts of man,","poem":1},{"text":"that they are futile.","poem":2}]},{"number":12,"lines":[{"text":"Blessed is the man You discipline, O LORD,","poem":1},{"text":"and teach from Your law,","poem":2}]},{"number":13,"lines":[{"text":"to grant him relief from days of trouble,","poem":1},{"text":"until a pit is dug for the wicked.","poem":2}]},{"number":14,"lines":[{"text":"For the LORD will not forsake His people;","poem":1},{"text":"He will never abandon His heritage.","poem":2}]},{"number":15,"lines":[{"text":"Surely judgment will again be righteous,","poem":1},{"text":"and all the upright in heart will follow it.","poem":2}]},{"number":16,"lines":[{"text":"Who will rise up for me against the wicked?","poem":1},{"text":"Who will stand for me against the workers of iniquity?","poem":2}]},{"number":17,"lines":[{"text":"Unless the LORD had been my helper,","poem":1},{"text":"I would soon have dwelt in the abode of silence.","poem":2}]},{"number":18,"lines":[{"text":"If I say, “My foot is slipping,”","poem":1},{"text":"Your loving devotion, O LORD, supports me.","poem":2}]},{"number":19,"lines":[{"text":"When anxiety overwhelms me,","poem":1},{"text":"Your consolation delights my soul.","poem":2}]},{"number":20,"lines":[{"text":"Can a corrupt throne be Your ally—","poem":1},{"text":"one devising mischief by decree?","poem":2}]},{"number":21,"lines":[{"text":"They band together against the righteous","poem":1},{"text":"and condemn the innocent to death.","poem":2}]},{"number":22,"lines":[{"text":"But the LORD has been my stronghold,","poem":1},{"text":"and my God is my rock of refuge.","poem":2}]},{"number":23,"lines":[{"text":"He will bring upon them their own iniquity","poem":1},{"text":"and destroy them for their wickedness.","poem":2},{"text":"The LORD our God will destroy them.","poem":2}]}]},{"number":95,"lastVerse":11,"verses":[{"number":1,"lines":[{"text":"Come, let us sing for joy to the LORD;","poem":1},{"text":"let us shout to the Rock of our salvation!","poem":2}]},{"number":2,"lines":[{"text":"Let us enter His presence with thanksgiving;","poem":1},{"text":"let us make a joyful noise to Him in song.","poem":2}]},{"number":3,"lines":[{"text":"For the LORD is a great God,","poem":1},{"text":"a great King above all gods.","poem":2}]},{"number":4,"lines":[{"text":"In His hand are the depths of the earth,","poem":1},{"text":"and the mountain peaks belong to Him.","poem":2}]},{"number":5,"lines":[{"text":"The sea is His, for He made it,","poem":1},{"text":"and His hands formed the dry land.","poem":2}]},{"number":6,"lines":[{"text":"O come, let us worship and bow down;","poem":1},{"text":"let us kneel before the LORD our Maker.","poem":2}]},{"number":7,"lines":[{"text":"For He is our God,","poem":1},{"text":"and we are the people of His pasture,","poem":2},{"text":"the sheep under His care.","poem":2},{"text":"Today, if you hear His voice,","poem":1}]},{"number":8,"lines":[{"text":"do not harden your hearts","poem":2},{"text":"as you did at Meribah,","poem":1},{"text":"in the day at Massah in the wilderness,","poem":2}]},{"number":9,"lines":[{"text":"where your fathers tested and tried Me,","poem":1},{"text":"though they had seen My work.","poem":2}]},{"number":10,"lines":[{"text":"For forty years I was angry with that generation,","poem":1},{"text":"and I said, “They are a people whose hearts go astray,","poem":2},{"text":"and they have not known My ways.”","poem":2}]},{"number":11,"lines":[{"text":"So I swore on oath in My anger,","poem":1},{"text":"“They shall never enter My rest.”","poem":2}]}]},{"number":96,"lastVerse":13,"verses":[{"number":1,"lines":[{"text":"Sing to the LORD a new song;","poem":1},{"text":"sing to the LORD, all the earth.","poem":2}]},{"number":2,"lines":[{"text":"Sing to the LORD, bless His name;","poem":1},{"text":"proclaim His salvation day after day.","poem":2}]},{"number":3,"lines":[{"text":"Declare His glory among the nations,","poem":1},{"text":"His wonders among all peoples.","poem":2}]},{"number":4,"lines":[{"text":"For great is the LORD, and greatly to be praised;","poem":1},{"text":"He is to be feared above all gods.","poem":2}]},{"number":5,"lines":[{"text":"For all the gods of the nations are idols,","poem":1},{"text":"but it is the LORD who made the heavens.","poem":2}]},{"number":6,"lines":[{"text":"Splendor and majesty are before Him;","poem":1},{"text":"strength and beauty fill His sanctuary.","poem":2}]},{"number":7,"lines":[{"text":"Ascribe to the LORD, O families of the nations,","poem":1},{"text":"ascribe to the LORD glory and strength.","poem":2}]},{"number":8,"lines":[{"text":"Ascribe to the LORD the glory due His name;","poem":1},{"text":"bring an offering and enter His courts.","poem":2}]},{"number":9,"lines":[{"text":"Worship the LORD in the splendor of His holiness;","poem":1},{"text":"tremble before Him, all the earth.","poem":2}]},{"number":10,"lines":[{"text":"Declare among the nations: “The LORD reigns!”","poem":1},{"text":"The world is firmly established; it cannot be moved;","poem":2},{"text":"He will judge the peoples with equity.","poem":2}]},{"number":11,"lines":[{"text":"Let the heavens be glad","poem":1},{"text":"and the earth rejoice;","poem":2},{"text":"let the sea resound,","poem":1},{"text":"and all that fills it.","poem":2}]},{"number":12,"lines":[{"text":"Let the fields exult,","poem":1},{"text":"and all that is in them.","poem":2},{"text":"Then all the trees of the forest","poem":1},{"text":"will sing for joy","poem":2}]},{"number":13,"lines":[{"text":"before the LORD,","poem":2},{"text":"for He is coming—","poem":1},{"text":"He is coming to judge the earth.","poem":2},{"text":"He will judge the world in righteousness","poem":1},{"text":"and the peoples in His faithfulness.","poem":2}]}]},{"number":97,"lastVerse":12,"verses":[{"number":1,"lines":[{"text":"The LORD reigns, let the earth rejoice;","poem":1},{"text":"let the distant shores be glad.","poem":2}]},{"number":2,"lines":[{"text":"Clouds and darkness surround Him;","poem":1},{"text":"righteousness and justice are His throne’s foundation.","poem":2}]},{"number":3,"lines":[{"text":"Fire goes before Him","poem":1},{"text":"and consumes His foes on every side.","poem":2}]},{"number":4,"lines":[{"text":"His lightning illuminates the world;","poem":1},{"text":"the earth sees and trembles.","poem":2}]},{"number":5,"lines":[{"text":"The mountains melt like wax","poem":1},{"text":"at the presence of the LORD,","poem":2},{"text":"before the Lord of all the earth.","poem":2}]},{"number":6,"lines":[{"text":"The heavens proclaim His righteousness;","poem":1},{"text":"all the peoples see His glory.","poem":2}]},{"number":7,"lines":[{"text":"All worshipers of images are put to shame—","poem":1},{"text":"those who boast in idols.","poem":2},{"text":"Worship Him, all you gods!","poem":2}]},{"number":8,"lines":[{"text":"Zion hears and rejoices,","poem":1},{"text":"and the towns of Judah exult","poem":2},{"text":"because of Your judgments, O LORD.","poem":2}]},{"number":9,"lines":[{"text":"For You, O LORD, are Most High over all the earth;","poem":1},{"text":"You are exalted far above all gods.","poem":2}]},{"number":10,"lines":[{"text":"Hate evil, O you who love the LORD!","poem":1},{"text":"He preserves the souls of His saints;","poem":2},{"text":"He delivers them from the hand of the wicked.","poem":2}]},{"number":11,"lines":[{"text":"Light shines on the righteous,","poem":1},{"text":"gladness on the upright in heart.","poem":2}]},{"number":12,"lines":[{"text":"Rejoice in the LORD, you righteous ones,","poem":1},{"text":"and praise His holy name.","poem":2}]}]},{"number":98,"lastVerse":9,"verses":[{"number":1,"lines":[{"text":"Sing to the LORD a new song,","poem":1},{"text":"for He has done wonders;","poem":2},{"text":"His right hand and holy arm","poem":1},{"text":"have gained Him the victory.","poem":2}]},{"number":2,"lines":[{"text":"The LORD has proclaimed His salvation","poem":1},{"text":"and revealed His righteousness to the nations.","poem":2}]},{"number":3,"lines":[{"text":"He has remembered His love and faithfulness","poem":1},{"text":"to the house of Israel;","poem":2},{"text":"all the ends of the earth","poem":1},{"text":"have seen the salvation of our God.","poem":2}]},{"number":4,"lines":[{"text":"Make a joyful noise to the LORD, all the earth;","poem":1},{"text":"break forth—let your cry ring out, and sing praises!","poem":2}]},{"number":5,"lines":[{"text":"Sing praises to the LORD with the lyre,","poem":1},{"text":"in melodious song with the harp.","poem":2}]},{"number":6,"lines":[{"text":"With trumpets and the blast of the ram’s horn","poem":1},{"text":"shout for joy before the LORD, the King.","poem":2}]},{"number":7,"lines":[{"text":"Let the sea resound, and all that fills it,","poem":1},{"text":"the world, and all who dwell in it.","poem":2}]},{"number":8,"lines":[{"text":"Let the rivers clap their hands,","poem":1},{"text":"let the mountains sing together for joy","poem":2}]},{"number":9,"lines":[{"text":"before the LORD,","poem":1},{"text":"for He comes to judge the earth.","poem":2},{"text":"He will judge the world with righteousness","poem":1},{"text":"and the peoples with equity.","poem":2}]}]},{"number":99,"lastVerse":9,"verses":[{"number":1,"lines":[{"text":"The LORD reigns;","poem":1},{"text":"let the nations tremble!","poem":2},{"text":"He is enthroned above the cherubim;","poem":1},{"text":"let the earth quake!","poem":2}]},{"number":2,"lines":[{"text":"Great is the LORD in Zion;","poem":1},{"text":"He is exalted above all the peoples.","poem":2}]},{"number":3,"lines":[{"text":"Let them praise Your great and awesome name—","poem":1},{"text":"He is holy!","poem":2}]},{"number":4,"lines":[{"text":"The mighty King loves justice.","poem":1},{"text":"You have established equity;","poem":2},{"text":"You have exercised justice","poem":1},{"text":"and righteousness in Jacob.","poem":2}]},{"number":5,"lines":[{"text":"Exalt the LORD our God,","poem":1},{"text":"and worship at His footstool;","poem":2},{"text":"He is holy!","poem":2}]},{"number":6,"lines":[{"text":"Moses and Aaron were among His priests;","poem":1},{"text":"Samuel was among those who called on His name.","poem":2},{"text":"They called to the LORD and He answered.","poem":2}]},{"number":7,"lines":[{"text":"He spoke to them from the pillar of cloud;","poem":1},{"text":"they kept His decrees and the statutes He gave them.","poem":2}]},{"number":8,"lines":[{"text":"O LORD our God, You answered them.","poem":1},{"text":"You were a forgiving God to them,","poem":2},{"text":"yet an avenger of their misdeeds.","poem":2}]},{"number":9,"lines":[{"text":"Exalt the LORD our God","poem":1},{"text":"and worship at His holy mountain,","poem":2},{"text":"for the LORD our God is holy.","poem":2}]}]},{"number":100,"lastVerse":5,"verses":[{"number":1,"lines":[{"text":"Make a joyful noise to the LORD,","poem":1},{"text":"all the earth.","poem":2}]},{"number":2,"lines":[{"text":"Serve the LORD with gladness;","poem":1},{"text":"come into His presence with joyful songs.","poem":2}]},{"number":3,"lines":[{"text":"Know that the LORD is God.","poem":1},{"text":"It is He who made us, and we are His;","poem":2},{"text":"we are His people, and the sheep of His pasture.","poem":2}]},{"number":4,"lines":[{"text":"Enter His gates with thanksgiving","poem":1},{"text":"and His courts with praise;","poem":2},{"text":"give thanks to Him and bless His name.","poem":2}]},{"number":5,"lines":[{"text":"For the LORD is good,","poem":1},{"text":"and His loving devotion endures forever;","poem":2},{"text":"His faithfulness continues to all generations.","poem":2}]}]},{"number":101,"lastVerse":8,"verses":[{"number":1,"lines":[{"text":"I will sing of Your loving devotion and justice;","poem":1},{"text":"to You, O LORD, I will sing praises.","poem":2}]},{"number":2,"lines":[{"text":"I will ponder the way that is blameless—","poem":1},{"text":"when will You come to me?","poem":2},{"text":"I will walk in my house","poem":1},{"text":"with integrity of heart.","poem":2}]},{"number":3,"lines":[{"text":"I will set no worthless thing","poem":1},{"text":"before my eyes.","poem":2},{"text":"I hate the work of those who fall away;","poem":1},{"text":"it shall not cling to me.","poem":2}]},{"number":4,"lines":[{"text":"A perverse heart shall depart from me;","poem":1},{"text":"I will know nothing of evil.","poem":2}]},{"number":5,"lines":[{"text":"Whoever slanders his neighbor in secret,","poem":1},{"text":"I will put to silence;","poem":2},{"text":"the one with haughty eyes and a proud heart,","poem":1},{"text":"I will not endure.","poem":2}]},{"number":6,"lines":[{"text":"My eyes favor the faithful of the land,","poem":1},{"text":"that they may dwell with me;","poem":2},{"text":"he who walks in the way of integrity","poem":1},{"text":"shall minister to me.","poem":2}]},{"number":7,"lines":[{"text":"No one who practices deceit","poem":1},{"text":"shall dwell in my house;","poem":2},{"text":"no one who tells lies","poem":1},{"text":"shall stand in my presence.","poem":2}]},{"number":8,"lines":[{"text":"Every morning I will remove all the wicked of the land,","poem":1},{"text":"that I may cut off every evildoer from the city of the LORD.","poem":2}]}]},{"number":102,"lastVerse":28,"verses":[{"number":1,"lines":[{"text":"Hear my prayer, O LORD;","poem":1},{"text":"let my cry for help come before You.","poem":2}]},{"number":2,"lines":[{"text":"Do not hide Your face from me","poem":1},{"text":"in my day of distress.","poem":2},{"text":"Incline Your ear to me;","poem":1},{"text":"answer me quickly when I call.","poem":2}]},{"number":3,"lines":[{"text":"For my days vanish like smoke,","poem":1},{"text":"and my bones burn like glowing embers.","poem":2}]},{"number":4,"lines":[{"text":"My heart is afflicted, and withered like grass;","poem":1},{"text":"I even forget to eat my bread.","poem":2}]},{"number":5,"lines":[{"text":"Through my loud groaning","poem":1},{"text":"my skin hangs on my bones.","poem":2}]},{"number":6,"lines":[{"text":"I am like a desert owl,","poem":1},{"text":"like an owl among the ruins.","poem":2}]},{"number":7,"lines":[{"text":"I lie awake;","poem":1},{"text":"I am like a lone bird on a housetop.","poem":2}]},{"number":8,"lines":[{"text":"All day long my enemies taunt me;","poem":1},{"text":"they ridicule me and curse me.","poem":2}]},{"number":9,"lines":[{"text":"For I have eaten ashes like bread","poem":1},{"text":"and mixed my drink with tears","poem":2}]},{"number":10,"lines":[{"text":"because of Your indignation and wrath,","poem":1},{"text":"for You have picked me up and cast me aside.","poem":2}]},{"number":11,"lines":[{"text":"My days are like lengthening shadows,","poem":1},{"text":"and I wither away like grass.","poem":2}]},{"number":12,"lines":[{"text":"But You, O LORD, sit enthroned forever;","poem":1},{"text":"Your renown endures to all generations.","poem":2}]},{"number":13,"lines":[{"text":"You will rise up and have compassion on Zion,","poem":1},{"text":"for it is time to show her favor—","poem":2},{"text":"the appointed time has come.","poem":2}]},{"number":14,"lines":[{"text":"For Your servants delight in her stones","poem":1},{"text":"and take pity on her dust.","poem":2}]},{"number":15,"lines":[{"text":"So the nations will fear the name of the LORD,","poem":1},{"text":"and all the kings of the earth will fear Your glory.","poem":2}]},{"number":16,"lines":[{"text":"For the LORD will rebuild Zion;","poem":1},{"text":"He has appeared in His glory.","poem":2}]},{"number":17,"lines":[{"text":"He will turn toward the prayer of the destitute;","poem":1},{"text":"He will not despise their prayer.","poem":2}]},{"number":18,"lines":[{"text":"Let this be written for the generation to come,","poem":1},{"text":"so that a people not yet created may praise the LORD.","poem":2}]},{"number":19,"lines":[{"text":"For He looked down from the heights of His sanctuary;","poem":1},{"text":"the LORD gazed out from heaven to earth","poem":2}]},{"number":20,"lines":[{"text":"to hear a prisoner’s groaning,","poem":1},{"text":"to release those condemned to death,","poem":2}]},{"number":21,"lines":[{"text":"that they may proclaim the name of the LORD in Zion","poem":1},{"text":"and praise Him in Jerusalem,","poem":2}]},{"number":22,"lines":[{"text":"when peoples and kingdoms assemble","poem":1},{"text":"to serve the LORD.","poem":2}]},{"number":23,"lines":[{"text":"He has broken my strength on the way;","poem":1},{"text":"He has cut short my days.","poem":2}]},{"number":24,"lines":[{"text":"I say: “O my God, do not take me in the midst of my days!","poem":1},{"text":"Your years go on through all generations.","poem":2}]},{"number":25,"lines":[{"text":"In the beginning You laid the foundations of the earth,","poem":1},{"text":"and the heavens are the work of Your hands.","poem":2}]},{"number":26,"lines":[{"text":"They will perish, but You remain;","poem":1},{"text":"they will all wear out like a garment.","poem":2},{"text":"Like clothing You will change them,","poem":1},{"text":"and they will be passed on.","poem":2}]},{"number":27,"lines":[{"text":"But You remain the same,","poem":1},{"text":"and Your years will never end.","poem":2}]},{"number":28,"lines":[{"text":"The children of Your servants will dwell securely,","poem":1},{"text":"and their descendants will be established before You.”","poem":2}]}]},{"number":103,"lastVerse":22,"verses":[{"number":1,"lines":[{"text":"Bless the LORD, O my soul;","poem":1},{"text":"all that is within me, bless His holy name.","poem":2}]},{"number":2,"lines":[{"text":"Bless the LORD, O my soul,","poem":1},{"text":"and do not forget all His kind deeds—","poem":2}]},{"number":3,"lines":[{"text":"He who forgives all your iniquities","poem":1},{"text":"and heals all your diseases,","poem":2}]},{"number":4,"lines":[{"text":"who redeems your life from the Pit","poem":1},{"text":"and crowns you with loving devotion and compassion,","poem":2}]},{"number":5,"lines":[{"text":"who satisfies you with good things,","poem":1},{"text":"so that your youth is renewed like the eagle’s.","poem":2}]},{"number":6,"lines":[{"text":"The LORD executes righteousness","poem":1},{"text":"and justice for all the oppressed.","poem":2}]},{"number":7,"lines":[{"text":"He made known His ways to Moses,","poem":1},{"text":"His deeds to the people of Israel.","poem":2}]},{"number":8,"lines":[{"text":"The LORD is compassionate and gracious,","poem":1},{"text":"slow to anger, abounding in loving devotion.","poem":2}]},{"number":9,"lines":[{"text":"He will not always accuse us,","poem":1},{"text":"nor harbor His anger forever.","poem":2}]},{"number":10,"lines":[{"text":"He has not dealt with us according to our sins","poem":1},{"text":"or repaid us according to our iniquities.","poem":2}]},{"number":11,"lines":[{"text":"For as high as the heavens are above the earth,","poem":1},{"text":"so great is His loving devotion for those who fear Him.","poem":2}]},{"number":12,"lines":[{"text":"As far as the east is from the west,","poem":1},{"text":"so far has He removed our transgressions from us.","poem":2}]},{"number":13,"lines":[{"text":"As a father has compassion on his children,","poem":1},{"text":"so the LORD has compassion on those who fear Him.","poem":2}]},{"number":14,"lines":[{"text":"For He knows our frame;","poem":1},{"text":"He is mindful that we are dust.","poem":2}]},{"number":15,"lines":[{"text":"As for man, his days are like grass—","poem":1},{"text":"he blooms like a flower of the field;","poem":2}]},{"number":16,"lines":[{"text":"when the wind passes over, it vanishes,","poem":1},{"text":"and its place remembers it no more.","poem":2}]},{"number":17,"lines":[{"text":"But from everlasting to everlasting","poem":1},{"text":"the loving devotion of the LORD","poem":2},{"text":"extends to those who fear Him,","poem":2},{"text":"and His righteousness to their children’s children—","poem":1}]},{"number":18,"lines":[{"text":"to those who keep His covenant","poem":2},{"text":"and remember to obey His precepts.","poem":2}]},{"number":19,"lines":[{"text":"The LORD has established His throne in heaven,","poem":1},{"text":"and His kingdom rules over all.","poem":2}]},{"number":20,"lines":[{"text":"Bless the LORD, all His angels mighty in strength","poem":1},{"text":"who carry out His word,","poem":2},{"text":"who hearken to the voice of His command.","poem":2}]},{"number":21,"lines":[{"text":"Bless the LORD, all His hosts,","poem":1},{"text":"you servants who do His will.","poem":2}]},{"number":22,"lines":[{"text":"Bless the LORD, all His works","poem":1},{"text":"in all places of His dominion.","poem":2},{"text":"Bless the LORD, O my soul!","poem":1}]}]},{"number":104,"lastVerse":35,"verses":[{"number":1,"lines":[{"text":"Bless the LORD, O my soul!","poem":1},{"text":"O LORD my God, You are very great;","poem":1},{"text":"You are clothed with splendor and majesty.","poem":2}]},{"number":2,"lines":[{"text":"He wraps Himself in light as with a garment;","poem":1},{"text":"He stretches out the heavens like a tent,","poem":2}]},{"number":3,"lines":[{"text":"laying the beams of His chambers","poem":1},{"text":"in the waters above,","poem":2},{"text":"making the clouds His chariot,","poem":1},{"text":"walking on the wings of the wind.","poem":2}]},{"number":4,"lines":[{"text":"He makes the winds His messengers,","poem":1},{"text":"flames of fire His servants.","poem":2}]},{"number":5,"lines":[{"text":"He set the earth on its foundations,","poem":1},{"text":"never to be moved.","poem":2}]},{"number":6,"lines":[{"text":"You covered it with the deep like a garment;","poem":1},{"text":"the waters stood above the mountains.","poem":2}]},{"number":7,"lines":[{"text":"At Your rebuke the waters fled;","poem":1},{"text":"at the sound of Your thunder they hurried away—","poem":2}]},{"number":8,"lines":[{"text":"the mountains rose and the valleys sank","poem":1},{"text":"to the place You assigned for them—","poem":2}]},{"number":9,"lines":[{"text":"You set a boundary they cannot cross,","poem":1},{"text":"that they may never again cover the earth.","poem":2}]},{"number":10,"lines":[{"text":"He sends forth springs in the valleys;","poem":1},{"text":"they flow between the mountains.","poem":2}]},{"number":11,"lines":[{"text":"They give drink to every beast of the field;","poem":1},{"text":"the wild donkeys quench their thirst.","poem":2}]},{"number":12,"lines":[{"text":"The birds of the air nest beside the springs;","poem":1},{"text":"they sing among the branches.","poem":2}]},{"number":13,"lines":[{"text":"He waters the mountains from His chambers;","poem":1},{"text":"the earth is satisfied by the fruit of His works.","poem":2}]},{"number":14,"lines":[{"text":"He makes the grass grow for the livestock","poem":1},{"text":"and provides crops for man to cultivate,","poem":2},{"text":"bringing forth food from the earth:","poem":2}]},{"number":15,"lines":[{"text":"wine that gladdens the heart of man,","poem":1},{"text":"oil that makes his face to shine,","poem":2},{"text":"and bread that sustains his heart.","poem":2}]},{"number":16,"lines":[{"text":"The trees of the LORD have their fill,","poem":1},{"text":"the cedars of Lebanon that He planted,","poem":2}]},{"number":17,"lines":[{"text":"where the birds build their nests;","poem":1},{"text":"the stork makes her home in the cypresses.","poem":2}]},{"number":18,"lines":[{"text":"The high mountains are for the wild goats,","poem":1},{"text":"the cliffs a refuge for the rock badgers.","poem":2}]},{"number":19,"lines":[{"text":"He made the moon to mark the seasons;","poem":1},{"text":"the sun knows when to set.","poem":2}]},{"number":20,"lines":[{"text":"You bring darkness, and it becomes night,","poem":1},{"text":"when all the beasts of the forest prowl.","poem":2}]},{"number":21,"lines":[{"text":"The young lions roar for their prey","poem":1},{"text":"and seek their food from God.","poem":2}]},{"number":22,"lines":[{"text":"The sun rises, and they withdraw;","poem":1},{"text":"they lie down in their dens.","poem":2}]},{"number":23,"lines":[{"text":"Man goes forth to his work","poem":1},{"text":"and to his labor until evening.","poem":2}]},{"number":24,"lines":[{"text":"How many are Your works, O LORD!","poem":1},{"text":"In wisdom You have made them all;","poem":2},{"text":"the earth is full of Your creatures.","poem":2}]},{"number":25,"lines":[{"text":"Here is the sea, vast and wide,","poem":1},{"text":"teeming with creatures beyond number,","poem":2},{"text":"living things both great and small.","poem":2}]},{"number":26,"lines":[{"text":"There the ships pass,","poem":1},{"text":"and Leviathan, which You formed to frolic there.","poem":2}]},{"number":27,"lines":[{"text":"All creatures look to You","poem":1},{"text":"to give them their food in due season.","poem":2}]},{"number":28,"lines":[{"text":"When You give it to them,","poem":1},{"text":"they gather it up;","poem":2},{"text":"when You open Your hand,","poem":1},{"text":"they are satisfied with good things.","poem":2}]},{"number":29,"lines":[{"text":"When You hide Your face,","poem":1},{"text":"they are terrified;","poem":2},{"text":"when You take away their breath,","poem":1},{"text":"they die and return to dust.","poem":2}]},{"number":30,"lines":[{"text":"When You send Your Spirit,","poem":1},{"text":"they are created,","poem":2},{"text":"and You renew","poem":1},{"text":"the face of the earth.","poem":2}]},{"number":31,"lines":[{"text":"May the glory of the LORD endure forever;","poem":1},{"text":"may the LORD rejoice in His works.","poem":2}]},{"number":32,"lines":[{"text":"He looks on the earth,","poem":1},{"text":"and it trembles;","poem":2},{"text":"He touches the mountains,","poem":1},{"text":"and they smolder.","poem":2}]},{"number":33,"lines":[{"text":"I will sing to the LORD all my life;","poem":1},{"text":"I will sing praise to my God while I have my being.","poem":2}]},{"number":34,"lines":[{"text":"May my meditation be pleasing to Him,","poem":1},{"text":"for I rejoice in the LORD.","poem":2}]},{"number":35,"lines":[{"text":"May sinners vanish from the earth","poem":1},{"text":"and the wicked be no more.","poem":2},{"text":"Bless the LORD, O my soul.","poem":1},{"text":"Hallelujah!","poem":1}]}]},{"number":105,"lastVerse":45,"verses":[{"number":1,"lines":[{"text":"Give thanks to the LORD, call upon His name;","poem":1},{"text":"make known His deeds among the nations.","poem":2}]},{"number":2,"lines":[{"text":"Sing to Him, sing praises to Him;","poem":1},{"text":"tell of all His wonders.","poem":2}]},{"number":3,"lines":[{"text":"Glory in His holy name;","poem":1},{"text":"let the hearts of those who seek the LORD rejoice.","poem":2}]},{"number":4,"lines":[{"text":"Seek out the LORD and His strength;","poem":1},{"text":"seek His face always.","poem":2}]},{"number":5,"lines":[{"text":"Remember the wonders He has done,","poem":1},{"text":"His marvels, and the judgments He has pronounced,","poem":2}]},{"number":6,"lines":[{"text":"O offspring of His servant Abraham,","poem":1},{"text":"O sons of Jacob, His chosen ones.","poem":2}]},{"number":7,"lines":[{"text":"He is the LORD our God;","poem":1},{"text":"His judgments carry throughout the earth.","poem":2}]},{"number":8,"lines":[{"text":"He remembers His covenant forever,","poem":1},{"text":"the word He ordained for a thousand generations—","poem":2}]},{"number":9,"lines":[{"text":"the covenant He made with Abraham,","poem":1},{"text":"and the oath He swore to Isaac.","poem":2}]},{"number":10,"lines":[{"text":"He confirmed it to Jacob as a decree,","poem":1},{"text":"to Israel as an everlasting covenant:","poem":2}]},{"number":11,"lines":[{"text":"“I will give you the land of Canaan","poem":1},{"text":"as the portion of your inheritance.”","poem":2}]},{"number":12,"lines":[{"text":"When they were few in number,","poem":1},{"text":"few indeed, and strangers in the land,","poem":2}]},{"number":13,"lines":[{"text":"they wandered from nation to nation,","poem":1},{"text":"from one kingdom to another.","poem":2}]},{"number":14,"lines":[{"text":"He let no man oppress them;","poem":1},{"text":"He rebuked kings on their behalf:","poem":2}]},{"number":15,"lines":[{"text":"“Do not touch My anointed ones!","poem":1},{"text":"Do no harm to My prophets!”","poem":2}]},{"number":16,"lines":[{"text":"He called down famine on the land","poem":1},{"text":"and cut off all their supplies of food.","poem":2}]},{"number":17,"lines":[{"text":"He sent a man before them—","poem":1},{"text":"Joseph, sold as a slave.","poem":2}]},{"number":18,"lines":[{"text":"They bruised his feet with shackles","poem":1},{"text":"and placed his neck in irons,","poem":2}]},{"number":19,"lines":[{"text":"until his prediction came true","poem":1},{"text":"and the word of the LORD proved him right.","poem":2}]},{"number":20,"lines":[{"text":"The king sent and released him;","poem":1},{"text":"the ruler of peoples set him free.","poem":2}]},{"number":21,"lines":[{"text":"He made him master of his household,","poem":1},{"text":"ruler over all his substance,","poem":2}]},{"number":22,"lines":[{"text":"to instruct his princes as he pleased","poem":1},{"text":"and teach his elders wisdom.","poem":2}]},{"number":23,"lines":[{"text":"Then Israel entered Egypt;","poem":1},{"text":"Jacob dwelt in the land of Ham.","poem":2}]},{"number":24,"lines":[{"text":"And the LORD made His people very fruitful,","poem":1},{"text":"more numerous than their foes,","poem":2}]},{"number":25,"lines":[{"text":"whose hearts He turned to hate His people,","poem":1},{"text":"to conspire against His servants.","poem":2}]},{"number":26,"lines":[{"text":"He sent Moses His servant,","poem":1},{"text":"and Aaron, whom He had chosen.","poem":2}]},{"number":27,"lines":[{"text":"They performed His miraculous signs among them,","poem":1},{"text":"and wonders in the land of Ham.","poem":2}]},{"number":28,"lines":[{"text":"He sent darkness, and it became dark—","poem":1},{"text":"yet they defied His words.","poem":2}]},{"number":29,"lines":[{"text":"He turned their waters to blood","poem":1},{"text":"and caused their fish to die.","poem":2}]},{"number":30,"lines":[{"text":"Their land teemed with frogs,","poem":1},{"text":"even in their royal chambers.","poem":2}]},{"number":31,"lines":[{"text":"He spoke, and insects swarmed—","poem":1},{"text":"gnats throughout their country.","poem":2}]},{"number":32,"lines":[{"text":"He gave them hail for rain,","poem":1},{"text":"with lightning throughout their land.","poem":2}]},{"number":33,"lines":[{"text":"He struck their vines and fig trees","poem":1},{"text":"and shattered the trees of their country.","poem":2}]},{"number":34,"lines":[{"text":"He spoke, and the locusts came—","poem":1},{"text":"young locusts without number.","poem":2}]},{"number":35,"lines":[{"text":"They devoured every plant in their land","poem":1},{"text":"and consumed the produce of their soil.","poem":2}]},{"number":36,"lines":[{"text":"Then He struck all the firstborn in their land,","poem":1},{"text":"the firstfruits of all their vigor.","poem":2}]},{"number":37,"lines":[{"text":"He brought Israel out with silver and gold,","poem":1},{"text":"and none among His tribes stumbled.","poem":2}]},{"number":38,"lines":[{"text":"Egypt was glad when they departed,","poem":1},{"text":"for the dread of Israel had fallen on them.","poem":2}]},{"number":39,"lines":[{"text":"He spread a cloud as a covering","poem":1},{"text":"and a fire to light up the night.","poem":2}]},{"number":40,"lines":[{"text":"They asked, and He brought quail","poem":1},{"text":"and satisfied them with the bread of heaven.","poem":2}]},{"number":41,"lines":[{"text":"He opened a rock, and water gushed out;","poem":1},{"text":"it flowed like a river in the desert.","poem":2}]},{"number":42,"lines":[{"text":"For He remembered His holy promise","poem":1},{"text":"to Abraham His servant.","poem":2}]},{"number":43,"lines":[{"text":"He brought forth His people with rejoicing,","poem":1},{"text":"His chosen with shouts of joy.","poem":2}]},{"number":44,"lines":[{"text":"He gave them the lands of the nations,","poem":1},{"text":"that they might inherit the fruit of others’ labor,","poem":2}]},{"number":45,"lines":[{"text":"that they might keep His statutes","poem":1},{"text":"and obey His laws.","poem":2},{"text":"Hallelujah!","poem":1}]}]},{"number":106,"lastVerse":48,"verses":[{"number":1,"lines":[{"text":"Hallelujah!","poem":1},{"text":"Give thanks to the LORD, for He is good;","poem":1},{"text":"His loving devotion endures forever.","poem":2}]},{"number":2,"lines":[{"text":"Who can describe the mighty acts of the LORD","poem":1},{"text":"or fully proclaim His praise?","poem":2}]},{"number":3,"lines":[{"text":"Blessed are those who uphold justice,","poem":1},{"text":"who practice righteousness at all times.","poem":2}]},{"number":4,"lines":[{"text":"Remember me, O LORD, in Your favor to Your people;","poem":1},{"text":"visit me with Your salvation,","poem":2}]},{"number":5,"lines":[{"text":"that I may see the prosperity of Your chosen ones,","poem":1},{"text":"and rejoice in the gladness of Your nation,","poem":2},{"text":"and give glory with Your inheritance.","poem":2}]},{"number":6,"lines":[{"text":"We have sinned like our fathers;","poem":1},{"text":"we have done wrong and acted wickedly.","poem":2}]},{"number":7,"lines":[{"text":"Our fathers in Egypt did not grasp Your wonders","poem":1},{"text":"or remember Your abundant kindness;","poem":2},{"text":"but they rebelled by the sea,","poem":1},{"text":"there at the Red Sea.","poem":2}]},{"number":8,"lines":[{"text":"Yet He saved them for the sake of His name,","poem":1},{"text":"to make His power known.","poem":2}]},{"number":9,"lines":[{"text":"He rebuked the Red Sea, and it dried up;","poem":1},{"text":"He led them through the depths as through a desert.","poem":2}]},{"number":10,"lines":[{"text":"He saved them from the hand that hated them;","poem":1},{"text":"He redeemed them from the hand of the enemy.","poem":2}]},{"number":11,"lines":[{"text":"The waters covered their foes;","poem":1},{"text":"not one of them remained.","poem":2}]},{"number":12,"lines":[{"text":"Then they believed His promises","poem":1},{"text":"and sang His praise.","poem":2}]},{"number":13,"lines":[{"text":"Yet they soon forgot His works","poem":1},{"text":"and failed to wait for His counsel.","poem":2}]},{"number":14,"lines":[{"text":"They craved intensely in the wilderness","poem":1},{"text":"and tested God in the desert.","poem":2}]},{"number":15,"lines":[{"text":"So He granted their request,","poem":1},{"text":"but sent a wasting disease upon them.","poem":2}]},{"number":16,"lines":[{"text":"In the camp they envied Moses,","poem":1},{"text":"as well as Aaron, the holy one of the LORD.","poem":2}]},{"number":17,"lines":[{"text":"The earth opened up and swallowed Dathan;","poem":1},{"text":"it covered the assembly of Abiram.","poem":2}]},{"number":18,"lines":[{"text":"Then fire blazed through their company;","poem":1},{"text":"flames consumed the wicked.","poem":2}]},{"number":19,"lines":[{"text":"At Horeb they made a calf","poem":1},{"text":"and worshiped a molten image.","poem":2}]},{"number":20,"lines":[{"text":"They exchanged their Glory","poem":1},{"text":"for the image of a grass-eating ox.","poem":2}]},{"number":21,"lines":[{"text":"They forgot God their Savior,","poem":1},{"text":"who did great things in Egypt,","poem":2}]},{"number":22,"lines":[{"text":"wondrous works in the land of Ham,","poem":1},{"text":"and awesome deeds by the Red Sea.","poem":2}]},{"number":23,"lines":[{"text":"So He said He would destroy them—","poem":1},{"text":"had not Moses His chosen one","poem":2},{"text":"stood before Him in the breach","poem":1},{"text":"to divert His wrath from destroying them.","poem":2}]},{"number":24,"lines":[{"text":"They despised the pleasant land;","poem":1},{"text":"they did not believe His promise.","poem":2}]},{"number":25,"lines":[{"text":"They grumbled in their tents","poem":1},{"text":"and did not listen to the voice of the LORD.","poem":2}]},{"number":26,"lines":[{"text":"So He raised His hand and swore","poem":1},{"text":"to cast them down in the wilderness,","poem":2}]},{"number":27,"lines":[{"text":"to disperse their offspring among the nations","poem":1},{"text":"and scatter them throughout the lands.","poem":2}]},{"number":28,"lines":[{"text":"They yoked themselves to Baal of Peor","poem":1},{"text":"and ate sacrifices offered to lifeless gods.","poem":2}]},{"number":29,"lines":[{"text":"So they provoked the LORD to anger with their deeds,","poem":1},{"text":"and a plague broke out among them.","poem":2}]},{"number":30,"lines":[{"text":"But Phinehas stood and intervened,","poem":1},{"text":"and the plague was restrained.","poem":2}]},{"number":31,"lines":[{"text":"It was credited to him as righteousness","poem":1},{"text":"for endless generations to come.","poem":2}]},{"number":32,"lines":[{"text":"At the waters of Meribah they angered the LORD,","poem":1},{"text":"and trouble came to Moses because of them.","poem":2}]},{"number":33,"lines":[{"text":"For they rebelled against His Spirit,","poem":1},{"text":"and Moses spoke rashly with his lips.","poem":2}]},{"number":34,"lines":[{"text":"They did not destroy the peoples","poem":1},{"text":"as the LORD had commanded them,","poem":2}]},{"number":35,"lines":[{"text":"but they mingled with the nations","poem":1},{"text":"and adopted their customs.","poem":2}]},{"number":36,"lines":[{"text":"They worshiped their idols,","poem":1},{"text":"which became a snare to them.","poem":2}]},{"number":37,"lines":[{"text":"They sacrificed their sons","poem":1},{"text":"and their daughters to demons.","poem":2}]},{"number":38,"lines":[{"text":"They shed innocent blood—","poem":1},{"text":"the blood of their sons and daughters,","poem":2},{"text":"whom they sacrificed to the idols of Canaan,","poem":1},{"text":"and the land was polluted with blood.","poem":2}]},{"number":39,"lines":[{"text":"They defiled themselves by their actions","poem":1},{"text":"and prostituted themselves by their deeds.","poem":2}]},{"number":40,"lines":[{"text":"So the anger of the LORD burned against His people,","poem":1},{"text":"and He abhorred His own inheritance.","poem":2}]},{"number":41,"lines":[{"text":"He delivered them into the hand of the nations,","poem":1},{"text":"and those who hated them ruled over them.","poem":2}]},{"number":42,"lines":[{"text":"Their enemies oppressed them","poem":1},{"text":"and subdued them under their hand.","poem":2}]},{"number":43,"lines":[{"text":"Many times He rescued them,","poem":1},{"text":"but they were bent on rebellion","poem":2},{"text":"and sank down in their iniquity.","poem":2}]},{"number":44,"lines":[{"text":"Nevertheless He heard their cry;","poem":1},{"text":"He took note of their distress.","poem":2}]},{"number":45,"lines":[{"text":"And He remembered His covenant with them,","poem":1},{"text":"and relented by the abundance of His loving devotion.","poem":2}]},{"number":46,"lines":[{"text":"He made them objects of compassion","poem":1},{"text":"to all who held them captive.","poem":2}]},{"number":47,"lines":[{"text":"Save us, O LORD our God,","poem":1},{"text":"and gather us from the nations,","poem":2},{"text":"that we may give thanks to Your holy name,","poem":1},{"text":"that we may glory in Your praise.","poem":2}]},{"number":48,"lines":[{"text":"Blessed be the LORD, the God of Israel,","poem":1},{"text":"from everlasting to everlasting.","poem":2},{"text":"Let all the people say, “Amen!”","poem":1},{"text":"Hallelujah!","poem":1}]}]},{"number":107,"lastVerse":43,"verses":[{"number":1,"lines":[{"text":"Give thanks to the LORD, for He is good;","poem":1},{"text":"His loving devotion endures forever.","poem":2}]},{"number":2,"lines":[{"text":"Let the redeemed of the LORD say so,","poem":1},{"text":"whom He has redeemed from the hand of the enemy","poem":2}]},{"number":3,"lines":[{"text":"and gathered from the lands,","poem":1},{"text":"from east and west, from north and south.","poem":2}]},{"number":4,"lines":[{"text":"Some wandered in desert wastelands,","poem":1},{"text":"finding no path to a city in which to dwell.","poem":2}]},{"number":5,"lines":[{"text":"They were hungry and thirsty;","poem":1},{"text":"their soul fainted within them.","poem":2}]},{"number":6,"lines":[{"text":"Then they cried out to the LORD in their trouble,","poem":1},{"text":"and He delivered them from their distress.","poem":2}]},{"number":7,"lines":[{"text":"He led them on a straight path","poem":1},{"text":"to reach a city where they could live.","poem":2}]},{"number":8,"lines":[{"text":"Let them give thanks to the LORD for His loving devotion","poem":1},{"text":"and His wonders to the sons of men.","poem":2}]},{"number":9,"lines":[{"text":"For He satisfies the thirsty","poem":1},{"text":"and fills the hungry with good things.","poem":2}]},{"number":10,"lines":[{"text":"Some sat in darkness and in the shadow of death,","poem":1},{"text":"prisoners in affliction and chains,","poem":2}]},{"number":11,"lines":[{"text":"because they rebelled against the words of God","poem":1},{"text":"and despised the counsel of the Most High.","poem":2}]},{"number":12,"lines":[{"text":"He humbled their hearts with hard labor;","poem":1},{"text":"they stumbled, and there was no one to help.","poem":2}]},{"number":13,"lines":[{"text":"Then they cried out to the LORD in their trouble,","poem":1},{"text":"and He saved them from their distress.","poem":2}]},{"number":14,"lines":[{"text":"He brought them out of darkness and the shadow of death","poem":1},{"text":"and broke away their chains.","poem":2}]},{"number":15,"lines":[{"text":"Let them give thanks to the LORD for His loving devotion","poem":1},{"text":"and His wonders to the sons of men.","poem":2}]},{"number":16,"lines":[{"text":"For He has broken down the gates of bronze","poem":1},{"text":"and cut through the bars of iron.","poem":2}]},{"number":17,"lines":[{"text":"Fools, in their rebellious ways,","poem":1},{"text":"and through their iniquities, suffered affliction.","poem":2}]},{"number":18,"lines":[{"text":"They loathed all food","poem":1},{"text":"and drew near to the gates of death.","poem":2}]},{"number":19,"lines":[{"text":"Then they cried out to the LORD in their trouble,","poem":1},{"text":"and He saved them from their distress.","poem":2}]},{"number":20,"lines":[{"text":"He sent forth His word and healed them;","poem":1},{"text":"He rescued them from the Pit.","poem":2}]},{"number":21,"lines":[{"text":"Let them give thanks to the LORD for His loving devotion","poem":1},{"text":"and His wonders to the sons of men.","poem":2}]},{"number":22,"lines":[{"text":"Let them offer sacrifices of thanksgiving","poem":1},{"text":"and declare His works with rejoicing.","poem":2}]},{"number":23,"lines":[{"text":"Others went out to sea in ships,","poem":1},{"text":"conducting trade on the mighty waters.","poem":2}]},{"number":24,"lines":[{"text":"They saw the works of the LORD,","poem":1},{"text":"and His wonders in the deep.","poem":2}]},{"number":25,"lines":[{"text":"For He spoke and raised a tempest","poem":1},{"text":"that lifted the waves of the sea.","poem":2}]},{"number":26,"lines":[{"text":"They mounted up to the heavens, then sunk to the depths;","poem":1},{"text":"their courage melted in their anguish.","poem":2}]},{"number":27,"lines":[{"text":"They reeled and staggered like drunkards,","poem":1},{"text":"and all their skill was useless.","poem":2}]},{"number":28,"lines":[{"text":"Then they cried out to the LORD in their trouble,","poem":1},{"text":"and He brought them out of their distress.","poem":2}]},{"number":29,"lines":[{"text":"He calmed the storm to a whisper,","poem":1},{"text":"and the waves of the sea were hushed.","poem":2}]},{"number":30,"lines":[{"text":"They rejoiced in the silence,","poem":1},{"text":"and He guided them to the harbor they desired.","poem":2}]},{"number":31,"lines":[{"text":"Let them give thanks to the LORD for His loving devotion","poem":1},{"text":"and His wonders to the sons of men.","poem":2}]},{"number":32,"lines":[{"text":"Let them exalt Him in the assembly of the people","poem":1},{"text":"and praise Him in the council of the elders.","poem":2}]},{"number":33,"lines":[{"text":"He turns rivers into deserts,","poem":1},{"text":"springs of water into thirsty ground,","poem":2}]},{"number":34,"lines":[{"text":"and fruitful land into fields of salt,","poem":1},{"text":"because of the wickedness of its dwellers.","poem":2}]},{"number":35,"lines":[{"text":"He turns a desert into pools of water","poem":1},{"text":"and a dry land into flowing springs.","poem":2}]},{"number":36,"lines":[{"text":"He causes the hungry to settle there,","poem":1},{"text":"that they may establish a city in which to dwell.","poem":2}]},{"number":37,"lines":[{"text":"They sow fields and plant vineyards","poem":1},{"text":"that yield a fruitful harvest.","poem":2}]},{"number":38,"lines":[{"text":"He blesses them, and they multiply greatly;","poem":1},{"text":"He does not let their herds diminish.","poem":2}]},{"number":39,"lines":[{"text":"When they are decreased and humbled","poem":1},{"text":"by oppression, evil, and sorrow,","poem":2}]},{"number":40,"lines":[{"text":"He pours out contempt on the nobles","poem":1},{"text":"and makes them wander in a trackless wasteland.","poem":2}]},{"number":41,"lines":[{"text":"But He lifts the needy from affliction","poem":1},{"text":"and increases their families like flocks.","poem":2}]},{"number":42,"lines":[{"text":"The upright see and rejoice,","poem":1},{"text":"and all iniquity shuts its mouth.","poem":2}]},{"number":43,"lines":[{"text":"Let him who is wise pay heed to these things","poem":1},{"text":"and consider the loving devotion of the LORD.","poem":2}]}]},{"number":108,"lastVerse":13,"verses":[{"number":1,"lines":[{"text":"My heart is steadfast, O God;","poem":1},{"text":"I will sing and make music with all my being.","poem":2}]},{"number":2,"lines":[{"text":"Awake, O harp and lyre!","poem":1},{"text":"I will awaken the dawn.","poem":2}]},{"number":3,"lines":[{"text":"I will praise You, O LORD, among the nations;","poem":1},{"text":"I will sing Your praises among the peoples.","poem":2}]},{"number":4,"lines":[{"text":"For Your loving devotion extends beyond the heavens,","poem":1},{"text":"and Your faithfulness reaches to the clouds.","poem":2}]},{"number":5,"lines":[{"text":"Be exalted, O God, above the heavens;","poem":1},{"text":"may Your glory cover all the earth.","poem":2}]},{"number":6,"lines":[{"text":"Respond and save us with Your right hand,","poem":1},{"text":"that Your beloved may be delivered.","poem":2}]},{"number":7,"lines":[{"text":"God has spoken from His sanctuary:","poem":1},{"text":"“I will triumph!","poem":2},{"text":"I will parcel out Shechem","poem":1},{"text":"and apportion the Valley of Succoth.","poem":2}]},{"number":8,"lines":[{"text":"Gilead is Mine, and Manasseh is Mine;","poem":1},{"text":"Ephraim is My helmet, Judah is My scepter.","poem":2}]},{"number":9,"lines":[{"text":"Moab is My washbasin;","poem":1},{"text":"upon Edom I toss My sandal;","poem":2},{"text":"over Philistia I shout in triumph.”","poem":2}]},{"number":10,"lines":[{"text":"Who will bring me to the fortified city?","poem":1},{"text":"Who will lead me to Edom?","poem":2}]},{"number":11,"lines":[{"text":"Have You not rejected us, O God?","poem":1},{"text":"Will You no longer march out, O God, with our armies?","poem":2}]},{"number":12,"lines":[{"text":"Give us aid against the enemy,","poem":1},{"text":"for the help of man is worthless.","poem":2}]},{"number":13,"lines":[{"text":"With God we will perform with valor,","poem":1},{"text":"and He will trample our enemies.","poem":2}]}]},{"number":109,"lastVerse":31,"verses":[{"number":1,"lines":[{"text":"O God of my praise,","poem":1},{"text":"be not silent.","poem":2}]},{"number":2,"lines":[{"text":"For wicked and deceitful mouths open against me;","poem":1},{"text":"they speak against me with lying tongues.","poem":2}]},{"number":3,"lines":[{"text":"They surround me with hateful words","poem":1},{"text":"and attack me without cause.","poem":2}]},{"number":4,"lines":[{"text":"In return for my love they accuse me,","poem":1},{"text":"but I am a man of prayer.","poem":2}]},{"number":5,"lines":[{"text":"They repay me evil for good,","poem":1},{"text":"and hatred for my love.","poem":2}]},{"number":6,"lines":[{"text":"Set over him a wicked man;","poem":1},{"text":"let an accuser stand at his right hand.","poem":2}]},{"number":7,"lines":[{"text":"When he is tried, let him be found guilty,","poem":1},{"text":"and may his prayer be regarded as sin.","poem":2}]},{"number":8,"lines":[{"text":"May his days be few;","poem":1},{"text":"may another take his position.","poem":2}]},{"number":9,"lines":[{"text":"May his children be fatherless","poem":1},{"text":"and his wife a widow.","poem":2}]},{"number":10,"lines":[{"text":"May his children wander as beggars,","poem":1},{"text":"seeking sustenance far from their ruined homes.","poem":2}]},{"number":11,"lines":[{"text":"May the creditor seize all he owns,","poem":1},{"text":"and strangers plunder the fruits of his labor.","poem":2}]},{"number":12,"lines":[{"text":"May there be no one to extend kindness to him,","poem":1},{"text":"and no one to favor his fatherless children.","poem":2}]},{"number":13,"lines":[{"text":"May his descendants be cut off;","poem":1},{"text":"may their name be blotted out from the next generation.","poem":2}]},{"number":14,"lines":[{"text":"May the iniquity of his fathers be remembered before the LORD,","poem":1},{"text":"and the sin of his mother never be blotted out.","poem":2}]},{"number":15,"lines":[{"text":"May their sins always remain before the LORD,","poem":1},{"text":"that He may cut off their memory from the earth.","poem":2}]},{"number":16,"lines":[{"text":"For he never thought to show kindness,","poem":1},{"text":"but pursued the poor and needy and brokenhearted,","poem":2},{"text":"even to their death.","poem":2}]},{"number":17,"lines":[{"text":"The cursing that he loved,","poem":1},{"text":"may it fall on him;","poem":2},{"text":"the blessing in which he refused to delight,","poem":1},{"text":"may it be far from him.","poem":2}]},{"number":18,"lines":[{"text":"The cursing that he wore like a coat,","poem":1},{"text":"may it soak into his body like water,","poem":2},{"text":"and into his bones like oil.","poem":2}]},{"number":19,"lines":[{"text":"May it be like a robe wrapped about him,","poem":1},{"text":"like a belt tied forever around him.","poem":2}]},{"number":20,"lines":[{"text":"May this be the LORD’s reward to my accusers,","poem":1},{"text":"to those who speak evil against me.","poem":2}]},{"number":21,"lines":[{"text":"But You, O GOD, the Lord,","poem":1},{"text":"deal kindly with me for the sake of Your name;","poem":2},{"text":"deliver me by the goodness of Your loving devotion.","poem":2}]},{"number":22,"lines":[{"text":"For I am poor and needy;","poem":1},{"text":"my heart is wounded within me.","poem":2}]},{"number":23,"lines":[{"text":"I am fading away like a lengthening shadow;","poem":1},{"text":"I am shaken off like a locust.","poem":2}]},{"number":24,"lines":[{"text":"My knees are weak from fasting,","poem":1},{"text":"and my body grows lean and gaunt.","poem":2}]},{"number":25,"lines":[{"text":"I am an object of scorn to my accusers;","poem":1},{"text":"when they see me, they shake their heads.","poem":2}]},{"number":26,"lines":[{"text":"Help me, O LORD my God;","poem":1},{"text":"save me according to Your loving devotion.","poem":2}]},{"number":27,"lines":[{"text":"Let them know that this is Your hand,","poem":1},{"text":"that You, O LORD, have done it.","poem":2}]},{"number":28,"lines":[{"text":"Though they curse, You will bless.","poem":1},{"text":"When they rise up, they will be put to shame,","poem":2},{"text":"but Your servant will rejoice.","poem":2}]},{"number":29,"lines":[{"text":"May my accusers be clothed with disgrace;","poem":1},{"text":"may they wear their shame like a robe.","poem":2}]},{"number":30,"lines":[{"text":"With my mouth I will thank the LORD profusely;","poem":1},{"text":"I will praise Him in the presence of many.","poem":2}]},{"number":31,"lines":[{"text":"For He stands at the right hand of the needy one,","poem":1},{"text":"to save him from the condemners of his soul.","poem":2}]}]},{"number":110,"lastVerse":7,"verses":[{"number":1,"lines":[{"text":"The LORD said to my Lord:","poem":1},{"text":"“Sit at My right hand","poem":2},{"text":"until I make Your enemies","poem":1},{"text":"a footstool for Your feet.”","poem":2}]},{"number":2,"lines":[{"text":"The LORD extends Your mighty scepter from Zion:","poem":1},{"text":"“Rule in the midst of Your enemies.”","poem":2}]},{"number":3,"lines":[{"text":"Your people shall be willing","poem":1},{"text":"on Your day of battle.","poem":2},{"text":"Arrayed in holy splendor, from the womb of the dawn,","poem":1},{"text":"to You belongs the dew of Your youth.","poem":2}]},{"number":4,"lines":[{"text":"The LORD has sworn","poem":1},{"text":"and will not change His mind:","poem":2},{"text":"“You are a priest forever","poem":1},{"text":"in the order of Melchizedek.”","poem":2}]},{"number":5,"lines":[{"text":"The Lord is at Your right hand;","poem":1},{"text":"He will crush kings in the day of His wrath.","poem":2}]},{"number":6,"lines":[{"text":"He will judge the nations, heaping up the dead;","poem":1},{"text":"He will crush the leaders far and wide.","poem":2}]},{"number":7,"lines":[{"text":"He will drink from the brook by the road;","poem":1},{"text":"therefore He will lift up His head.","poem":2}]}]},{"number":111,"lastVerse":10,"verses":[{"number":1,"lines":[{"text":"Hallelujah!","poem":1},{"text":"I will give thanks to the LORD with all my heart","poem":1},{"text":"in the council of the upright and in the assembly.","poem":2}]},{"number":2,"lines":[{"text":"Great are the works of the LORD;","poem":1},{"text":"they are pondered by all who delight in them.","poem":2}]},{"number":3,"lines":[{"text":"Splendid and majestic is His work;","poem":1},{"text":"His righteousness endures forever.","poem":2}]},{"number":4,"lines":[{"text":"He has caused His wonders to be remembered;","poem":1},{"text":"the LORD is gracious and compassionate.","poem":2}]},{"number":5,"lines":[{"text":"He provides food for those who fear Him;","poem":1},{"text":"He remembers His covenant forever.","poem":2}]},{"number":6,"lines":[{"text":"He has shown His people the power of His works","poem":1},{"text":"by giving them the inheritance of the nations.","poem":2}]},{"number":7,"lines":[{"text":"The works of His hands are truth and justice;","poem":1},{"text":"all His precepts are trustworthy.","poem":2}]},{"number":8,"lines":[{"text":"They are upheld forever and ever,","poem":1},{"text":"enacted in truth and uprightness.","poem":2}]},{"number":9,"lines":[{"text":"He has sent redemption to His people;","poem":1},{"text":"He has ordained His covenant forever;","poem":2},{"text":"holy and awesome is His name.","poem":2}]},{"number":10,"lines":[{"text":"The fear of the LORD is the beginning of wisdom;","poem":1},{"text":"all who follow His precepts gain rich understanding.","poem":2},{"text":"His praise endures forever!","poem":1}]}]},{"number":112,"lastVerse":10,"verses":[{"number":1,"lines":[{"text":"Hallelujah!","poem":1},{"text":"Blessed is the man who fears the LORD,","poem":1},{"text":"who greatly delights in His commandments.","poem":2}]},{"number":2,"lines":[{"text":"His descendants will be mighty in the land;","poem":1},{"text":"the generation of the upright will be blessed.","poem":2}]},{"number":3,"lines":[{"text":"Wealth and riches are in his house,","poem":1},{"text":"and his righteousness endures forever.","poem":2}]},{"number":4,"lines":[{"text":"Light dawns in the darkness for the upright—","poem":1},{"text":"for the gracious, compassionate, and righteous.","poem":2}]},{"number":5,"lines":[{"text":"It is well with the man who is generous and lends freely,","poem":1},{"text":"whose affairs are guided by justice.","poem":2}]},{"number":6,"lines":[{"text":"Surely he will never be shaken;","poem":1},{"text":"the righteous man will be remembered forever.","poem":2}]},{"number":7,"lines":[{"text":"He does not fear bad news;","poem":1},{"text":"his heart is steadfast, trusting in the LORD.","poem":2}]},{"number":8,"lines":[{"text":"His heart is assured; he does not fear,","poem":1},{"text":"until he looks in triumph on his foes.","poem":2}]},{"number":9,"lines":[{"text":"He has scattered abroad his gifts to the poor;","poem":1},{"text":"his righteousness endures forever;","poem":2},{"text":"his horn will be lifted high in honor.","poem":2}]},{"number":10,"lines":[{"text":"The wicked man will see and be grieved;","poem":1},{"text":"he will gnash his teeth and waste away;","poem":2},{"text":"the desires of the wicked will perish.","poem":2}]}]},{"number":113,"lastVerse":9,"verses":[{"number":1,"lines":[{"text":"Hallelujah!","poem":1},{"text":"Give praise, O servants of the LORD;","poem":1},{"text":"praise the name of the LORD.","poem":2}]},{"number":2,"lines":[{"text":"Blessed be the name of the LORD","poem":1},{"text":"both now and forevermore.","poem":2}]},{"number":3,"lines":[{"text":"From where the sun rises to where it sets,","poem":1},{"text":"the name of the LORD is praised.","poem":2}]},{"number":4,"lines":[{"text":"The LORD is exalted over all the nations,","poem":1},{"text":"His glory above the heavens.","poem":2}]},{"number":5,"lines":[{"text":"Who is like the LORD our God,","poem":1},{"text":"the One enthroned on high?","poem":2}]},{"number":6,"lines":[{"text":"He humbles Himself to behold","poem":1},{"text":"the heavens and the earth.","poem":2}]},{"number":7,"lines":[{"text":"He raises the poor from the dust","poem":1},{"text":"and lifts the needy from the dump","poem":2}]},{"number":8,"lines":[{"text":"to seat them with nobles,","poem":1},{"text":"with the princes of His people.","poem":2}]},{"number":9,"lines":[{"text":"He settles the barren woman in her home","poem":1},{"text":"as a joyful mother to her children.","poem":2},{"text":"Hallelujah!","poem":1}]}]},{"number":114,"lastVerse":8,"verses":[{"number":1,"lines":[{"text":"When Israel departed from Egypt,","poem":1},{"text":"the house of Jacob from a people of foreign tongue,","poem":2}]},{"number":2,"lines":[{"text":"Judah became God’s sanctuary,","poem":1},{"text":"Israel His dominion.","poem":2}]},{"number":3,"lines":[{"text":"The sea observed and fled;","poem":1},{"text":"the Jordan turned back;","poem":2}]},{"number":4,"lines":[{"text":"the mountains skipped like rams,","poem":1},{"text":"the hills like lambs.","poem":2}]},{"number":5,"lines":[{"text":"Why was it, O sea, that you fled,","poem":1},{"text":"O Jordan, that you turned back,","poem":2}]},{"number":6,"lines":[{"text":"O mountains, that you skipped like rams,","poem":1},{"text":"O hills, like lambs?","poem":2}]},{"number":7,"lines":[{"text":"Tremble, O earth, at the presence of the Lord,","poem":1},{"text":"at the presence of the God of Jacob,","poem":2}]},{"number":8,"lines":[{"text":"who turned the rock into a pool,","poem":1},{"text":"the flint into a fountain of water!","poem":2}]}]},{"number":115,"lastVerse":18,"verses":[{"number":1,"lines":[{"text":"Not to us, O LORD, not to us,","poem":1},{"text":"but to Your name be the glory,","poem":2},{"text":"because of Your loving devotion,","poem":1},{"text":"because of Your faithfulness.","poem":2}]},{"number":2,"lines":[{"text":"Why should the nations say,","poem":1},{"text":"“Where is their God?”","poem":2}]},{"number":3,"lines":[{"text":"Our God is in heaven;","poem":1},{"text":"He does as He pleases.","poem":2}]},{"number":4,"lines":[{"text":"Their idols are silver and gold,","poem":1},{"text":"made by the hands of men.","poem":2}]},{"number":5,"lines":[{"text":"They have mouths, but cannot speak;","poem":1},{"text":"they have eyes, but cannot see;","poem":2}]},{"number":6,"lines":[{"text":"they have ears, but cannot hear;","poem":1},{"text":"they have noses, but cannot smell;","poem":2}]},{"number":7,"lines":[{"text":"they have hands, but cannot feel;","poem":1},{"text":"they have feet, but cannot walk;","poem":2},{"text":"they cannot even clear their throats.","poem":2}]},{"number":8,"lines":[{"text":"Those who make them become like them,","poem":1},{"text":"as do all who trust in them.","poem":2}]},{"number":9,"lines":[{"text":"O Israel, trust in the LORD!","poem":1},{"text":"He is their help and shield.","poem":2}]},{"number":10,"lines":[{"text":"O house of Aaron, trust in the LORD!","poem":1},{"text":"He is their help and shield.","poem":2}]},{"number":11,"lines":[{"text":"You who fear the LORD, trust in the LORD!","poem":1},{"text":"He is their help and shield.","poem":2}]},{"number":12,"lines":[{"text":"The LORD is mindful of us;","poem":1},{"text":"He will bless us.","poem":2},{"text":"He will bless the house of Israel;","poem":1},{"text":"He will bless the house of Aaron;","poem":2}]},{"number":13,"lines":[{"text":"He will bless those who fear the LORD—","poem":1},{"text":"small and great alike.","poem":2}]},{"number":14,"lines":[{"text":"May the LORD give you increase,","poem":1},{"text":"both you and your children.","poem":2}]},{"number":15,"lines":[{"text":"May you be blessed by the LORD,","poem":1},{"text":"the Maker of heaven and earth.","poem":2}]},{"number":16,"lines":[{"text":"The highest heavens belong to the LORD,","poem":1},{"text":"but the earth He has given to mankind.","poem":2}]},{"number":17,"lines":[{"text":"It is not the dead who praise the LORD,","poem":1},{"text":"nor any who descend into silence.","poem":2}]},{"number":18,"lines":[{"text":"But it is we who will bless the LORD,","poem":1},{"text":"both now and forevermore.","poem":2},{"text":"Hallelujah!","poem":1}]}]},{"number":116,"lastVerse":19,"verses":[{"number":1,"lines":[{"text":"I love the LORD, for He has heard my voice—","poem":1},{"text":"my appeal for mercy.","poem":2}]},{"number":2,"lines":[{"text":"Because He has inclined His ear to me,","poem":1},{"text":"I will call on Him as long as I live.","poem":2}]},{"number":3,"lines":[{"text":"The ropes of death entangled me;","poem":1},{"text":"the anguish of Sheol overcame me;","poem":2},{"text":"I was confronted by trouble and sorrow.","poem":2}]},{"number":4,"lines":[{"text":"Then I called on the name of the LORD:","poem":1},{"text":"“O LORD, deliver my soul!”","poem":2}]},{"number":5,"lines":[{"text":"The LORD is gracious and righteous;","poem":1},{"text":"our God is full of compassion.","poem":2}]},{"number":6,"lines":[{"text":"The LORD preserves the simplehearted;","poem":1},{"text":"I was helpless, and He saved me.","poem":2}]},{"number":7,"lines":[{"text":"Return to your rest, O my soul,","poem":1},{"text":"for the LORD has been good to you.","poem":2}]},{"number":8,"lines":[{"text":"For You have delivered my soul from death,","poem":1},{"text":"my eyes from tears, my feet from stumbling.","poem":2}]},{"number":9,"lines":[{"text":"I will walk before the LORD","poem":1},{"text":"in the land of the living.","poem":2}]},{"number":10,"lines":[{"text":"I believed, therefore I said,","poem":1},{"text":"“I am greatly afflicted.”","poem":2}]},{"number":11,"lines":[{"text":"In my alarm I said,","poem":1},{"text":"“All men are liars!”","poem":2}]},{"number":12,"lines":[{"text":"How can I repay the LORD","poem":1},{"text":"for all His goodness to me?","poem":2}]},{"number":13,"lines":[{"text":"I will lift the cup of salvation","poem":1},{"text":"and call on the name of the LORD.","poem":2}]},{"number":14,"lines":[{"text":"I will fulfill my vows to the LORD","poem":1},{"text":"in the presence of all His people.","poem":2}]},{"number":15,"lines":[{"text":"Precious in the sight of the LORD","poem":1},{"text":"is the death of His saints.","poem":2}]},{"number":16,"lines":[{"text":"Truly, O LORD, I am Your servant;","poem":1},{"text":"I am Your servant, the son of Your maidservant;","poem":2},{"text":"You have broken my bonds.","poem":2}]},{"number":17,"lines":[{"text":"I will offer to You a sacrifice of thanksgiving","poem":1},{"text":"and call on the name of the LORD.","poem":2}]},{"number":18,"lines":[{"text":"I will fulfill my vows to the LORD","poem":1},{"text":"in the presence of all His people,","poem":2}]},{"number":19,"lines":[{"text":"in the courts of the LORD’s house,","poem":1},{"text":"in your midst, O Jerusalem.","poem":2},{"text":"Hallelujah!","poem":1}]}]},{"number":117,"lastVerse":2,"verses":[{"number":1,"lines":[{"text":"Praise the LORD, all you nations!","poem":1},{"text":"Extol Him, all you peoples!","poem":2}]},{"number":2,"lines":[{"text":"For great is His loving devotion toward us,","poem":1},{"text":"and the faithfulness of the LORD endures forever.","poem":2},{"text":"Hallelujah!","poem":1}]}]},{"number":118,"lastVerse":29,"verses":[{"number":1,"lines":[{"text":"Give thanks to the LORD, for He is good;","poem":1},{"text":"His loving devotion endures forever.","poem":2}]},{"number":2,"lines":[{"text":"Let Israel say,","poem":1},{"text":"“His loving devotion endures forever.”","poem":2}]},{"number":3,"lines":[{"text":"Let the house of Aaron say,","poem":1},{"text":"“His loving devotion endures forever.”","poem":2}]},{"number":4,"lines":[{"text":"Let those who fear the LORD say,","poem":1},{"text":"“His loving devotion endures forever.”","poem":2}]},{"number":5,"lines":[{"text":"In my distress I called to the LORD,","poem":1},{"text":"and He answered and set me free.","poem":2}]},{"number":6,"lines":[{"text":"The LORD is on my side; I will not be afraid.","poem":1},{"text":"What can man do to me?","poem":2}]},{"number":7,"lines":[{"text":"The LORD is on my side; He is my helper.","poem":1},{"text":"Therefore I will look in triumph on those who hate me.","poem":2}]},{"number":8,"lines":[{"text":"It is better to take refuge in the LORD","poem":1},{"text":"than to trust in man.","poem":2}]},{"number":9,"lines":[{"text":"It is better to take refuge in the LORD","poem":1},{"text":"than to trust in princes.","poem":2}]},{"number":10,"lines":[{"text":"All the nations surrounded me,","poem":1},{"text":"but in the name of the LORD I cut them off.","poem":2}]},{"number":11,"lines":[{"text":"They surrounded me on every side,","poem":1},{"text":"but in the name of the LORD I cut them off.","poem":2}]},{"number":12,"lines":[{"text":"They swarmed around me like bees,","poem":1},{"text":"but they were extinguished like burning thorns;","poem":2},{"text":"in the name of the LORD I cut them off.","poem":2}]},{"number":13,"lines":[{"text":"I was pushed so hard I was falling,","poem":1},{"text":"but the LORD helped me.","poem":2}]},{"number":14,"lines":[{"text":"The LORD is my strength and my song,","poem":1},{"text":"and He has become my salvation.","poem":2}]},{"number":15,"lines":[{"text":"Shouts of joy and salvation resound in the tents of the righteous:","poem":1},{"text":"“The right hand of the LORD performs with valor!","poem":2}]},{"number":16,"lines":[{"text":"The right hand of the LORD is exalted!","poem":1},{"text":"The right hand of the LORD performs with valor!”","poem":2}]},{"number":17,"lines":[{"text":"I will not die, but I will live","poem":1},{"text":"and proclaim what the LORD has done.","poem":2}]},{"number":18,"lines":[{"text":"The LORD disciplined me severely,","poem":1},{"text":"but He has not given me over to death.","poem":2}]},{"number":19,"lines":[{"text":"Open to me the gates of righteousness,","poem":1},{"text":"that I may enter and give thanks to the LORD.","poem":2}]},{"number":20,"lines":[{"text":"This is the gate of the LORD;","poem":1},{"text":"the righteous shall enter through it.","poem":2}]},{"number":21,"lines":[{"text":"I will give You thanks, for You have answered me,","poem":1},{"text":"and You have become my salvation.","poem":2}]},{"number":22,"lines":[{"text":"The stone the builders rejected","poem":1},{"text":"has become the cornerstone.","poem":2}]},{"number":23,"lines":[{"text":"This is from the LORD,","poem":1},{"text":"and it is marvelous in our eyes.","poem":2}]},{"number":24,"lines":[{"text":"This is the day that the LORD has made;","poem":1},{"text":"we will rejoice and be glad in it.","poem":2}]},{"number":25,"lines":[{"text":"O LORD, save us, we pray.","poem":1},{"text":"We beseech You, O LORD, cause us to prosper!","poem":2}]},{"number":26,"lines":[{"text":"Blessed is he who comes in the name of the LORD.","poem":1},{"text":"From the house of the LORD we bless you.","poem":2}]},{"number":27,"lines":[{"text":"The LORD is God;","poem":1},{"text":"He has made His light to shine upon us.","poem":2},{"text":"Bind the festal sacrifice with cords","poem":1},{"text":"to the horns of the altar.","poem":2}]},{"number":28,"lines":[{"text":"You are my God, and I will give You thanks.","poem":1},{"text":"You are my God, and I will exalt You.","poem":2}]},{"number":29,"lines":[{"text":"Give thanks to the LORD, for He is good;","poem":1},{"text":"His loving devotion endures forever.","poem":2}]}]},{"number":119,"lastVerse":176,"verses":[{"number":1,"lines":[{"text":"Blessed are those whose way is blameless,","poem":1},{"text":"who walk in the Law of the LORD.","poem":2}]},{"number":2,"lines":[{"text":"Blessed are those who keep His testimonies","poem":1},{"text":"and seek Him with all their heart.","poem":2}]},{"number":3,"lines":[{"text":"They do no iniquity;","poem":1},{"text":"they walk in His ways.","poem":2}]},{"number":4,"lines":[{"text":"You have ordained Your precepts,","poem":1},{"text":"that we should keep them diligently.","poem":2}]},{"number":5,"lines":[{"text":"Oh, that my ways were committed","poem":1},{"text":"to keeping Your statutes!","poem":2}]},{"number":6,"lines":[{"text":"Then I would not be ashamed","poem":1},{"text":"when I consider all Your commandments.","poem":2}]},{"number":7,"lines":[{"text":"I will praise You with an upright heart","poem":1},{"text":"when I learn Your righteous judgments.","poem":2}]},{"number":8,"lines":[{"text":"I will keep Your statutes;","poem":1},{"text":"do not utterly forsake me.","poem":2}]},{"number":9,"lines":[{"text":"How can a young man keep his way pure?","poem":1},{"text":"By guarding it according to Your word.","poem":2}]},{"number":10,"lines":[{"text":"With all my heart I have sought You;","poem":1},{"text":"do not let me stray from Your commandments.","poem":2}]},{"number":11,"lines":[{"text":"I have hidden Your word in my heart","poem":1},{"text":"that I might not sin against You.","poem":2}]},{"number":12,"lines":[{"text":"Blessed are You, O LORD;","poem":1},{"text":"teach me Your statutes.","poem":2}]},{"number":13,"lines":[{"text":"With my lips I proclaim","poem":1},{"text":"all the judgments of Your mouth.","poem":2}]},{"number":14,"lines":[{"text":"I rejoice in the way of Your testimonies","poem":1},{"text":"as much as in all riches.","poem":2}]},{"number":15,"lines":[{"text":"I will meditate on Your precepts","poem":1},{"text":"and regard Your ways.","poem":2}]},{"number":16,"lines":[{"text":"I will delight in Your statutes;","poem":1},{"text":"I will not forget Your word.","poem":2}]},{"number":17,"lines":[{"text":"Deal bountifully with Your servant,","poem":1},{"text":"that I may live and keep Your word.","poem":2}]},{"number":18,"lines":[{"text":"Open my eyes that I may see","poem":1},{"text":"wondrous things from Your law.","poem":2}]},{"number":19,"lines":[{"text":"I am a stranger on the earth;","poem":1},{"text":"do not hide Your commandments from me.","poem":2}]},{"number":20,"lines":[{"text":"My soul is consumed with longing","poem":1},{"text":"for Your judgments at all times.","poem":2}]},{"number":21,"lines":[{"text":"You rebuke the arrogant—","poem":1},{"text":"the cursed who stray from Your commandments.","poem":2}]},{"number":22,"lines":[{"text":"Remove my scorn and contempt,","poem":1},{"text":"for I have kept Your testimonies.","poem":2}]},{"number":23,"lines":[{"text":"Though rulers sit and slander me,","poem":1},{"text":"Your servant meditates on Your statutes.","poem":2}]},{"number":24,"lines":[{"text":"Your testimonies are indeed my delight;","poem":1},{"text":"they are my counselors.","poem":2}]},{"number":25,"lines":[{"text":"My soul cleaves to the dust;","poem":1},{"text":"revive me according to Your word.","poem":2}]},{"number":26,"lines":[{"text":"I recounted my ways, and You answered me;","poem":1},{"text":"teach me Your statutes.","poem":2}]},{"number":27,"lines":[{"text":"Make clear to me the way of Your precepts;","poem":1},{"text":"then I will meditate on Your wonders.","poem":2}]},{"number":28,"lines":[{"text":"My soul melts with sorrow;","poem":1},{"text":"strengthen me according to Your word.","poem":2}]},{"number":29,"lines":[{"text":"Remove me from the path of deceit","poem":1},{"text":"and graciously grant me Your law.","poem":2}]},{"number":30,"lines":[{"text":"I have chosen the way of truth;","poem":1},{"text":"I have set Your ordinances before me.","poem":2}]},{"number":31,"lines":[{"text":"I cling to Your testimonies, O LORD;","poem":1},{"text":"let me not be put to shame.","poem":2}]},{"number":32,"lines":[{"text":"I run in the path of Your commandments,","poem":1},{"text":"for You will enlarge my heart.","poem":2}]},{"number":33,"lines":[{"text":"Teach me, O LORD, the way of Your statutes,","poem":1},{"text":"and I will keep them to the end.","poem":2}]},{"number":34,"lines":[{"text":"Give me understanding that I may obey Your law,","poem":1},{"text":"and follow it with all my heart.","poem":2}]},{"number":35,"lines":[{"text":"Direct me in the path of Your commandments,","poem":1},{"text":"for there I find delight.","poem":2}]},{"number":36,"lines":[{"text":"Turn my heart to Your testimonies","poem":1},{"text":"and not to covetous gain.","poem":2}]},{"number":37,"lines":[{"text":"Turn my eyes away from worthless things;","poem":1},{"text":"revive me with Your word.","poem":2}]},{"number":38,"lines":[{"text":"Establish Your word to Your servant,","poem":1},{"text":"to produce reverence for You.","poem":2}]},{"number":39,"lines":[{"text":"Turn away the disgrace I dread,","poem":1},{"text":"for Your judgments are good.","poem":2}]},{"number":40,"lines":[{"text":"How I long for Your precepts!","poem":1},{"text":"Revive me in Your righteousness.","poem":2}]},{"number":41,"lines":[{"text":"May Your loving devotion come to me, O LORD,","poem":1},{"text":"Your salvation, according to Your promise.","poem":2}]},{"number":42,"lines":[{"text":"Then I can answer him who taunts,","poem":1},{"text":"for I trust in Your word.","poem":2}]},{"number":43,"lines":[{"text":"Never take Your word of truth from my mouth,","poem":1},{"text":"for I hope in Your judgments.","poem":2}]},{"number":44,"lines":[{"text":"I will always obey Your law,","poem":1},{"text":"forever and ever.","poem":2}]},{"number":45,"lines":[{"text":"And I will walk in freedom,","poem":1},{"text":"for I have sought Your precepts.","poem":2}]},{"number":46,"lines":[{"text":"I will speak of Your testimonies before kings,","poem":1},{"text":"and I will not be ashamed.","poem":2}]},{"number":47,"lines":[{"text":"I delight in Your commandments","poem":1},{"text":"because I love them.","poem":2}]},{"number":48,"lines":[{"text":"I lift up my hands to Your commandments, which I love,","poem":1},{"text":"and I meditate on Your statutes.","poem":2}]},{"number":49,"lines":[{"text":"Remember Your word to Your servant,","poem":1},{"text":"upon which You have given me hope.","poem":2}]},{"number":50,"lines":[{"text":"This is my comfort in affliction,","poem":1},{"text":"that Your promise has given me life.","poem":2}]},{"number":51,"lines":[{"text":"The arrogant utterly deride me,","poem":1},{"text":"but I do not turn from Your law.","poem":2}]},{"number":52,"lines":[{"text":"I remember Your judgments of old, O LORD,","poem":1},{"text":"and in them I find comfort.","poem":2}]},{"number":53,"lines":[{"text":"Rage has taken hold of me","poem":1},{"text":"because of the wicked who reject Your law.","poem":2}]},{"number":54,"lines":[{"text":"Your statutes are songs to me","poem":1},{"text":"in the house of my pilgrimage.","poem":2}]},{"number":55,"lines":[{"text":"In the night, O LORD, I remember Your name,","poem":1},{"text":"that I may keep Your law.","poem":2}]},{"number":56,"lines":[{"text":"This is my practice,","poem":1},{"text":"for I obey Your precepts.","poem":2}]},{"number":57,"lines":[{"text":"The LORD is my portion;","poem":1},{"text":"I have promised to keep Your words.","poem":2}]},{"number":58,"lines":[{"text":"I have sought Your face with all my heart;","poem":1},{"text":"be gracious to me according to Your promise.","poem":2}]},{"number":59,"lines":[{"text":"I considered my ways","poem":1},{"text":"and turned my steps to Your testimonies.","poem":2}]},{"number":60,"lines":[{"text":"I hurried without hesitating","poem":1},{"text":"to keep Your commandments.","poem":2}]},{"number":61,"lines":[{"text":"Though the ropes of the wicked bind me,","poem":1},{"text":"I do not forget Your law.","poem":2}]},{"number":62,"lines":[{"text":"At midnight I rise to give You thanks","poem":1},{"text":"for Your righteous judgments.","poem":2}]},{"number":63,"lines":[{"text":"I am a friend to all who fear You,","poem":1},{"text":"and to those who keep Your precepts.","poem":2}]},{"number":64,"lines":[{"text":"The earth is filled with Your loving devotion, O LORD;","poem":1},{"text":"teach me Your statutes.","poem":2}]},{"number":65,"lines":[{"text":"You are good to Your servant, O LORD,","poem":1},{"text":"according to Your word.","poem":2}]},{"number":66,"lines":[{"text":"Teach me good judgment and knowledge,","poem":1},{"text":"for I believe in Your commandments.","poem":2}]},{"number":67,"lines":[{"text":"Before I was afflicted, I went astray;","poem":1},{"text":"but now I keep Your word.","poem":2}]},{"number":68,"lines":[{"text":"You are good, and You do what is good;","poem":1},{"text":"teach me Your statutes.","poem":2}]},{"number":69,"lines":[{"text":"Though the arrogant have smeared me with lies,","poem":1},{"text":"I keep Your precepts with all my heart.","poem":2}]},{"number":70,"lines":[{"text":"Their hearts are callous and insensitive,","poem":1},{"text":"but I delight in Your law.","poem":2}]},{"number":71,"lines":[{"text":"It was good for me to be afflicted,","poem":1},{"text":"that I might learn Your statutes.","poem":2}]},{"number":72,"lines":[{"text":"The law from Your mouth is more precious to me","poem":1},{"text":"than thousands of pieces of gold and silver.","poem":2}]},{"number":73,"lines":[{"text":"Your hands have made me and fashioned me;","poem":1},{"text":"give me understanding to learn Your commandments.","poem":2}]},{"number":74,"lines":[{"text":"May those who fear You see me and rejoice,","poem":1},{"text":"for I have hoped in Your word.","poem":2}]},{"number":75,"lines":[{"text":"I know, O LORD, that Your judgments are righteous,","poem":1},{"text":"and that in faithfulness You have afflicted me.","poem":2}]},{"number":76,"lines":[{"text":"May Your loving devotion comfort me, I pray,","poem":1},{"text":"according to Your promise to Your servant.","poem":2}]},{"number":77,"lines":[{"text":"May Your compassion come to me, that I may live,","poem":1},{"text":"for Your law is my delight.","poem":2}]},{"number":78,"lines":[{"text":"May the arrogant be put to shame for subverting me with a lie;","poem":1},{"text":"I will meditate on Your precepts.","poem":2}]},{"number":79,"lines":[{"text":"May those who fear You turn to me,","poem":1},{"text":"those who know Your testimonies.","poem":2}]},{"number":80,"lines":[{"text":"May my heart be blameless in Your statutes,","poem":1},{"text":"that I may not be put to shame.","poem":2}]},{"number":81,"lines":[{"text":"My soul faints for Your salvation;","poem":1},{"text":"I wait for Your word.","poem":2}]},{"number":82,"lines":[{"text":"My eyes fail, looking for Your promise;","poem":1},{"text":"I ask, “When will You comfort me?”","poem":2}]},{"number":83,"lines":[{"text":"Though I am like a wineskin dried up by smoke,","poem":1},{"text":"I do not forget Your statutes.","poem":2}]},{"number":84,"lines":[{"text":"How many days must Your servant wait?","poem":1},{"text":"When will You execute judgment on my persecutors?","poem":2}]},{"number":85,"lines":[{"text":"The arrogant have dug pits for me","poem":1},{"text":"in violation of Your law.","poem":2}]},{"number":86,"lines":[{"text":"All Your commandments are faithful;","poem":1},{"text":"I am persecuted without cause—help me!","poem":2}]},{"number":87,"lines":[{"text":"They almost wiped me from the earth,","poem":1},{"text":"but I have not forsaken Your precepts.","poem":2}]},{"number":88,"lines":[{"text":"Revive me according to Your loving devotion,","poem":1},{"text":"that I may obey the testimony of Your mouth.","poem":2}]},{"number":89,"lines":[{"text":"Your word, O LORD, is everlasting;","poem":1},{"text":"it is firmly fixed in the heavens.","poem":2}]},{"number":90,"lines":[{"text":"Your faithfulness continues through all generations;","poem":1},{"text":"You established the earth, and it endures.","poem":2}]},{"number":91,"lines":[{"text":"Your ordinances stand to this day,","poem":1},{"text":"for all things are servants to You.","poem":2}]},{"number":92,"lines":[{"text":"If Your law had not been my delight,","poem":1},{"text":"then I would have perished in my affliction.","poem":2}]},{"number":93,"lines":[{"text":"I will never forget Your precepts,","poem":1},{"text":"for by them You have revived me.","poem":2}]},{"number":94,"lines":[{"text":"I am Yours; save me,","poem":1},{"text":"for I have sought Your precepts.","poem":2}]},{"number":95,"lines":[{"text":"The wicked wait to destroy me,","poem":1},{"text":"but I will ponder Your testimonies.","poem":2}]},{"number":96,"lines":[{"text":"I have seen a limit to all perfection,","poem":1},{"text":"but Your commandment is without limit.","poem":2}]},{"number":97,"lines":[{"text":"Oh, how I love Your law!","poem":1},{"text":"All day long it is my meditation.","poem":2}]},{"number":98,"lines":[{"text":"Your commandments make me wiser than my enemies,","poem":1},{"text":"for they are always with me.","poem":2}]},{"number":99,"lines":[{"text":"I have more insight than all my teachers,","poem":1},{"text":"for Your testimonies are my meditation.","poem":2}]},{"number":100,"lines":[{"text":"I discern more than the elders,","poem":1},{"text":"for I obey Your precepts.","poem":2}]},{"number":101,"lines":[{"text":"I have kept my feet from every evil path,","poem":1},{"text":"that I may keep Your word.","poem":2}]},{"number":102,"lines":[{"text":"I have not departed from Your ordinances,","poem":1},{"text":"for You Yourself have taught me.","poem":2}]},{"number":103,"lines":[{"text":"How sweet are Your words to my taste—","poem":1},{"text":"sweeter than honey in my mouth!","poem":2}]},{"number":104,"lines":[{"text":"I gain understanding from Your precepts;","poem":1},{"text":"therefore I hate every false way.","poem":2}]},{"number":105,"lines":[{"text":"Your word is a lamp to my feet","poem":1},{"text":"and a light to my path.","poem":2}]},{"number":106,"lines":[{"text":"I have sworn and confirmed","poem":1},{"text":"that I will keep Your righteous judgments.","poem":2}]},{"number":107,"lines":[{"text":"I am severely afflicted, O LORD;","poem":1},{"text":"revive me through Your word.","poem":2}]},{"number":108,"lines":[{"text":"Accept the freewill offerings of my mouth, O LORD,","poem":1},{"text":"and teach me Your judgments.","poem":2}]},{"number":109,"lines":[{"text":"I constantly take my life in my hands,","poem":1},{"text":"yet I do not forget Your law.","poem":2}]},{"number":110,"lines":[{"text":"The wicked have set a snare for me,","poem":1},{"text":"but I have not strayed from Your precepts.","poem":2}]},{"number":111,"lines":[{"text":"Your testimonies are my heritage forever,","poem":1},{"text":"for they are the joy of my heart.","poem":2}]},{"number":112,"lines":[{"text":"I have inclined my heart to perform Your statutes,","poem":1},{"text":"even to the very end.","poem":2}]},{"number":113,"lines":[{"text":"The double-minded I despise,","poem":1},{"text":"but Your law I love.","poem":2}]},{"number":114,"lines":[{"text":"You are my hiding place and my shield;","poem":1},{"text":"I put my hope in Your word.","poem":2}]},{"number":115,"lines":[{"text":"Depart from me, you evildoers,","poem":1},{"text":"that I may obey the commandments of my God.","poem":2}]},{"number":116,"lines":[{"text":"Sustain me as You promised, that I may live;","poem":1},{"text":"let me not be ashamed of my hope.","poem":2}]},{"number":117,"lines":[{"text":"Uphold me, and I will be saved,","poem":1},{"text":"that I may always regard Your statutes.","poem":2}]},{"number":118,"lines":[{"text":"You reject all who stray from Your statutes,","poem":1},{"text":"for their deceitfulness is in vain.","poem":2}]},{"number":119,"lines":[{"text":"All the wicked on earth You discard like dross;","poem":1},{"text":"therefore I love Your testimonies.","poem":2}]},{"number":120,"lines":[{"text":"My flesh trembles in awe of You;","poem":1},{"text":"I stand in fear of Your judgments.","poem":2}]},{"number":121,"lines":[{"text":"I have done what is just and right;","poem":1},{"text":"do not leave me to my oppressors.","poem":2}]},{"number":122,"lines":[{"text":"Ensure Your servant’s well-being;","poem":1},{"text":"do not let the arrogant oppress me.","poem":2}]},{"number":123,"lines":[{"text":"My eyes fail, looking for Your salvation,","poem":1},{"text":"and for Your righteous promise.","poem":2}]},{"number":124,"lines":[{"text":"Deal with Your servant according to Your loving devotion,","poem":1},{"text":"and teach me Your statutes.","poem":2}]},{"number":125,"lines":[{"text":"I am Your servant; give me understanding,","poem":1},{"text":"that I may know Your testimonies.","poem":2}]},{"number":126,"lines":[{"text":"It is time for the LORD to act,","poem":1},{"text":"for they have broken Your law.","poem":2}]},{"number":127,"lines":[{"text":"Therefore I love Your commandments more than gold,","poem":1},{"text":"even the purest gold.","poem":2}]},{"number":128,"lines":[{"text":"Therefore I admire all Your precepts","poem":1},{"text":"and hate every false way.","poem":2}]},{"number":129,"lines":[{"text":"Wonderful are Your testimonies;","poem":1},{"text":"therefore I obey them.","poem":2}]},{"number":130,"lines":[{"text":"The unfolding of Your words gives light;","poem":1},{"text":"it informs the simple.","poem":2}]},{"number":131,"lines":[{"text":"I open my mouth and pant,","poem":1},{"text":"longing for Your commandments.","poem":2}]},{"number":132,"lines":[{"text":"Turn to me and show me mercy,","poem":1},{"text":"as You do to those who love Your name.","poem":2}]},{"number":133,"lines":[{"text":"Order my steps in Your word;","poem":1},{"text":"let no sin rule over me.","poem":2}]},{"number":134,"lines":[{"text":"Redeem me from the oppression of man,","poem":1},{"text":"that I may keep Your precepts.","poem":2}]},{"number":135,"lines":[{"text":"Make Your face shine upon Your servant,","poem":1},{"text":"and teach me Your statutes.","poem":2}]},{"number":136,"lines":[{"text":"My eyes shed streams of tears","poem":1},{"text":"because Your law is not obeyed.","poem":2}]},{"number":137,"lines":[{"text":"Righteous are You, O LORD,","poem":1},{"text":"and upright are Your judgments.","poem":2}]},{"number":138,"lines":[{"text":"The testimonies You have laid down are righteous","poem":1},{"text":"and altogether faithful.","poem":2}]},{"number":139,"lines":[{"text":"My zeal has consumed me","poem":1},{"text":"because my foes forget Your words.","poem":2}]},{"number":140,"lines":[{"text":"Your promise is completely pure;","poem":1},{"text":"therefore Your servant loves it.","poem":2}]},{"number":141,"lines":[{"text":"I am lowly and despised,","poem":1},{"text":"but I do not forget Your precepts.","poem":2}]},{"number":142,"lines":[{"text":"Your righteousness is everlasting","poem":1},{"text":"and Your law is true.","poem":2}]},{"number":143,"lines":[{"text":"Trouble and distress have found me,","poem":1},{"text":"but Your commandments are my delight.","poem":2}]},{"number":144,"lines":[{"text":"Your testimonies are righteous forever.","poem":1},{"text":"Give me understanding, that I may live.","poem":2}]},{"number":145,"lines":[{"text":"I call with all my heart; answer me, O LORD!","poem":1},{"text":"I will obey Your statutes.","poem":2}]},{"number":146,"lines":[{"text":"I call to You; save me,","poem":1},{"text":"that I may keep Your testimonies.","poem":2}]},{"number":147,"lines":[{"text":"I rise before dawn and cry for help;","poem":1},{"text":"in Your word I have put my hope.","poem":2}]},{"number":148,"lines":[{"text":"My eyes anticipate the watches of night,","poem":1},{"text":"that I may meditate on Your word.","poem":2}]},{"number":149,"lines":[{"text":"Hear my voice, O LORD, according to Your loving devotion;","poem":1},{"text":"give me life according to Your justice.","poem":2}]},{"number":150,"lines":[{"text":"Those who follow after wickedness draw near;","poem":1},{"text":"they are far from Your law.","poem":2}]},{"number":151,"lines":[{"text":"You are near, O LORD,","poem":1},{"text":"and all Your commandments are true.","poem":2}]},{"number":152,"lines":[{"text":"Long ago I learned from Your testimonies","poem":1},{"text":"that You have established them forever.","poem":2}]},{"number":153,"lines":[{"text":"Look upon my affliction and rescue me,","poem":1},{"text":"for I have not forgotten Your law.","poem":2}]},{"number":154,"lines":[{"text":"Defend my cause and redeem me;","poem":1},{"text":"revive me according to Your word.","poem":2}]},{"number":155,"lines":[{"text":"Salvation is far from the wicked","poem":1},{"text":"because they do not seek Your statutes.","poem":2}]},{"number":156,"lines":[{"text":"Great are Your mercies, O LORD;","poem":1},{"text":"revive me according to Your ordinances.","poem":2}]},{"number":157,"lines":[{"text":"Though my persecutors and foes are many,","poem":1},{"text":"I have not turned from Your testimonies.","poem":2}]},{"number":158,"lines":[{"text":"I look on the faithless with loathing","poem":1},{"text":"because they do not keep Your word.","poem":2}]},{"number":159,"lines":[{"text":"Consider how I love Your precepts, O LORD;","poem":1},{"text":"give me life according to Your loving devotion.","poem":2}]},{"number":160,"lines":[{"text":"The entirety of Your word is truth,","poem":1},{"text":"and all Your righteous judgments endure forever.","poem":2}]},{"number":161,"lines":[{"text":"Rulers persecute me without cause,","poem":1},{"text":"but my heart fears only Your word.","poem":2}]},{"number":162,"lines":[{"text":"I rejoice in Your promise","poem":1},{"text":"like one who finds great spoil.","poem":2}]},{"number":163,"lines":[{"text":"I hate and abhor falsehood,","poem":1},{"text":"but Your law I love.","poem":2}]},{"number":164,"lines":[{"text":"Seven times a day I praise You","poem":1},{"text":"for Your righteous judgments.","poem":2}]},{"number":165,"lines":[{"text":"Abundant peace belongs to those who love Your law;","poem":1},{"text":"nothing can make them stumble.","poem":2}]},{"number":166,"lines":[{"text":"I wait for Your salvation, O LORD,","poem":1},{"text":"and I carry out Your commandments.","poem":2}]},{"number":167,"lines":[{"text":"I obey Your testimonies","poem":1},{"text":"and love them greatly.","poem":2}]},{"number":168,"lines":[{"text":"I obey Your precepts and Your testimonies,","poem":1},{"text":"for all my ways are before You.","poem":2}]},{"number":169,"lines":[{"text":"May my cry come before You, O LORD;","poem":1},{"text":"give me understanding according to Your word.","poem":2}]},{"number":170,"lines":[{"text":"May my plea come before You;","poem":1},{"text":"rescue me according to Your promise.","poem":2}]},{"number":171,"lines":[{"text":"My lips pour forth praise,","poem":1},{"text":"for You teach me Your statutes.","poem":2}]},{"number":172,"lines":[{"text":"My tongue sings of Your word,","poem":1},{"text":"for all Your commandments are righteous.","poem":2}]},{"number":173,"lines":[{"text":"May Your hand be ready to help me,","poem":1},{"text":"for I have chosen Your precepts.","poem":2}]},{"number":174,"lines":[{"text":"I long for Your salvation, O LORD,","poem":1},{"text":"and Your law is my delight.","poem":2}]},{"number":175,"lines":[{"text":"Let me live to praise You;","poem":1},{"text":"may Your judgments sustain me.","poem":2}]},{"number":176,"lines":[{"text":"I have strayed like a lost sheep;","poem":1},{"text":"seek Your servant, for I have not forgotten Your commandments.","poem":2}]}]},{"number":120,"lastVerse":7,"verses":[{"number":1,"lines":[{"text":"In my distress I cried to the LORD,","poem":1},{"text":"and He answered me.","poem":2}]},{"number":2,"lines":[{"text":"Deliver my soul, O LORD,","poem":1},{"text":"from lying lips and a deceitful tongue.","poem":2}]},{"number":3,"lines":[{"text":"What will He do to you,","poem":1},{"text":"and what will be added to you,","poem":2},{"text":"O deceitful tongue?","poem":2}]},{"number":4,"lines":[{"text":"Sharp arrows will come from the warrior,","poem":1},{"text":"with burning coals of the broom tree!","poem":2}]},{"number":5,"lines":[{"text":"Woe to me that I dwell in Meshech,","poem":1},{"text":"that I live among the tents of Kedar!","poem":2}]},{"number":6,"lines":[{"text":"Too long have I dwelt","poem":1},{"text":"among those who hate peace.","poem":2}]},{"number":7,"lines":[{"text":"I am in favor of peace;","poem":1},{"text":"but when I speak, they want war.","poem":2}]}]},{"number":121,"lastVerse":8,"verses":[{"number":1,"lines":[{"text":"I lift up my eyes to the hills.","poem":1},{"text":"From where does my help come?","poem":2}]},{"number":2,"lines":[{"text":"My help comes from the LORD,","poem":1},{"text":"the Maker of heaven and earth.","poem":2}]},{"number":3,"lines":[{"text":"He will not allow your foot to slip;","poem":1},{"text":"your Protector will not slumber.","poem":2}]},{"number":4,"lines":[{"text":"Behold, the Protector of Israel","poem":1},{"text":"will neither slumber nor sleep.","poem":2}]},{"number":5,"lines":[{"text":"The LORD is your keeper;","poem":1},{"text":"the LORD is the shade on your right hand.","poem":2}]},{"number":6,"lines":[{"text":"The sun will not strike you by day,","poem":1},{"text":"nor the moon by night.","poem":2}]},{"number":7,"lines":[{"text":"The LORD will guard you from all evil;","poem":1},{"text":"He will preserve your soul.","poem":2}]},{"number":8,"lines":[{"text":"The LORD will watch over your coming and going,","poem":1},{"text":"both now and forevermore.","poem":2}]}]},{"number":122,"lastVerse":9,"verses":[{"number":1,"lines":[{"text":"I was glad when they said to me,","poem":1},{"text":"“Let us go to the house of the LORD.”","poem":2}]},{"number":2,"lines":[{"text":"Our feet are standing in your gates,","poem":1},{"text":"O Jerusalem.","poem":2}]},{"number":3,"lines":[{"text":"Jerusalem is built up","poem":1},{"text":"as a city united together,","poem":2}]},{"number":4,"lines":[{"text":"where the tribes go up,","poem":1},{"text":"the tribes of the LORD,","poem":2},{"text":"as a testimony for Israel,","poem":1},{"text":"to give thanks to the name of the LORD.","poem":2}]},{"number":5,"lines":[{"text":"For there the thrones of judgment stand,","poem":1},{"text":"the thrones of the house of David.","poem":2}]},{"number":6,"lines":[{"text":"Pray for the peace of Jerusalem:","poem":1},{"text":"“May those who love you prosper.","poem":2}]},{"number":7,"lines":[{"text":"May there be peace within your walls,","poem":1},{"text":"and prosperity inside your fortresses.”","poem":2}]},{"number":8,"lines":[{"text":"For the sake of my brothers and friends,","poem":1},{"text":"I will say, “Peace be within you.”","poem":2}]},{"number":9,"lines":[{"text":"For the sake of the house of the LORD our God,","poem":1},{"text":"I will seek your prosperity.","poem":2}]}]},{"number":123,"lastVerse":4,"verses":[{"number":1,"lines":[{"text":"I lift up my eyes to You,","poem":1},{"text":"the One enthroned in heaven.","poem":2}]},{"number":2,"lines":[{"text":"As the eyes of servants","poem":1},{"text":"look to the hand of their master,","poem":2},{"text":"as the eyes of a maidservant","poem":1},{"text":"look to the hand of her mistress,","poem":2},{"text":"so our eyes are on the LORD our God","poem":1},{"text":"until He shows us mercy.","poem":2}]},{"number":3,"lines":[{"text":"Have mercy on us, O LORD, have mercy,","poem":1},{"text":"for we have endured much contempt.","poem":2}]},{"number":4,"lines":[{"text":"We have endured much scorn from the arrogant,","poem":1},{"text":"much contempt from the proud.","poem":2}]}]},{"number":124,"lastVerse":8,"verses":[{"number":1,"lines":[{"text":"If the LORD had not been on our side—","poem":1},{"text":"let Israel now declare—","poem":2}]},{"number":2,"lines":[{"text":"if the LORD had not been on our side","poem":1},{"text":"when men attacked us,","poem":2}]},{"number":3,"lines":[{"text":"when their anger flared against us,","poem":1},{"text":"then they would have swallowed us alive,","poem":2}]},{"number":4,"lines":[{"text":"then the floods would have engulfed us,","poem":1},{"text":"then the torrent would have overwhelmed us,","poem":2}]},{"number":5,"lines":[{"text":"then the raging waters","poem":1},{"text":"would have swept us away.","poem":2}]},{"number":6,"lines":[{"text":"Blessed be the LORD,","poem":1},{"text":"who has not given us as prey to their teeth.","poem":2}]},{"number":7,"lines":[{"text":"We have escaped like a bird from the snare of the fowler;","poem":1},{"text":"the net is torn, and we have slipped away.","poem":2}]},{"number":8,"lines":[{"text":"Our help is in the name of the LORD,","poem":1},{"text":"the Maker of heaven and earth.","poem":2}]}]},{"number":125,"lastVerse":5,"verses":[{"number":1,"lines":[{"text":"Those who trust in the LORD are like Mount Zion.","poem":1},{"text":"It cannot be moved; it abides forever.","poem":2}]},{"number":2,"lines":[{"text":"As the mountains surround Jerusalem,","poem":1},{"text":"so the LORD surrounds His people,","poem":2},{"text":"both now and forevermore.","poem":2}]},{"number":3,"lines":[{"text":"For the scepter of the wicked will not rest","poem":1},{"text":"upon the land allotted to the righteous,","poem":2},{"text":"so that the righteous will not put forth","poem":1},{"text":"their hands to injustice.","poem":2}]},{"number":4,"lines":[{"text":"Do good, O LORD, to those who are good,","poem":1},{"text":"and to the upright in heart.","poem":2}]},{"number":5,"lines":[{"text":"But those who turn to crooked ways","poem":1},{"text":"the LORD will banish with the evildoers.","poem":2},{"text":"Peace be upon Israel.","poem":1}]}]},{"number":126,"lastVerse":6,"verses":[{"number":1,"lines":[{"text":"When the LORD restored the captives of Zion,","poem":1},{"text":"we were like dreamers.","poem":2}]},{"number":2,"lines":[{"text":"Then our mouths were filled with laughter,","poem":1},{"text":"our tongues with shouts of joy.","poem":2},{"text":"Then it was said among the nations,","poem":1},{"text":"“The LORD has done great things for them.”","poem":2}]},{"number":3,"lines":[{"text":"The LORD has done great things for us;","poem":1},{"text":"we are filled with joy.","poem":2}]},{"number":4,"lines":[{"text":"Restore our captives, O LORD,","poem":1},{"text":"like streams in the Negev.","poem":2}]},{"number":5,"lines":[{"text":"Those who sow in tears","poem":1},{"text":"will reap with shouts of joy.","poem":2}]},{"number":6,"lines":[{"text":"He who goes out weeping,","poem":1},{"text":"bearing a trail of seed,","poem":2},{"text":"will surely return with shouts of joy,","poem":1},{"text":"carrying sheaves of grain.","poem":2}]}]},{"number":127,"lastVerse":5,"verses":[{"number":1,"lines":[{"text":"Unless the LORD builds the house,","poem":1},{"text":"its builders labor in vain;","poem":2},{"text":"unless the LORD protects the city,","poem":1},{"text":"its watchmen stand guard in vain.","poem":2}]},{"number":2,"lines":[{"text":"In vain you rise early","poem":1},{"text":"and stay up late,","poem":2},{"text":"toiling for bread to eat—","poem":1},{"text":"for He gives sleep to His beloved.","poem":2}]},{"number":3,"lines":[{"text":"Children are indeed a heritage from the LORD,","poem":1},{"text":"and the fruit of the womb is His reward.","poem":2}]},{"number":4,"lines":[{"text":"Like arrows in the hand of a warrior,","poem":1},{"text":"so are children born in one’s youth.","poem":2}]},{"number":5,"lines":[{"text":"Blessed is the man","poem":1},{"text":"whose quiver is full of them.","poem":2},{"text":"He will not be put to shame","poem":1},{"text":"when he confronts the enemies at the gate.","poem":2}]}]},{"number":128,"lastVerse":6,"verses":[{"number":1,"lines":[{"text":"Blessed are all who fear the LORD,","poem":1},{"text":"who walk in His ways!","poem":2}]},{"number":2,"lines":[{"text":"For when you eat the fruit of your labor,","poem":1},{"text":"blessings and prosperity will be yours.","poem":2}]},{"number":3,"lines":[{"text":"Your wife will be like a fruitful vine","poem":1},{"text":"flourishing within your house,","poem":2},{"text":"your sons like olive shoots","poem":1},{"text":"sitting around your table.","poem":2}]},{"number":4,"lines":[{"text":"In this way indeed shall blessing come","poem":1},{"text":"to the man who fears the LORD.","poem":2}]},{"number":5,"lines":[{"text":"May the LORD bless you from Zion,","poem":1},{"text":"that you may see the prosperity of Jerusalem","poem":2},{"text":"all the days of your life,","poem":2}]},{"number":6,"lines":[{"text":"that you may see","poem":1},{"text":"your children’s children.","poem":2},{"text":"Peace be upon Israel!","poem":1}]}]},{"number":129,"lastVerse":8,"verses":[{"number":1,"lines":[{"text":"Many a time they have persecuted me from my youth—","poem":1},{"text":"let Israel now declare—","poem":2}]},{"number":2,"lines":[{"text":"many a time they have persecuted me from my youth,","poem":1},{"text":"but they have not prevailed against me.","poem":2}]},{"number":3,"lines":[{"text":"The plowmen plowed over my back;","poem":1},{"text":"they made their furrows long.","poem":2}]},{"number":4,"lines":[{"text":"The LORD is righteous;","poem":1},{"text":"He has cut me from the cords of the wicked.","poem":2}]},{"number":5,"lines":[{"text":"May all who hate Zion","poem":1},{"text":"be turned back in shame.","poem":2}]},{"number":6,"lines":[{"text":"May they be like grass on the rooftops,","poem":1},{"text":"which withers before it can grow,","poem":2}]},{"number":7,"lines":[{"text":"unable to fill the hands of the reaper,","poem":1},{"text":"or the arms of the binder of sheaves.","poem":2}]},{"number":8,"lines":[{"text":"May none who pass by say to them,","poem":1},{"text":"“The blessing of the LORD be on you;","poem":2},{"text":"we bless you in the name of the LORD.”","poem":2}]}]},{"number":130,"lastVerse":8,"verses":[{"number":1,"lines":[{"text":"Out of the depths","poem":1},{"text":"I cry to You, O LORD!","poem":2}]},{"number":2,"lines":[{"text":"O Lord, hear my voice;","poem":1},{"text":"let Your ears be attentive to my plea for mercy.","poem":2}]},{"number":3,"lines":[{"text":"If You, O LORD, kept track of iniquities,","poem":1},{"text":"then who, O Lord, could stand?","poem":2}]},{"number":4,"lines":[{"text":"But with You there is forgiveness,","poem":1},{"text":"so that You may be feared.","poem":2}]},{"number":5,"lines":[{"text":"I wait for the LORD; my soul does wait,","poem":1},{"text":"and in His word I put my hope.","poem":2}]},{"number":6,"lines":[{"text":"My soul waits for the Lord","poem":1},{"text":"more than watchmen wait for the morning—","poem":2},{"text":"more than watchmen wait for the morning.","poem":2}]},{"number":7,"lines":[{"text":"O Israel, put your hope in the LORD,","poem":1},{"text":"for with the LORD is loving devotion,","poem":2},{"text":"and with Him is redemption in abundance.","poem":2}]},{"number":8,"lines":[{"text":"And He will redeem Israel","poem":1},{"text":"from all iniquity.","poem":2}]}]},{"number":131,"lastVerse":3,"verses":[{"number":1,"lines":[{"text":"My heart is not proud, O LORD,","poem":1},{"text":"my eyes are not haughty.","poem":2},{"text":"I do not aspire to great things","poem":1},{"text":"or matters too lofty for me.","poem":2}]},{"number":2,"lines":[{"text":"Surely I have stilled and quieted my soul;","poem":1},{"text":"like a weaned child with his mother,","poem":2},{"text":"like a weaned child is my soul within me.","poem":2}]},{"number":3,"lines":[{"text":"O Israel, put your hope in the LORD,","poem":1},{"text":"both now and forevermore.","poem":2}]}]},{"number":132,"lastVerse":18,"verses":[{"number":1,"lines":[{"text":"O LORD, remember on behalf of David","poem":1},{"text":"all the hardships he endured,","poem":2}]},{"number":2,"lines":[{"text":"how he swore an oath to the LORD,","poem":1},{"text":"and vowed to the Mighty One of Jacob:","poem":2}]},{"number":3,"lines":[{"text":"“I will not enter my house","poem":1},{"text":"or get into my bed,","poem":2}]},{"number":4,"lines":[{"text":"I will not give sleep to my eyes","poem":1},{"text":"or slumber to my eyelids,","poem":2}]},{"number":5,"lines":[{"text":"until I find a place for the LORD,","poem":1},{"text":"a dwelling for the Mighty One of Jacob.”","poem":2}]},{"number":6,"lines":[{"text":"We heard that the ark was in Ephrathah;","poem":1},{"text":"we found it in the fields of Jaar.","poem":2}]},{"number":7,"lines":[{"text":"Let us go to His dwelling place;","poem":1},{"text":"let us worship at His footstool.","poem":2}]},{"number":8,"lines":[{"text":"Arise, O LORD, to Your resting place,","poem":1},{"text":"You and the ark of Your strength.","poem":2}]},{"number":9,"lines":[{"text":"May Your priests be clothed with righteousness,","poem":1},{"text":"and Your saints shout for joy.","poem":2}]},{"number":10,"lines":[{"text":"For the sake of Your servant David,","poem":1},{"text":"do not reject Your anointed one.","poem":2}]},{"number":11,"lines":[{"text":"The LORD swore an oath to David,","poem":1},{"text":"a promise He will not revoke:","poem":2},{"text":"“One of your descendants","poem":1},{"text":"I will place on your throne.","poem":2}]},{"number":12,"lines":[{"text":"If your sons keep My covenant","poem":1},{"text":"and the testimony I will teach them,","poem":2},{"text":"then their sons will also sit on your throne","poem":1},{"text":"forever and ever.”","poem":2}]},{"number":13,"lines":[{"text":"For the LORD has chosen Zion;","poem":1},{"text":"He has desired it for His home:","poem":2}]},{"number":14,"lines":[{"text":"“This is My resting place forever and ever;","poem":1},{"text":"here I will dwell, for I have desired this home.","poem":2}]},{"number":15,"lines":[{"text":"I will bless her with abundant provisions;","poem":1},{"text":"I will satisfy her poor with bread.","poem":2}]},{"number":16,"lines":[{"text":"I will clothe her priests with salvation,","poem":1},{"text":"and her saints will sing out in joy.","poem":2}]},{"number":17,"lines":[{"text":"There I will make a horn grow for David;","poem":1},{"text":"I have prepared a lamp for My anointed one.","poem":2}]},{"number":18,"lines":[{"text":"I will clothe his enemies with shame,","poem":1},{"text":"but the crown upon him will gleam.”","poem":2}]}]},{"number":133,"lastVerse":3,"verses":[{"number":1,"lines":[{"text":"Behold, how good and pleasant it is","poem":1},{"text":"when brothers live together in harmony!","poem":2}]},{"number":2,"lines":[{"text":"It is like fine oil on the head,","poem":1},{"text":"running down on the beard,","poem":2},{"text":"running down Aaron’s beard","poem":1},{"text":"over the collar of his robes.","poem":2}]},{"number":3,"lines":[{"text":"It is like the dew of Hermon","poem":1},{"text":"falling on the mountains of Zion.","poem":2},{"text":"For there the LORD has bestowed the blessing","poem":1},{"text":"of life forevermore.","poem":2}]}]},{"number":134,"lastVerse":3,"verses":[{"number":1,"lines":[{"text":"Come, bless the LORD,","poem":1},{"text":"all you servants of the LORD","poem":2},{"text":"who serve by night","poem":1},{"text":"in the house of the LORD!","poem":2}]},{"number":2,"lines":[{"text":"Lift up your hands to the sanctuary","poem":1},{"text":"and bless the LORD!","poem":2}]},{"number":3,"lines":[{"text":"May the LORD, the Maker of heaven and earth,","poem":1},{"text":"bless you from Zion.","poem":2}]}]},{"number":135,"lastVerse":21,"verses":[{"number":1,"lines":[{"text":"Hallelujah!","poem":1},{"text":"Praise the name of the LORD.","poem":1},{"text":"Give praise, O servants of the LORD,","poem":2}]},{"number":2,"lines":[{"text":"who stand in the house of the LORD,","poem":1},{"text":"in the courts of the house of our God.","poem":2}]},{"number":3,"lines":[{"text":"Hallelujah, for the LORD is good;","poem":1},{"text":"sing praises to His name, for it is lovely.","poem":2}]},{"number":4,"lines":[{"text":"For the LORD has chosen Jacob as His own,","poem":1},{"text":"Israel as His treasured possession.","poem":2}]},{"number":5,"lines":[{"text":"For I know that the LORD is great;","poem":1},{"text":"our Lord is above all gods.","poem":2}]},{"number":6,"lines":[{"text":"The LORD does all that pleases Him","poem":1},{"text":"in the heavens and on the earth,","poem":2},{"text":"in the seas and in all their depths.","poem":2}]},{"number":7,"lines":[{"text":"He causes the clouds to rise","poem":1},{"text":"from the ends of the earth.","poem":2},{"text":"He generates the lightning with the rain","poem":1},{"text":"and brings forth the wind from His storehouses.","poem":2}]},{"number":8,"lines":[{"text":"He struck down the firstborn of Egypt,","poem":1},{"text":"of both man and beast.","poem":2}]},{"number":9,"lines":[{"text":"He sent signs and wonders into your midst, O Egypt,","poem":1},{"text":"against Pharaoh and all his servants.","poem":2}]},{"number":10,"lines":[{"text":"He struck down many nations","poem":1},{"text":"and slaughtered mighty kings:","poem":2}]},{"number":11,"lines":[{"text":"Sihon king of the Amorites,","poem":1},{"text":"Og king of Bashan,","poem":2},{"text":"and all the kings of Canaan.","poem":2}]},{"number":12,"lines":[{"text":"He gave their land as an inheritance,","poem":1},{"text":"as a heritage to His people Israel.","poem":2}]},{"number":13,"lines":[{"text":"Your name, O LORD, endures forever,","poem":1},{"text":"Your renown, O LORD, through all generations.","poem":2}]},{"number":14,"lines":[{"text":"For the LORD will vindicate His people","poem":1},{"text":"and will have compassion on His servants.","poem":2}]},{"number":15,"lines":[{"text":"The idols of the nations are silver and gold,","poem":1},{"text":"made by the hands of men.","poem":2}]},{"number":16,"lines":[{"text":"They have mouths, but cannot speak;","poem":1},{"text":"they have eyes, but cannot see;","poem":2}]},{"number":17,"lines":[{"text":"they have ears, but cannot hear;","poem":1},{"text":"nor is there breath in their mouths.","poem":2}]},{"number":18,"lines":[{"text":"Those who make them become like them,","poem":1},{"text":"as do all who trust in them.","poem":2}]},{"number":19,"lines":[{"text":"O house of Israel, bless the LORD;","poem":1},{"text":"O house of Aaron, bless the LORD;","poem":2}]},{"number":20,"lines":[{"text":"O house of Levi, bless the LORD;","poem":1},{"text":"you who fear the LORD, bless the LORD!","poem":2}]},{"number":21,"lines":[{"text":"Blessed be the LORD from Zion—","poem":1},{"text":"He who dwells in Jerusalem.","poem":2},{"text":"Hallelujah!","poem":1}]}]},{"number":136,"lastVerse":26,"verses":[{"number":1,"lines":[{"text":"Give thanks to the LORD, for He is good.","poem":1},{"text":"His loving devotion endures forever."}]},{"number":2,"lines":[{"text":"Give thanks to the God of gods.","poem":1},{"text":"His loving devotion endures forever."}]},{"number":3,"lines":[{"text":"Give thanks to the Lord of lords.","poem":1},{"text":"His loving devotion endures forever."}]},{"number":4,"lines":[{"text":"He alone does great wonders.","poem":1},{"text":"His loving devotion endures forever."}]},{"number":5,"lines":[{"text":"By His insight He made the heavens.","poem":1},{"text":"His loving devotion endures forever."}]},{"number":6,"lines":[{"text":"He spread out the earth upon the waters.","poem":1},{"text":"His loving devotion endures forever."}]},{"number":7,"lines":[{"text":"He made the great lights—","poem":1},{"text":"His loving devotion endures forever."}]},{"number":8,"lines":[{"text":"the sun to rule the day,","poem":1},{"text":"His loving devotion endures forever."}]},{"number":9,"lines":[{"text":"the moon and stars to govern the night.","poem":1},{"text":"His loving devotion endures forever."}]},{"number":10,"lines":[{"text":"He struck down the firstborn of Egypt","poem":1},{"text":"His loving devotion endures forever."}]},{"number":11,"lines":[{"text":"and brought Israel out from among them","poem":1},{"text":"His loving devotion endures forever."}]},{"number":12,"lines":[{"text":"with a mighty hand and an outstretched arm.","poem":1},{"text":"His loving devotion endures forever."}]},{"number":13,"lines":[{"text":"He divided the Red Sea in two","poem":1},{"text":"His loving devotion endures forever."}]},{"number":14,"lines":[{"text":"and led Israel through the midst,","poem":1},{"text":"His loving devotion endures forever."}]},{"number":15,"lines":[{"text":"but swept Pharaoh and his army into the Red Sea.","poem":1},{"text":"His loving devotion endures forever."}]},{"number":16,"lines":[{"text":"He led His people through the wilderness.","poem":1},{"text":"His loving devotion endures forever."}]},{"number":17,"lines":[{"text":"He struck down great kings","poem":1},{"text":"His loving devotion endures forever."}]},{"number":18,"lines":[{"text":"and slaughtered mighty kings—","poem":1},{"text":"His loving devotion endures forever."}]},{"number":19,"lines":[{"text":"Sihon king of the Amorites","poem":1},{"text":"His loving devotion endures forever."}]},{"number":20,"lines":[{"text":"and Og king of Bashan—","poem":1},{"text":"His loving devotion endures forever."}]},{"number":21,"lines":[{"text":"and He gave their land as an inheritance,","poem":1},{"text":"His loving devotion endures forever."}]},{"number":22,"lines":[{"text":"a heritage to His servant Israel.","poem":1},{"text":"His loving devotion endures forever."}]},{"number":23,"lines":[{"text":"He remembered us in our low estate","poem":1},{"text":"His loving devotion endures forever."}]},{"number":24,"lines":[{"text":"and freed us from our enemies.","poem":1},{"text":"His loving devotion endures forever."}]},{"number":25,"lines":[{"text":"He gives food to every creature.","poem":1},{"text":"His loving devotion endures forever."}]},{"number":26,"lines":[{"text":"Give thanks to the God of heaven!","poem":1},{"text":"His loving devotion endures forever."}]}]},{"number":137,"lastVerse":9,"verses":[{"number":1,"lines":[{"text":"By the rivers of Babylon we sat and wept","poem":1},{"text":"when we remembered Zion.","poem":2}]},{"number":2,"lines":[{"text":"There on the willows","poem":1},{"text":"we hung our harps,","poem":2}]},{"number":3,"lines":[{"text":"for there our captors requested a song;","poem":1},{"text":"our tormentors demanded songs of joy:","poem":2},{"text":"“Sing us a song of Zion.”","poem":1}]},{"number":4,"lines":[{"text":"How can we sing a song of the LORD","poem":1},{"text":"in a foreign land?","poem":2}]},{"number":5,"lines":[{"text":"If I forget you, O Jerusalem,","poem":1},{"text":"may my right hand cease to function.","poem":2}]},{"number":6,"lines":[{"text":"May my tongue cling to the roof of my mouth","poem":1},{"text":"if I do not remember you,","poem":2},{"text":"if I do not exalt Jerusalem","poem":1},{"text":"as my greatest joy!","poem":2}]},{"number":7,"lines":[{"text":"Remember, O LORD,","poem":1},{"text":"the sons of Edom on the day Jerusalem fell:","poem":2},{"text":"“Destroy it,” they said,","poem":1},{"text":"“tear it down to its foundations!”","poem":2}]},{"number":8,"lines":[{"text":"O Daughter of Babylon,","poem":1},{"text":"doomed to destruction,","poem":2},{"text":"blessed is he who repays you","poem":1},{"text":"as you have done to us.","poem":2}]},{"number":9,"lines":[{"text":"Blessed is he who seizes your infants","poem":1},{"text":"and dashes them against the rocks.","poem":2}]}]},{"number":138,"lastVerse":8,"verses":[{"number":1,"lines":[{"text":"I give You thanks with all my heart;","poem":1},{"text":"before the gods I sing Your praises.","poem":2}]},{"number":2,"lines":[{"text":"I bow down toward Your holy temple","poem":1},{"text":"and give thanks to Your name","poem":2},{"text":"for Your loving devotion and Your faithfulness;","poem":2},{"text":"You have exalted Your name","poem":1},{"text":"and Your word above all else.","poem":2}]},{"number":3,"lines":[{"text":"On the day I called, You answered me;","poem":1},{"text":"You emboldened me and strengthened my soul.","poem":2}]},{"number":4,"lines":[{"text":"All the kings of the earth will give You thanks, O LORD,","poem":1},{"text":"when they hear the words of Your mouth.","poem":2}]},{"number":5,"lines":[{"text":"They will sing of the ways of the LORD,","poem":1},{"text":"for the glory of the LORD is great.","poem":2}]},{"number":6,"lines":[{"text":"Though the LORD is on high,","poem":1},{"text":"He attends to the lowly;","poem":2},{"text":"but the proud He knows from afar.","poem":2}]},{"number":7,"lines":[{"text":"If I walk in the midst of trouble,","poem":1},{"text":"You preserve me from the anger of my foes;","poem":2},{"text":"You extend Your hand,","poem":1},{"text":"and Your right hand saves me.","poem":2}]},{"number":8,"lines":[{"text":"The LORD will fulfill","poem":1},{"text":"His purpose for me.","poem":2},{"text":"O LORD, Your loving devotion endures forever—","poem":1},{"text":"do not abandon the works of Your hands.","poem":2}]}]},{"number":139,"lastVerse":24,"verses":[{"number":1,"lines":[{"text":"O LORD, You have searched me","poem":1},{"text":"and known me.","poem":2}]},{"number":2,"lines":[{"text":"You know when I sit and when I rise;","poem":1},{"text":"You understand my thoughts from afar.","poem":2}]},{"number":3,"lines":[{"text":"You search out my path and my lying down;","poem":1},{"text":"You are aware of all my ways.","poem":2}]},{"number":4,"lines":[{"text":"Even before a word is on my tongue,","poem":1},{"text":"You know all about it, O LORD.","poem":2}]},{"number":5,"lines":[{"text":"You hem me in behind and before;","poem":1},{"text":"You have laid Your hand upon me.","poem":2}]},{"number":6,"lines":[{"text":"Such knowledge is too wonderful for me,","poem":1},{"text":"too lofty for me to attain.","poem":2}]},{"number":7,"lines":[{"text":"Where can I go to escape Your Spirit?","poem":1},{"text":"Where can I flee from Your presence?","poem":2}]},{"number":8,"lines":[{"text":"If I ascend to the heavens, You are there;","poem":1},{"text":"if I make my bed in Sheol, You are there.","poem":2}]},{"number":9,"lines":[{"text":"If I rise on the wings of the dawn,","poem":1},{"text":"if I settle by the farthest sea,","poem":2}]},{"number":10,"lines":[{"text":"even there Your hand will guide me;","poem":1},{"text":"Your right hand will hold me fast.","poem":2}]},{"number":11,"lines":[{"text":"If I say, “Surely the darkness will hide me,","poem":1},{"text":"and the light become night around me”—","poem":2}]},{"number":12,"lines":[{"text":"even the darkness is not dark to You,","poem":1},{"text":"but the night shines like the day,","poem":2},{"text":"for darkness is as light to You.","poem":2}]},{"number":13,"lines":[{"text":"For You formed my inmost being;","poem":1},{"text":"You knit me together in my mother’s womb.","poem":2}]},{"number":14,"lines":[{"text":"I praise You,","poem":1},{"text":"for I am fearfully and wonderfully made.","poem":2},{"text":"Marvelous are Your works,","poem":1},{"text":"and I know this very well.","poem":2}]},{"number":15,"lines":[{"text":"My frame was not hidden from You","poem":1},{"text":"when I was made in secret,","poem":2},{"text":"when I was woven together","poem":1},{"text":"in the depths of the earth.","poem":2}]},{"number":16,"lines":[{"text":"Your eyes saw my unformed body;","poem":1},{"text":"all my days were written in Your book","poem":2},{"text":"and ordained for me","poem":1},{"text":"before one of them came to be.","poem":2}]},{"number":17,"lines":[{"text":"How precious to me are Your thoughts, O God,","poem":1},{"text":"how vast is their sum!","poem":2}]},{"number":18,"lines":[{"text":"If I were to count them,","poem":1},{"text":"they would outnumber the grains of sand;","poem":2},{"text":"and when I awake,","poem":1},{"text":"I am still with You.","poem":2}]},{"number":19,"lines":[{"text":"O God, that You would slay the wicked—","poem":1},{"text":"away from me, you bloodthirsty men—","poem":2}]},{"number":20,"lines":[{"text":"who speak of You deceitfully;","poem":1},{"text":"Your enemies take Your name in vain.","poem":2}]},{"number":21,"lines":[{"text":"Do I not hate those who hate You, O LORD,","poem":1},{"text":"and detest those who rise against You?","poem":2}]},{"number":22,"lines":[{"text":"I hate them with perfect hatred;","poem":1},{"text":"I count them as my enemies.","poem":2}]},{"number":23,"lines":[{"text":"Search me, O God, and know my heart;","poem":1},{"text":"test me and know my concerns.","poem":2}]},{"number":24,"lines":[{"text":"See if there is any offensive way in me;","poem":1},{"text":"lead me in the way everlasting.","poem":2}]}]},{"number":140,"lastVerse":13,"verses":[{"number":1,"lines":[{"text":"Rescue me, O LORD, from evil men.","poem":1},{"text":"Protect me from men of violence,","poem":2}]},{"number":2,"lines":[{"text":"who devise evil in their hearts","poem":1},{"text":"and stir up war all day long.","poem":2}]},{"number":3,"lines":[{"text":"They sharpen their tongues like snakes;","poem":1},{"text":"the venom of vipers is on their lips.","poem":2},{"text":"Selah"}]},{"number":4,"lines":[{"text":"Guard me, O LORD,","poem":1},{"text":"from the hands of the wicked.","poem":2},{"text":"Keep me safe from men of violence","poem":1},{"text":"who scheme to make me stumble.","poem":2}]},{"number":5,"lines":[{"text":"The proud hide a snare for me;","poem":1},{"text":"the cords of their net are spread along the path,","poem":2},{"text":"and lures are set out for me.","poem":2},{"text":"Selah"}]},{"number":6,"lines":[{"text":"I say to the LORD, “You are my God.”","poem":1},{"text":"Hear, O LORD, my cry for help.","poem":2}]},{"number":7,"lines":[{"text":"O GOD the Lord, the strength of my salvation,","poem":1},{"text":"You shield my head in the day of battle.","poem":2}]},{"number":8,"lines":[{"text":"Grant not, O LORD, the desires of the wicked;","poem":1},{"text":"do not promote their evil plans,","poem":2},{"text":"lest they be exalted.","poem":2},{"text":"Selah"}]},{"number":9,"lines":[{"text":"May the heads of those who surround me","poem":1},{"text":"be covered in the trouble their lips have caused.","poem":2}]},{"number":10,"lines":[{"text":"May burning coals fall on them;","poem":1},{"text":"may they be thrown into the fire,","poem":2},{"text":"into the miry pits, never to rise again.","poem":2}]},{"number":11,"lines":[{"text":"May no slanderer be established in the land;","poem":1},{"text":"may calamity hunt down the man of violence.","poem":2}]},{"number":12,"lines":[{"text":"I know that the LORD upholds justice for the poor","poem":1},{"text":"and defends the cause of the needy.","poem":2}]},{"number":13,"lines":[{"text":"Surely the righteous will praise Your name;","poem":1},{"text":"the upright will dwell in Your presence.","poem":2}]}]},{"number":141,"lastVerse":10,"verses":[{"number":1,"lines":[{"text":"I call upon You, O LORD; come quickly to me.","poem":1},{"text":"Hear my voice when I call to You.","poem":2}]},{"number":2,"lines":[{"text":"May my prayer be set before You like incense;","poem":1},{"text":"my uplifted hands, like the evening offering.","poem":2}]},{"number":3,"lines":[{"text":"Set a guard, O LORD, over my mouth;","poem":1},{"text":"keep watch at the door of my lips.","poem":2}]},{"number":4,"lines":[{"text":"Do not let my heart be drawn to any evil thing","poem":1},{"text":"or take part in works of wickedness","poem":2},{"text":"with men who do iniquity;","poem":1},{"text":"let me not feast on their delicacies.","poem":2}]},{"number":5,"lines":[{"text":"Let the righteous man strike me;","poem":1},{"text":"let his rebuke be an act of loving devotion.","poem":2},{"text":"It is oil for my head; let me not refuse it.","poem":1},{"text":"For my prayer is ever against the deeds of the wicked.","poem":2}]},{"number":6,"lines":[{"text":"When their rulers are thrown down from the cliffs,","poem":1},{"text":"the people will listen to my words,","poem":2},{"text":"for they are pleasant.","poem":2}]},{"number":7,"lines":[{"text":"As when one plows and breaks up the soil,","poem":1},{"text":"so our bones have been scattered at the mouth of Sheol.","poem":2}]},{"number":8,"lines":[{"text":"But my eyes are fixed on You,","poem":1},{"text":"O GOD the Lord.","poem":2},{"text":"In You I seek refuge;","poem":1},{"text":"do not leave my soul defenseless.","poem":2}]},{"number":9,"lines":[{"text":"Keep me from the snares they have laid for me,","poem":1},{"text":"and from the lures of evildoers.","poem":2}]},{"number":10,"lines":[{"text":"Let the wicked fall into their own nets,","poem":1},{"text":"while I pass by in safety.","poem":2}]}]},{"number":142,"lastVerse":7,"verses":[{"number":1,"lines":[{"text":"I cry aloud to the LORD;","poem":1},{"text":"I lift my voice to the LORD for mercy.","poem":2}]},{"number":2,"lines":[{"text":"I pour out my complaint before Him;","poem":1},{"text":"I reveal my trouble to Him.","poem":2}]},{"number":3,"lines":[{"text":"Although my spirit grows faint within me,","poem":1},{"text":"You know my way.","poem":2},{"text":"Along the path I travel","poem":1},{"text":"they have hidden a snare for me.","poem":2}]},{"number":4,"lines":[{"text":"Look to my right and see;","poem":1},{"text":"no one attends to me.","poem":2},{"text":"There is no refuge for me;","poem":1},{"text":"no one cares for my soul.","poem":2}]},{"number":5,"lines":[{"text":"I cry to You, O LORD: “You are my refuge,","poem":1},{"text":"my portion in the land of the living.”","poem":2}]},{"number":6,"lines":[{"text":"Listen to my cry,","poem":1},{"text":"for I am brought quite low.","poem":2},{"text":"Rescue me from my pursuers,","poem":1},{"text":"for they are too strong for me.","poem":2}]},{"number":7,"lines":[{"text":"Free my soul from prison,","poem":1},{"text":"that I may praise Your name.","poem":2},{"text":"The righteous will gather around me","poem":1},{"text":"because of Your goodness to me.","poem":2}]}]},{"number":143,"lastVerse":12,"verses":[{"number":1,"lines":[{"text":"O LORD, hear my prayer.","poem":1},{"text":"In Your faithfulness, give ear to my plea;","poem":2},{"text":"in Your righteousness, answer me.","poem":2}]},{"number":2,"lines":[{"text":"Do not bring Your servant into judgment,","poem":1},{"text":"for no one alive is righteous before You.","poem":2}]},{"number":3,"lines":[{"text":"For the enemy has pursued my soul,","poem":1},{"text":"crushing my life to the ground,","poem":2},{"text":"making me dwell in darkness","poem":1},{"text":"like those long since dead.","poem":2}]},{"number":4,"lines":[{"text":"My spirit grows faint within me;","poem":1},{"text":"my heart is dismayed inside me.","poem":2}]},{"number":5,"lines":[{"text":"I remember the days of old;","poem":1},{"text":"I meditate on all Your works;","poem":2},{"text":"I consider the work of Your hands.","poem":2}]},{"number":6,"lines":[{"text":"I stretch out my hands to You;","poem":1},{"text":"my soul thirsts for You like a parched land.","poem":2},{"text":"Selah"}]},{"number":7,"lines":[{"text":"Answer me quickly, O LORD;","poem":1},{"text":"my spirit fails.","poem":2},{"text":"Do not hide Your face from me,","poem":1},{"text":"or I will be like those who descend to the Pit.","poem":2}]},{"number":8,"lines":[{"text":"Let me hear Your loving devotion in the morning,","poem":1},{"text":"for I have put my trust in You.","poem":2},{"text":"Teach me the way I should walk,","poem":1},{"text":"for to You I lift up my soul.","poem":2}]},{"number":9,"lines":[{"text":"Deliver me from my enemies, O LORD;","poem":1},{"text":"I flee to You for refuge.","poem":2}]},{"number":10,"lines":[{"text":"Teach me to do Your will,","poem":1},{"text":"for You are my God.","poem":2},{"text":"May Your good Spirit lead me","poem":1},{"text":"on level ground.","poem":2}]},{"number":11,"lines":[{"text":"For the sake of Your name, O LORD,","poem":1},{"text":"revive me.","poem":2},{"text":"In Your righteousness,","poem":1},{"text":"bring my soul out of trouble.","poem":2}]},{"number":12,"lines":[{"text":"And in Your loving devotion,","poem":1},{"text":"cut off my enemies.","poem":2},{"text":"Destroy all who afflict me,","poem":1},{"text":"for I am Your servant.","poem":2}]}]},{"number":144,"lastVerse":15,"verses":[{"number":1,"lines":[{"text":"Blessed be the LORD, my Rock,","poem":1},{"text":"who trains my hands for war,","poem":2},{"text":"my fingers for battle.","poem":2}]},{"number":2,"lines":[{"text":"He is my steadfast love and my fortress,","poem":1},{"text":"my stronghold and my deliverer.","poem":2},{"text":"He is my shield, in whom I take refuge,","poem":1},{"text":"who subdues peoples under me.","poem":2}]},{"number":3,"lines":[{"text":"O LORD, what is man, that You regard him,","poem":1},{"text":"the son of man that You think of him?","poem":2}]},{"number":4,"lines":[{"text":"Man is like a breath;","poem":1},{"text":"his days are like a passing shadow.","poem":2}]},{"number":5,"lines":[{"text":"Part Your heavens, O LORD, and come down;","poem":1},{"text":"touch the mountains, that they may smoke.","poem":2}]},{"number":6,"lines":[{"text":"Flash forth Your lightning and scatter them;","poem":1},{"text":"shoot Your arrows and rout them.","poem":2}]},{"number":7,"lines":[{"text":"Reach down from on high;","poem":1},{"text":"set me free and rescue me","poem":2},{"text":"from the deep waters,","poem":1},{"text":"from the grasp of foreigners,","poem":2}]},{"number":8,"lines":[{"text":"whose mouths speak falsehood,","poem":1},{"text":"whose right hands are deceitful.","poem":2}]},{"number":9,"lines":[{"text":"I will sing to You a new song, O God;","poem":1},{"text":"on a harp of ten strings I will make music to You—","poem":2}]},{"number":10,"lines":[{"text":"to Him who gives victory to kings,","poem":1},{"text":"who frees His servant David from the deadly sword.","poem":2}]},{"number":11,"lines":[{"text":"Set me free and rescue me","poem":1},{"text":"from the grasp of foreigners,","poem":2},{"text":"whose mouths speak falsehood,","poem":1},{"text":"whose right hands are deceitful.","poem":2}]},{"number":12,"lines":[{"text":"Then our sons will be like plants","poem":1},{"text":"nurtured in their youth,","poem":2},{"text":"our daughters like corner pillars","poem":1},{"text":"carved to adorn a palace.","poem":2}]},{"number":13,"lines":[{"text":"Our storehouses will be full,","poem":1},{"text":"supplying all manner of produce;","poem":2},{"text":"our flocks will bring forth thousands,","poem":1},{"text":"tens of thousands in our fields.","poem":2}]},{"number":14,"lines":[{"text":"Our oxen will bear great loads.","poem":1},{"text":"There will be no breach in the walls,","poem":2},{"text":"no going into captivity,","poem":1},{"text":"and no cry of lament in our streets.","poem":2}]},{"number":15,"lines":[{"text":"Blessed are the people of whom this is so;","poem":1},{"text":"blessed are the people whose God is the LORD.","poem":2}]}]},{"number":145,"lastVerse":21,"verses":[{"number":1,"lines":[{"text":"I will exalt You, my God and King;","poem":1},{"text":"I will bless Your name forever and ever.","poem":2}]},{"number":2,"lines":[{"text":"Every day I will bless You,","poem":1},{"text":"and I will praise Your name forever and ever.","poem":2}]},{"number":3,"lines":[{"text":"Great is the LORD and greatly to be praised;","poem":1},{"text":"His greatness is unsearchable.","poem":2}]},{"number":4,"lines":[{"text":"One generation will commend Your works to the next,","poem":1},{"text":"and will proclaim Your mighty acts—","poem":2}]},{"number":5,"lines":[{"text":"the glorious splendor of Your majesty.","poem":1},{"text":"And I will meditate on Your wondrous works.","poem":2}]},{"number":6,"lines":[{"text":"They will proclaim the power of Your awesome deeds,","poem":1},{"text":"and I will declare Your greatness.","poem":2}]},{"number":7,"lines":[{"text":"They will extol the fame of Your abundant goodness","poem":1},{"text":"and sing joyfully of Your righteousness.","poem":2}]},{"number":8,"lines":[{"text":"The LORD is gracious and compassionate,","poem":1},{"text":"slow to anger and abounding in loving devotion.","poem":2}]},{"number":9,"lines":[{"text":"The LORD is good to all;","poem":1},{"text":"His compassion rests on all He has made.","poem":2}]},{"number":10,"lines":[{"text":"All You have made will give You thanks, O LORD,","poem":1},{"text":"and Your saints will bless You.","poem":2}]},{"number":11,"lines":[{"text":"They will tell of the glory of Your kingdom","poem":1},{"text":"and speak of Your might,","poem":2}]},{"number":12,"lines":[{"text":"to make known to men Your mighty acts","poem":1},{"text":"and the glorious splendor of Your kingdom.","poem":2}]},{"number":13,"lines":[{"text":"Your kingdom is an everlasting kingdom,","poem":1},{"text":"and Your dominion endures through all generations.","poem":2},{"text":"The LORD is faithful in all His words","poem":1},{"text":"and kind in all His actions.","poem":2}]},{"number":14,"lines":[{"text":"The LORD upholds all who fall","poem":1},{"text":"and lifts up all who are bowed down.","poem":2}]},{"number":15,"lines":[{"text":"The eyes of all look to You,","poem":1},{"text":"and You give them their food in season.","poem":2}]},{"number":16,"lines":[{"text":"You open Your hand","poem":1},{"text":"and satisfy the desire of every living thing.","poem":2}]},{"number":17,"lines":[{"text":"The LORD is righteous in all His ways","poem":1},{"text":"and kind in all His deeds.","poem":2}]},{"number":18,"lines":[{"text":"The LORD is near to all who call on Him,","poem":1},{"text":"to all who call out to Him in truth.","poem":2}]},{"number":19,"lines":[{"text":"He fulfills the desires of those who fear Him;","poem":1},{"text":"He hears their cry and saves them.","poem":2}]},{"number":20,"lines":[{"text":"The LORD preserves all who love Him,","poem":1},{"text":"but all the wicked He will destroy.","poem":2}]},{"number":21,"lines":[{"text":"My mouth will declare the praise of the LORD;","poem":1},{"text":"let every creature bless His holy name","poem":2},{"text":"forever and ever.","poem":2}]}]},{"number":146,"lastVerse":10,"verses":[{"number":1,"lines":[{"text":"Hallelujah!","poem":1},{"text":"Praise the LORD, O my soul.","poem":1}]},{"number":2,"lines":[{"text":"I will praise the LORD all my life;","poem":1},{"text":"I will sing praises to my God while I have my being.","poem":2}]},{"number":3,"lines":[{"text":"Put not your trust in princes,","poem":1},{"text":"in mortal man, who cannot save.","poem":2}]},{"number":4,"lines":[{"text":"When his spirit departs, he returns to the ground;","poem":1},{"text":"on that very day his plans perish.","poem":2}]},{"number":5,"lines":[{"text":"Blessed is he whose help is the God of Jacob,","poem":1},{"text":"whose hope is in the LORD his God,","poem":2}]},{"number":6,"lines":[{"text":"the Maker of heaven and earth,","poem":1},{"text":"the sea, and everything in them.","poem":2},{"text":"He remains faithful forever.","poem":2}]},{"number":7,"lines":[{"text":"He executes justice for the oppressed","poem":1},{"text":"and gives food to the hungry.","poem":2},{"text":"The LORD sets the prisoners free,","poem":1}]},{"number":8,"lines":[{"text":"the LORD opens the eyes of the blind,","poem":2},{"text":"the LORD lifts those who are weighed down,","poem":1},{"text":"the LORD loves the righteous.","poem":2}]},{"number":9,"lines":[{"text":"The LORD protects foreigners;","poem":1},{"text":"He sustains the fatherless and the widow,","poem":2},{"text":"but the ways of the wicked He frustrates.","poem":2}]},{"number":10,"lines":[{"text":"The LORD reigns forever,","poem":1},{"text":"your God, O Zion, for all generations.","poem":2},{"text":"Hallelujah!","poem":1}]}]},{"number":147,"lastVerse":20,"verses":[{"number":1,"lines":[{"text":"Hallelujah!","poem":1},{"text":"How good it is to sing praises to our God,","poem":1},{"text":"how pleasant and lovely to praise Him!","poem":2}]},{"number":2,"lines":[{"text":"The LORD builds up Jerusalem;","poem":1},{"text":"He gathers the exiles of Israel.","poem":2}]},{"number":3,"lines":[{"text":"He heals the brokenhearted","poem":1},{"text":"and binds up their wounds.","poem":2}]},{"number":4,"lines":[{"text":"He determines the number of the stars;","poem":1},{"text":"He calls them each by name.","poem":2}]},{"number":5,"lines":[{"text":"Great is our Lord, and mighty in power;","poem":1},{"text":"His understanding has no limit.","poem":2}]},{"number":6,"lines":[{"text":"The LORD sustains the humble,","poem":1},{"text":"but casts the wicked to the ground.","poem":2}]},{"number":7,"lines":[{"text":"Sing to the LORD with thanksgiving;","poem":1},{"text":"make music on the harp to our God,","poem":2}]},{"number":8,"lines":[{"text":"who covers the sky with clouds,","poem":1},{"text":"who prepares rain for the earth,","poem":2},{"text":"who makes grass to grow on the hills.","poem":2}]},{"number":9,"lines":[{"text":"He provides food for the animals,","poem":1},{"text":"and for the young ravens when they call.","poem":2}]},{"number":10,"lines":[{"text":"He does not delight in the strength of the horse;","poem":1},{"text":"He takes no pleasure in the legs of a man.","poem":2}]},{"number":11,"lines":[{"text":"The LORD is pleased with those who fear Him,","poem":1},{"text":"who hope in His loving devotion.","poem":2}]},{"number":12,"lines":[{"text":"Exalt the LORD, O Jerusalem;","poem":1},{"text":"praise your God, O Zion!","poem":2}]},{"number":13,"lines":[{"text":"For He strengthens the bars of your gates","poem":1},{"text":"and blesses the children within you.","poem":2}]},{"number":14,"lines":[{"text":"He makes peace at your borders;","poem":1},{"text":"He fills you with the finest wheat.","poem":2}]},{"number":15,"lines":[{"text":"He sends forth His command to the earth;","poem":1},{"text":"His word runs swiftly.","poem":2}]},{"number":16,"lines":[{"text":"He spreads the snow like wool;","poem":1},{"text":"He scatters the frost like ashes;","poem":2}]},{"number":17,"lines":[{"text":"He casts forth His hail like pebbles.","poem":1},{"text":"Who can withstand His icy blast?","poem":2}]},{"number":18,"lines":[{"text":"He sends forth His word and melts them;","poem":1},{"text":"He unleashes His winds, and the waters flow.","poem":2}]},{"number":19,"lines":[{"text":"He declares His word to Jacob,","poem":1},{"text":"His statutes and judgments to Israel.","poem":2}]},{"number":20,"lines":[{"text":"He has done this for no other nation;","poem":1},{"text":"they do not know His judgments.","poem":2},{"text":"Hallelujah!","poem":1}]}]},{"number":148,"lastVerse":14,"verses":[{"number":1,"lines":[{"text":"Hallelujah!","poem":1},{"text":"Praise the LORD from the heavens;","poem":1},{"text":"praise Him in the highest places.","poem":2}]},{"number":2,"lines":[{"text":"Praise Him, all His angels;","poem":1},{"text":"praise Him, all His heavenly hosts.","poem":2}]},{"number":3,"lines":[{"text":"Praise Him, O sun and moon;","poem":1},{"text":"praise Him, all you shining stars.","poem":2}]},{"number":4,"lines":[{"text":"Praise Him, O highest heavens,","poem":1},{"text":"and you waters above the skies.","poem":2}]},{"number":5,"lines":[{"text":"Let them praise the name of the LORD,","poem":1},{"text":"for He gave the command and they were created.","poem":2}]},{"number":6,"lines":[{"text":"He established them forever and ever;","poem":1},{"text":"He issued a decree that will never pass away.","poem":2}]},{"number":7,"lines":[{"text":"Praise the LORD from the earth,","poem":1},{"text":"all great sea creatures and ocean depths,","poem":2}]},{"number":8,"lines":[{"text":"lightning and hail, snow and clouds,","poem":1},{"text":"powerful wind fulfilling His word,","poem":2}]},{"number":9,"lines":[{"text":"mountains and all hills,","poem":1},{"text":"fruit trees and all cedars,","poem":2}]},{"number":10,"lines":[{"text":"wild animals and all cattle,","poem":1},{"text":"crawling creatures and flying birds,","poem":2}]},{"number":11,"lines":[{"text":"kings of the earth and all peoples,","poem":1},{"text":"princes and all rulers of the earth,","poem":2}]},{"number":12,"lines":[{"text":"young men and maidens,","poem":1},{"text":"old and young together.","poem":2}]},{"number":13,"lines":[{"text":"Let them praise the name of the LORD,","poem":1},{"text":"for His name alone is exalted;","poem":2},{"text":"His splendor is above the earth and the heavens.","poem":2}]},{"number":14,"lines":[{"text":"He has raised up a horn for His people,","poem":1},{"text":"the praise of all His saints,","poem":2},{"text":"of Israel, a people near to Him.","poem":2},{"text":"Hallelujah!","poem":1}]}]},{"number":149,"lastVerse":9,"verses":[{"number":1,"lines":[{"text":"Hallelujah!","poem":1},{"text":"Sing to the LORD a new song—","poem":1},{"text":"His praise in the assembly of the godly.","poem":2}]},{"number":2,"lines":[{"text":"Let Israel rejoice in their Maker;","poem":1},{"text":"let the children of Zion rejoice in their King.","poem":2}]},{"number":3,"lines":[{"text":"Let them praise His name with dancing,","poem":1},{"text":"and make music to Him with tambourine and harp.","poem":2}]},{"number":4,"lines":[{"text":"For the LORD takes pleasure in His people;","poem":1},{"text":"He adorns the afflicted with salvation.","poem":2}]},{"number":5,"lines":[{"text":"Let the saints exult in glory;","poem":1},{"text":"let them shout for joy upon their beds.","poem":2}]},{"number":6,"lines":[{"text":"May the high praises of God be in their mouths,","poem":1},{"text":"and a double-edged sword in their hands,","poem":2}]},{"number":7,"lines":[{"text":"to inflict vengeance on the nations","poem":1},{"text":"and punishment on the peoples,","poem":2}]},{"number":8,"lines":[{"text":"to bind their kings with chains","poem":1},{"text":"and their nobles with shackles of iron,","poem":2}]},{"number":9,"lines":[{"text":"to execute the judgment written against them.","poem":1},{"text":"This honor is for all His saints.","poem":2},{"text":"Hallelujah!","poem":1}]}]},{"number":150,"lastVerse":6,"verses":[{"number":1,"lines":[{"text":"Hallelujah!","poem":1},{"text":"Praise God in His sanctuary.","poem":1},{"text":"Praise Him in His mighty heavens.","poem":2}]},{"number":2,"lines":[{"text":"Praise Him for His mighty acts;","poem":1},{"text":"praise Him for His excellent greatness.","poem":2}]},{"number":3,"lines":[{"text":"Praise Him with the sound of the horn;","poem":1},{"text":"praise Him with the harp and lyre.","poem":2}]},{"number":4,"lines":[{"text":"Praise Him with tambourine and dancing;","poem":1},{"text":"praise Him with strings and flute.","poem":2}]},{"number":5,"lines":[{"text":"Praise Him with clashing cymbals;","poem":1},{"text":"praise Him with resounding cymbals.","poem":2}]},{"number":6,"lines":[{"text":"Let everything that has breath praise the LORD!","poem":1},{"text":"Hallelujah!","poem":1}]}]}]}
