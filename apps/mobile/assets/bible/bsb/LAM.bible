{"formatVersion":1,"translationId":"BSB","textDirection":"ltr","bookId":"LAM","bookName":"Lamentations","chapters":[{"number":1,"lastVerse":22,"verses":[{"number":1,"lines":[{"text":"How lonely lies the city,","poem":1},{"text":"once so full of people!","poem":2},{"text":"She who was great among the nations","poem":1},{"text":"has become a widow.","poem":2},{"text":"The princess of the provinces","poem":1},{"text":"has become a slave.","poem":2}]},{"number":2,"lines":[{"text":"She weeps aloud in the night,","poem":1},{"text":"with tears upon her cheeks.","poem":2},{"text":"Among all her lovers","poem":1},{"text":"there is no one to comfort her.","poem":2},{"text":"All her friends have betrayed her;","poem":1},{"text":"they have become her enemies.","poem":2}]},{"number":3,"lines":[{"text":"Judah has gone into exile","poem":1},{"text":"under affliction and harsh slavery;","poem":2},{"text":"she dwells among the nations","poem":1},{"text":"but finds no place to rest.","poem":2},{"text":"All her pursuers have overtaken her","poem":1},{"text":"in the midst of her distress.","poem":2}]},{"number":4,"lines":[{"text":"The roads to Zion mourn,","poem":1},{"text":"because no one comes to her appointed feasts.","poem":2},{"text":"All her gates are deserted;","poem":1},{"text":"her priests groan,","poem":2},{"text":"her maidens grieve,","poem":1},{"text":"and she herself is bitter with anguish.","poem":2}]},{"number":5,"lines":[{"text":"Her foes have become her masters;","poem":1},{"text":"her enemies are at ease.","poem":2},{"text":"For the LORD has brought her grief","poem":1},{"text":"because of her many transgressions.","poem":2},{"text":"Her children have gone away","poem":1},{"text":"as captives before the enemy.","poem":2}]},{"number":6,"lines":[{"text":"All the splendor has departed","poem":1},{"text":"from the Daughter of Zion.","poem":2},{"text":"Her princes are like deer","poem":1},{"text":"that find no pasture;","poem":2},{"text":"they lack the strength to flee","poem":1},{"text":"in the face of the hunter.","poem":2}]},{"number":7,"lines":[{"text":"In the days of her affliction and wandering","poem":1},{"text":"Jerusalem remembers all the treasures","poem":2},{"text":"that were hers in days of old.","poem":2},{"text":"When her people fell into enemy hands","poem":1},{"text":"she received no help.","poem":2},{"text":"Her enemies looked upon her,","poem":1},{"text":"laughing at her downfall.","poem":2}]},{"number":8,"lines":[{"text":"Jerusalem has sinned greatly;","poem":1},{"text":"therefore she has become an object of scorn.","poem":2},{"text":"All who honored her now despise her,","poem":1},{"text":"for they have seen her nakedness;","poem":2},{"text":"she herself groans and turns away.","poem":2}]},{"number":9,"lines":[{"text":"Her uncleanness stains her skirts;","poem":1},{"text":"she did not consider her end.","poem":2},{"text":"Her downfall was astounding;","poem":1},{"text":"there was no one to comfort her.","poem":2},{"text":"Look, O LORD, on my affliction,","poem":1},{"text":"for the enemy has triumphed!","poem":2}]},{"number":10,"lines":[{"text":"The adversary has seized","poem":1},{"text":"all her treasures.","poem":2},{"text":"For she has seen the nations","poem":1},{"text":"enter her sanctuary—","poem":2},{"text":"those You had forbidden","poem":1},{"text":"to enter Your assembly.","poem":2}]},{"number":11,"lines":[{"text":"All her people groan","poem":1},{"text":"as they search for bread.","poem":2},{"text":"They have traded their treasures for food","poem":1},{"text":"to keep themselves alive.","poem":2},{"text":"Look, O LORD, and consider,","poem":1},{"text":"for I have become despised.","poem":2}]},{"number":12,"lines":[{"text":"Is this nothing to you, all you who pass by?","poem":1},{"text":"Look around and see!","poem":2},{"text":"Is there any sorrow like mine,","poem":1},{"text":"which was inflicted on me,","poem":2},{"text":"which the LORD made me suffer","poem":1},{"text":"on the day of His fierce anger?","poem":2}]},{"number":13,"lines":[{"text":"He sent fire from on high,","poem":1},{"text":"and it overpowered my bones.","poem":2},{"text":"He spread a net for my feet","poem":1},{"text":"and turned me back.","poem":2},{"text":"He made me desolate,","poem":1},{"text":"faint all the day long.","poem":2}]},{"number":14,"lines":[{"text":"My transgressions are bound into a yoke,","poem":1},{"text":"knit together by His hand;","poem":2},{"text":"they are draped over my neck,","poem":1},{"text":"and the Lord has broken my strength.","poem":2},{"text":"He has delivered me into the hands","poem":1},{"text":"of those I cannot withstand.","poem":2}]},{"number":15,"lines":[{"text":"The Lord has rejected","poem":1},{"text":"all the mighty men in my midst;","poem":2},{"text":"He has summoned an army against me","poem":1},{"text":"to crush my young warriors.","poem":2},{"text":"Like grapes in a winepress,","poem":1},{"text":"the Lord has trampled the Virgin Daughter of Judah.","poem":2}]},{"number":16,"lines":[{"text":"For these things I weep;","poem":1},{"text":"my eyes flow with tears.","poem":2},{"text":"For there is no one nearby to comfort me,","poem":1},{"text":"no one to revive my soul.","poem":2},{"text":"My children are destitute","poem":1},{"text":"because the enemy has prevailed.","poem":2}]},{"number":17,"lines":[{"text":"Zion stretches out her hands,","poem":1},{"text":"but there is no one to comfort her.","poem":2},{"text":"The LORD has decreed against Jacob","poem":1},{"text":"that his neighbors become his foes.","poem":2},{"text":"Jerusalem has become","poem":1},{"text":"an unclean thing among them.","poem":2}]},{"number":18,"lines":[{"text":"The LORD is righteous,","poem":1},{"text":"yet I rebelled against His command.","poem":2},{"text":"Listen, all you people;","poem":1},{"text":"look upon my suffering.","poem":2},{"text":"My young men and maidens","poem":1},{"text":"have gone into captivity.","poem":2}]},{"number":19,"lines":[{"text":"I called out to my lovers,","poem":1},{"text":"but they have betrayed me.","poem":2},{"text":"My priests and elders","poem":1},{"text":"perished in the city","poem":2},{"text":"while they searched for food","poem":1},{"text":"to keep themselves alive.","poem":2}]},{"number":20,"lines":[{"text":"See, O LORD, how distressed I am!","poem":1},{"text":"I am churning within;","poem":2},{"text":"my heart is pounding within me,","poem":1},{"text":"for I have been most rebellious.","poem":2},{"text":"Outside, the sword bereaves;","poem":1},{"text":"inside, there is death.","poem":2}]},{"number":21,"lines":[{"text":"People have heard my groaning,","poem":1},{"text":"but there is no one to comfort me.","poem":2},{"text":"All my enemies have heard of my trouble;","poem":1},{"text":"they are glad that You have caused it.","poem":2},{"text":"May You bring the day You have announced,","poem":1},{"text":"so that they may become like me.","poem":2}]},{"number":22,"lines":[{"text":"Let all their wickedness come before You,","poem":1},{"text":"and deal with them","poem":2},{"text":"as You have dealt with me","poem":1},{"text":"because of all my transgressions.","poem":2},{"text":"For my groans are many,","poem":1},{"text":"and my heart is faint.","poem":2}]}]},{"number":2,"lastVerse":22,"verses":[{"number":1,"lines":[{"text":"How the Lord has covered the Daughter of Zion","poem":1},{"text":"with the cloud of His anger!","poem":2},{"text":"He has cast the glory of Israel","poem":1},{"text":"from heaven to earth.","poem":2},{"text":"He has abandoned His footstool","poem":1},{"text":"in the day of His anger.","poem":2}]},{"number":2,"lines":[{"text":"Without pity the Lord has swallowed up","poem":1},{"text":"all the dwellings of Jacob.","poem":2},{"text":"In His wrath He has demolished","poem":1},{"text":"the fortified cities of the Daughter of Judah.","poem":2},{"text":"He brought to the ground and defiled","poem":1},{"text":"her kingdom and its princes.","poem":2}]},{"number":3,"lines":[{"text":"In fierce anger He has cut off","poem":1},{"text":"every horn of Israel","poem":2},{"text":"and withdrawn His right hand","poem":1},{"text":"at the approach of the enemy.","poem":2},{"text":"He has burned in Jacob like a flaming fire","poem":1},{"text":"that consumes everything around it.","poem":2}]},{"number":4,"lines":[{"text":"He has bent His bow like an enemy;","poem":1},{"text":"His right hand is positioned.","poem":2},{"text":"Like a foe He has killed","poem":1},{"text":"all who were pleasing to the eye;","poem":2},{"text":"He has poured out His wrath like fire","poem":1},{"text":"on the tent of the Daughter of Zion.","poem":2}]},{"number":5,"lines":[{"text":"The Lord is like an enemy;","poem":1},{"text":"He has swallowed up Israel.","poem":2},{"text":"He has swallowed up all her palaces","poem":1},{"text":"and destroyed her strongholds.","poem":2},{"text":"He has multiplied mourning and lamentation","poem":1},{"text":"for the Daughter of Judah.","poem":2}]},{"number":6,"lines":[{"text":"He has laid waste His tabernacle like a garden booth;","poem":1},{"text":"He has destroyed His place of meeting.","poem":2},{"text":"The LORD has made Zion forget","poem":1},{"text":"her appointed feasts and Sabbaths.","poem":2},{"text":"In His fierce anger","poem":1},{"text":"He has despised both king and priest.","poem":2}]},{"number":7,"lines":[{"text":"The Lord has rejected His altar;","poem":1},{"text":"He has abandoned His sanctuary;","poem":2},{"text":"He has delivered the walls of her palaces","poem":1},{"text":"into the hand of the enemy.","poem":2},{"text":"They have raised a shout in the house of the LORD","poem":1},{"text":"as on the day of an appointed feast.","poem":2}]},{"number":8,"lines":[{"text":"The LORD determined to destroy","poem":1},{"text":"the wall of the Daughter of Zion.","poem":2},{"text":"He stretched out a measuring line","poem":1},{"text":"and did not withdraw His hand from destroying.","poem":2},{"text":"He made the ramparts and walls lament;","poem":1},{"text":"together they waste away.","poem":2}]},{"number":9,"lines":[{"text":"Her gates have sunk into the ground;","poem":1},{"text":"He has destroyed and shattered their bars.","poem":2},{"text":"Her king and her princes are exiled among the nations,","poem":1},{"text":"the law is no more,","poem":2},{"text":"and even her prophets","poem":1},{"text":"find no vision from the LORD.","poem":2}]},{"number":10,"lines":[{"text":"The elders of the Daughter of Zion","poem":1},{"text":"sit on the ground in silence.","poem":2},{"text":"They have thrown dust on their heads","poem":1},{"text":"and put on sackcloth.","poem":2},{"text":"The young women of Jerusalem","poem":1},{"text":"have bowed their heads to the ground.","poem":2}]},{"number":11,"lines":[{"text":"My eyes fail from weeping;","poem":1},{"text":"I am churning within.","poem":2},{"text":"My heart is poured out in grief","poem":1},{"text":"over the destruction of the daughter of my people,","poem":2},{"text":"because children and infants faint","poem":1},{"text":"in the streets of the city.","poem":2}]},{"number":12,"lines":[{"text":"They cry out to their mothers:","poem":1},{"text":"“Where is the grain and wine?”","poem":2},{"text":"as they faint like the wounded","poem":1},{"text":"in the streets of the city,","poem":2},{"text":"as their lives fade away","poem":1},{"text":"in the arms of their mothers.","poem":2}]},{"number":13,"lines":[{"text":"What can I say for you?","poem":1},{"text":"To what can I compare you,","poem":2},{"text":"O Daughter of Jerusalem?","poem":2},{"text":"To what can I liken you,","poem":1},{"text":"that I may console you,","poem":2},{"text":"O Virgin Daughter of Zion?","poem":2},{"text":"For your wound is as deep as the sea.","poem":1},{"text":"Who can ever heal you?","poem":2}]},{"number":14,"lines":[{"text":"The visions of your prophets","poem":1},{"text":"were empty and deceptive;","poem":2},{"text":"they did not expose your guilt","poem":1},{"text":"to ward off your captivity.","poem":2},{"text":"The burdens they envisioned for you","poem":1},{"text":"were empty and misleading.","poem":2}]},{"number":15,"lines":[{"text":"All who pass by","poem":1},{"text":"clap their hands at you in scorn.","poem":2},{"text":"They hiss and shake their heads","poem":1},{"text":"at the Daughter of Jerusalem:","poem":2},{"text":"“Is this the city that was called","poem":1},{"text":"the perfection of beauty,","poem":2},{"text":"the joy of all the earth?”","poem":2}]},{"number":16,"lines":[{"text":"All your enemies","poem":1},{"text":"open their mouths against you.","poem":2},{"text":"They hiss and gnash their teeth,","poem":1},{"text":"saying, “We have swallowed her up.","poem":2},{"text":"This is the day for which we have waited.","poem":1},{"text":"We have lived to see it!”","poem":2}]},{"number":17,"lines":[{"text":"The LORD has done what He planned;","poem":1},{"text":"He has accomplished His decree,","poem":2},{"text":"which He ordained in days of old;","poem":1},{"text":"He has overthrown you without pity.","poem":2},{"text":"He has let the enemy gloat over you","poem":1},{"text":"and exalted the horn of your foes.","poem":2}]},{"number":18,"lines":[{"text":"The hearts of the people","poem":1},{"text":"cry out to the Lord.","poem":2},{"text":"O wall of the Daughter of Zion,","poem":1},{"text":"let your tears run down like a river","poem":2},{"text":"day and night.","poem":2},{"text":"Give yourself no relief,","poem":1},{"text":"and your eyes no rest.","poem":2}]},{"number":19,"lines":[{"text":"Arise, cry out in the night","poem":1},{"text":"from the first watch of the night.","poem":2},{"text":"Pour out your heart like water","poem":1},{"text":"in the presence of the Lord.","poem":2},{"text":"Lift up your hands to Him","poem":1},{"text":"for the lives of your children","poem":2},{"text":"who are fainting from hunger","poem":1},{"text":"on the corner of every street.","poem":2}]},{"number":20,"lines":[{"text":"Look, O LORD, and consider:","poem":1},{"text":"Whom have You ever treated like this?","poem":2},{"text":"Should women eat their offspring,","poem":1},{"text":"the infants they have nurtured?","poem":2},{"text":"Should priests and prophets be killed","poem":1},{"text":"in the sanctuary of the Lord?","poem":2}]},{"number":21,"lines":[{"text":"Both young and old lie together","poem":1},{"text":"in the dust of the streets.","poem":2},{"text":"My young men and maidens","poem":1},{"text":"have fallen by the sword.","poem":2},{"text":"You have slain them in the day of Your anger;","poem":1},{"text":"You have slaughtered them without compassion.","poem":2}]},{"number":22,"lines":[{"text":"You summoned my terrors on every side,","poem":1},{"text":"as for the day of an appointed feast.","poem":2},{"text":"In the day of the LORD’s anger","poem":1},{"text":"no one escaped or survived;","poem":2},{"text":"my enemy has destroyed","poem":1},{"text":"those I nurtured and reared.","poem":2}]}]},{"number":3,"lastVerse":66,"verses":[{"number":1,"lines":[{"text":"I am the man who has seen affliction","poem":1},{"text":"under the rod of God’s wrath.","poem":2}]},{"number":2,"lines":[{"text":"He has driven me away and made me walk","poem":1},{"text":"in darkness instead of light.","poem":2}]},{"number":3,"lines":[{"text":"Indeed, He keeps turning His hand","poem":1},{"text":"against me all day long.","poem":2}]},{"number":4,"lines":[{"text":"He has worn away my flesh and skin;","poem":1},{"text":"He has shattered my bones.","poem":2}]},{"number":5,"lines":[{"text":"He has besieged me and surrounded me","poem":1},{"text":"with bitterness and hardship.","poem":2}]},{"number":6,"lines":[{"text":"He has made me dwell in darkness","poem":1},{"text":"like those dead for ages.","poem":2}]},{"number":7,"lines":[{"text":"He has walled me in so I cannot escape;","poem":1},{"text":"He has weighed me down with chains.","poem":2}]},{"number":8,"lines":[{"text":"Even when I cry out and plead for help,","poem":1},{"text":"He shuts out my prayer.","poem":2}]},{"number":9,"lines":[{"text":"He has barred my ways with cut stones;","poem":1},{"text":"He has made my paths crooked.","poem":2}]},{"number":10,"lines":[{"text":"He is a bear lying in wait,","poem":1},{"text":"a lion hiding in ambush.","poem":2}]},{"number":11,"lines":[{"text":"He forced me off my path and tore me to pieces;","poem":1},{"text":"He left me without help.","poem":2}]},{"number":12,"lines":[{"text":"He bent His bow","poem":1},{"text":"and set me as the target for His arrow.","poem":2}]},{"number":13,"lines":[{"text":"He pierced my kidneys","poem":1},{"text":"with His arrows.","poem":2}]},{"number":14,"lines":[{"text":"I am a laughingstock to all my people;","poem":1},{"text":"they mock me in song all day long.","poem":2}]},{"number":15,"lines":[{"text":"He has filled me with bitterness;","poem":1},{"text":"He has intoxicated me with wormwood.","poem":2}]},{"number":16,"lines":[{"text":"He has ground my teeth with gravel","poem":1},{"text":"and trampled me in the dust.","poem":2}]},{"number":17,"lines":[{"text":"My soul has been deprived of peace;","poem":1},{"text":"I have forgotten what prosperity is.","poem":2}]},{"number":18,"lines":[{"text":"So I say, “My strength has perished,","poem":1},{"text":"along with my hope from the LORD.”","poem":2}]},{"number":19,"lines":[{"text":"Remember my affliction and wandering,","poem":1},{"text":"the wormwood and the gall.","poem":2}]},{"number":20,"lines":[{"text":"Surely my soul remembers","poem":1},{"text":"and is humbled within me.","poem":2}]},{"number":21,"lines":[{"text":"Yet I call this to mind,","poem":1},{"text":"and therefore I have hope:","poem":2}]},{"number":22,"lines":[{"text":"Because of the loving devotion of the LORD we are not consumed,","poem":1},{"text":"for His mercies never fail.","poem":2}]},{"number":23,"lines":[{"text":"They are new every morning;","poem":1},{"text":"great is Your faithfulness!","poem":2}]},{"number":24,"lines":[{"text":"“The LORD is my portion,” says my soul,","poem":1},{"text":"“therefore I will hope in Him.”","poem":2}]},{"number":25,"lines":[{"text":"The LORD is good to those who wait for Him,","poem":1},{"text":"to the soul who seeks Him.","poem":2}]},{"number":26,"lines":[{"text":"It is good to wait quietly","poem":1},{"text":"for the salvation of the LORD.","poem":2}]},{"number":27,"lines":[{"text":"It is good for a man to bear the yoke","poem":1},{"text":"while he is still young.","poem":2}]},{"number":28,"lines":[{"text":"Let him sit alone in silence,","poem":1},{"text":"for the LORD has laid it upon him.","poem":2}]},{"number":29,"lines":[{"text":"Let him bury his face in the dust—","poem":1},{"text":"perhaps there is still hope.","poem":2}]},{"number":30,"lines":[{"text":"Let him offer his cheek to the one who would strike him;","poem":1},{"text":"let him be filled with reproach.","poem":2}]},{"number":31,"lines":[{"text":"For the Lord will not","poem":1},{"text":"cast us off forever.","poem":2}]},{"number":32,"lines":[{"text":"Even if He causes grief, He will show compassion","poem":1},{"text":"according to His abundant loving devotion.","poem":2}]},{"number":33,"lines":[{"text":"For He does not willingly afflict","poem":1},{"text":"or grieve the sons of men.","poem":2}]},{"number":34,"lines":[{"text":"To crush underfoot","poem":1},{"text":"all the prisoners of the land,","poem":2}]},{"number":35,"lines":[{"text":"to deny a man justice","poem":1},{"text":"before the Most High,","poem":2}]},{"number":36,"lines":[{"text":"to subvert a man in his lawsuit—","poem":1},{"text":"of these the Lord does not approve.","poem":2}]},{"number":37,"lines":[{"text":"Who has spoken and it came to pass,","poem":1},{"text":"unless the Lord has ordained it?","poem":2}]},{"number":38,"lines":[{"text":"Do not both adversity and good","poem":1},{"text":"come from the mouth of the Most High?","poem":2}]},{"number":39,"lines":[{"text":"Why should any mortal man complain,","poem":1},{"text":"in view of his sins?","poem":2}]},{"number":40,"lines":[{"text":"Let us examine and test our ways,","poem":1},{"text":"and turn back to the LORD.","poem":2}]},{"number":41,"lines":[{"text":"Let us lift up our hearts and hands","poem":1},{"text":"to God in heaven:","poem":2}]},{"number":42,"lines":[{"text":"“We have sinned and rebelled;","poem":1},{"text":"You have not forgiven.”","poem":2}]},{"number":43,"lines":[{"text":"You have covered Yourself in anger and pursued us;","poem":1},{"text":"You have killed without pity.","poem":2}]},{"number":44,"lines":[{"text":"You have covered Yourself with a cloud","poem":1},{"text":"that no prayer can pass through.","poem":2}]},{"number":45,"lines":[{"text":"You have made us scum and refuse","poem":1},{"text":"among the nations.","poem":2}]},{"number":46,"lines":[{"text":"All our enemies","poem":1},{"text":"open their mouths against us.","poem":2}]},{"number":47,"lines":[{"text":"Panic and pitfall have come upon us—","poem":1},{"text":"devastation and destruction.","poem":2}]},{"number":48,"lines":[{"text":"Streams of tears flow from my eyes","poem":1},{"text":"over the destruction of the daughter of my people.","poem":2}]},{"number":49,"lines":[{"text":"My eyes overflow unceasingly,","poem":1},{"text":"without relief,","poem":2}]},{"number":50,"lines":[{"text":"until the LORD","poem":1},{"text":"looks down from heaven and sees.","poem":2}]},{"number":51,"lines":[{"text":"My eyes bring grief to my soul","poem":1},{"text":"because of all the daughters of my city.","poem":2}]},{"number":52,"lines":[{"text":"Without cause my enemies","poem":1},{"text":"hunted me like a bird.","poem":2}]},{"number":53,"lines":[{"text":"They dropped me alive into a pit","poem":1},{"text":"and cast stones upon me.","poem":2}]},{"number":54,"lines":[{"text":"The waters flowed over my head,","poem":1},{"text":"and I thought I was going to die.","poem":2}]},{"number":55,"lines":[{"text":"I called on Your name, O LORD,","poem":1},{"text":"out of the depths of the Pit.","poem":2}]},{"number":56,"lines":[{"text":"You heard my plea:","poem":1},{"text":"“Do not ignore my cry for relief.”","poem":2}]},{"number":57,"lines":[{"text":"You drew near when I called on You;","poem":1},{"text":"You said, “Do not be afraid.”","poem":2}]},{"number":58,"lines":[{"text":"You defend my cause, O Lord;","poem":1},{"text":"You redeem my life.","poem":2}]},{"number":59,"lines":[{"text":"You have seen, O LORD, the wrong done to me;","poem":1},{"text":"vindicate my cause!","poem":2}]},{"number":60,"lines":[{"text":"You have seen all their malice,","poem":1},{"text":"all their plots against me.","poem":2}]},{"number":61,"lines":[{"text":"O LORD, You have heard their insults,","poem":1},{"text":"all their plots against me—","poem":2}]},{"number":62,"lines":[{"text":"the slander and murmuring of my assailants","poem":1},{"text":"against me all day long.","poem":2}]},{"number":63,"lines":[{"text":"When they sit and when they rise,","poem":1},{"text":"see how they mock me in song.","poem":2}]},{"number":64,"lines":[{"text":"You will pay them back what they deserve, O LORD,","poem":1},{"text":"according to the work of their hands.","poem":2}]},{"number":65,"lines":[{"text":"Put a veil of anguish over their hearts;","poem":1},{"text":"may Your curse be upon them!","poem":2}]},{"number":66,"lines":[{"text":"You will pursue them in anger and exterminate them","poem":1},{"text":"from under Your heavens, O LORD.","poem":2}]}]},{"number":4,"lastVerse":22,"verses":[{"number":1,"lines":[{"text":"How the gold has become tarnished,","poem":1},{"text":"the pure gold has become dull!","poem":2},{"text":"The gems of the temple lie scattered","poem":1},{"text":"on every street corner.","poem":2}]},{"number":2,"lines":[{"text":"How the precious sons of Zion,","poem":1},{"text":"once worth their weight in pure gold,","poem":2},{"text":"are now esteemed as jars of clay,","poem":1},{"text":"the work of a potter’s hands!","poem":2}]},{"number":3,"lines":[{"text":"Even jackals offer their breasts","poem":1},{"text":"to nurse their young,","poem":2},{"text":"but the daughter of my people has become cruel,","poem":1},{"text":"like an ostrich in the wilderness.","poem":2}]},{"number":4,"lines":[{"text":"The nursing infant’s tongue","poem":1},{"text":"clings in thirst to the roof of his mouth.","poem":2},{"text":"Little children beg for bread,","poem":1},{"text":"but no one gives them any.","poem":2}]},{"number":5,"lines":[{"text":"Those who once ate delicacies","poem":1},{"text":"are destitute in the streets;","poem":2},{"text":"those brought up in crimson","poem":1},{"text":"huddle in ash heaps.","poem":2}]},{"number":6,"lines":[{"text":"The punishment of the daughter of my people","poem":1},{"text":"is greater than that of Sodom,","poem":2},{"text":"which was overthrown in an instant","poem":1},{"text":"without a hand turned to help her.","poem":2}]},{"number":7,"lines":[{"text":"Her dignitaries were brighter than snow,","poem":1},{"text":"whiter than milk;","poem":2},{"text":"their bodies were more ruddy than rubies,","poem":1},{"text":"their appearance like sapphires.","poem":2}]},{"number":8,"lines":[{"text":"But now their appearance is blacker than soot;","poem":1},{"text":"they are not recognized in the streets.","poem":2},{"text":"Their skin has shriveled on their bones;","poem":1},{"text":"it has become as dry as a stick.","poem":2}]},{"number":9,"lines":[{"text":"Those slain by the sword are better off","poem":1},{"text":"than those who die of hunger,","poem":2},{"text":"who waste away, pierced with pain","poem":1},{"text":"because the fields lack produce.","poem":2}]},{"number":10,"lines":[{"text":"The hands of compassionate women","poem":1},{"text":"have cooked their own children,","poem":2},{"text":"who became their food","poem":1},{"text":"in the destruction of the daughter of my people.","poem":2}]},{"number":11,"lines":[{"text":"The LORD has exhausted His wrath;","poem":1},{"text":"He has poured out His fierce anger;","poem":2},{"text":"He has kindled a fire in Zion,","poem":1},{"text":"and it has consumed her foundations.","poem":2}]},{"number":12,"lines":[{"text":"The kings of the earth did not believe,","poem":1},{"text":"nor any people of the world,","poem":2},{"text":"that an enemy or a foe","poem":1},{"text":"could enter the gates of Jerusalem.","poem":2}]},{"number":13,"lines":[{"text":"But this was for the sins of her prophets","poem":1},{"text":"and the guilt of her priests,","poem":2},{"text":"who shed the blood of the righteous","poem":1},{"text":"in her midst.","poem":2}]},{"number":14,"lines":[{"text":"They wandered blind in the streets,","poem":1},{"text":"defiled by this blood,","poem":2},{"text":"so that no one dared","poem":1},{"text":"to touch their garments.","poem":2}]},{"number":15,"lines":[{"text":"“Go away! Unclean!”","poem":1},{"text":"men shouted at them.","poem":2},{"text":"“Away, away! Do not touch us!”","poem":1},{"text":"So they fled and wandered.","poem":2},{"text":"Among the nations it was said,","poem":1},{"text":"“They can stay here no longer.”","poem":2}]},{"number":16,"lines":[{"text":"The presence of the LORD has scattered them;","poem":1},{"text":"He regards them no more.","poem":2},{"text":"The priests are shown no honor;","poem":1},{"text":"the elders find no favor.","poem":2}]},{"number":17,"lines":[{"text":"All the while our eyes were failing","poem":1},{"text":"as we looked in vain for help.","poem":2},{"text":"We watched from our towers","poem":1},{"text":"for a nation that could not save us.","poem":2}]},{"number":18,"lines":[{"text":"They stalked our every step,","poem":1},{"text":"so that we could not walk in our streets.","poem":2},{"text":"Our end drew near, our time ran out,","poem":1},{"text":"for our end had come!","poem":2}]},{"number":19,"lines":[{"text":"Those who chased us were swifter","poem":1},{"text":"than the eagles in the sky;","poem":2},{"text":"they pursued us over the mountains","poem":1},{"text":"and ambushed us in the wilderness.","poem":2}]},{"number":20,"lines":[{"text":"The LORD’s anointed, the breath of our life,","poem":1},{"text":"was captured in their pits.","poem":2},{"text":"We had said of him,","poem":1},{"text":"“Under his shadow we will live among the nations.”","poem":2}]},{"number":21,"lines":[{"text":"So rejoice and be glad, O Daughter of Edom,","poem":1},{"text":"you who dwell in the land of Uz.","poem":2},{"text":"Yet the cup will pass to you as well;","poem":1},{"text":"you will get drunk and expose yourself.","poem":2}]},{"number":22,"lines":[{"text":"O Daughter of Zion, your punishment is complete;","poem":1},{"text":"He will not prolong your exile.","poem":2},{"text":"But He will punish your iniquity, O Daughter of Edom;","poem":1},{"text":"He will expose your sins.","poem":2}]}]},{"number":5,"lastVerse":22,"verses":[{"number":1,"lines":[{"text":"Remember, O LORD, what has happened to us.","poem":1},{"text":"Look and see our disgrace!","poem":2}]},{"number":2,"lines":[{"text":"Our inheritance has been turned over to strangers,","poem":1},{"text":"our houses to foreigners.","poem":2}]},{"number":3,"lines":[{"text":"We have become fatherless orphans;","poem":1},{"text":"our mothers are widows.","poem":2}]},{"number":4,"lines":[{"text":"We must buy the water we drink;","poem":1},{"text":"our wood comes at a price.","poem":2}]},{"number":5,"lines":[{"text":"We are closely pursued;","poem":1},{"text":"we are weary and find no rest.","poem":2}]},{"number":6,"lines":[{"text":"We submitted to Egypt and Assyria","poem":1},{"text":"to get enough bread.","poem":2}]},{"number":7,"lines":[{"text":"Our fathers sinned and are no more,","poem":1},{"text":"but we bear their punishment.","poem":2}]},{"number":8,"lines":[{"text":"Slaves rule over us;","poem":1},{"text":"there is no one to deliver us from their hands.","poem":2}]},{"number":9,"lines":[{"text":"We get our bread at the risk of our lives","poem":1},{"text":"because of the sword in the wilderness.","poem":2}]},{"number":10,"lines":[{"text":"Our skin is as hot as an oven","poem":1},{"text":"with fever from our hunger.","poem":2}]},{"number":11,"lines":[{"text":"Women have been ravished in Zion,","poem":1},{"text":"virgins in the cities of Judah.","poem":2}]},{"number":12,"lines":[{"text":"Princes have been hung up by their hands;","poem":1},{"text":"elders receive no respect.","poem":2}]},{"number":13,"lines":[{"text":"Young men toil at millstones;","poem":1},{"text":"boys stagger under loads of wood.","poem":2}]},{"number":14,"lines":[{"text":"The elders have left the city gate;","poem":1},{"text":"the young men have stopped their music.","poem":2}]},{"number":15,"lines":[{"text":"Joy has left our hearts;","poem":1},{"text":"our dancing has turned to mourning.","poem":2}]},{"number":16,"lines":[{"text":"The crown has fallen from our head.","poem":1},{"text":"Woe to us, for we have sinned!","poem":2}]},{"number":17,"lines":[{"text":"Because of this, our hearts are faint;","poem":1},{"text":"because of these, our eyes grow dim—","poem":2}]},{"number":18,"lines":[{"text":"because of Mount Zion, which lies desolate,","poem":1},{"text":"patrolled by foxes.","poem":2}]},{"number":19,"lines":[{"text":"You, O LORD, reign forever;","poem":1},{"text":"Your throne endures from generation to generation.","poem":2}]},{"number":20,"lines":[{"text":"Why have You forgotten us forever?","poem":1},{"text":"Why have You forsaken us for so long?","poem":2}]},{"number":21,"lines":[{"text":"Restore us to Yourself, O LORD, so we may return;","poem":1},{"text":"renew our days as of old,","poem":2}]},{"number":22,"lines":[{"text":"unless You have utterly rejected us","poem":1},{"text":"and remain angry with us beyond measure.","poem":2}]}]}]}
