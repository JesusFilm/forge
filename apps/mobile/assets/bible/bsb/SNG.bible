{"formatVersion":1,"translationId":"BSB","textDirection":"ltr","bookId":"SNG","bookName":"Song of Solomon","chapters":[{"number":1,"lastVerse":17,"verses":[{"number":1,"lines":[{"text":"This is Solomon’s Song of Songs."}]},{"number":2,"lines":[{"text":"Let him kiss me with the kisses of his mouth!","poem":1},{"text":"For your love is more delightful than wine.","poem":2}]},{"number":3,"lines":[{"text":"The fragrance of your perfume is pleasing;","poem":1},{"text":"your name is like perfume poured out.","poem":2},{"text":"No wonder the maidens adore you.","poem":2}]},{"number":4,"lines":[{"text":"Take me away with you—let us hurry!","poem":1},{"text":"May the king bring me to his chambers.","poem":2},{"text":"The Friends"},{"text":"We will rejoice and delight in you;","poem":1},{"text":"we will praise your love more than wine.","poem":2},{"text":"The Bride"},{"text":"It is only right that they adore you.","poem":1}]},{"number":5,"lines":[{"text":"I am dark, yet lovely, O daughters of Jerusalem,","poem":1},{"text":"like the tents of Kedar, like the curtains of Solomon.","poem":2}]},{"number":6,"lines":[{"text":"Do not stare because I am dark,","poem":1},{"text":"for the sun has gazed upon me.","poem":2},{"text":"My mother’s sons were angry with me;","poem":1},{"text":"they made me a keeper of the vineyards,","poem":2},{"text":"but my own vineyard I have neglected.","poem":2}]},{"number":7,"lines":[{"text":"Tell me, O one I love,","poem":1},{"text":"where do you pasture your sheep?","poem":2},{"text":"Where do you rest them at midday?","poem":2},{"text":"Why should I be like a veiled woman","poem":1},{"text":"beside the flocks of your companions?","poem":2}]},{"number":8,"lines":[{"text":"If you do not know, O fairest of women,","poem":1},{"text":"follow the tracks of the flock,","poem":2},{"text":"and graze your young goats","poem":1},{"text":"near the tents of the shepherds.","poem":2}]},{"number":9,"lines":[{"text":"I compare you, my darling,","poem":1},{"text":"to a mare among Pharaoh’s chariots.","poem":2}]},{"number":10,"lines":[{"text":"Your cheeks are beautiful with ornaments,","poem":1},{"text":"your neck with strings of jewels.","poem":2}]},{"number":11,"lines":[{"text":"We will make you ornaments of gold,","poem":1},{"text":"studded with beads of silver.","poem":2}]},{"number":12,"lines":[{"text":"While the king was at his table,","poem":1},{"text":"my perfume spread its fragrance.","poem":2}]},{"number":13,"lines":[{"text":"My beloved is to me a sachet of myrrh","poem":1},{"text":"resting between my breasts.","poem":2}]},{"number":14,"lines":[{"text":"My beloved is to me a cluster of henna blossoms","poem":1},{"text":"in the vineyards of En-gedi.","poem":2}]},{"number":15,"lines":[{"text":"How beautiful you are, my darling!","poem":1},{"text":"Oh, how very beautiful!","poem":2},{"text":"Your eyes are like doves.","poem":2}]},{"number":16,"lines":[{"text":"How handsome you are, my beloved!","poem":1},{"text":"Oh, how delightful!","poem":2},{"text":"The soft grass is our bed.","poem":2}]},{"number":17,"lines":[{"text":"The beams of our house are cedars;","poem":1},{"text":"our rafters are fragrant firs.","poem":2}]}]},{"number":2,"lastVerse":17,"verses":[{"number":1,"lines":[{"text":"I am a rose of Sharon,","poem":1},{"text":"a lily of the valley.","poem":2}]},{"number":2,"lines":[{"text":"Like a lily among the thorns","poem":1},{"text":"is my darling among the maidens.","poem":2}]},{"number":3,"lines":[{"text":"Like an apple tree among the trees of the forest","poem":1},{"text":"is my beloved among the young men.","poem":2},{"text":"I delight to sit in his shade,","poem":1},{"text":"and his fruit is sweet to my taste.","poem":2}]},{"number":4,"lines":[{"text":"He has brought me to the house of wine,","poem":1},{"text":"and his banner over me is love.","poem":2}]},{"number":5,"lines":[{"text":"Sustain me with raisins;","poem":1},{"text":"refresh me with apples,","poem":2},{"text":"for I am faint with love.","poem":2}]},{"number":6,"lines":[{"text":"His left hand is under my head,","poem":1},{"text":"and his right arm embraces me.","poem":2}]},{"number":7,"lines":[{"text":"O daughters of Jerusalem, I adjure you","poem":1},{"text":"by the gazelles and does of the field:","poem":2},{"text":"Do not arouse or awaken love","poem":1},{"text":"until the time is right.","poem":2}]},{"number":8,"lines":[{"text":"Listen! My beloved approaches.","poem":1},{"text":"Look! Here he comes,","poem":2},{"text":"leaping across the mountains,","poem":1},{"text":"bounding over the hills.","poem":2}]},{"number":9,"lines":[{"text":"My beloved is like a gazelle or a young stag.","poem":1},{"text":"Look, he stands behind our wall,","poem":2},{"text":"gazing through the windows,","poem":1},{"text":"peering through the lattice.","poem":2}]},{"number":10,"lines":[{"text":"My beloved calls to me,","poem":1},{"text":"“Arise, my darling.","poem":2},{"text":"Come away with me, my beautiful one.","poem":2}]},{"number":11,"lines":[{"text":"For now the winter is past;","poem":1},{"text":"the rain is over and gone.","poem":2}]},{"number":12,"lines":[{"text":"The flowers have appeared in the countryside;","poem":1},{"text":"the season of singing has come,","poem":2},{"text":"and the cooing of turtledoves","poem":1},{"text":"is heard in our land.","poem":2}]},{"number":13,"lines":[{"text":"The fig tree ripens its figs;","poem":1},{"text":"the blossoming vines spread their fragrance.","poem":2},{"text":"Arise, come away, my darling;","poem":1},{"text":"come away with me, my beautiful one.”","poem":2}]},{"number":14,"lines":[{"text":"O my dove in the clefts of the rock,","poem":1},{"text":"in the crevices of the cliff,","poem":2},{"text":"let me see your face,","poem":1},{"text":"let me hear your voice;","poem":2},{"text":"for your voice is sweet,","poem":1},{"text":"and your countenance is lovely.","poem":2}]},{"number":15,"lines":[{"text":"Catch for us the foxes—","poem":1},{"text":"the little foxes that ruin the vineyards—","poem":2},{"text":"for our vineyards are in bloom.","poem":2}]},{"number":16,"lines":[{"text":"My beloved is mine and I am his;","poem":1},{"text":"he pastures his flock among the lilies.","poem":2}]},{"number":17,"lines":[{"text":"Before the day breaks and shadows flee,","poem":1},{"text":"turn, my beloved,","poem":2},{"text":"and be like a gazelle","poem":1},{"text":"or a young stag on the mountains of Bether.","poem":2}]}]},{"number":3,"lastVerse":11,"verses":[{"number":1,"lines":[{"text":"On my bed at night","poem":1},{"text":"I sought the one I love;","poem":2},{"text":"I sought him,","poem":1},{"text":"but did not find him.","poem":2}]},{"number":2,"lines":[{"text":"I will arise now and go about the city,","poem":1},{"text":"through the streets and squares.","poem":2},{"text":"I will seek the one I love.","poem":1},{"text":"So I sought him but did not find him.","poem":2}]},{"number":3,"lines":[{"text":"I encountered the watchmen on their rounds of the city:","poem":1},{"text":"“Have you seen the one I love?”","poem":2}]},{"number":4,"lines":[{"text":"I had just passed them when I found the one I love.","poem":1},{"text":"I held him and would not let go","poem":2},{"text":"until I had brought him to my mother’s house,","poem":1},{"text":"to the chamber of the one who conceived me.","poem":2}]},{"number":5,"lines":[{"text":"O daughters of Jerusalem, I adjure you","poem":1},{"text":"by the gazelles and does of the field:","poem":2},{"text":"Do not arouse or awaken love","poem":1},{"text":"until the time is right.","poem":2}]},{"number":6,"lines":[{"text":"Who is this coming up from the wilderness","poem":1},{"text":"like a column of smoke,","poem":2},{"text":"scented with myrrh and frankincense","poem":1},{"text":"from all the spices of the merchant?","poem":2}]},{"number":7,"lines":[{"text":"Behold, it is Solomon’s carriage,","poem":1},{"text":"escorted by sixty of the mightiest men of Israel.","poem":2}]},{"number":8,"lines":[{"text":"All are skilled with the sword,","poem":1},{"text":"experienced in warfare.","poem":2},{"text":"Each has his sword at his side","poem":1},{"text":"prepared for the terror of the night.","poem":2}]},{"number":9,"lines":[{"text":"King Solomon has made his carriage","poem":1},{"text":"out of the timber of Lebanon.","poem":2}]},{"number":10,"lines":[{"text":"He has made its posts of silver,","poem":1},{"text":"its base of gold, its seat of purple fabric.","poem":2},{"text":"Its interior is inlaid with love","poem":1},{"text":"by the daughters of Jerusalem.","poem":2}]},{"number":11,"lines":[{"text":"Come out, O daughters of Zion,","poem":1},{"text":"and gaze at King Solomon,","poem":2},{"text":"wearing the crown with which his mother crowned him","poem":1},{"text":"on the day of his wedding—","poem":2},{"text":"the day of his heart’s rejoicing.","poem":2}]}]},{"number":4,"lastVerse":16,"verses":[{"number":1,"lines":[{"text":"How beautiful you are, my darling—","poem":1},{"text":"how very beautiful!","poem":2},{"text":"Your eyes are like doves","poem":1},{"text":"behind your veil.","poem":2},{"text":"Your hair is like a flock of goats","poem":1},{"text":"streaming down Mount Gilead.","poem":2}]},{"number":2,"lines":[{"text":"Your teeth are like a flock of newly shorn sheep","poem":1},{"text":"coming up from the washing;","poem":2},{"text":"each has its twin,","poem":1},{"text":"and not one of them is lost.","poem":2}]},{"number":3,"lines":[{"text":"Your lips are like a scarlet ribbon,","poem":1},{"text":"and your mouth is lovely.","poem":2},{"text":"Your brow behind your veil","poem":1},{"text":"is like a slice of pomegranate.","poem":2}]},{"number":4,"lines":[{"text":"Your neck is like the tower of David,","poem":1},{"text":"built with rows of stones;","poem":2},{"text":"on it hang a thousand shields,","poem":1},{"text":"all of them shields of warriors.","poem":2}]},{"number":5,"lines":[{"text":"Your breasts are like two fawns,","poem":1},{"text":"twins of a gazelle grazing among the lilies.","poem":2}]},{"number":6,"lines":[{"text":"Before the day breaks and the shadows flee,","poem":1},{"text":"I will make my way","poem":2},{"text":"to the mountain of myrrh","poem":1},{"text":"and to the hill of frankincense.","poem":2}]},{"number":7,"lines":[{"text":"You are altogether beautiful, my darling;","poem":1},{"text":"in you there is no flaw.","poem":2}]},{"number":8,"lines":[{"text":"Come with me from Lebanon, my bride,","poem":1},{"text":"come with me from Lebanon!","poem":2},{"text":"Descend from the peak of Amana,","poem":1},{"text":"from the summits of Senir and Hermon,","poem":2},{"text":"from the dens of the lions,","poem":1},{"text":"from the mountains of the leopards.","poem":2}]},{"number":9,"lines":[{"text":"You have captured my heart,","poem":1},{"text":"my sister, my bride;","poem":2},{"text":"you have stolen my heart with one glance of your eyes,","poem":1},{"text":"with one jewel of your neck.","poem":2}]},{"number":10,"lines":[{"text":"How delightful is your love,","poem":1},{"text":"my sister, my bride!","poem":2},{"text":"Your love is much better than wine,","poem":1},{"text":"and the fragrance of your perfume than all spices.","poem":2}]},{"number":11,"lines":[{"text":"Your lips, my bride,","poem":1},{"text":"drip sweetness like the honeycomb;","poem":2},{"text":"honey and milk are under your tongue,","poem":1},{"text":"and the fragrance of your garments","poem":2},{"text":"is like the aroma of Lebanon.","poem":2}]},{"number":12,"lines":[{"text":"My sister, my bride, you are a garden locked up,","poem":1},{"text":"a spring enclosed, a fountain sealed.","poem":2}]},{"number":13,"lines":[{"text":"Your branches are an orchard of pomegranates","poem":1},{"text":"with the choicest of fruits, with henna and nard,","poem":2}]},{"number":14,"lines":[{"text":"with nard and saffron, with calamus and cinnamon,","poem":1},{"text":"with every kind of frankincense tree,","poem":2},{"text":"with myrrh and aloes,","poem":1},{"text":"with all the finest spices.","poem":2}]},{"number":15,"lines":[{"text":"You are a garden spring,","poem":1},{"text":"a well of fresh water","poem":2},{"text":"flowing down from Lebanon.","poem":2}]},{"number":16,"lines":[{"text":"Awake, O north wind,","poem":1},{"text":"and come, O south wind.","poem":2},{"text":"Breathe on my garden","poem":1},{"text":"and spread the fragrance of its spices.","poem":2},{"text":"Let my beloved come into his garden","poem":1},{"text":"and taste its choicest fruits.","poem":2}]}]},{"number":5,"lastVerse":16,"verses":[{"number":1,"lines":[{"text":"I have come to my garden, my sister, my bride;","poem":1},{"text":"I have gathered my myrrh with my spice.","poem":2},{"text":"I have eaten my honeycomb with my honey;","poem":1},{"text":"I have drunk my wine with my milk.","poem":2},{"text":"The Friends"},{"text":"Eat, O friends, and drink;","poem":1},{"text":"drink freely, O beloved.","poem":2}]},{"number":2,"lines":[{"text":"I sleep, but my heart is awake.","poem":1},{"text":"A sound! My beloved is knocking:","poem":2},{"text":"“Open to me, my sister, my darling,","poem":1},{"text":"my dove, my flawless one.","poem":2},{"text":"My head is drenched with dew,","poem":1},{"text":"my hair with the dampness of the night.”","poem":2}]},{"number":3,"lines":[{"text":"I have taken off my robe—","poem":1},{"text":"must I put it back on?","poem":2},{"text":"I have washed my feet—","poem":1},{"text":"must I soil them again?","poem":2}]},{"number":4,"lines":[{"text":"My beloved put his hand to the latch;","poem":1},{"text":"my heart pounded for him.","poem":2}]},{"number":5,"lines":[{"text":"I rose up to open for my beloved.","poem":1},{"text":"My hands dripped with myrrh,","poem":2},{"text":"my fingers with flowing myrrh","poem":1},{"text":"on the handles of the bolt.","poem":2}]},{"number":6,"lines":[{"text":"I opened for my beloved,","poem":1},{"text":"but he had turned and gone.","poem":2},{"text":"My heart sank at his departure.","poem":1},{"text":"I sought him but did not find him.","poem":2},{"text":"I called, but he did not answer.","poem":2}]},{"number":7,"lines":[{"text":"I encountered the watchmen on their rounds of the city.","poem":1},{"text":"They beat me and bruised me;","poem":2},{"text":"they took away my cloak,","poem":1},{"text":"those guardians of the walls.","poem":2}]},{"number":8,"lines":[{"text":"O daughters of Jerusalem, I adjure you,","poem":1},{"text":"if you find my beloved,","poem":2},{"text":"tell him I am sick with love.","poem":2}]},{"number":9,"lines":[{"text":"How is your beloved better than others,","poem":1},{"text":"O most beautiful among women?","poem":2},{"text":"How is your beloved better than another,","poem":1},{"text":"that you charge us so?","poem":2}]},{"number":10,"lines":[{"text":"My beloved is dazzling and ruddy,","poem":1},{"text":"outstanding among ten thousand.","poem":2}]},{"number":11,"lines":[{"text":"His head is purest gold;","poem":1},{"text":"his hair is wavy and black as a raven.","poem":2}]},{"number":12,"lines":[{"text":"His eyes are like doves","poem":1},{"text":"beside the streams of water,","poem":2},{"text":"bathed in milk","poem":1},{"text":"and mounted like jewels.","poem":2}]},{"number":13,"lines":[{"text":"His cheeks are like beds of spice,","poem":1},{"text":"towers of perfume.","poem":2},{"text":"His lips are like lilies,","poem":1},{"text":"dripping with flowing myrrh.","poem":2}]},{"number":14,"lines":[{"text":"His arms are rods of gold","poem":1},{"text":"set with beryl.","poem":2},{"text":"His body is polished ivory","poem":1},{"text":"bedecked with sapphires.","poem":2}]},{"number":15,"lines":[{"text":"His legs are pillars of marble","poem":1},{"text":"set on bases of pure gold.","poem":2},{"text":"His appearance is like Lebanon,","poem":1},{"text":"as majestic as the cedars.","poem":2}]},{"number":16,"lines":[{"text":"His mouth is most sweet;","poem":1},{"text":"he is altogether lovely.","poem":2},{"text":"This is my beloved, and this is my friend,","poem":1},{"text":"O daughters of Jerusalem.","poem":2}]}]},{"number":6,"lastVerse":13,"verses":[{"number":1,"lines":[{"text":"Where has your beloved gone,","poem":1},{"text":"O most beautiful among women?","poem":2},{"text":"Which way has he turned?","poem":1},{"text":"We will seek him with you.","poem":2}]},{"number":2,"lines":[{"text":"My beloved has gone down to his garden,","poem":1},{"text":"to the beds of spices,","poem":2},{"text":"to pasture his flock in the gardens","poem":1},{"text":"and to gather lilies.","poem":2}]},{"number":3,"lines":[{"text":"I belong to my beloved and he belongs to me;","poem":1},{"text":"he pastures his flock among the lilies.","poem":2}]},{"number":4,"lines":[{"text":"You are as beautiful, my darling, as Tirzah,","poem":1},{"text":"as lovely as Jerusalem,","poem":2},{"text":"as majestic as troops with banners.","poem":2}]},{"number":5,"lines":[{"text":"Turn your eyes away from me,","poem":1},{"text":"for they have overcome me.","poem":2},{"text":"Your hair is like a flock of goats","poem":1},{"text":"streaming down from Gilead.","poem":2}]},{"number":6,"lines":[{"text":"Your teeth are like a flock of sheep","poem":1},{"text":"coming up from the washing;","poem":2},{"text":"each has its twin,","poem":1},{"text":"and not one of them is lost.","poem":2}]},{"number":7,"lines":[{"text":"Your brow behind your veil","poem":1},{"text":"is like a slice of pomegranate.","poem":2}]},{"number":8,"lines":[{"text":"There are sixty queens and eighty concubines,","poem":1},{"text":"and maidens without number,","poem":2}]},{"number":9,"lines":[{"text":"but my dove, my perfect one, is unique,","poem":1},{"text":"the favorite of the mother who bore her.","poem":2},{"text":"The maidens see her and call her blessed;","poem":1},{"text":"the queens and concubines sing her praises.","poem":2}]},{"number":10,"lines":[{"text":"Who is this who shines like the dawn,","poem":1},{"text":"as fair as the moon,","poem":2},{"text":"as bright as the sun,","poem":1},{"text":"as majestic as the stars in procession?","poem":2}]},{"number":11,"lines":[{"text":"I went down to the walnut grove","poem":1},{"text":"to see the blossoms of the valley,","poem":2},{"text":"to see if the vines were budding","poem":1},{"text":"or the pomegranates were in bloom.","poem":2}]},{"number":12,"lines":[{"text":"Before I realized it, my desire had set me","poem":1},{"text":"among the royal chariots of my people.","poem":2}]},{"number":13,"lines":[{"text":"Come back, come back, O Shulammite!","poem":1},{"text":"Come back, come back, that we may gaze upon you.","poem":2},{"text":"The Bridegroom"},{"text":"Why do you look at the Shulammite,","poem":1},{"text":"as on the dance of Mahanaim?","poem":2}]}]},{"number":7,"lastVerse":13,"verses":[{"number":1,"lines":[{"text":"How beautiful are your sandaled feet,","poem":1},{"text":"O daughter of the prince!","poem":2},{"text":"The curves of your thighs are like jewels,","poem":1},{"text":"the handiwork of a master.","poem":2}]},{"number":2,"lines":[{"text":"Your navel is a rounded goblet;","poem":1},{"text":"it never lacks blended wine.","poem":2},{"text":"Your waist is a mound of wheat","poem":1},{"text":"encircled by the lilies.","poem":2}]},{"number":3,"lines":[{"text":"Your breasts are like two fawns,","poem":1},{"text":"twins of a gazelle.","poem":2}]},{"number":4,"lines":[{"text":"Your neck is like a tower","poem":1},{"text":"made of ivory;","poem":2},{"text":"your eyes are like the pools of Heshbon","poem":1},{"text":"by the gate of Bath-rabbim;","poem":2},{"text":"your nose is like the tower of Lebanon,","poem":1},{"text":"facing toward Damascus.","poem":2}]},{"number":5,"lines":[{"text":"Your head crowns you like Mount Carmel,","poem":1},{"text":"the hair of your head like purple threads;","poem":2},{"text":"the king is captured in your tresses.","poem":2}]},{"number":6,"lines":[{"text":"How fair and pleasant you are,","poem":1},{"text":"O love, with your delights!","poem":2}]},{"number":7,"lines":[{"text":"Your stature is like a palm tree;","poem":1},{"text":"your breasts are clusters of fruit.","poem":2}]},{"number":8,"lines":[{"text":"I said, “I will climb the palm tree;","poem":1},{"text":"I will take hold of its fruit.”","poem":2},{"text":"May your breasts be like clusters of the vine,","poem":1},{"text":"the fragrance of your breath like apples,","poem":2}]},{"number":9,"lines":[{"text":"and your mouth like the finest wine.","poem":2},{"text":"The Bride"},{"text":"May it flow smoothly to my beloved,","poem":1},{"text":"gliding gently over lips and teeth.","poem":2}]},{"number":10,"lines":[{"text":"I belong to my beloved,","poem":1},{"text":"and his desire is for me.","poem":2}]},{"number":11,"lines":[{"text":"Come, my beloved,","poem":1},{"text":"let us go to the countryside;","poem":2},{"text":"let us spend the night among the wildflowers.","poem":2}]},{"number":12,"lines":[{"text":"Let us go early to the vineyards","poem":1},{"text":"to see if the vine has budded,","poem":2},{"text":"if the blossom has opened,","poem":1},{"text":"if the pomegranates are in bloom—","poem":2},{"text":"there I will give you my love.","poem":2}]},{"number":13,"lines":[{"text":"The mandrakes send forth a fragrance,","poem":1},{"text":"and at our door is every delicacy,","poem":2},{"text":"new as well as old,","poem":1},{"text":"that I have treasured up for you, my beloved.","poem":2}]}]},{"number":8,"lastVerse":14,"verses":[{"number":1,"lines":[{"text":"O that you were to me like a brother","poem":1},{"text":"who nursed at my mother’s breasts!","poem":2},{"text":"If I found you outdoors, I would kiss you,","poem":1},{"text":"and no one would despise me.","poem":2}]},{"number":2,"lines":[{"text":"I would lead you and bring you","poem":1},{"text":"to the house of my mother who taught me.","poem":2},{"text":"I would give you spiced wine to drink,","poem":1},{"text":"the nectar of my pomegranates.","poem":2}]},{"number":3,"lines":[{"text":"His left hand is under my head,","poem":1},{"text":"and his right arm embraces me.","poem":2}]},{"number":4,"lines":[{"text":"O daughters of Jerusalem, I adjure you:","poem":1},{"text":"Do not arouse or awaken love","poem":2},{"text":"until the time is right.","poem":2}]},{"number":5,"lines":[{"text":"Who is this coming up from the wilderness,","poem":1},{"text":"leaning on her beloved?","poem":2},{"text":"The Bride"},{"text":"I roused you under the apple tree;","poem":1},{"text":"there your mother conceived you;","poem":2},{"text":"there she travailed and brought you forth.","poem":2}]},{"number":6,"lines":[{"text":"Set me as a seal over your heart,","poem":1},{"text":"as a seal upon your arm.","poem":2},{"text":"For love is as strong as death,","poem":1},{"text":"its jealousy as unrelenting as Sheol.","poem":2},{"text":"Its sparks are fiery flames,","poem":1},{"text":"the fiercest blaze of all.","poem":2}]},{"number":7,"lines":[{"text":"Mighty waters cannot quench love;","poem":1},{"text":"rivers cannot sweep it away.","poem":2},{"text":"If a man were to give all the wealth of his house for love,","poem":1},{"text":"his offer would be utterly scorned.","poem":2}]},{"number":8,"lines":[{"text":"We have a little sister,","poem":1},{"text":"and her breasts are not yet grown.","poem":2},{"text":"What shall we do for our sister","poem":1},{"text":"on the day she is spoken for?","poem":2}]},{"number":9,"lines":[{"text":"If she is a wall,","poem":1},{"text":"we will build a tower of silver upon her.","poem":2},{"text":"If she is a door,","poem":1},{"text":"we will enclose her with panels of cedar.","poem":2}]},{"number":10,"lines":[{"text":"I am a wall,","poem":1},{"text":"and my breasts are like towers.","poem":2},{"text":"So I have become in his eyes","poem":1},{"text":"like one who brings peace.","poem":2}]},{"number":11,"lines":[{"text":"Solomon had a vineyard in Baal-hamon.","poem":1},{"text":"He leased it to the tenants.","poem":2},{"text":"For its fruit, each was to bring","poem":1},{"text":"a thousand shekels of silver.","poem":2}]},{"number":12,"lines":[{"text":"But my own vineyard is mine to give;","poem":1},{"text":"the thousand shekels are for you, O Solomon,","poem":2},{"text":"and two hundred are for those who tend its fruit.","poem":2}]},{"number":13,"lines":[{"text":"You who dwell in the gardens,","poem":1},{"text":"my companions are listening for your voice.","poem":2},{"text":"Let me hear it!","poem":2}]},{"number":14,"lines":[{"text":"Come away, my beloved,","poem":1},{"text":"and be like a gazelle","poem":2},{"text":"or a young stag","poem":1},{"text":"on the mountains of spices.","poem":2}]}]}]}
