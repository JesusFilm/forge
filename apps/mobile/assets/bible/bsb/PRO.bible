{"formatVersion":1,"translationId":"BSB","textDirection":"ltr","bookId":"PRO","bookName":"Proverbs","chapters":[{"number":1,"lastVerse":33,"verses":[{"number":1,"lines":[{"text":"These are the proverbs of Solomon son of David,","poem":1},{"text":"king of Israel,","poem":2}]},{"number":2,"lines":[{"text":"for gaining wisdom and discipline,","poem":1},{"text":"for comprehending words of insight,","poem":2}]},{"number":3,"lines":[{"text":"and for receiving instruction in wise living","poem":1},{"text":"and in righteousness, justice, and equity.","poem":2}]},{"number":4,"lines":[{"text":"To impart prudence to the simple","poem":1},{"text":"and knowledge and discretion to the young,","poem":2}]},{"number":5,"lines":[{"text":"let the wise listen and gain instruction,","poem":1},{"text":"and the discerning acquire wise counsel","poem":2}]},{"number":6,"lines":[{"text":"by understanding the proverbs and parables,","poem":1},{"text":"the sayings and riddles of the wise.","poem":2}]},{"number":7,"lines":[{"text":"The fear of the LORD is the beginning of knowledge,","poem":1},{"text":"but fools despise wisdom and discipline.","poem":2}]},{"number":8,"lines":[{"text":"Listen, my son, to your father’s instruction,","poem":1},{"text":"and do not forsake the teaching of your mother.","poem":2}]},{"number":9,"lines":[{"text":"For they are a garland of grace on your head","poem":1},{"text":"and a pendant around your neck.","poem":2}]},{"number":10,"lines":[{"text":"My son, if sinners entice you,","poem":1},{"text":"do not yield to them.","poem":2}]},{"number":11,"lines":[{"text":"If they say, “Come along, let us lie in wait for blood,","poem":1},{"text":"let us ambush the innocent without cause,","poem":2}]},{"number":12,"lines":[{"text":"let us swallow them alive like Sheol,","poem":1},{"text":"and whole like those descending into the Pit.","poem":2}]},{"number":13,"lines":[{"text":"We will find all manner of precious goods;","poem":1},{"text":"we will fill our houses with plunder.","poem":2}]},{"number":14,"lines":[{"text":"Throw in your lot with us;","poem":1},{"text":"let us all share one purse”—","poem":2}]},{"number":15,"lines":[{"text":"my son, do not walk the road with them","poem":1},{"text":"or set foot upon their path.","poem":2}]},{"number":16,"lines":[{"text":"For their feet run to evil,","poem":1},{"text":"and they are swift to shed blood.","poem":2}]},{"number":17,"lines":[{"text":"How futile it is to spread the net","poem":1},{"text":"where any bird can see it!","poem":2}]},{"number":18,"lines":[{"text":"But they lie in wait for their own blood;","poem":1},{"text":"they ambush their own lives.","poem":2}]},{"number":19,"lines":[{"text":"Such is the fate of all who are greedy,","poem":1},{"text":"whose unjust gain takes the lives of its possessors.","poem":2}]},{"number":20,"lines":[{"text":"Wisdom calls out in the street,","poem":1},{"text":"she lifts her voice in the square;","poem":2}]},{"number":21,"lines":[{"text":"in the main concourse she cries aloud,","poem":1},{"text":"at the city gates she makes her speech:","poem":2}]},{"number":22,"lines":[{"text":"“How long, O simple ones, will you love your simple ways?","poem":1},{"text":"How long will scoffers delight in their scorn","poem":2},{"text":"and fools hate knowledge?","poem":2}]},{"number":23,"lines":[{"text":"If you had repented at my rebuke,","poem":1},{"text":"then surely I would have poured out my spirit on you;","poem":2},{"text":"I would have made my words known to you.","poem":2}]},{"number":24,"lines":[{"text":"Because you refused my call,","poem":1},{"text":"and no one took my outstretched hand,","poem":2}]},{"number":25,"lines":[{"text":"because you neglected all my counsel,","poem":1},{"text":"and wanted none of my correction,","poem":2}]},{"number":26,"lines":[{"text":"in turn I will mock your calamity;","poem":1},{"text":"I will sneer when terror strikes you,","poem":2}]},{"number":27,"lines":[{"text":"when your dread comes like a storm,","poem":1},{"text":"and your destruction like a whirlwind,","poem":2},{"text":"when distress and anguish overwhelm you.","poem":2}]},{"number":28,"lines":[{"text":"Then they will call on me, but I will not answer;","poem":1},{"text":"they will earnestly seek me, but will not find me.","poem":2}]},{"number":29,"lines":[{"text":"For they hated knowledge","poem":1},{"text":"and chose not to fear the LORD.","poem":2}]},{"number":30,"lines":[{"text":"They accepted none of my counsel;","poem":1},{"text":"they despised all my reproof.","poem":2}]},{"number":31,"lines":[{"text":"So they will eat the fruit of their own way,","poem":1},{"text":"and be filled with their own devices.","poem":2}]},{"number":32,"lines":[{"text":"For the waywardness of the simple will slay them,","poem":1},{"text":"and the complacency of fools will destroy them.","poem":2}]},{"number":33,"lines":[{"text":"But whoever listens to me will dwell in safety,","poem":1},{"text":"secure from the fear of evil.”","poem":2}]}]},{"number":2,"lastVerse":22,"verses":[{"number":1,"lines":[{"text":"My son, if you accept my words","poem":1},{"text":"and hide my commandments within you,","poem":2}]},{"number":2,"lines":[{"text":"if you incline your ear to wisdom","poem":1},{"text":"and direct your heart to understanding,","poem":2}]},{"number":3,"lines":[{"text":"if you truly call out to insight","poem":1},{"text":"and lift your voice to understanding,","poem":2}]},{"number":4,"lines":[{"text":"if you seek it like silver","poem":1},{"text":"and search it out like hidden treasure,","poem":2}]},{"number":5,"lines":[{"text":"then you will discern the fear of the LORD","poem":1},{"text":"and discover the knowledge of God.","poem":2}]},{"number":6,"lines":[{"text":"For the LORD gives wisdom;","poem":1},{"text":"from His mouth come knowledge and understanding.","poem":2}]},{"number":7,"lines":[{"text":"He stores up sound wisdom for the upright;","poem":1},{"text":"He is a shield to those who walk with integrity,","poem":2}]},{"number":8,"lines":[{"text":"to guard the paths of justice","poem":1},{"text":"and protect the way of His saints.","poem":2}]},{"number":9,"lines":[{"text":"Then you will discern righteousness","poem":1},{"text":"and justice and equity—every good path.","poem":2}]},{"number":10,"lines":[{"text":"For wisdom will enter your heart,","poem":1},{"text":"and knowledge will delight your soul.","poem":2}]},{"number":11,"lines":[{"text":"Discretion will watch over you,","poem":1},{"text":"and understanding will guard you,","poem":2}]},{"number":12,"lines":[{"text":"to deliver you from the way of evil,","poem":1},{"text":"from the man who speaks perversity,","poem":2}]},{"number":13,"lines":[{"text":"from those who leave the straight paths","poem":1},{"text":"to walk in the ways of darkness,","poem":2}]},{"number":14,"lines":[{"text":"from those who enjoy doing evil","poem":1},{"text":"and rejoice in the twistedness of evil,","poem":2}]},{"number":15,"lines":[{"text":"whose paths are crooked","poem":1},{"text":"and whose ways are devious.","poem":2}]},{"number":16,"lines":[{"text":"It will rescue you from the forbidden woman,","poem":1},{"text":"from the stranger with seductive words","poem":2}]},{"number":17,"lines":[{"text":"who abandons the partner of her youth","poem":1},{"text":"and forgets the covenant of her God.","poem":2}]},{"number":18,"lines":[{"text":"For her house sinks down to death,","poem":1},{"text":"and her tracks to the departed spirits.","poem":2}]},{"number":19,"lines":[{"text":"None who go to her return","poem":1},{"text":"or negotiate the paths of life.","poem":2}]},{"number":20,"lines":[{"text":"So you will follow in the ways of the good,","poem":1},{"text":"and keep to the paths of the righteous.","poem":2}]},{"number":21,"lines":[{"text":"For the upright will inhabit the land,","poem":1},{"text":"and the blameless will remain in it;","poem":2}]},{"number":22,"lines":[{"text":"but the wicked will be cut off from the land,","poem":1},{"text":"and the unfaithful will be uprooted.","poem":2}]}]},{"number":3,"lastVerse":35,"verses":[{"number":1,"lines":[{"text":"My son, do not forget my teaching,","poem":1},{"text":"but let your heart keep my commandments;","poem":2}]},{"number":2,"lines":[{"text":"for they will add length to your days,","poem":1},{"text":"years and peace to your life.","poem":2}]},{"number":3,"lines":[{"text":"Never let loving devotion or faithfulness leave you;","poem":1},{"text":"bind them around your neck,","poem":2},{"text":"write them on the tablet of your heart.","poem":2}]},{"number":4,"lines":[{"text":"Then you will find favor and high regard","poem":1},{"text":"in the sight of God and man.","poem":2}]},{"number":5,"lines":[{"text":"Trust in the LORD with all your heart,","poem":1},{"text":"and lean not on your own understanding;","poem":2}]},{"number":6,"lines":[{"text":"in all your ways acknowledge Him,","poem":1},{"text":"and He will make your paths straight.","poem":2}]},{"number":7,"lines":[{"text":"Be not wise in your own eyes;","poem":1},{"text":"fear the LORD and turn away from evil.","poem":2}]},{"number":8,"lines":[{"text":"This will bring healing to your body","poem":1},{"text":"and refreshment to your bones.","poem":2}]},{"number":9,"lines":[{"text":"Honor the LORD with your wealth","poem":1},{"text":"and with the firstfruits of all your crops;","poem":2}]},{"number":10,"lines":[{"text":"then your barns will be filled with plenty,","poem":1},{"text":"and your vats will overflow with new wine.","poem":2}]},{"number":11,"lines":[{"text":"My son, do not reject the discipline of the LORD,","poem":1},{"text":"and do not loathe His rebuke;","poem":2}]},{"number":12,"lines":[{"text":"for the LORD disciplines the one He loves,","poem":1},{"text":"as does a father the son in whom he delights.","poem":2}]},{"number":13,"lines":[{"text":"Blessed is the man who finds wisdom,","poem":1},{"text":"the man who acquires understanding,","poem":2}]},{"number":14,"lines":[{"text":"for she is more profitable than silver,","poem":1},{"text":"and her gain is better than fine gold.","poem":2}]},{"number":15,"lines":[{"text":"She is more precious than rubies;","poem":1},{"text":"nothing you desire compares with her.","poem":2}]},{"number":16,"lines":[{"text":"Long life is in her right hand;","poem":1},{"text":"in her left hand are riches and honor.","poem":2}]},{"number":17,"lines":[{"text":"All her ways are pleasant,","poem":1},{"text":"and all her paths are peaceful.","poem":2}]},{"number":18,"lines":[{"text":"She is a tree of life to those who embrace her,","poem":1},{"text":"and those who lay hold of her are blessed.","poem":2}]},{"number":19,"lines":[{"text":"The LORD founded the earth by wisdom","poem":1},{"text":"and established the heavens by understanding.","poem":2}]},{"number":20,"lines":[{"text":"By His knowledge the watery depths were broken open,","poem":1},{"text":"and the clouds dripped with dew.","poem":2}]},{"number":21,"lines":[{"text":"My son, do not lose sight of this:","poem":1},{"text":"Preserve sound judgment and discernment.","poem":2}]},{"number":22,"lines":[{"text":"They will be life to your soul","poem":1},{"text":"and adornment to your neck.","poem":2}]},{"number":23,"lines":[{"text":"Then you will go on your way in safety,","poem":1},{"text":"and your foot will not stumble.","poem":2}]},{"number":24,"lines":[{"text":"When you lie down, you will not be afraid;","poem":1},{"text":"when you rest, your sleep will be sweet.","poem":2}]},{"number":25,"lines":[{"text":"Do not fear sudden danger","poem":1},{"text":"or the ruin that overtakes the wicked,","poem":2}]},{"number":26,"lines":[{"text":"for the LORD will be your confidence","poem":1},{"text":"and will keep your foot from the snare.","poem":2}]},{"number":27,"lines":[{"text":"Do not withhold good from the deserving","poem":1},{"text":"when it is within your power to act.","poem":2}]},{"number":28,"lines":[{"text":"Do not tell your neighbor,","poem":1},{"text":"“Come back tomorrow and I will provide”—","poem":2},{"text":"when you already have the means.","poem":2}]},{"number":29,"lines":[{"text":"Do not devise evil against your neighbor,","poem":1},{"text":"for he trustfully dwells beside you.","poem":2}]},{"number":30,"lines":[{"text":"Do not accuse a man without cause,","poem":1},{"text":"when he has done you no harm.","poem":2}]},{"number":31,"lines":[{"text":"Do not envy a violent man","poem":1},{"text":"or choose any of his ways;","poem":2}]},{"number":32,"lines":[{"text":"for the LORD detests the perverse,","poem":1},{"text":"but He is a friend to the upright.","poem":2}]},{"number":33,"lines":[{"text":"The curse of the LORD is on the house of the wicked,","poem":1},{"text":"but He blesses the home of the righteous.","poem":2}]},{"number":34,"lines":[{"text":"He mocks the mockers,","poem":1},{"text":"but gives grace to the humble.","poem":2}]},{"number":35,"lines":[{"text":"The wise will inherit honor,","poem":1},{"text":"but fools are held up to shame.","poem":2}]}]},{"number":4,"lastVerse":27,"verses":[{"number":1,"lines":[{"text":"Listen, my sons, to a father’s instruction;","poem":1},{"text":"pay attention and gain understanding.","poem":2}]},{"number":2,"lines":[{"text":"For I give you sound teaching;","poem":1},{"text":"do not abandon my directive.","poem":2}]},{"number":3,"lines":[{"text":"When I was a son to my father,","poem":1},{"text":"tender and the only child of my mother,","poem":2}]},{"number":4,"lines":[{"text":"he taught me and said,","poem":1},{"text":"“Let your heart lay hold of my words;","poem":2},{"text":"keep my commands and you will live.","poem":2}]},{"number":5,"lines":[{"text":"Get wisdom, get understanding;","poem":1},{"text":"do not forget my words or turn from them.","poem":2}]},{"number":6,"lines":[{"text":"Do not forsake wisdom, and she will preserve you;","poem":1},{"text":"love her, and she will guard you.","poem":2}]},{"number":7,"lines":[{"text":"Wisdom is supreme; so acquire wisdom.","poem":1},{"text":"And whatever you may acquire, gain understanding.","poem":2}]},{"number":8,"lines":[{"text":"Prize her, and she will exalt you;","poem":1},{"text":"if you embrace her, she will honor you.","poem":2}]},{"number":9,"lines":[{"text":"She will set a garland of grace on your head;","poem":1},{"text":"she will present you with a crown of beauty.”","poem":2}]},{"number":10,"lines":[{"text":"Listen, my son, and receive my words,","poem":1},{"text":"and the years of your life will be many.","poem":2}]},{"number":11,"lines":[{"text":"I will guide you in the way of wisdom;","poem":1},{"text":"I will lead you on straight paths.","poem":2}]},{"number":12,"lines":[{"text":"When you walk, your steps will not be impeded;","poem":1},{"text":"when you run, you will not stumble.","poem":2}]},{"number":13,"lines":[{"text":"Hold on to instruction; do not let go.","poem":1},{"text":"Guard it, for it is your life.","poem":2}]},{"number":14,"lines":[{"text":"Do not set foot on the path of the wicked","poem":1},{"text":"or walk in the way of evildoers.","poem":2}]},{"number":15,"lines":[{"text":"Avoid it; do not travel on it.","poem":1},{"text":"Turn from it and pass on by.","poem":2}]},{"number":16,"lines":[{"text":"For they cannot sleep","poem":1},{"text":"unless they do evil;","poem":2},{"text":"they are deprived of slumber","poem":1},{"text":"until they make someone fall.","poem":2}]},{"number":17,"lines":[{"text":"For they eat the bread of wickedness","poem":1},{"text":"and drink the wine of violence.","poem":2}]},{"number":18,"lines":[{"text":"The path of the righteous is like the first gleam of dawn,","poem":1},{"text":"shining brighter and brighter until midday.","poem":2}]},{"number":19,"lines":[{"text":"But the way of the wicked is like the darkest gloom;","poem":1},{"text":"they do not know what makes them stumble.","poem":2}]},{"number":20,"lines":[{"text":"My son, pay attention to my words;","poem":1},{"text":"incline your ear to my sayings.","poem":2}]},{"number":21,"lines":[{"text":"Do not lose sight of them;","poem":1},{"text":"keep them within your heart.","poem":2}]},{"number":22,"lines":[{"text":"For they are life to those who find them,","poem":1},{"text":"and health to the whole body.","poem":2}]},{"number":23,"lines":[{"text":"Guard your heart with all diligence,","poem":1},{"text":"for from it flow springs of life.","poem":2}]},{"number":24,"lines":[{"text":"Put away deception from your mouth;","poem":1},{"text":"keep your lips from perverse speech.","poem":2}]},{"number":25,"lines":[{"text":"Let your eyes look forward;","poem":1},{"text":"fix your gaze straight ahead.","poem":2}]},{"number":26,"lines":[{"text":"Make a level path for your feet,","poem":1},{"text":"and all your ways will be sure.","poem":2}]},{"number":27,"lines":[{"text":"Do not swerve to the right or to the left;","poem":1},{"text":"turn your feet away from evil.","poem":2}]}]},{"number":5,"lastVerse":23,"verses":[{"number":1,"lines":[{"text":"My son, pay attention to my wisdom;","poem":1},{"text":"incline your ear to my insight,","poem":2}]},{"number":2,"lines":[{"text":"that you may maintain discretion","poem":1},{"text":"and your lips may preserve knowledge.","poem":2}]},{"number":3,"lines":[{"text":"Though the lips of the forbidden woman drip honey","poem":1},{"text":"and her speech is smoother than oil,","poem":2}]},{"number":4,"lines":[{"text":"in the end she is bitter as wormwood,","poem":1},{"text":"sharp as a double-edged sword.","poem":2}]},{"number":5,"lines":[{"text":"Her feet go down to death;","poem":1},{"text":"her steps lead straight to Sheol.","poem":2}]},{"number":6,"lines":[{"text":"She does not consider the path of life;","poem":1},{"text":"she does not know that her ways are unstable.","poem":2}]},{"number":7,"lines":[{"text":"So now, my sons, listen to me,","poem":1},{"text":"and do not turn aside from the words of my mouth.","poem":2}]},{"number":8,"lines":[{"text":"Keep your path far from her;","poem":1},{"text":"do not go near the door of her house,","poem":2}]},{"number":9,"lines":[{"text":"lest you concede your vigor to others,","poem":1},{"text":"and your years to one who is cruel;","poem":2}]},{"number":10,"lines":[{"text":"lest strangers feast on your wealth,","poem":1},{"text":"and your labors enrich the house of a foreigner.","poem":2}]},{"number":11,"lines":[{"text":"At the end of your life you will groan","poem":1},{"text":"when your flesh and your body are spent,","poem":2}]},{"number":12,"lines":[{"text":"and you will say, “How I hated discipline,","poem":1},{"text":"and my heart despised reproof!","poem":2}]},{"number":13,"lines":[{"text":"I did not listen to the voice of my teachers","poem":1},{"text":"or incline my ear to my mentors.","poem":2}]},{"number":14,"lines":[{"text":"I am on the brink of utter ruin","poem":1},{"text":"in the midst of the whole assembly.”","poem":2}]},{"number":15,"lines":[{"text":"Drink water from your own cistern,","poem":1},{"text":"and running water from your own well.","poem":2}]},{"number":16,"lines":[{"text":"Why should your springs flow in the streets,","poem":1},{"text":"your streams of water in the public squares?","poem":2}]},{"number":17,"lines":[{"text":"Let them be yours alone,","poem":1},{"text":"never to be shared with strangers.","poem":2}]},{"number":18,"lines":[{"text":"May your fountain be blessed,","poem":1},{"text":"and may you rejoice in the wife of your youth:","poem":2}]},{"number":19,"lines":[{"text":"A loving doe, a graceful fawn—","poem":1},{"text":"may her breasts satisfy you always;","poem":2},{"text":"may you be captivated by her love forever.","poem":2}]},{"number":20,"lines":[{"text":"Why be captivated, my son, by an adulteress,","poem":1},{"text":"or embrace the bosom of a stranger?","poem":2}]},{"number":21,"lines":[{"text":"For a man’s ways are before the eyes of the LORD,","poem":1},{"text":"and the LORD examines all his paths.","poem":2}]},{"number":22,"lines":[{"text":"The iniquities of a wicked man entrap him;","poem":1},{"text":"the cords of his sin entangle him.","poem":2}]},{"number":23,"lines":[{"text":"He dies for lack of discipline,","poem":1},{"text":"led astray by his own great folly.","poem":2}]}]},{"number":6,"lastVerse":35,"verses":[{"number":1,"lines":[{"text":"My son, if you have put up security for your neighbor,","poem":1},{"text":"if you have struck hands in pledge with a stranger,","poem":2}]},{"number":2,"lines":[{"text":"if you have been trapped by the words of your lips,","poem":1},{"text":"ensnared by the words of your mouth,","poem":2}]},{"number":3,"lines":[{"text":"then do this, my son, to free yourself,","poem":1},{"text":"for you have fallen into your neighbor’s hands:","poem":2},{"text":"Go, humble yourself,","poem":1},{"text":"and press your plea with your neighbor.","poem":2}]},{"number":4,"lines":[{"text":"Allow no sleep to your eyes","poem":1},{"text":"or slumber to your eyelids.","poem":2}]},{"number":5,"lines":[{"text":"Free yourself, like a gazelle from the hand of the hunter,","poem":1},{"text":"like a bird from the snare of the fowler.","poem":2}]},{"number":6,"lines":[{"text":"Walk in the manner of the ant, O slacker;","poem":1},{"text":"observe its ways and become wise.","poem":2}]},{"number":7,"lines":[{"text":"Without a commander,","poem":1},{"text":"without an overseer or ruler,","poem":2}]},{"number":8,"lines":[{"text":"it prepares its provisions in summer;","poem":1},{"text":"it gathers its food at harvest.","poem":2}]},{"number":9,"lines":[{"text":"How long will you lie there, O slacker?","poem":1},{"text":"When will you get up from your sleep?","poem":2}]},{"number":10,"lines":[{"text":"A little sleep, a little slumber,","poem":1},{"text":"a little folding of the hands to rest,","poem":2}]},{"number":11,"lines":[{"text":"and poverty will come upon you like a robber,","poem":1},{"text":"and need like a bandit.","poem":2}]},{"number":12,"lines":[{"text":"A worthless person, a wicked man,","poem":1},{"text":"walks with a perverse mouth,","poem":2}]},{"number":13,"lines":[{"text":"winking his eyes, speaking with his feet,","poem":1},{"text":"and pointing with his fingers.","poem":2}]},{"number":14,"lines":[{"text":"With deceit in his heart he devises evil;","poem":1},{"text":"he continually sows discord.","poem":2}]},{"number":15,"lines":[{"text":"Therefore calamity will come upon him suddenly;","poem":1},{"text":"in an instant he will be shattered beyond recovery.","poem":2}]},{"number":16,"lines":[{"text":"There are six things that the LORD hates, seven that are detestable to Him:"}]},{"number":17,"lines":[{"text":"haughty eyes,"},{"text":"a lying tongue,"},{"text":"hands that shed innocent blood,"}]},{"number":18,"lines":[{"text":"a heart that devises wicked schemes,"},{"text":"feet that run swiftly to evil,"}]},{"number":19,"lines":[{"text":"a false witness who gives false testimony,"},{"text":"and one who stirs up discord among brothers."}]},{"number":20,"lines":[{"text":"My son, keep your father’s commandment,","poem":1},{"text":"and do not forsake your mother’s teaching.","poem":2}]},{"number":21,"lines":[{"text":"Bind them always upon your heart;","poem":1},{"text":"tie them around your neck.","poem":2}]},{"number":22,"lines":[{"text":"When you walk, they will guide you;","poem":1},{"text":"when you lie down, they will watch over you;","poem":2},{"text":"when you awake, they will speak to you.","poem":2}]},{"number":23,"lines":[{"text":"For this commandment is a lamp, this teaching is a light,","poem":1},{"text":"and the reproofs of discipline are the way to life,","poem":2}]},{"number":24,"lines":[{"text":"to keep you from the evil woman,","poem":1},{"text":"from the smooth tongue of the adulteress.","poem":2}]},{"number":25,"lines":[{"text":"Do not lust in your heart for her beauty","poem":1},{"text":"or let her captivate you with her eyes.","poem":2}]},{"number":26,"lines":[{"text":"For the levy of the prostitute is poverty,","poem":1},{"text":"and the adulteress preys upon your very life.","poem":2}]},{"number":27,"lines":[{"text":"Can a man embrace fire","poem":1},{"text":"and his clothes not be burned?","poem":2}]},{"number":28,"lines":[{"text":"Can a man walk on hot coals","poem":1},{"text":"without scorching his feet?","poem":2}]},{"number":29,"lines":[{"text":"So is he who sleeps with another man’s wife;","poem":1},{"text":"no one who touches her will go unpunished.","poem":2}]},{"number":30,"lines":[{"text":"Men do not despise the thief","poem":1},{"text":"if he steals to satisfy his hunger.","poem":2}]},{"number":31,"lines":[{"text":"Yet if caught, he must pay sevenfold;","poem":1},{"text":"he must give up all the wealth of his house.","poem":2}]},{"number":32,"lines":[{"text":"He who commits adultery lacks judgment;","poem":1},{"text":"whoever does so destroys himself.","poem":2}]},{"number":33,"lines":[{"text":"Wounds and dishonor will befall him,","poem":1},{"text":"and his reproach will never be wiped away.","poem":2}]},{"number":34,"lines":[{"text":"For jealousy enrages a husband,","poem":1},{"text":"and he will show no mercy in the day of vengeance.","poem":2}]},{"number":35,"lines":[{"text":"He will not be appeased by any ransom,","poem":1},{"text":"or persuaded by lavish gifts.","poem":2}]}]},{"number":7,"lastVerse":27,"verses":[{"number":1,"lines":[{"text":"My son, keep my words","poem":1},{"text":"and treasure my commandments within you.","poem":2}]},{"number":2,"lines":[{"text":"Keep my commandments and live;","poem":1},{"text":"guard my teachings as the apple of your eye.","poem":2}]},{"number":3,"lines":[{"text":"Tie them to your fingers;","poem":1},{"text":"write them on the tablet of your heart.","poem":2}]},{"number":4,"lines":[{"text":"Say to wisdom, “You are my sister,”","poem":1},{"text":"and call understanding your kinsman,","poem":2}]},{"number":5,"lines":[{"text":"that they may keep you from the adulteress,","poem":1},{"text":"from the stranger with seductive words.","poem":2}]},{"number":6,"lines":[{"text":"For at the window of my house","poem":1},{"text":"I looked through the lattice.","poem":2}]},{"number":7,"lines":[{"text":"I saw among the simple,","poem":1},{"text":"I noticed among the youths,","poem":2},{"text":"a young man lacking judgment,","poem":2}]},{"number":8,"lines":[{"text":"crossing the street near her corner,","poem":1},{"text":"strolling down the road to her house,","poem":2}]},{"number":9,"lines":[{"text":"at twilight, as the day was fading","poem":1},{"text":"into the dark of the night.","poem":2}]},{"number":10,"lines":[{"text":"Then a woman came out to meet him,","poem":1},{"text":"with the attire of a harlot and cunning of heart.","poem":2}]},{"number":11,"lines":[{"text":"She is loud and defiant;","poem":1},{"text":"her feet do not remain at home.","poem":2}]},{"number":12,"lines":[{"text":"Now in the street, now in the squares,","poem":1},{"text":"she lurks at every corner.","poem":2}]},{"number":13,"lines":[{"text":"She seizes him and kisses him;","poem":1},{"text":"she brazenly says to him:","poem":2}]},{"number":14,"lines":[{"text":"“I have made my peace offerings;","poem":1},{"text":"today I have paid my vows.","poem":2}]},{"number":15,"lines":[{"text":"So I came out to meet you;","poem":1},{"text":"I sought you, and I have found you.","poem":2}]},{"number":16,"lines":[{"text":"I have decked my bed with coverings,","poem":1},{"text":"with colored linen from Egypt.","poem":2}]},{"number":17,"lines":[{"text":"I have perfumed my bed with myrrh,","poem":1},{"text":"with aloes, and with cinnamon.","poem":2}]},{"number":18,"lines":[{"text":"Come, let us take our fill of love till morning.","poem":1},{"text":"Let us delight in loving caresses!","poem":2}]},{"number":19,"lines":[{"text":"For my husband is not at home;","poem":1},{"text":"he has gone on a long journey.","poem":2}]},{"number":20,"lines":[{"text":"He took with him a bag of money","poem":1},{"text":"and will not return till the moon is full.”","poem":2}]},{"number":21,"lines":[{"text":"With her great persuasion she entices him;","poem":1},{"text":"with her flattering lips she lures him.","poem":2}]},{"number":22,"lines":[{"text":"He follows her on impulse,","poem":1},{"text":"like an ox going to the slaughter,","poem":2},{"text":"like a deer bounding into a trap,","poem":2}]},{"number":23,"lines":[{"text":"until an arrow pierces his liver,","poem":1},{"text":"like a bird darting into a snare—","poem":2},{"text":"not knowing it will cost him his life.","poem":2}]},{"number":24,"lines":[{"text":"Now, my sons, listen to me,","poem":1},{"text":"and attend to the words of my mouth.","poem":2}]},{"number":25,"lines":[{"text":"Do not let your heart turn aside to her ways;","poem":1},{"text":"do not stray into her paths.","poem":2}]},{"number":26,"lines":[{"text":"For she has brought many down to death;","poem":1},{"text":"her slain are many in number.","poem":2}]},{"number":27,"lines":[{"text":"Her house is the road to Sheol,","poem":1},{"text":"descending to the chambers of death.","poem":2}]}]},{"number":8,"lastVerse":36,"verses":[{"number":1,"lines":[{"text":"Does not wisdom call out,","poem":1},{"text":"and understanding raise her voice?","poem":2}]},{"number":2,"lines":[{"text":"On the heights overlooking the road,","poem":1},{"text":"at the crossroads she takes her stand.","poem":2}]},{"number":3,"lines":[{"text":"Beside the gates to the city,","poem":1},{"text":"at the entrances she cries out:","poem":2}]},{"number":4,"lines":[{"text":"“To you, O men, I call out,","poem":1},{"text":"and my cry is to the sons of men.","poem":2}]},{"number":5,"lines":[{"text":"O simple ones, learn to be shrewd;","poem":1},{"text":"O fools, gain understanding.","poem":2}]},{"number":6,"lines":[{"text":"Listen, for I speak of noble things,","poem":1},{"text":"and the opening of my lips will reveal right.","poem":2}]},{"number":7,"lines":[{"text":"For my mouth will speak the truth,","poem":1},{"text":"and wickedness is detestable to my lips.","poem":2}]},{"number":8,"lines":[{"text":"All the words of my mouth are righteous;","poem":1},{"text":"none are crooked or perverse.","poem":2}]},{"number":9,"lines":[{"text":"They are all plain to the discerning,","poem":1},{"text":"and upright to those who find knowledge.","poem":2}]},{"number":10,"lines":[{"text":"Receive my instruction instead of silver,","poem":1},{"text":"and knowledge rather than pure gold.","poem":2}]},{"number":11,"lines":[{"text":"For wisdom is more precious than rubies,","poem":1},{"text":"and nothing you desire compares with her.","poem":2}]},{"number":12,"lines":[{"text":"I, wisdom, dwell together with prudence,","poem":1},{"text":"and I find knowledge and discretion.","poem":2}]},{"number":13,"lines":[{"text":"To fear the LORD is to hate evil;","poem":1},{"text":"I hate arrogant pride, evil conduct, and perverse speech.","poem":2}]},{"number":14,"lines":[{"text":"Counsel and sound judgment are mine;","poem":1},{"text":"I have insight and strength.","poem":2}]},{"number":15,"lines":[{"text":"By me kings reign,","poem":1},{"text":"and rulers enact just laws;","poem":2}]},{"number":16,"lines":[{"text":"By me princes rule,","poem":1},{"text":"and all nobles who govern justly.","poem":2}]},{"number":17,"lines":[{"text":"I love those who love me,","poem":1},{"text":"and those who seek me early shall find me.","poem":2}]},{"number":18,"lines":[{"text":"With me are riches and honor,","poem":1},{"text":"enduring wealth and righteousness.","poem":2}]},{"number":19,"lines":[{"text":"My fruit is better than gold, pure gold,","poem":1},{"text":"and my harvest surpasses choice silver.","poem":2}]},{"number":20,"lines":[{"text":"I walk in the way of righteousness,","poem":1},{"text":"along the paths of justice,","poem":2}]},{"number":21,"lines":[{"text":"bestowing wealth on those who love me","poem":1},{"text":"and making their treasuries full.","poem":2}]},{"number":22,"lines":[{"text":"The LORD created me as His first course,","poem":1},{"text":"before His works of old.","poem":2}]},{"number":23,"lines":[{"text":"From everlasting I was established,","poem":1},{"text":"from the beginning, before the earth began.","poem":2}]},{"number":24,"lines":[{"text":"When there were no watery depths, I was brought forth,","poem":1},{"text":"when no springs were overflowing with water.","poem":2}]},{"number":25,"lines":[{"text":"Before the mountains were settled,","poem":1},{"text":"before the hills, I was brought forth,","poem":2}]},{"number":26,"lines":[{"text":"before He made the land or fields,","poem":1},{"text":"or any of the dust of the earth.","poem":2}]},{"number":27,"lines":[{"text":"I was there when He established the heavens,","poem":1},{"text":"when He inscribed a circle on the face of the deep,","poem":2}]},{"number":28,"lines":[{"text":"when He established the clouds above,","poem":1},{"text":"when the fountains of the deep gushed forth,","poem":2}]},{"number":29,"lines":[{"text":"when He set a boundary for the sea,","poem":1},{"text":"so that the waters would not surpass His command,","poem":2},{"text":"when He marked out the foundations of the earth.","poem":2}]},{"number":30,"lines":[{"text":"Then I was a skilled craftsman at His side,","poem":1},{"text":"and His delight day by day,","poem":2},{"text":"rejoicing always in His presence.","poem":2}]},{"number":31,"lines":[{"text":"I was rejoicing in His whole world,","poem":1},{"text":"delighting together in the sons of men.","poem":2}]},{"number":32,"lines":[{"text":"Now therefore, my sons, listen to me,","poem":1},{"text":"for blessed are those who keep my ways.","poem":2}]},{"number":33,"lines":[{"text":"Listen to instruction and be wise;","poem":1},{"text":"do not ignore it.","poem":2}]},{"number":34,"lines":[{"text":"Blessed is the man who listens to me,","poem":1},{"text":"watching daily at my doors,","poem":2},{"text":"waiting at the posts of my doorway.","poem":2}]},{"number":35,"lines":[{"text":"For whoever finds me finds life","poem":1},{"text":"and obtains the favor of the LORD.","poem":2}]},{"number":36,"lines":[{"text":"But he who fails to find me harms himself;","poem":1},{"text":"all who hate me love death.”","poem":2}]}]},{"number":9,"lastVerse":18,"verses":[{"number":1,"lines":[{"text":"Wisdom has built her house;","poem":1},{"text":"she has carved out her seven pillars.","poem":2}]},{"number":2,"lines":[{"text":"She has prepared her meat and mixed her wine;","poem":1},{"text":"she has also set her table.","poem":2}]},{"number":3,"lines":[{"text":"She has sent out her maidservants;","poem":1},{"text":"she calls out from the heights of the city.","poem":2}]},{"number":4,"lines":[{"text":"“Whoever is simple, let him turn in here!”","poem":1},{"text":"she says to him who lacks judgment.","poem":2}]},{"number":5,"lines":[{"text":"“Come, eat my bread","poem":1},{"text":"and drink the wine I have mixed.","poem":2}]},{"number":6,"lines":[{"text":"Leave your folly behind, and you will live;","poem":1},{"text":"walk in the way of understanding.”","poem":2}]},{"number":7,"lines":[{"text":"He who corrects a mocker brings shame on himself;","poem":1},{"text":"he who rebukes a wicked man taints himself.","poem":2}]},{"number":8,"lines":[{"text":"Do not rebuke a mocker, or he will hate you;","poem":1},{"text":"rebuke a wise man, and he will love you.","poem":2}]},{"number":9,"lines":[{"text":"Instruct a wise man, and he will be wiser still;","poem":1},{"text":"teach a righteous man, and he will increase his learning.","poem":2}]},{"number":10,"lines":[{"text":"The fear of the LORD is the beginning of wisdom,","poem":1},{"text":"and knowledge of the Holy One is understanding.","poem":2}]},{"number":11,"lines":[{"text":"For through wisdom your days will be multiplied,","poem":1},{"text":"and years will be added to your life.","poem":2}]},{"number":12,"lines":[{"text":"If you are wise, you are wise to your own advantage;","poem":1},{"text":"but if you scoff, you alone will bear the consequences.","poem":2}]},{"number":13,"lines":[{"text":"The woman named Folly is loud;","poem":1},{"text":"she is naive and knows nothing.","poem":2}]},{"number":14,"lines":[{"text":"She sits at the door of her house,","poem":1},{"text":"on a seat in the heights of the city,","poem":2}]},{"number":15,"lines":[{"text":"calling out to those who pass by,","poem":1},{"text":"who make their paths straight.","poem":2}]},{"number":16,"lines":[{"text":"“Whoever is simple, let him turn in here!”","poem":1},{"text":"she says to him who lacks judgment.","poem":2}]},{"number":17,"lines":[{"text":"“Stolen water is sweet,","poem":1},{"text":"and bread eaten in secret is tasty!”","poem":2}]},{"number":18,"lines":[{"text":"But they do not know that the dead are there,","poem":1},{"text":"that her guests are in the depths of Sheol.","poem":2}]}]},{"number":10,"lastVerse":32,"verses":[{"number":1,"lines":[{"text":"The proverbs of Solomon:"},{"text":"A wise son brings joy to his father,","poem":1},{"text":"but a foolish son grief to his mother.","poem":2}]},{"number":2,"lines":[{"text":"Ill-gotten treasures profit nothing,","poem":1},{"text":"but righteousness brings deliverance from death.","poem":2}]},{"number":3,"lines":[{"text":"The LORD does not let the righteous go hungry,","poem":1},{"text":"but He denies the craving of the wicked.","poem":2}]},{"number":4,"lines":[{"text":"Idle hands make one poor,","poem":1},{"text":"but diligent hands bring wealth.","poem":2}]},{"number":5,"lines":[{"text":"He who gathers in summer is a wise son,","poem":1},{"text":"but he who sleeps during harvest is a disgraceful son.","poem":2}]},{"number":6,"lines":[{"text":"Blessings are on the head of the righteous,","poem":1},{"text":"but the mouth of the wicked conceals violence.","poem":2}]},{"number":7,"lines":[{"text":"The memory of the righteous is a blessing,","poem":1},{"text":"but the name of the wicked will rot.","poem":2}]},{"number":8,"lines":[{"text":"A wise heart will receive commandments,","poem":1},{"text":"but foolish lips will come to ruin.","poem":2}]},{"number":9,"lines":[{"text":"He who walks in integrity walks securely,","poem":1},{"text":"but he who perverts his ways will be found out.","poem":2}]},{"number":10,"lines":[{"text":"He who winks the eye causes grief,","poem":1},{"text":"and foolish lips will come to ruin.","poem":2}]},{"number":11,"lines":[{"text":"The mouth of the righteous is a fountain of life,","poem":1},{"text":"but the mouth of the wicked conceals violence.","poem":2}]},{"number":12,"lines":[{"text":"Hatred stirs up dissension,","poem":1},{"text":"but love covers all transgressions.","poem":2}]},{"number":13,"lines":[{"text":"Wisdom is found on the lips of the discerning,","poem":1},{"text":"but a rod is for the back of him who lacks judgment.","poem":2}]},{"number":14,"lines":[{"text":"The wise store up knowledge,","poem":1},{"text":"but the mouth of the fool invites destruction.","poem":2}]},{"number":15,"lines":[{"text":"The wealth of the rich man is his fortified city,","poem":1},{"text":"but poverty is the ruin of the poor.","poem":2}]},{"number":16,"lines":[{"text":"The labor of the righteous leads to life,","poem":1},{"text":"but the gain of the wicked brings punishment.","poem":2}]},{"number":17,"lines":[{"text":"Whoever heeds instruction is on the path to life,","poem":1},{"text":"but he who ignores reproof goes astray.","poem":2}]},{"number":18,"lines":[{"text":"The one who conceals hatred has lying lips,","poem":1},{"text":"and whoever spreads slander is a fool.","poem":2}]},{"number":19,"lines":[{"text":"When words are many, sin is unavoidable,","poem":1},{"text":"but he who restrains his lips is wise.","poem":2}]},{"number":20,"lines":[{"text":"The tongue of the righteous is choice silver,","poem":1},{"text":"but the heart of the wicked has little worth.","poem":2}]},{"number":21,"lines":[{"text":"The lips of the righteous feed many,","poem":1},{"text":"but fools die for lack of judgment.","poem":2}]},{"number":22,"lines":[{"text":"The blessing of the LORD enriches,","poem":1},{"text":"and He adds no sorrow to it.","poem":2}]},{"number":23,"lines":[{"text":"The fool delights in shameful conduct,","poem":1},{"text":"but a man of understanding has wisdom.","poem":2}]},{"number":24,"lines":[{"text":"What the wicked man dreads will overtake him,","poem":1},{"text":"but the desire of the righteous will be granted.","poem":2}]},{"number":25,"lines":[{"text":"When the whirlwind passes, the wicked are no more,","poem":1},{"text":"but the righteous are secure forever.","poem":2}]},{"number":26,"lines":[{"text":"Like vinegar to the teeth and smoke to the eyes,","poem":1},{"text":"so is the slacker to those who send him.","poem":2}]},{"number":27,"lines":[{"text":"The fear of the LORD prolongs life,","poem":1},{"text":"but the years of the wicked will be cut short.","poem":2}]},{"number":28,"lines":[{"text":"The hope of the righteous is joy,","poem":1},{"text":"but the expectations of the wicked will perish.","poem":2}]},{"number":29,"lines":[{"text":"The way of the LORD is a refuge to the upright,","poem":1},{"text":"but destruction awaits those who do evil.","poem":2}]},{"number":30,"lines":[{"text":"The righteous will never be shaken,","poem":1},{"text":"but the wicked will not inhabit the land.","poem":2}]},{"number":31,"lines":[{"text":"The mouth of the righteous brings forth wisdom,","poem":1},{"text":"but a perverse tongue will be cut out.","poem":2}]},{"number":32,"lines":[{"text":"The lips of the righteous know what is fitting,","poem":1},{"text":"but the mouth of the wicked is perverse.","poem":2}]}]},{"number":11,"lastVerse":31,"verses":[{"number":1,"lines":[{"text":"Dishonest scales are an abomination to the LORD,","poem":1},{"text":"but an accurate weight is His delight.","poem":2}]},{"number":2,"lines":[{"text":"When pride comes, disgrace follows,","poem":1},{"text":"but with humility comes wisdom.","poem":2}]},{"number":3,"lines":[{"text":"The integrity of the upright guides them,","poem":1},{"text":"but the perversity of the faithless destroys them.","poem":2}]},{"number":4,"lines":[{"text":"Riches are worthless in the day of wrath,","poem":1},{"text":"but righteousness brings deliverance from death.","poem":2}]},{"number":5,"lines":[{"text":"The righteousness of the blameless directs their path,","poem":1},{"text":"but the wicked fall by their own wickedness.","poem":2}]},{"number":6,"lines":[{"text":"The righteousness of the upright delivers them,","poem":1},{"text":"but the faithless are trapped by their own desires.","poem":2}]},{"number":7,"lines":[{"text":"When the wicked man dies, his hope perishes,","poem":1},{"text":"and the hope of his strength vanishes.","poem":2}]},{"number":8,"lines":[{"text":"The righteous man is delivered from trouble;","poem":1},{"text":"in his place the wicked man goes in.","poem":2}]},{"number":9,"lines":[{"text":"With his mouth the ungodly man destroys his neighbor,","poem":1},{"text":"but through knowledge the righteous are rescued.","poem":2}]},{"number":10,"lines":[{"text":"When the righteous thrive, the city rejoices,","poem":1},{"text":"and when the wicked perish, there are shouts of joy.","poem":2}]},{"number":11,"lines":[{"text":"By the blessing of the upright a city is built up,","poem":1},{"text":"but by the mouth of the wicked it is torn down.","poem":2}]},{"number":12,"lines":[{"text":"Whoever shows contempt for his neighbor lacks judgment,","poem":1},{"text":"but a man of understanding remains silent.","poem":2}]},{"number":13,"lines":[{"text":"A gossip reveals a secret,","poem":1},{"text":"but a trustworthy person keeps a confidence.","poem":2}]},{"number":14,"lines":[{"text":"For lack of guidance, a nation falls,","poem":1},{"text":"but with many counselors comes deliverance.","poem":2}]},{"number":15,"lines":[{"text":"He who puts up security for a stranger will surely suffer,","poem":1},{"text":"but the one who hates indebtedness is secure.","poem":2}]},{"number":16,"lines":[{"text":"A gracious woman attains honor,","poem":1},{"text":"but ruthless men gain only wealth.","poem":2}]},{"number":17,"lines":[{"text":"A kind man benefits himself,","poem":1},{"text":"but a cruel man brings trouble on himself.","poem":2}]},{"number":18,"lines":[{"text":"The wicked man earns an empty wage,","poem":1},{"text":"but he who sows righteousness reaps a true reward.","poem":2}]},{"number":19,"lines":[{"text":"Genuine righteousness leads to life,","poem":1},{"text":"but the pursuit of evil brings death.","poem":2}]},{"number":20,"lines":[{"text":"The perverse in heart are an abomination to the LORD,","poem":1},{"text":"but the blameless in their walk are His delight.","poem":2}]},{"number":21,"lines":[{"text":"Be assured that the wicked will not go unpunished,","poem":1},{"text":"but the offspring of the righteous will escape.","poem":2}]},{"number":22,"lines":[{"text":"Like a gold ring in a pig’s snout","poem":1},{"text":"is a beautiful woman who lacks discretion.","poem":2}]},{"number":23,"lines":[{"text":"The desire of the righteous leads only to good,","poem":1},{"text":"but the hope of the wicked brings wrath.","poem":2}]},{"number":24,"lines":[{"text":"One gives freely, yet gains even more;","poem":1},{"text":"another withholds what is right, only to become poor.","poem":2}]},{"number":25,"lines":[{"text":"A generous soul will prosper,","poem":1},{"text":"and he who refreshes others will himself be refreshed.","poem":2}]},{"number":26,"lines":[{"text":"The people will curse the hoarder of grain,","poem":1},{"text":"but blessing will crown the one who sells it.","poem":2}]},{"number":27,"lines":[{"text":"He who searches out good finds favor,","poem":1},{"text":"but evil will come to him who seeks it.","poem":2}]},{"number":28,"lines":[{"text":"He who trusts in his riches will fall,","poem":1},{"text":"but the righteous will thrive like foliage.","poem":2}]},{"number":29,"lines":[{"text":"He who brings trouble on his house will inherit the wind,","poem":1},{"text":"and the fool will be servant to the wise of heart.","poem":2}]},{"number":30,"lines":[{"text":"The fruit of the righteous is a tree of life,","poem":1},{"text":"and he who wins souls is wise.","poem":2}]},{"number":31,"lines":[{"text":"If the righteous receive their due on earth,","poem":1},{"text":"how much more the ungodly and the sinner!","poem":2}]}]},{"number":12,"lastVerse":28,"verses":[{"number":1,"lines":[{"text":"Whoever loves discipline loves knowledge,","poem":1},{"text":"but he who hates correction is stupid.","poem":2}]},{"number":2,"lines":[{"text":"The good man obtains favor from the LORD,","poem":1},{"text":"but the LORD condemns a man who devises evil.","poem":2}]},{"number":3,"lines":[{"text":"A man cannot be established through wickedness,","poem":1},{"text":"but the righteous cannot be uprooted.","poem":2}]},{"number":4,"lines":[{"text":"A wife of noble character is her husband’s crown,","poem":1},{"text":"but she who causes shame is like decay in his bones.","poem":2}]},{"number":5,"lines":[{"text":"The plans of the righteous are just,","poem":1},{"text":"but the counsel of the wicked leads to deceit.","poem":2}]},{"number":6,"lines":[{"text":"The words of the wicked lie in wait for blood,","poem":1},{"text":"but the speech of the upright rescues them.","poem":2}]},{"number":7,"lines":[{"text":"The wicked are overthrown and perish,","poem":1},{"text":"but the house of the righteous will stand.","poem":2}]},{"number":8,"lines":[{"text":"A man is praised according to his wisdom,","poem":1},{"text":"but a twisted mind is despised.","poem":2}]},{"number":9,"lines":[{"text":"Better to be lightly esteemed yet have a servant,","poem":1},{"text":"than to be self-important but lack food.","poem":2}]},{"number":10,"lines":[{"text":"A righteous man regards the life of his animal,","poem":1},{"text":"but the tender mercies of the wicked are only cruelty.","poem":2}]},{"number":11,"lines":[{"text":"The one who works his land will have plenty of food,","poem":1},{"text":"but whoever chases fantasies lacks judgment.","poem":2}]},{"number":12,"lines":[{"text":"The wicked desire the plunder of evil men,","poem":1},{"text":"but the root of the righteous flourishes.","poem":2}]},{"number":13,"lines":[{"text":"An evil man is trapped by his rebellious speech,","poem":1},{"text":"but a righteous man escapes from trouble.","poem":2}]},{"number":14,"lines":[{"text":"By fruitful speech a man is filled with good things,","poem":1},{"text":"and the work of his hands returns to him.","poem":2}]},{"number":15,"lines":[{"text":"The way of a fool is right in his own eyes,","poem":1},{"text":"but a wise man listens to counsel.","poem":2}]},{"number":16,"lines":[{"text":"A fool’s anger is known at once,","poem":1},{"text":"but a prudent man overlooks an insult.","poem":2}]},{"number":17,"lines":[{"text":"He who speaks the truth declares what is right,","poem":1},{"text":"but a false witness speaks deceit.","poem":2}]},{"number":18,"lines":[{"text":"Speaking rashly is like a piercing sword,","poem":1},{"text":"but the tongue of the wise brings healing.","poem":2}]},{"number":19,"lines":[{"text":"Truthful lips endure forever,","poem":1},{"text":"but a lying tongue lasts only a moment.","poem":2}]},{"number":20,"lines":[{"text":"Deceit is in the hearts of those who devise evil,","poem":1},{"text":"but the counselors of peace have joy.","poem":2}]},{"number":21,"lines":[{"text":"No harm befalls the righteous,","poem":1},{"text":"but the wicked are filled with trouble.","poem":2}]},{"number":22,"lines":[{"text":"Lying lips are detestable to the LORD,","poem":1},{"text":"but those who deal faithfully are His delight.","poem":2}]},{"number":23,"lines":[{"text":"A shrewd man keeps his knowledge to himself,","poem":1},{"text":"but a foolish heart proclaims its folly.","poem":2}]},{"number":24,"lines":[{"text":"The hand of the diligent will rule,","poem":1},{"text":"but laziness ends in forced labor.","poem":2}]},{"number":25,"lines":[{"text":"Anxiety weighs down the heart of a man,","poem":1},{"text":"but a good word cheers it up.","poem":2}]},{"number":26,"lines":[{"text":"A righteous man is cautious in friendship,","poem":1},{"text":"but the ways of the wicked lead them astray.","poem":2}]},{"number":27,"lines":[{"text":"A lazy man does not roast his game,","poem":1},{"text":"but a diligent man prizes his possession.","poem":2}]},{"number":28,"lines":[{"text":"There is life in the path of righteousness,","poem":1},{"text":"but another path leads to death.","poem":2}]}]},{"number":13,"lastVerse":25,"verses":[{"number":1,"lines":[{"text":"A wise son heeds his father’s discipline,","poem":1},{"text":"but a mocker does not listen to rebuke.","poem":2}]},{"number":2,"lines":[{"text":"From the fruit of his lips a man enjoys good things,","poem":1},{"text":"but the desire of the faithless is violence.","poem":2}]},{"number":3,"lines":[{"text":"He who guards his mouth protects his life,","poem":1},{"text":"but the one who opens his lips invites his own ruin.","poem":2}]},{"number":4,"lines":[{"text":"The slacker craves yet has nothing,","poem":1},{"text":"but the soul of the diligent is fully satisfied.","poem":2}]},{"number":5,"lines":[{"text":"The righteous hate falsehood,","poem":1},{"text":"but the wicked bring shame and disgrace.","poem":2}]},{"number":6,"lines":[{"text":"Righteousness guards the man of integrity,","poem":1},{"text":"but wickedness undermines the sinner.","poem":2}]},{"number":7,"lines":[{"text":"One pretends to be rich, but has nothing;","poem":1},{"text":"another pretends to be poor, yet has great wealth.","poem":2}]},{"number":8,"lines":[{"text":"Riches may ransom a man’s life,","poem":1},{"text":"but a poor man hears no threat.","poem":2}]},{"number":9,"lines":[{"text":"The light of the righteous shines brightly,","poem":1},{"text":"but the lamp of the wicked is extinguished.","poem":2}]},{"number":10,"lines":[{"text":"Arrogance leads only to strife,","poem":1},{"text":"but wisdom is with the well-advised.","poem":2}]},{"number":11,"lines":[{"text":"Dishonest wealth will dwindle,","poem":1},{"text":"but what is earned through hard work will be multiplied.","poem":2}]},{"number":12,"lines":[{"text":"Hope deferred makes the heart sick,","poem":1},{"text":"but desire fulfilled is a tree of life.","poem":2}]},{"number":13,"lines":[{"text":"He who despises instruction will pay the penalty,","poem":1},{"text":"but the one who respects a command will be rewarded.","poem":2}]},{"number":14,"lines":[{"text":"The teaching of the wise is a fountain of life,","poem":1},{"text":"turning one from the snares of death.","poem":2}]},{"number":15,"lines":[{"text":"Good understanding wins favor,","poem":1},{"text":"but the way of the faithless is difficult.","poem":2}]},{"number":16,"lines":[{"text":"Every prudent man acts with knowledge,","poem":1},{"text":"but a fool displays his folly.","poem":2}]},{"number":17,"lines":[{"text":"A wicked messenger falls into trouble,","poem":1},{"text":"but a faithful envoy brings healing.","poem":2}]},{"number":18,"lines":[{"text":"Poverty and shame come to him who ignores discipline,","poem":1},{"text":"but whoever heeds correction is honored.","poem":2}]},{"number":19,"lines":[{"text":"Desire fulfilled is sweet to the soul,","poem":1},{"text":"but turning from evil is detestable to fools.","poem":2}]},{"number":20,"lines":[{"text":"He who walks with the wise will become wise,","poem":1},{"text":"but the companion of fools will be destroyed.","poem":2}]},{"number":21,"lines":[{"text":"Disaster pursues sinners,","poem":1},{"text":"but prosperity is the reward of the righteous.","poem":2}]},{"number":22,"lines":[{"text":"A good man leaves an inheritance to his children’s children,","poem":1},{"text":"but the sinner’s wealth is passed to the righteous.","poem":2}]},{"number":23,"lines":[{"text":"Abundant food is in the fallow ground of the poor,","poem":1},{"text":"but without justice it is swept away.","poem":2}]},{"number":24,"lines":[{"text":"He who spares the rod hates his son,","poem":1},{"text":"but he who loves him disciplines him diligently.","poem":2}]},{"number":25,"lines":[{"text":"A righteous man eats to his heart’s content,","poem":1},{"text":"but the stomach of the wicked is empty.","poem":2}]}]},{"number":14,"lastVerse":35,"verses":[{"number":1,"lines":[{"text":"Every wise woman builds her house,","poem":1},{"text":"but a foolish one tears it down with her own hands.","poem":2}]},{"number":2,"lines":[{"text":"He who walks in uprightness fears the LORD,","poem":1},{"text":"but the one who is devious in his ways despises Him.","poem":2}]},{"number":3,"lines":[{"text":"The proud speech of a fool brings a rod to his back,","poem":1},{"text":"but the lips of the wise protect them.","poem":2}]},{"number":4,"lines":[{"text":"Where there are no oxen, the manger is empty,","poem":1},{"text":"but an abundant harvest comes through the strength of the ox.","poem":2}]},{"number":5,"lines":[{"text":"An honest witness does not deceive,","poem":1},{"text":"but a dishonest witness pours forth lies.","poem":2}]},{"number":6,"lines":[{"text":"A mocker seeks wisdom and finds none,","poem":1},{"text":"but knowledge comes easily to the discerning.","poem":2}]},{"number":7,"lines":[{"text":"Stay away from a foolish man;","poem":1},{"text":"you will gain no knowledge from his speech.","poem":2}]},{"number":8,"lines":[{"text":"The wisdom of the prudent is to discern his way,","poem":1},{"text":"but the folly of fools deceives them.","poem":2}]},{"number":9,"lines":[{"text":"Fools mock the making of amends,","poem":1},{"text":"but goodwill is found among the upright.","poem":2}]},{"number":10,"lines":[{"text":"The heart knows its own bitterness,","poem":1},{"text":"and no stranger shares in its joy.","poem":2}]},{"number":11,"lines":[{"text":"The house of the wicked will be destroyed,","poem":1},{"text":"but the tent of the upright will flourish.","poem":2}]},{"number":12,"lines":[{"text":"There is a way that seems right to a man,","poem":1},{"text":"but its end is the way of death.","poem":2}]},{"number":13,"lines":[{"text":"Even in laughter the heart may ache,","poem":1},{"text":"and joy may end in sorrow.","poem":2}]},{"number":14,"lines":[{"text":"The backslider in heart receives the fill of his own ways,","poem":1},{"text":"but a good man is rewarded for his ways.","poem":2}]},{"number":15,"lines":[{"text":"The simple man believes every word,","poem":1},{"text":"but the prudent man watches his steps.","poem":2}]},{"number":16,"lines":[{"text":"A wise man fears and turns from evil,","poem":1},{"text":"but a fool is careless and reckless.","poem":2}]},{"number":17,"lines":[{"text":"A quick-tempered man acts foolishly,","poem":1},{"text":"and a devious man is hated.","poem":2}]},{"number":18,"lines":[{"text":"The simple inherit folly,","poem":1},{"text":"but the prudent are crowned with knowledge.","poem":2}]},{"number":19,"lines":[{"text":"The evil bow before the good,","poem":1},{"text":"and the wicked at the gates of the righteous.","poem":2}]},{"number":20,"lines":[{"text":"The poor man is hated even by his neighbor,","poem":1},{"text":"but many are those who love the rich.","poem":2}]},{"number":21,"lines":[{"text":"He who despises his neighbor sins,","poem":1},{"text":"but blessed is he who shows kindness to the poor.","poem":2}]},{"number":22,"lines":[{"text":"Do not those who contrive evil go astray?","poem":1},{"text":"But those who plan goodness find loving devotion and faithfulness.","poem":2}]},{"number":23,"lines":[{"text":"There is profit in all labor,","poem":1},{"text":"but mere talk leads only to poverty.","poem":2}]},{"number":24,"lines":[{"text":"The crown of the wise is their wealth,","poem":1},{"text":"but the effort of fools is folly.","poem":2}]},{"number":25,"lines":[{"text":"A truthful witness saves lives,","poem":1},{"text":"but one who utters lies is deceitful.","poem":2}]},{"number":26,"lines":[{"text":"He who fears the LORD is secure in confidence,","poem":1},{"text":"and his children shall have a place of refuge.","poem":2}]},{"number":27,"lines":[{"text":"The fear of the LORD is a fountain of life,","poem":1},{"text":"turning a man from the snares of death.","poem":2}]},{"number":28,"lines":[{"text":"A large population is a king’s splendor,","poem":1},{"text":"but a lack of subjects is a prince’s ruin.","poem":2}]},{"number":29,"lines":[{"text":"A patient man has great understanding,","poem":1},{"text":"but a quick-tempered man promotes folly.","poem":2}]},{"number":30,"lines":[{"text":"A tranquil heart is life to the body,","poem":1},{"text":"but envy rots the bones.","poem":2}]},{"number":31,"lines":[{"text":"Whoever oppresses the poor taunts their Maker,","poem":1},{"text":"but whoever is kind to the needy honors Him.","poem":2}]},{"number":32,"lines":[{"text":"The wicked man is thrown down by his own sin,","poem":1},{"text":"but the righteous man has a refuge even in death.","poem":2}]},{"number":33,"lines":[{"text":"Wisdom rests in the heart of the discerning;","poem":1},{"text":"even among fools she is known.","poem":2}]},{"number":34,"lines":[{"text":"Righteousness exalts a nation,","poem":1},{"text":"but sin is a disgrace to any people.","poem":2}]},{"number":35,"lines":[{"text":"A king delights in a wise servant,","poem":1},{"text":"but his anger falls on the shameful.","poem":2}]}]},{"number":15,"lastVerse":33,"verses":[{"number":1,"lines":[{"text":"A gentle answer turns away wrath,","poem":1},{"text":"but a harsh word stirs up anger.","poem":2}]},{"number":2,"lines":[{"text":"The tongue of the wise commends knowledge,","poem":1},{"text":"but the mouth of the fool spouts folly.","poem":2}]},{"number":3,"lines":[{"text":"The eyes of the LORD are in every place,","poem":1},{"text":"observing the evil and the good.","poem":2}]},{"number":4,"lines":[{"text":"A soothing tongue is a tree of life,","poem":1},{"text":"but a perverse tongue crushes the spirit.","poem":2}]},{"number":5,"lines":[{"text":"A fool rejects his father’s discipline,","poem":1},{"text":"but whoever heeds correction is prudent.","poem":2}]},{"number":6,"lines":[{"text":"The house of the righteous has great treasure,","poem":1},{"text":"but the income of the wicked is trouble.","poem":2}]},{"number":7,"lines":[{"text":"The lips of the wise spread knowledge,","poem":1},{"text":"but not so the hearts of fools.","poem":2}]},{"number":8,"lines":[{"text":"The sacrifice of the wicked is detestable to the LORD,","poem":1},{"text":"but the prayer of the upright is His delight.","poem":2}]},{"number":9,"lines":[{"text":"The LORD detests the way of the wicked,","poem":1},{"text":"but He loves those who pursue righteousness.","poem":2}]},{"number":10,"lines":[{"text":"Discipline is harsh for him who leaves the path;","poem":1},{"text":"he who hates correction will die.","poem":2}]},{"number":11,"lines":[{"text":"Sheol and Abaddon lie open before the LORD—","poem":1},{"text":"how much more the hearts of men!","poem":2}]},{"number":12,"lines":[{"text":"A mocker does not love to be reproved,","poem":1},{"text":"nor will he consult the wise.","poem":2}]},{"number":13,"lines":[{"text":"A joyful heart makes a cheerful countenance,","poem":1},{"text":"but sorrow of the heart crushes the spirit.","poem":2}]},{"number":14,"lines":[{"text":"A discerning heart seeks knowledge,","poem":1},{"text":"but the mouth of a fool feeds on folly.","poem":2}]},{"number":15,"lines":[{"text":"All the days of the oppressed are bad,","poem":1},{"text":"but a cheerful heart has a continual feast.","poem":2}]},{"number":16,"lines":[{"text":"Better a little with the fear of the LORD","poem":1},{"text":"than great treasure with turmoil.","poem":2}]},{"number":17,"lines":[{"text":"Better a dish of vegetables where there is love","poem":1},{"text":"than a fattened ox with hatred.","poem":2}]},{"number":18,"lines":[{"text":"A hot-tempered man stirs up strife,","poem":1},{"text":"but he who is slow to anger calms dispute.","poem":2}]},{"number":19,"lines":[{"text":"The way of the slacker is like a hedge of thorns,","poem":1},{"text":"but the path of the upright is a highway.","poem":2}]},{"number":20,"lines":[{"text":"A wise son brings joy to his father,","poem":1},{"text":"but a foolish man despises his mother.","poem":2}]},{"number":21,"lines":[{"text":"Folly is joy to one who lacks judgment,","poem":1},{"text":"but a man of understanding walks a straight path.","poem":2}]},{"number":22,"lines":[{"text":"Plans fail for lack of counsel,","poem":1},{"text":"but with many advisers they succeed.","poem":2}]},{"number":23,"lines":[{"text":"A man takes joy in a fitting reply—","poem":1},{"text":"and how good is a timely word!","poem":2}]},{"number":24,"lines":[{"text":"The path of life leads upward for the wise,","poem":1},{"text":"that he may avoid going down to Sheol.","poem":2}]},{"number":25,"lines":[{"text":"The LORD tears down the house of the proud,","poem":1},{"text":"but He protects the boundaries of the widow.","poem":2}]},{"number":26,"lines":[{"text":"The LORD detests the thoughts of the wicked,","poem":1},{"text":"but the words of the pure are pleasant to Him.","poem":2}]},{"number":27,"lines":[{"text":"He who is greedy for unjust gain brings trouble on his household,","poem":1},{"text":"but he who hates bribes will live.","poem":2}]},{"number":28,"lines":[{"text":"The heart of the righteous ponders how to answer,","poem":1},{"text":"but the mouth of the wicked blurts out evil.","poem":2}]},{"number":29,"lines":[{"text":"The LORD is far from the wicked,","poem":1},{"text":"but He hears the prayer of the righteous.","poem":2}]},{"number":30,"lines":[{"text":"The light of the eyes cheers the heart,","poem":1},{"text":"and good news nourishes the bones.","poem":2}]},{"number":31,"lines":[{"text":"He who listens to life-giving reproof","poem":1},{"text":"will dwell among the wise.","poem":2}]},{"number":32,"lines":[{"text":"He who ignores discipline despises himself,","poem":1},{"text":"but whoever heeds correction gains understanding.","poem":2}]},{"number":33,"lines":[{"text":"The fear of the LORD is the instruction of wisdom,","poem":1},{"text":"and humility comes before honor.","poem":2}]}]},{"number":16,"lastVerse":33,"verses":[{"number":1,"lines":[{"text":"The plans of the heart belong to man,","poem":1},{"text":"but the reply of the tongue is from the LORD.","poem":2}]},{"number":2,"lines":[{"text":"All a man’s ways are pure in his own eyes,","poem":1},{"text":"but his motives are weighed out by the LORD.","poem":2}]},{"number":3,"lines":[{"text":"Commit your works to the LORD","poem":1},{"text":"and your plans will be achieved.","poem":2}]},{"number":4,"lines":[{"text":"The LORD has made everything for His purpose—","poem":1},{"text":"even the wicked for the day of disaster.","poem":2}]},{"number":5,"lines":[{"text":"Everyone who is proud in heart is detestable to the LORD;","poem":1},{"text":"be assured that he will not go unpunished.","poem":2}]},{"number":6,"lines":[{"text":"By loving devotion and faithfulness iniquity is atoned for,","poem":1},{"text":"and by the fear of the LORD one turns aside from evil.","poem":2}]},{"number":7,"lines":[{"text":"When a man’s ways please the LORD,","poem":1},{"text":"He makes even the man’s enemies live at peace with him.","poem":2}]},{"number":8,"lines":[{"text":"Better a little with righteousness","poem":1},{"text":"than great gain with injustice.","poem":2}]},{"number":9,"lines":[{"text":"A man’s heart plans his course,","poem":1},{"text":"but the LORD determines his steps.","poem":2}]},{"number":10,"lines":[{"text":"A divine verdict is on the lips of a king;","poem":1},{"text":"his mouth must not betray justice.","poem":2}]},{"number":11,"lines":[{"text":"Honest scales and balances are from the LORD;","poem":1},{"text":"all the weights in the bag are His concern.","poem":2}]},{"number":12,"lines":[{"text":"Wicked behavior is detestable for kings,","poem":1},{"text":"for a throne is established through righteousness.","poem":2}]},{"number":13,"lines":[{"text":"Righteous lips are a king’s delight,","poem":1},{"text":"and he who speaks honestly is beloved.","poem":2}]},{"number":14,"lines":[{"text":"The wrath of a king is a messenger of death,","poem":1},{"text":"but a wise man will pacify it.","poem":2}]},{"number":15,"lines":[{"text":"When a king’s face brightens, there is life;","poem":1},{"text":"his favor is like a rain cloud in spring.","poem":2}]},{"number":16,"lines":[{"text":"How much better to acquire wisdom than gold!","poem":1},{"text":"To gain understanding is more desirable than silver.","poem":2}]},{"number":17,"lines":[{"text":"The highway of the upright leads away from evil;","poem":1},{"text":"he who guards his way protects his life.","poem":2}]},{"number":18,"lines":[{"text":"Pride goes before destruction,","poem":1},{"text":"and a haughty spirit before a fall.","poem":2}]},{"number":19,"lines":[{"text":"It is better to be lowly in spirit among the humble","poem":1},{"text":"than to divide the spoil with the proud.","poem":2}]},{"number":20,"lines":[{"text":"Whoever heeds instruction will find success,","poem":1},{"text":"and blessed is he who trusts in the LORD.","poem":2}]},{"number":21,"lines":[{"text":"The wise in heart are called discerning,","poem":1},{"text":"and pleasant speech promotes instruction.","poem":2}]},{"number":22,"lines":[{"text":"Understanding is a fountain of life to its possessor,","poem":1},{"text":"but the discipline of fools is folly.","poem":2}]},{"number":23,"lines":[{"text":"The heart of the wise man instructs his mouth","poem":1},{"text":"and adds persuasiveness to his lips.","poem":2}]},{"number":24,"lines":[{"text":"Pleasant words are a honeycomb,","poem":1},{"text":"sweet to the soul and healing to the bones.","poem":2}]},{"number":25,"lines":[{"text":"There is a way that seems right to a man,","poem":1},{"text":"but its end is the way of death.","poem":2}]},{"number":26,"lines":[{"text":"A worker’s appetite works for him","poem":1},{"text":"because his hunger drives him onward.","poem":2}]},{"number":27,"lines":[{"text":"A worthless man digs up evil,","poem":1},{"text":"and his speech is like a scorching fire.","poem":2}]},{"number":28,"lines":[{"text":"A perverse man spreads dissension,","poem":1},{"text":"and a gossip divides close friends.","poem":2}]},{"number":29,"lines":[{"text":"A violent man entices his neighbor","poem":1},{"text":"and leads him down a path that is not good.","poem":2}]},{"number":30,"lines":[{"text":"He who winks his eye devises perversity;","poem":1},{"text":"he who purses his lips is bent on evil.","poem":2}]},{"number":31,"lines":[{"text":"Gray hair is a crown of glory;","poem":1},{"text":"it is attained along the path of righteousness.","poem":2}]},{"number":32,"lines":[{"text":"He who is slow to anger is better than a warrior,","poem":1},{"text":"and he who controls his temper is greater than one who captures a city.","poem":2}]},{"number":33,"lines":[{"text":"The lot is cast into the lap,","poem":1},{"text":"but its every decision is from the LORD.","poem":2}]}]},{"number":17,"lastVerse":28,"verses":[{"number":1,"lines":[{"text":"Better a dry morsel in quietness","poem":1},{"text":"than a house full of feasting with strife.","poem":2}]},{"number":2,"lines":[{"text":"A wise servant will rule over a disgraceful son","poem":1},{"text":"and share his inheritance as one of the brothers.","poem":2}]},{"number":3,"lines":[{"text":"A crucible for silver and a furnace for gold,","poem":1},{"text":"but the LORD is the tester of hearts.","poem":2}]},{"number":4,"lines":[{"text":"A wicked man listens to evil lips;","poem":1},{"text":"a liar gives ear to a destructive tongue.","poem":2}]},{"number":5,"lines":[{"text":"He who mocks the poor insults their Maker;","poem":1},{"text":"whoever gloats over calamity will not go unpunished.","poem":2}]},{"number":6,"lines":[{"text":"Grandchildren are the crown of the aged,","poem":1},{"text":"and the glory of a son is his father.","poem":2}]},{"number":7,"lines":[{"text":"Eloquent words are unfit for a fool;","poem":1},{"text":"how much worse are lying lips to a ruler!","poem":2}]},{"number":8,"lines":[{"text":"A bribe is a charm to its giver;","poem":1},{"text":"wherever he turns, he succeeds.","poem":2}]},{"number":9,"lines":[{"text":"Whoever conceals an offense promotes love,","poem":1},{"text":"but he who brings it up separates friends.","poem":2}]},{"number":10,"lines":[{"text":"A rebuke cuts into a man of discernment","poem":1},{"text":"deeper than a hundred lashes cut into a fool.","poem":2}]},{"number":11,"lines":[{"text":"An evil man seeks only rebellion;","poem":1},{"text":"a cruel messenger will be sent against him.","poem":2}]},{"number":12,"lines":[{"text":"It is better to meet a bear robbed of her cubs","poem":1},{"text":"than a fool in his folly.","poem":2}]},{"number":13,"lines":[{"text":"If anyone returns evil for good,","poem":1},{"text":"evil will never leave his house.","poem":2}]},{"number":14,"lines":[{"text":"To start a quarrel is to release a flood;","poem":1},{"text":"so abandon the dispute before it breaks out.","poem":2}]},{"number":15,"lines":[{"text":"Acquitting the guilty and condemning the righteous—","poem":1},{"text":"both are detestable to the LORD.","poem":2}]},{"number":16,"lines":[{"text":"Why should the fool have money in his hand","poem":1},{"text":"with no intention of buying wisdom?","poem":2}]},{"number":17,"lines":[{"text":"A friend loves at all times,","poem":1},{"text":"and a brother is born for adversity.","poem":2}]},{"number":18,"lines":[{"text":"A man lacking judgment strikes hands in pledge","poem":1},{"text":"and puts up security for his neighbor.","poem":2}]},{"number":19,"lines":[{"text":"He who loves transgression loves strife;","poem":1},{"text":"he who builds his gate high invites destruction.","poem":2}]},{"number":20,"lines":[{"text":"The one with a perverse heart finds no good,","poem":1},{"text":"and he whose tongue is deceitful falls into trouble.","poem":2}]},{"number":21,"lines":[{"text":"A man fathers a fool to his own grief;","poem":1},{"text":"the father of a fool has no joy.","poem":2}]},{"number":22,"lines":[{"text":"A joyful heart is good medicine,","poem":1},{"text":"but a broken spirit dries up the bones.","poem":2}]},{"number":23,"lines":[{"text":"A wicked man takes a covert bribe","poem":1},{"text":"to subvert the course of justice.","poem":2}]},{"number":24,"lines":[{"text":"Wisdom is the focus of the discerning,","poem":1},{"text":"but the eyes of a fool wander to the ends of the earth.","poem":2}]},{"number":25,"lines":[{"text":"A foolish son brings grief to his father","poem":1},{"text":"and bitterness to her who bore him.","poem":2}]},{"number":26,"lines":[{"text":"It is surely not good to punish the innocent","poem":1},{"text":"or to flog a noble for his honesty.","poem":2}]},{"number":27,"lines":[{"text":"A man of knowledge restrains his words,","poem":1},{"text":"and a man of understanding maintains a calm spirit.","poem":2}]},{"number":28,"lines":[{"text":"Even a fool is considered wise if he keeps silent,","poem":1},{"text":"and discerning when he holds his tongue.","poem":2}]}]},{"number":18,"lastVerse":24,"verses":[{"number":1,"lines":[{"text":"He who isolates himself pursues selfish desires;","poem":1},{"text":"he rebels against all sound judgment.","poem":2}]},{"number":2,"lines":[{"text":"A fool does not delight in understanding,","poem":1},{"text":"but only in airing his opinions.","poem":2}]},{"number":3,"lines":[{"text":"With a wicked man comes contempt as well,","poem":1},{"text":"and shame is accompanied by disgrace.","poem":2}]},{"number":4,"lines":[{"text":"The words of a man’s mouth are deep waters;","poem":1},{"text":"the fountain of wisdom is a bubbling brook.","poem":2}]},{"number":5,"lines":[{"text":"Showing partiality to the wicked is not good,","poem":1},{"text":"nor is depriving the innocent of justice.","poem":2}]},{"number":6,"lines":[{"text":"A fool’s lips bring him strife,","poem":1},{"text":"and his mouth invites a beating.","poem":2}]},{"number":7,"lines":[{"text":"A fool’s mouth is his ruin,","poem":1},{"text":"and his lips are a snare to his soul.","poem":2}]},{"number":8,"lines":[{"text":"The words of a gossip are like choice morsels","poem":1},{"text":"that go down into the inmost being.","poem":2}]},{"number":9,"lines":[{"text":"Whoever is slothful in his work","poem":1},{"text":"is brother to him who destroys.","poem":2}]},{"number":10,"lines":[{"text":"The name of the LORD is a strong tower;","poem":1},{"text":"the righteous run to it and are safe.","poem":2}]},{"number":11,"lines":[{"text":"A rich man’s wealth is his fortified city;","poem":1},{"text":"it is like a high wall in his imagination.","poem":2}]},{"number":12,"lines":[{"text":"Before his downfall a man’s heart is proud,","poem":1},{"text":"but humility comes before honor.","poem":2}]},{"number":13,"lines":[{"text":"He who answers a matter before he hears it—","poem":1},{"text":"this is folly and disgrace to him.","poem":2}]},{"number":14,"lines":[{"text":"The spirit of a man can endure his sickness,","poem":1},{"text":"but who can survive a broken spirit?","poem":2}]},{"number":15,"lines":[{"text":"The heart of the discerning acquires knowledge,","poem":1},{"text":"and the ear of the wise seeks it out.","poem":2}]},{"number":16,"lines":[{"text":"A man’s gift opens doors for him,","poem":1},{"text":"and brings him before great men.","poem":2}]},{"number":17,"lines":[{"text":"The first to state his case seems right","poem":1},{"text":"until another comes and cross-examines him.","poem":2}]},{"number":18,"lines":[{"text":"Casting the lot ends quarrels","poem":1},{"text":"and separates strong opponents.","poem":2}]},{"number":19,"lines":[{"text":"An offended brother is harder to win than a fortified city,","poem":1},{"text":"and disputes are like the bars of a castle.","poem":2}]},{"number":20,"lines":[{"text":"From the fruit of his mouth a man’s belly is filled;","poem":1},{"text":"with the harvest from his lips he is satisfied.","poem":2}]},{"number":21,"lines":[{"text":"Life and death are in the power of the tongue,","poem":1},{"text":"and those who love it will eat its fruit.","poem":2}]},{"number":22,"lines":[{"text":"He who finds a wife finds a good thing","poem":1},{"text":"and obtains favor from the LORD.","poem":2}]},{"number":23,"lines":[{"text":"The poor man pleads for mercy,","poem":1},{"text":"but the rich man answers harshly.","poem":2}]},{"number":24,"lines":[{"text":"A man of many companions may come to ruin,","poem":1},{"text":"but there is a friend who stays closer than a brother.","poem":2}]}]},{"number":19,"lastVerse":29,"verses":[{"number":1,"lines":[{"text":"Better a poor man who walks with integrity","poem":1},{"text":"than a fool whose lips are perverse.","poem":2}]},{"number":2,"lines":[{"text":"Even zeal is no good without knowledge,","poem":1},{"text":"and he who hurries his footsteps misses the mark.","poem":2}]},{"number":3,"lines":[{"text":"A man’s own folly subverts his way,","poem":1},{"text":"yet his heart rages against the LORD.","poem":2}]},{"number":4,"lines":[{"text":"Wealth attracts many friends,","poem":1},{"text":"but a poor man is deserted by his friend.","poem":2}]},{"number":5,"lines":[{"text":"A false witness will not go unpunished,","poem":1},{"text":"and one who utters lies will not escape.","poem":2}]},{"number":6,"lines":[{"text":"Many seek the favor of the prince,","poem":1},{"text":"and everyone is a friend of the gift giver.","poem":2}]},{"number":7,"lines":[{"text":"All the brothers of a poor man hate him—","poem":1},{"text":"how much more do his friends avoid him!","poem":2},{"text":"He may pursue them with pleading,","poem":1},{"text":"but they are nowhere to be found.","poem":2}]},{"number":8,"lines":[{"text":"He who acquires wisdom loves himself;","poem":1},{"text":"one who safeguards understanding will find success.","poem":2}]},{"number":9,"lines":[{"text":"A false witness will not go unpunished,","poem":1},{"text":"and one who pours out lies will perish.","poem":2}]},{"number":10,"lines":[{"text":"Luxury is unseemly for a fool—","poem":1},{"text":"how much worse for a slave to rule over princes!","poem":2}]},{"number":11,"lines":[{"text":"A man’s insight gives him patience,","poem":1},{"text":"and his virtue is to overlook an offense.","poem":2}]},{"number":12,"lines":[{"text":"A king’s rage is like the roar of a lion,","poem":1},{"text":"but his favor is like dew on the grass.","poem":2}]},{"number":13,"lines":[{"text":"A foolish son is his father’s ruin,","poem":1},{"text":"and a quarrelsome wife is like a constant dripping.","poem":2}]},{"number":14,"lines":[{"text":"Houses and wealth are inherited from fathers,","poem":1},{"text":"but a prudent wife is from the LORD.","poem":2}]},{"number":15,"lines":[{"text":"Laziness brings on deep sleep,","poem":1},{"text":"and an idle soul will suffer hunger.","poem":2}]},{"number":16,"lines":[{"text":"He who keeps a commandment preserves his soul,","poem":1},{"text":"but he who is careless in his ways will die.","poem":2}]},{"number":17,"lines":[{"text":"Kindness to the poor is a loan to the LORD,","poem":1},{"text":"and He will repay the lender.","poem":2}]},{"number":18,"lines":[{"text":"Discipline your son, for in that there is hope;","poem":1},{"text":"do not be party to his death.","poem":2}]},{"number":19,"lines":[{"text":"A man of great anger must pay the penalty;","poem":1},{"text":"if you rescue him, you will have to do so again.","poem":2}]},{"number":20,"lines":[{"text":"Listen to counsel and accept discipline,","poem":1},{"text":"that you may be wise the rest of your days.","poem":2}]},{"number":21,"lines":[{"text":"Many plans are in a man’s heart,","poem":1},{"text":"but the purpose of the LORD will prevail.","poem":2}]},{"number":22,"lines":[{"text":"The desire of a man is loving devotion;","poem":1},{"text":"better to be poor than a liar.","poem":2}]},{"number":23,"lines":[{"text":"The fear of the LORD leads to life,","poem":1},{"text":"that one may rest content, without visitation from harm.","poem":2}]},{"number":24,"lines":[{"text":"The slacker buries his hand in the dish;","poem":1},{"text":"he will not even bring it back to his mouth.","poem":2}]},{"number":25,"lines":[{"text":"Strike a mocker, and the simple will beware;","poem":1},{"text":"rebuke the discerning man, and he will gain knowledge.","poem":2}]},{"number":26,"lines":[{"text":"He who assaults his father or evicts his mother","poem":1},{"text":"is a son who brings shame and disgrace.","poem":2}]},{"number":27,"lines":[{"text":"If you cease to hear instruction, my son,","poem":1},{"text":"you will stray from the words of knowledge.","poem":2}]},{"number":28,"lines":[{"text":"A corrupt witness mocks justice,","poem":1},{"text":"and a wicked mouth swallows iniquity.","poem":2}]},{"number":29,"lines":[{"text":"Judgments are prepared for mockers,","poem":1},{"text":"and beatings for the backs of fools.","poem":2}]}]},{"number":20,"lastVerse":30,"verses":[{"number":1,"lines":[{"text":"Wine is a mocker, strong drink is a brawler,","poem":1},{"text":"and whoever is led astray by them is not wise.","poem":2}]},{"number":2,"lines":[{"text":"The terror of a king is like the roar of a lion;","poem":1},{"text":"whoever provokes him forfeits his own life.","poem":2}]},{"number":3,"lines":[{"text":"It is honorable for a man to resolve a dispute,","poem":1},{"text":"but any fool will quarrel.","poem":2}]},{"number":4,"lines":[{"text":"The slacker does not plow in season;","poem":1},{"text":"at harvest time he looks, but nothing is there.","poem":2}]},{"number":5,"lines":[{"text":"The intentions of a man’s heart are deep waters,","poem":1},{"text":"but a man of understanding draws them out.","poem":2}]},{"number":6,"lines":[{"text":"Many a man proclaims his loving devotion,","poem":1},{"text":"but who can find a trustworthy man?","poem":2}]},{"number":7,"lines":[{"text":"The righteous man walks with integrity;","poem":1},{"text":"blessed are his children after him.","poem":2}]},{"number":8,"lines":[{"text":"A king who sits on a throne to judge","poem":1},{"text":"sifts out all evil with his eyes.","poem":2}]},{"number":9,"lines":[{"text":"Who can say, “I have kept my heart pure;","poem":1},{"text":"I am cleansed from my sin”?","poem":2}]},{"number":10,"lines":[{"text":"Differing weights and unequal measures —","poem":1},{"text":"both are detestable to the LORD.","poem":2}]},{"number":11,"lines":[{"text":"Even a young man is known by his actions—","poem":1},{"text":"whether his conduct is pure and upright.","poem":2}]},{"number":12,"lines":[{"text":"Ears that hear and eyes that see—","poem":1},{"text":"the LORD has made them both.","poem":2}]},{"number":13,"lines":[{"text":"Do not love sleep, or you will grow poor;","poem":1},{"text":"open your eyes, and you will have plenty of food.","poem":2}]},{"number":14,"lines":[{"text":"“Worthless, worthless!” says the buyer,","poem":1},{"text":"but on the way out, he gloats.","poem":2}]},{"number":15,"lines":[{"text":"There is an abundance of gold and rubies,","poem":1},{"text":"but lips of knowledge are a rare treasure.","poem":2}]},{"number":16,"lines":[{"text":"Take the garment of the one who posts security for a stranger;","poem":1},{"text":"get collateral if it is for a foreigner.","poem":2}]},{"number":17,"lines":[{"text":"Food gained by fraud is sweet to a man,","poem":1},{"text":"but later his mouth is full of gravel.","poem":2}]},{"number":18,"lines":[{"text":"Set plans by consultation,","poem":1},{"text":"and wage war under sound guidance.","poem":2}]},{"number":19,"lines":[{"text":"He who reveals secrets is a constant gossip;","poem":1},{"text":"avoid the one who babbles with his lips.","poem":2}]},{"number":20,"lines":[{"text":"Whoever curses his father or mother,","poem":1},{"text":"his lamp will be extinguished in deepest darkness.","poem":2}]},{"number":21,"lines":[{"text":"An inheritance gained quickly","poem":1},{"text":"will not be blessed in the end.","poem":2}]},{"number":22,"lines":[{"text":"Do not say, “I will avenge this evil!”","poem":1},{"text":"Wait on the LORD, and He will save you.","poem":2}]},{"number":23,"lines":[{"text":"Unequal weights are detestable to the LORD,","poem":1},{"text":"and dishonest scales are no good.","poem":2}]},{"number":24,"lines":[{"text":"A man’s steps are from the LORD,","poem":1},{"text":"so how can anyone understand his own way?","poem":2}]},{"number":25,"lines":[{"text":"It is a trap for a man to dedicate something rashly,","poem":1},{"text":"only later to reconsider his vows.","poem":2}]},{"number":26,"lines":[{"text":"A wise king separates out the wicked","poem":1},{"text":"and drives the threshing wheel over them.","poem":2}]},{"number":27,"lines":[{"text":"The spirit of a man is the lamp of the LORD,","poem":1},{"text":"searching out his inmost being.","poem":2}]},{"number":28,"lines":[{"text":"Loving devotion and faithfulness preserve a king;","poem":1},{"text":"by these he maintains his throne.","poem":2}]},{"number":29,"lines":[{"text":"The glory of young men is their strength,","poem":1},{"text":"and gray hair is the splendor of the old.","poem":2}]},{"number":30,"lines":[{"text":"Lashes and wounds scour evil,","poem":1},{"text":"and beatings cleanse the inmost parts.","poem":2}]}]},{"number":21,"lastVerse":31,"verses":[{"number":1,"lines":[{"text":"The king’s heart is a waterway in the hand of the LORD;","poem":1},{"text":"He directs it where He pleases.","poem":2}]},{"number":2,"lines":[{"text":"All a man’s ways seem right to him,","poem":1},{"text":"but the LORD weighs the heart.","poem":2}]},{"number":3,"lines":[{"text":"To do righteousness and justice","poem":1},{"text":"is more desirable to the LORD than sacrifice.","poem":2}]},{"number":4,"lines":[{"text":"Haughty eyes and a proud heart—","poem":1},{"text":"the guides of the wicked—are sin.","poem":2}]},{"number":5,"lines":[{"text":"The plans of the diligent bring plenty,","poem":1},{"text":"as surely as haste leads to poverty.","poem":2}]},{"number":6,"lines":[{"text":"Making a fortune by a lying tongue","poem":1},{"text":"is a vanishing mist, a deadly pursuit.","poem":2}]},{"number":7,"lines":[{"text":"The violence of the wicked will sweep them away","poem":1},{"text":"because they refuse to do what is just.","poem":2}]},{"number":8,"lines":[{"text":"The way of a guilty man is crooked,","poem":1},{"text":"but the conduct of the innocent is upright.","poem":2}]},{"number":9,"lines":[{"text":"Better to live on a corner of the roof","poem":1},{"text":"than to share a house with a quarrelsome wife.","poem":2}]},{"number":10,"lines":[{"text":"The soul of the wicked man craves evil;","poem":1},{"text":"his neighbor finds no favor in his eyes.","poem":2}]},{"number":11,"lines":[{"text":"When a mocker is punished, the simple gain wisdom;","poem":1},{"text":"and when a wise man is instructed, he acquires knowledge.","poem":2}]},{"number":12,"lines":[{"text":"The Righteous One considers the house of the wicked","poem":1},{"text":"and brings the wicked to ruin.","poem":2}]},{"number":13,"lines":[{"text":"Whoever shuts his ears to the cry of the poor,","poem":1},{"text":"he too shall cry out and receive no answer.","poem":2}]},{"number":14,"lines":[{"text":"A gift in secret soothes anger,","poem":1},{"text":"and a covert bribe pacifies great wrath.","poem":2}]},{"number":15,"lines":[{"text":"Justice executed is a joy to the righteous,","poem":1},{"text":"but a terror to the workers of iniquity.","poem":2}]},{"number":16,"lines":[{"text":"The man who strays from the path of understanding","poem":1},{"text":"will rest in the assembly of the dead.","poem":2}]},{"number":17,"lines":[{"text":"He who loves pleasure will become poor;","poem":1},{"text":"the one who loves wine and oil will never be rich.","poem":2}]},{"number":18,"lines":[{"text":"The wicked become a ransom for the righteous,","poem":1},{"text":"and the faithless for the upright.","poem":2}]},{"number":19,"lines":[{"text":"Better to live in the desert","poem":1},{"text":"than with a contentious and ill-tempered wife.","poem":2}]},{"number":20,"lines":[{"text":"Precious treasures and oil are in the dwelling of the wise,","poem":1},{"text":"but a foolish man consumes them.","poem":2}]},{"number":21,"lines":[{"text":"He who pursues righteousness and loving devotion","poem":1},{"text":"finds life, righteousness, and honor.","poem":2}]},{"number":22,"lines":[{"text":"A wise man scales the city of the mighty","poem":1},{"text":"and pulls down the stronghold in which they trust.","poem":2}]},{"number":23,"lines":[{"text":"He who guards his mouth and tongue","poem":1},{"text":"keeps his soul from distress.","poem":2}]},{"number":24,"lines":[{"text":"Mocker is the name of the proud and arrogant man—","poem":1},{"text":"of him who acts with excessive pride.","poem":2}]},{"number":25,"lines":[{"text":"The craving of the slacker kills him","poem":1},{"text":"because his hands refuse to work.","poem":2}]},{"number":26,"lines":[{"text":"All day long he covets more,","poem":1},{"text":"but the righteous give without restraint.","poem":2}]},{"number":27,"lines":[{"text":"The sacrifice of the wicked is detestable—","poem":1},{"text":"how much more so when brought with ill intent!","poem":2}]},{"number":28,"lines":[{"text":"A lying witness will perish,","poem":1},{"text":"but the man who listens to truth will speak forever.","poem":2}]},{"number":29,"lines":[{"text":"A wicked man hardens his face,","poem":1},{"text":"but the upright man makes his way sure.","poem":2}]},{"number":30,"lines":[{"text":"There is no wisdom, no understanding, no counsel","poem":1},{"text":"that can prevail against the LORD.","poem":2}]},{"number":31,"lines":[{"text":"A horse is prepared for the day of battle,","poem":1},{"text":"but victory is of the LORD.","poem":2}]}]},{"number":22,"lastVerse":29,"verses":[{"number":1,"lines":[{"text":"A good name is more desirable than great riches;","poem":1},{"text":"favor is better than silver and gold.","poem":2}]},{"number":2,"lines":[{"text":"The rich and the poor have this in common:","poem":1},{"text":"The LORD is Maker of them all.","poem":2}]},{"number":3,"lines":[{"text":"The prudent see danger and take cover,","poem":1},{"text":"but the simple keep going and suffer the consequences.","poem":2}]},{"number":4,"lines":[{"text":"The rewards of humility and the fear of the LORD","poem":1},{"text":"are wealth and honor and life.","poem":2}]},{"number":5,"lines":[{"text":"Thorns and snares lie on the path of the perverse;","poem":1},{"text":"he who guards his soul stays far from them.","poem":2}]},{"number":6,"lines":[{"text":"Train up a child in the way he should go,","poem":1},{"text":"and when he is old he will not depart from it.","poem":2}]},{"number":7,"lines":[{"text":"The rich rule over the poor,","poem":1},{"text":"and the borrower is slave to the lender.","poem":2}]},{"number":8,"lines":[{"text":"He who sows injustice will reap disaster,","poem":1},{"text":"and the rod of his fury will be destroyed.","poem":2}]},{"number":9,"lines":[{"text":"A generous man will be blessed,","poem":1},{"text":"for he shares his bread with the poor.","poem":2}]},{"number":10,"lines":[{"text":"Drive out the mocker, and conflict will depart;","poem":1},{"text":"even quarreling and insults will cease.","poem":2}]},{"number":11,"lines":[{"text":"He who loves a pure heart and gracious lips","poem":1},{"text":"will have the king for a friend.","poem":2}]},{"number":12,"lines":[{"text":"The LORD’s eyes keep watch over knowledge,","poem":1},{"text":"but He frustrates the words of the faithless.","poem":2}]},{"number":13,"lines":[{"text":"The slacker says, “There is a lion outside!","poem":1},{"text":"I will be slain in the streets!”","poem":2}]},{"number":14,"lines":[{"text":"The mouth of an adulteress is a deep pit;","poem":1},{"text":"he who is under the wrath of the LORD will fall into it.","poem":2}]},{"number":15,"lines":[{"text":"Foolishness is bound up in the heart of a child,","poem":1},{"text":"but the rod of discipline drives it far from him.","poem":2}]},{"number":16,"lines":[{"text":"Oppressing the poor to enrich oneself or giving gifts to the rich","poem":1},{"text":"will surely lead to poverty.","poem":2}]},{"number":17,"lines":[{"text":"Incline your ear and hear the words of the wise—","poem":1},{"text":"apply your mind to my knowledge—","poem":2}]},{"number":18,"lines":[{"text":"for it is pleasing when you keep them within you","poem":1},{"text":"and they are constantly on your lips.","poem":2}]},{"number":19,"lines":[{"text":"So that your trust may be in the LORD,","poem":1},{"text":"I instruct you today—yes, you.","poem":2}]},{"number":20,"lines":[{"text":"Have I not written for you thirty sayings","poem":1},{"text":"about counsel and knowledge,","poem":2}]},{"number":21,"lines":[{"text":"to show you true and reliable words,","poem":1},{"text":"that you may soundly answer those who sent you?","poem":2}]},{"number":22,"lines":[{"text":"Do not rob a poor man because he is poor,","poem":1},{"text":"and do not crush the afflicted at the gate,","poem":2}]},{"number":23,"lines":[{"text":"for the LORD will take up their case","poem":1},{"text":"and will plunder those who rob them.","poem":2}]},{"number":24,"lines":[{"text":"Do not make friends with an angry man,","poem":1},{"text":"and do not associate with a hot-tempered man,","poem":2}]},{"number":25,"lines":[{"text":"or you may learn his ways","poem":1},{"text":"and entangle yourself in a snare.","poem":2}]},{"number":26,"lines":[{"text":"Do not be one who gives pledges,","poem":1},{"text":"who puts up security for debts.","poem":2}]},{"number":27,"lines":[{"text":"If you have nothing with which to pay,","poem":1},{"text":"why should your bed be taken from under you?","poem":2}]},{"number":28,"lines":[{"text":"Do not move an ancient boundary stone","poem":1},{"text":"which your fathers have placed.","poem":2}]},{"number":29,"lines":[{"text":"Do you see a man skilled in his work?","poem":1},{"text":"He will be stationed in the presence of kings;","poem":2},{"text":"he will not stand before obscure men.","poem":2}]}]},{"number":23,"lastVerse":35,"verses":[{"number":1,"lines":[{"text":"When you sit down to dine with a ruler,","poem":1},{"text":"consider carefully what is set before you,","poem":2}]},{"number":2,"lines":[{"text":"and put a knife to your throat","poem":1},{"text":"if you possess a great appetite.","poem":2}]},{"number":3,"lines":[{"text":"Do not crave his delicacies,","poem":1},{"text":"for that food is deceptive.","poem":2}]},{"number":4,"lines":[{"text":"Do not wear yourself out to get rich;","poem":1},{"text":"be wise enough to restrain yourself.","poem":2}]},{"number":5,"lines":[{"text":"When you glance at wealth, it disappears,","poem":1},{"text":"for it makes wings for itself","poem":2},{"text":"and flies like an eagle to the sky.","poem":2}]},{"number":6,"lines":[{"text":"Do not eat the bread of a stingy man,","poem":1},{"text":"and do not crave his delicacies;","poem":2}]},{"number":7,"lines":[{"text":"for he is keeping track,","poem":1},{"text":"inwardly counting the cost.","poem":2},{"text":"“Eat and drink,” he says to you,","poem":1},{"text":"but his heart is not with you.","poem":2}]},{"number":8,"lines":[{"text":"You will vomit up what little you have eaten","poem":1},{"text":"and waste your pleasant words.","poem":2}]},{"number":9,"lines":[{"text":"Do not speak to a fool,","poem":1},{"text":"for he will despise the wisdom of your words.","poem":2}]},{"number":10,"lines":[{"text":"Do not move an ancient boundary stone","poem":1},{"text":"or encroach on the fields of the fatherless,","poem":2}]},{"number":11,"lines":[{"text":"for their Redeemer is strong;","poem":1},{"text":"He will take up their case against you.","poem":2}]},{"number":12,"lines":[{"text":"Apply your heart to instruction","poem":1},{"text":"and your ears to words of knowledge.","poem":2}]},{"number":13,"lines":[{"text":"Do not withhold discipline from a child;","poem":1},{"text":"although you strike him with a rod, he will not die.","poem":2}]},{"number":14,"lines":[{"text":"Strike him with a rod,","poem":1},{"text":"and you will deliver his soul from Sheol.","poem":2}]},{"number":15,"lines":[{"text":"My son, if your heart is wise,","poem":1},{"text":"my own heart will indeed rejoice.","poem":2}]},{"number":16,"lines":[{"text":"My inmost being will rejoice","poem":1},{"text":"when your lips speak what is right.","poem":2}]},{"number":17,"lines":[{"text":"Do not let your heart envy sinners,","poem":1},{"text":"but always continue in the fear of the LORD.","poem":2}]},{"number":18,"lines":[{"text":"For surely there is a future,","poem":1},{"text":"and your hope will not be cut off.","poem":2}]},{"number":19,"lines":[{"text":"Listen, my son, and be wise,","poem":1},{"text":"and guide your heart on the right course.","poem":2}]},{"number":20,"lines":[{"text":"Do not join those who drink too much wine","poem":1},{"text":"or gorge themselves on meat.","poem":2}]},{"number":21,"lines":[{"text":"For the drunkard and the glutton will come to poverty,","poem":1},{"text":"and drowsiness will clothe them in rags.","poem":2}]},{"number":22,"lines":[{"text":"Listen to your father who gave you life,","poem":1},{"text":"and do not despise your mother when she is old.","poem":2}]},{"number":23,"lines":[{"text":"Invest in truth and never sell it—","poem":1},{"text":"in wisdom and instruction and understanding.","poem":2}]},{"number":24,"lines":[{"text":"The father of a righteous man will greatly rejoice,","poem":1},{"text":"and he who fathers a wise son will delight in him.","poem":2}]},{"number":25,"lines":[{"text":"May your father and mother be glad,","poem":1},{"text":"and may she who gave you birth rejoice!","poem":2}]},{"number":26,"lines":[{"text":"My son, give me your heart,","poem":1},{"text":"and let your eyes delight in my ways.","poem":2}]},{"number":27,"lines":[{"text":"For a prostitute is a deep pit,","poem":1},{"text":"and an adulteress is a narrow well.","poem":2}]},{"number":28,"lines":[{"text":"Like a robber she lies in wait","poem":1},{"text":"and multiplies the faithless among men.","poem":2}]},{"number":29,"lines":[{"text":"Who has woe? Who has sorrow?","poem":1},{"text":"Who has contentions? Who has complaints?","poem":2},{"text":"Who has needless wounds? Who has bloodshot eyes?","poem":2}]},{"number":30,"lines":[{"text":"Those who linger over wine,","poem":1},{"text":"who go to taste mixed drinks.","poem":2}]},{"number":31,"lines":[{"text":"Do not gaze at wine while it is red,","poem":1},{"text":"when it sparkles in the cup","poem":2},{"text":"and goes down smoothly.","poem":2}]},{"number":32,"lines":[{"text":"In the end it bites like a snake","poem":1},{"text":"and stings like a viper.","poem":2}]},{"number":33,"lines":[{"text":"Your eyes will see strange things,","poem":1},{"text":"and your mind will utter perversities.","poem":2}]},{"number":34,"lines":[{"text":"You will be like one sleeping on the high seas","poem":1},{"text":"or lying on the top of a mast:","poem":2}]},{"number":35,"lines":[{"text":"“They struck me, but I feel no pain!","poem":1},{"text":"They beat me, but I did not know it!","poem":2},{"text":"When can I wake up","poem":1},{"text":"to search for another drink?”","poem":2}]}]},{"number":24,"lastVerse":34,"verses":[{"number":1,"lines":[{"text":"Do not envy wicked men","poem":1},{"text":"or desire their company;","poem":2}]},{"number":2,"lines":[{"text":"for their hearts devise violence,","poem":1},{"text":"and their lips declare trouble.","poem":2}]},{"number":3,"lines":[{"text":"By wisdom a house is built","poem":1},{"text":"and by understanding it is established;","poem":2}]},{"number":4,"lines":[{"text":"through knowledge its rooms are filled","poem":1},{"text":"with every precious and beautiful treasure.","poem":2}]},{"number":5,"lines":[{"text":"A wise man is strong,","poem":1},{"text":"and a man of knowledge enhances his strength.","poem":2}]},{"number":6,"lines":[{"text":"Only with sound guidance should you wage war,","poem":1},{"text":"and victory lies in a multitude of counselors.","poem":2}]},{"number":7,"lines":[{"text":"Wisdom is too high for a fool;","poem":1},{"text":"he does not open his mouth in the meeting place.","poem":2}]},{"number":8,"lines":[{"text":"He who plots evil","poem":1},{"text":"will be called a schemer.","poem":2}]},{"number":9,"lines":[{"text":"A foolish scheme is sin,","poem":1},{"text":"and a mocker is detestable to men.","poem":2}]},{"number":10,"lines":[{"text":"If you faint in the day of distress,","poem":1},{"text":"how small is your strength!","poem":2}]},{"number":11,"lines":[{"text":"Rescue those being led away to death,","poem":1},{"text":"and restrain those stumbling toward the slaughter.","poem":2}]},{"number":12,"lines":[{"text":"If you say, “Behold, we did not know about this,”","poem":1},{"text":"does not He who weighs hearts consider it?","poem":2},{"text":"Does not the One who guards your life know?","poem":1},{"text":"Will He not repay a man according to his deeds?","poem":2}]},{"number":13,"lines":[{"text":"Eat honey, my son, for it is good,","poem":1},{"text":"and the honeycomb is sweet to your taste.","poem":2}]},{"number":14,"lines":[{"text":"Know therefore that wisdom is sweet to your soul.","poem":1},{"text":"If you find it, there is a future for you,","poem":2},{"text":"and your hope will never be cut off.","poem":2}]},{"number":15,"lines":[{"text":"Do not lie in wait, O wicked man, near the dwelling of the righteous;","poem":1},{"text":"do not destroy his resting place.","poem":2}]},{"number":16,"lines":[{"text":"For though a righteous man may fall seven times, he still gets up;","poem":1},{"text":"but the wicked stumble in bad times.","poem":2}]},{"number":17,"lines":[{"text":"Do not gloat when your enemy falls,","poem":1},{"text":"and do not let your heart rejoice when he stumbles,","poem":2}]},{"number":18,"lines":[{"text":"or the LORD will see and disapprove,","poem":1},{"text":"and turn His wrath away from him.","poem":2}]},{"number":19,"lines":[{"text":"Do not fret over evildoers,","poem":1},{"text":"and do not be envious of the wicked.","poem":2}]},{"number":20,"lines":[{"text":"For the evil man has no future;","poem":1},{"text":"the lamp of the wicked will be extinguished.","poem":2}]},{"number":21,"lines":[{"text":"My son, fear the LORD and the king,","poem":1},{"text":"and do not associate with the rebellious.","poem":2}]},{"number":22,"lines":[{"text":"For they will bring sudden destruction.","poem":1},{"text":"Who knows what ruin they can bring?","poem":2}]},{"number":23,"lines":[{"text":"These also are sayings of the wise:"},{"text":"To show partiality in judgment","poem":1},{"text":"is not good.","poem":2}]},{"number":24,"lines":[{"text":"Whoever tells the guilty, “You are innocent”—","poem":1},{"text":"peoples will curse him, and nations will denounce him;","poem":2}]},{"number":25,"lines":[{"text":"but it will go well with those who convict the guilty,","poem":1},{"text":"and rich blessing will come upon them.","poem":2}]},{"number":26,"lines":[{"text":"An honest answer given","poem":1},{"text":"is like a kiss on the lips.","poem":2}]},{"number":27,"lines":[{"text":"Complete your outdoor work and prepare your field;","poem":1},{"text":"after that, you may build your house.","poem":2}]},{"number":28,"lines":[{"text":"Do not testify against your neighbor without cause,","poem":1},{"text":"and do not deceive with your lips.","poem":2}]},{"number":29,"lines":[{"text":"Do not say, “I will do to him as he has done to me;","poem":1},{"text":"I will repay the man according to his work.”","poem":2}]},{"number":30,"lines":[{"text":"I went past the field of a slacker","poem":1},{"text":"and by the vineyard of a man lacking judgment.","poem":2}]},{"number":31,"lines":[{"text":"Thorns had grown up everywhere,","poem":1},{"text":"thistles had covered the ground,","poem":2},{"text":"and the stone wall was broken down.","poem":2}]},{"number":32,"lines":[{"text":"I observed and took it to heart;","poem":1},{"text":"I looked and received instruction:","poem":2}]},{"number":33,"lines":[{"text":"A little sleep, a little slumber,","poem":1},{"text":"a little folding of the hands to rest,","poem":2}]},{"number":34,"lines":[{"text":"and poverty will come upon you like a robber,","poem":1},{"text":"and need like a bandit.","poem":2}]}]},{"number":25,"lastVerse":28,"verses":[{"number":1,"lines":[{"text":"These are additional proverbs of Solomon, which were copied by the men of Hezekiah king of Judah:"}]},{"number":2,"lines":[{"text":"It is the glory of God to conceal a matter","poem":1},{"text":"and the glory of kings to search it out.","poem":2}]},{"number":3,"lines":[{"text":"As the heavens are high and the earth is deep,","poem":1},{"text":"so the hearts of kings cannot be searched.","poem":2}]},{"number":4,"lines":[{"text":"Remove the dross from the silver,","poem":1},{"text":"and a vessel for a silversmith will come forth.","poem":2}]},{"number":5,"lines":[{"text":"Remove the wicked from the king’s presence,","poem":1},{"text":"and his throne will be established in righteousness.","poem":2}]},{"number":6,"lines":[{"text":"Do not exalt yourself in the presence of the king,","poem":1},{"text":"and do not stand in the place of great men;","poem":2}]},{"number":7,"lines":[{"text":"for it is better to be told, “Come up here!”","poem":1},{"text":"than to be demoted in the presence of the prince.","poem":2},{"text":"Even what you have seen with your own eyes,","poem":1}]},{"number":8,"lines":[{"text":"do not bring hastily to court.","poem":2},{"text":"Otherwise, what will you do in the end","poem":1},{"text":"when your neighbor puts you to shame?","poem":2}]},{"number":9,"lines":[{"text":"Argue your case with your neighbor","poem":1},{"text":"without betraying another’s confidence,","poem":2}]},{"number":10,"lines":[{"text":"lest he who hears you bring shame upon you,","poem":1},{"text":"and your infamy never go away.","poem":2}]},{"number":11,"lines":[{"text":"A word fitly spoken","poem":1},{"text":"is like apples of gold in settings of silver.","poem":2}]},{"number":12,"lines":[{"text":"Like an earring of gold or an ornament of fine gold","poem":1},{"text":"is a wise man’s rebuke to a listening ear.","poem":2}]},{"number":13,"lines":[{"text":"Like the cold of snow in the time of harvest","poem":1},{"text":"is a trustworthy messenger to those who send him;","poem":2},{"text":"he refreshes the soul of his masters.","poem":2}]},{"number":14,"lines":[{"text":"Like clouds and wind without rain","poem":1},{"text":"is the man who boasts of gifts never given.","poem":2}]},{"number":15,"lines":[{"text":"Through patience a ruler can be persuaded,","poem":1},{"text":"and a gentle tongue can break a bone.","poem":2}]},{"number":16,"lines":[{"text":"If you find honey, eat just what you need,","poem":1},{"text":"lest you have too much and vomit it up.","poem":2}]},{"number":17,"lines":[{"text":"Seldom set foot in your neighbor’s house,","poem":1},{"text":"lest he grow weary and hate you.","poem":2}]},{"number":18,"lines":[{"text":"Like a club or sword or sharp arrow","poem":1},{"text":"is a man who bears false witness against his neighbor.","poem":2}]},{"number":19,"lines":[{"text":"Like a broken tooth or a foot out of joint","poem":1},{"text":"is confidence in a faithless man in time of trouble.","poem":2}]},{"number":20,"lines":[{"text":"Like one who removes a garment on a cold day","poem":1},{"text":"or vinegar poured on a wound","poem":2},{"text":"is one who sings songs to a heavy heart.","poem":2}]},{"number":21,"lines":[{"text":"If your enemy is hungry, give him food to eat,","poem":1},{"text":"and if he is thirsty, give him water to drink.","poem":2}]},{"number":22,"lines":[{"text":"For in so doing, you will heap burning coals on his head,","poem":1},{"text":"and the LORD will reward you.","poem":2}]},{"number":23,"lines":[{"text":"As the north wind brings forth rain,","poem":1},{"text":"so a backbiting tongue brings angry looks.","poem":2}]},{"number":24,"lines":[{"text":"Better to live on a corner of the roof","poem":1},{"text":"than to share a house with a quarrelsome wife.","poem":2}]},{"number":25,"lines":[{"text":"Like cold water to a weary soul","poem":1},{"text":"is good news from a distant land.","poem":2}]},{"number":26,"lines":[{"text":"Like a muddied spring or a polluted well","poem":1},{"text":"is a righteous man who gives way to the wicked.","poem":2}]},{"number":27,"lines":[{"text":"It is not good to eat too much honey","poem":1},{"text":"or to search out one’s own glory.","poem":2}]},{"number":28,"lines":[{"text":"Like a city whose walls are broken down","poem":1},{"text":"is a man who does not control his temper.","poem":2}]}]},{"number":26,"lastVerse":28,"verses":[{"number":1,"lines":[{"text":"Like snow in summer and rain at harvest,","poem":1},{"text":"honor does not befit a fool.","poem":2}]},{"number":2,"lines":[{"text":"Like a fluttering sparrow or darting swallow,","poem":1},{"text":"an undeserved curse does not come to rest.","poem":2}]},{"number":3,"lines":[{"text":"A whip for the horse, a bridle for the donkey,","poem":1},{"text":"and a rod for the backs of fools!","poem":2}]},{"number":4,"lines":[{"text":"Do not answer a fool according to his folly,","poem":1},{"text":"or you yourself will be like him.","poem":2}]},{"number":5,"lines":[{"text":"Answer a fool according to his folly,","poem":1},{"text":"lest he become wise in his own eyes.","poem":2}]},{"number":6,"lines":[{"text":"Like cutting off one’s own feet or drinking violence","poem":1},{"text":"is the sending of a message by the hand of a fool.","poem":2}]},{"number":7,"lines":[{"text":"Like lame legs hanging limp","poem":1},{"text":"is a proverb in the mouth of a fool.","poem":2}]},{"number":8,"lines":[{"text":"Like binding a stone into a sling","poem":1},{"text":"is the giving of honor to a fool.","poem":2}]},{"number":9,"lines":[{"text":"Like a thorn that goes into the hand of a drunkard","poem":1},{"text":"is a proverb in the mouth of a fool.","poem":2}]},{"number":10,"lines":[{"text":"Like an archer who wounds at random","poem":1},{"text":"is he who hires a fool or passerby.","poem":2}]},{"number":11,"lines":[{"text":"As a dog returns to its vomit,","poem":1},{"text":"so a fool repeats his folly.","poem":2}]},{"number":12,"lines":[{"text":"Do you see a man who is wise in his own eyes?","poem":1},{"text":"There is more hope for a fool than for him.","poem":2}]},{"number":13,"lines":[{"text":"The slacker says, “A lion is in the road!","poem":1},{"text":"A fierce lion roams the public square!”","poem":2}]},{"number":14,"lines":[{"text":"As a door turns on its hinges,","poem":1},{"text":"so the slacker turns on his bed.","poem":2}]},{"number":15,"lines":[{"text":"The slacker buries his hand in the dish;","poem":1},{"text":"it wearies him to bring it back to his mouth.","poem":2}]},{"number":16,"lines":[{"text":"The slacker is wiser in his own eyes","poem":1},{"text":"than seven men who answer discreetly.","poem":2}]},{"number":17,"lines":[{"text":"Like one who grabs a dog by the ears","poem":1},{"text":"is a passerby who meddles in a quarrel not his own.","poem":2}]},{"number":18,"lines":[{"text":"Like a madman shooting firebrands","poem":1},{"text":"and deadly arrows,","poem":2}]},{"number":19,"lines":[{"text":"so is the man who deceives his neighbor","poem":1},{"text":"and says, “I was only joking!”","poem":2}]},{"number":20,"lines":[{"text":"Without wood, a fire goes out;","poem":1},{"text":"without gossip, a conflict ceases.","poem":2}]},{"number":21,"lines":[{"text":"Like charcoal for embers and wood for fire,","poem":1},{"text":"so is a quarrelsome man for kindling strife.","poem":2}]},{"number":22,"lines":[{"text":"The words of a gossip are like choice morsels","poem":1},{"text":"that go down into the inmost being.","poem":2}]},{"number":23,"lines":[{"text":"Like glaze covering an earthen vessel","poem":1},{"text":"are burning lips and a wicked heart.","poem":2}]},{"number":24,"lines":[{"text":"A hateful man disguises himself with his speech,","poem":2},{"text":"but he lays up deceit in his heart.","poem":2}]},{"number":25,"lines":[{"text":"When he speaks graciously, do not believe him,","poem":1},{"text":"for seven abominations fill his heart.","poem":2}]},{"number":26,"lines":[{"text":"Though his hatred is concealed by deception,","poem":1},{"text":"his wickedness will be exposed in the assembly.","poem":2}]},{"number":27,"lines":[{"text":"He who digs a pit will fall into it,","poem":1},{"text":"and he who rolls a stone will have it roll back on him.","poem":2}]},{"number":28,"lines":[{"text":"A lying tongue hates those it crushes,","poem":1},{"text":"and a flattering mouth causes ruin.","poem":2}]}]},{"number":27,"lastVerse":27,"verses":[{"number":1,"lines":[{"text":"Do not boast about tomorrow,","poem":1},{"text":"for you do not know what a day may bring.","poem":2}]},{"number":2,"lines":[{"text":"Let another praise you, and not your own mouth—","poem":1},{"text":"a stranger, and not your own lips.","poem":2}]},{"number":3,"lines":[{"text":"A stone is heavy and sand is a burden,","poem":1},{"text":"but aggravation from a fool outweighs them both.","poem":2}]},{"number":4,"lines":[{"text":"Wrath is cruel and anger is like a flood,","poem":1},{"text":"but who can withstand jealousy?","poem":2}]},{"number":5,"lines":[{"text":"Better an open rebuke","poem":1},{"text":"than love that is concealed.","poem":2}]},{"number":6,"lines":[{"text":"The wounds of a friend are faithful,","poem":1},{"text":"but the kisses of an enemy are deceitful.","poem":2}]},{"number":7,"lines":[{"text":"The soul that is full loathes honey,","poem":1},{"text":"but to a hungry soul, any bitter thing is sweet.","poem":2}]},{"number":8,"lines":[{"text":"Like a bird that strays from its nest","poem":1},{"text":"is a man who wanders from his home.","poem":2}]},{"number":9,"lines":[{"text":"Oil and incense bring joy to the heart,","poem":1},{"text":"and the counsel of a friend is sweetness to the soul.","poem":2}]},{"number":10,"lines":[{"text":"Do not forsake your friend or your father’s friend,","poem":1},{"text":"and do not go to your brother’s house","poem":2},{"text":"in the day of your calamity;","poem":2},{"text":"better a neighbor nearby","poem":1},{"text":"than a brother far away.","poem":2}]},{"number":11,"lines":[{"text":"Be wise, my son, and bring joy to my heart,","poem":1},{"text":"so that I can answer him who taunts me.","poem":2}]},{"number":12,"lines":[{"text":"The prudent see danger and take cover,","poem":1},{"text":"but the simple keep going and pay the penalty.","poem":2}]},{"number":13,"lines":[{"text":"Take the garment of him who posts security for a stranger;","poem":1},{"text":"get collateral if it is for a foreigner.","poem":2}]},{"number":14,"lines":[{"text":"If one blesses his neighbor with a loud voice early in the morning,","poem":1},{"text":"it will be counted to him as a curse.","poem":2}]},{"number":15,"lines":[{"text":"A constant dripping on a rainy day","poem":1},{"text":"and a contentious woman are alike—","poem":2}]},{"number":16,"lines":[{"text":"restraining her is like holding back the wind","poem":1},{"text":"or grasping oil with one’s right hand.","poem":2}]},{"number":17,"lines":[{"text":"As iron sharpens iron,","poem":1},{"text":"so one man sharpens another.","poem":2}]},{"number":18,"lines":[{"text":"Whoever tends a fig tree will eat its fruit,","poem":1},{"text":"and he who looks after his master will be honored.","poem":2}]},{"number":19,"lines":[{"text":"As water reflects the face,","poem":1},{"text":"so the heart reflects the true man.","poem":2}]},{"number":20,"lines":[{"text":"Sheol and Abaddon are never satisfied;","poem":1},{"text":"so the eyes of man are never satisfied.","poem":2}]},{"number":21,"lines":[{"text":"A crucible for silver and a furnace for gold,","poem":1},{"text":"but a man is tested by the praise accorded him.","poem":2}]},{"number":22,"lines":[{"text":"Though you grind a fool like grain with mortar and a pestle,","poem":1},{"text":"yet his folly will not depart from him.","poem":2}]},{"number":23,"lines":[{"text":"Be sure to know the state of your flocks,","poem":1},{"text":"and pay close attention to your herds;","poem":2}]},{"number":24,"lines":[{"text":"for riches are not forever,","poem":1},{"text":"nor does a crown endure to every generation.","poem":2}]},{"number":25,"lines":[{"text":"When hay is removed and new growth appears","poem":1},{"text":"and the grass from the hills is gathered,","poem":2}]},{"number":26,"lines":[{"text":"the lambs will provide you with clothing,","poem":1},{"text":"and the goats with the price of a field.","poem":2}]},{"number":27,"lines":[{"text":"You will have plenty of goats’ milk to feed you—","poem":1},{"text":"food for your household","poem":2},{"text":"and nourishment for your maidservants.","poem":2}]}]},{"number":28,"lastVerse":28,"verses":[{"number":1,"lines":[{"text":"The wicked flee when no one pursues,","poem":1},{"text":"but the righteous are as bold as a lion.","poem":2}]},{"number":2,"lines":[{"text":"A land in rebellion has many rulers,","poem":1},{"text":"but a man of understanding and knowledge maintains order.","poem":2}]},{"number":3,"lines":[{"text":"A destitute leader who oppresses the poor","poem":1},{"text":"is like a driving rain that leaves no food.","poem":2}]},{"number":4,"lines":[{"text":"Those who forsake the law praise the wicked,","poem":1},{"text":"but those who keep the law resist them.","poem":2}]},{"number":5,"lines":[{"text":"Evil men do not understand justice,","poem":1},{"text":"but those who seek the LORD comprehend fully.","poem":2}]},{"number":6,"lines":[{"text":"Better a poor man who walks with integrity","poem":1},{"text":"than a rich man whose ways are perverse.","poem":2}]},{"number":7,"lines":[{"text":"A discerning son keeps the law,","poem":1},{"text":"but a companion of gluttons disgraces his father.","poem":2}]},{"number":8,"lines":[{"text":"He who increases his wealth by interest and usury","poem":1},{"text":"lays it up for one who is kind to the poor.","poem":2}]},{"number":9,"lines":[{"text":"Whoever turns his ear away from hearing the law,","poem":1},{"text":"even his prayer is detestable.","poem":2}]},{"number":10,"lines":[{"text":"He who leads the upright along the path of evil will fall into his own pit,","poem":1},{"text":"but the blameless will inherit what is good.","poem":2}]},{"number":11,"lines":[{"text":"A rich man is wise in his own eyes,","poem":1},{"text":"but a poor man with discernment sees through him.","poem":2}]},{"number":12,"lines":[{"text":"When the righteous triumph, there is great glory,","poem":1},{"text":"but when the wicked rise, men hide themselves.","poem":2}]},{"number":13,"lines":[{"text":"He who conceals his sins will not prosper,","poem":1},{"text":"but whoever confesses and renounces them will find mercy.","poem":2}]},{"number":14,"lines":[{"text":"Blessed is the man who is always reverent,","poem":1},{"text":"but he who hardens his heart falls into trouble.","poem":2}]},{"number":15,"lines":[{"text":"Like a roaring lion or a charging bear","poem":1},{"text":"is a wicked ruler over a helpless people.","poem":2}]},{"number":16,"lines":[{"text":"A leader who lacks judgment is also a great oppressor,","poem":1},{"text":"but he who hates dishonest profit will prolong his days.","poem":2}]},{"number":17,"lines":[{"text":"A man burdened by bloodguilt will flee into the Pit;","poem":1},{"text":"let no one support him.","poem":2}]},{"number":18,"lines":[{"text":"He who walks with integrity will be kept safe,","poem":1},{"text":"but whoever is perverse in his ways will suddenly fall.","poem":2}]},{"number":19,"lines":[{"text":"The one who works his land will have plenty of food,","poem":1},{"text":"but whoever chases fantasies will have his fill of poverty.","poem":2}]},{"number":20,"lines":[{"text":"A faithful man will abound with blessings,","poem":1},{"text":"but one eager to be rich will not go unpunished.","poem":2}]},{"number":21,"lines":[{"text":"To show partiality is not good,","poem":1},{"text":"yet a man will do wrong for a piece of bread.","poem":2}]},{"number":22,"lines":[{"text":"A stingy man hastens after wealth","poem":1},{"text":"and does not know that poverty awaits him.","poem":2}]},{"number":23,"lines":[{"text":"He who rebukes a man will later find more favor","poem":1},{"text":"than one who flatters with his tongue.","poem":2}]},{"number":24,"lines":[{"text":"He who robs his father or mother, saying, “It is not wrong,”","poem":1},{"text":"is a companion to the man who destroys.","poem":2}]},{"number":25,"lines":[{"text":"A greedy man stirs up strife,","poem":1},{"text":"but he who trusts in the LORD will prosper.","poem":2}]},{"number":26,"lines":[{"text":"He who trusts in himself is a fool,","poem":1},{"text":"but one who walks in wisdom will be safe.","poem":2}]},{"number":27,"lines":[{"text":"Whoever gives to the poor will not be in need,","poem":1},{"text":"but he who hides his eyes will receive many curses.","poem":2}]},{"number":28,"lines":[{"text":"When the wicked come to power, people hide themselves;","poem":1},{"text":"but when they perish, the righteous flourish.","poem":2}]}]},{"number":29,"lastVerse":27,"verses":[{"number":1,"lines":[{"text":"A man who remains stiff-necked after much reproof","poem":1},{"text":"will suddenly be shattered beyond recovery.","poem":2}]},{"number":2,"lines":[{"text":"When the righteous flourish, the people rejoice,","poem":1},{"text":"but when the wicked rule, the people groan.","poem":2}]},{"number":3,"lines":[{"text":"A man who loves wisdom brings joy to his father,","poem":1},{"text":"but a companion of prostitutes squanders his wealth.","poem":2}]},{"number":4,"lines":[{"text":"By justice a king brings stability to the land,","poem":1},{"text":"but a man who exacts tribute demolishes it.","poem":2}]},{"number":5,"lines":[{"text":"A man who flatters his neighbor","poem":1},{"text":"spreads a net for his feet.","poem":2}]},{"number":6,"lines":[{"text":"An evil man is caught by his own sin,","poem":1},{"text":"but a righteous one sings and rejoices.","poem":2}]},{"number":7,"lines":[{"text":"The righteous consider the cause of the poor,","poem":1},{"text":"but the wicked have no regard for such concerns.","poem":2}]},{"number":8,"lines":[{"text":"Mockers inflame a city,","poem":1},{"text":"but the wise turn away anger.","poem":2}]},{"number":9,"lines":[{"text":"If a wise man goes to court with a fool,","poem":1},{"text":"there will be raving and laughing with no resolution.","poem":2}]},{"number":10,"lines":[{"text":"Men of bloodshed hate a blameless man,","poem":1},{"text":"but the upright care for his life.","poem":2}]},{"number":11,"lines":[{"text":"A fool vents all his anger,","poem":1},{"text":"but a wise man holds it back.","poem":2}]},{"number":12,"lines":[{"text":"If a ruler listens to lies,","poem":1},{"text":"all his officials will be wicked.","poem":2}]},{"number":13,"lines":[{"text":"The poor man and the oppressor have this in common:","poem":1},{"text":"The LORD gives light to the eyes of both.","poem":2}]},{"number":14,"lines":[{"text":"A king who judges the poor with fairness—","poem":1},{"text":"his throne will be established forever.","poem":2}]},{"number":15,"lines":[{"text":"A rod of correction imparts wisdom,","poem":1},{"text":"but a child left to himself disgraces his mother.","poem":2}]},{"number":16,"lines":[{"text":"When the wicked thrive, rebellion increases;","poem":1},{"text":"but the righteous will see their downfall.","poem":2}]},{"number":17,"lines":[{"text":"Discipline your son, and he will give you rest;","poem":1},{"text":"he will bring delight to your soul.","poem":2}]},{"number":18,"lines":[{"text":"Where there is no vision, the people cast off restraint;","poem":1},{"text":"but blessed is he who keeps the Law.","poem":2}]},{"number":19,"lines":[{"text":"A servant cannot be corrected by words alone;","poem":1},{"text":"though he understands, he will not respond.","poem":2}]},{"number":20,"lines":[{"text":"Do you see a man who speaks in haste?","poem":1},{"text":"There is more hope for a fool than for him.","poem":2}]},{"number":21,"lines":[{"text":"A servant pampered from his youth","poem":1},{"text":"will bring grief in the end.","poem":2}]},{"number":22,"lines":[{"text":"An angry man stirs up dissension,","poem":1},{"text":"and a hot-tempered man abounds in transgression.","poem":2}]},{"number":23,"lines":[{"text":"A man’s pride will bring him low,","poem":1},{"text":"but a humble spirit will obtain honor.","poem":2}]},{"number":24,"lines":[{"text":"A partner to a thief hates his own soul;","poem":1},{"text":"he receives the oath but does not testify.","poem":2}]},{"number":25,"lines":[{"text":"The fear of man is a snare,","poem":1},{"text":"but whoever trusts in the LORD is set securely on high.","poem":2}]},{"number":26,"lines":[{"text":"Many seek the ruler’s favor,","poem":1},{"text":"but a man receives justice from the LORD.","poem":2}]},{"number":27,"lines":[{"text":"An unjust man is detestable to the righteous,","poem":1},{"text":"and one whose way is upright is detestable to the wicked.","poem":2}]}]},{"number":30,"lastVerse":33,"verses":[{"number":1,"lines":[{"text":"These are the words of Agur son of Jakeh—the burden that this man declared to Ithiel:"},{"text":"“I am weary, O God,","poem":1},{"text":"and worn out.","poem":2}]},{"number":2,"lines":[{"text":"Surely I am the most ignorant of men,","poem":1},{"text":"and I lack the understanding of a man.","poem":2}]},{"number":3,"lines":[{"text":"I have not learned wisdom,","poem":1},{"text":"and I have no knowledge of the Holy One.","poem":2}]},{"number":4,"lines":[{"text":"Who has ascended to heaven and come down?","poem":1},{"text":"Who has gathered the wind in His hands?","poem":2},{"text":"Who has bound up the waters in His cloak?","poem":1},{"text":"Who has established all the ends of the earth?","poem":2},{"text":"What is His name, and what is the name of His Son—","poem":1},{"text":"surely you know!","poem":2}]},{"number":5,"lines":[{"text":"Every word of God is flawless;","poem":1},{"text":"He is a shield to those who take refuge in Him.","poem":2}]},{"number":6,"lines":[{"text":"Do not add to His words,","poem":1},{"text":"lest He rebuke you and prove you a liar.","poem":2}]},{"number":7,"lines":[{"text":"Two things I ask of You—","poem":1},{"text":"do not refuse me before I die:","poem":2}]},{"number":8,"lines":[{"text":"Keep falsehood and deceitful words far from me.","poem":1},{"text":"Give me neither poverty nor riches;","poem":2},{"text":"feed me with the bread that is my portion.","poem":2}]},{"number":9,"lines":[{"text":"Otherwise, I may have too much","poem":1},{"text":"and deny You, saying, ‘Who is the LORD?’","poem":2},{"text":"Or I may become poor and steal,","poem":1},{"text":"profaning the name of my God.","poem":2}]},{"number":10,"lines":[{"text":"Do not slander a servant to his master,","poem":1},{"text":"or he will curse you, and you will bear the guilt.","poem":2}]},{"number":11,"lines":[{"text":"There is a generation of those who curse their fathers","poem":1},{"text":"and do not bless their mothers.","poem":2}]},{"number":12,"lines":[{"text":"There is a generation of those who are pure in their own eyes","poem":1},{"text":"and yet unwashed of their filth.","poem":2}]},{"number":13,"lines":[{"text":"There is a generation—how haughty are their eyes","poem":1},{"text":"and pretentious are their glances—","poem":2}]},{"number":14,"lines":[{"text":"there is a generation whose teeth are swords","poem":1},{"text":"and whose jaws are knives,","poem":2},{"text":"devouring the oppressed from the earth","poem":1},{"text":"and the needy from among men.","poem":2}]},{"number":15,"lines":[{"text":"The leech has two daughters:","poem":1},{"text":"Give and Give.","poem":2},{"text":"There are three things that are never satisfied, four that never say, ‘Enough!’:"}]},{"number":16,"lines":[{"text":"Sheol,"},{"text":"the barren womb,"},{"text":"land never satisfied with water,"},{"text":"and fire that never says, ‘Enough!’"}]},{"number":17,"lines":[{"text":"As for the eye that mocks a father","poem":1},{"text":"and scorns obedience to a mother,","poem":2},{"text":"may the ravens of the valley pluck it out","poem":1},{"text":"and young vultures devour it.","poem":2}]},{"number":18,"lines":[{"text":"There are three things too wonderful for me, four that I cannot understand:"}]},{"number":19,"lines":[{"text":"the way of an eagle in the sky,"},{"text":"the way of a snake on a rock,"},{"text":"the way of a ship at sea,"},{"text":"and the way of a man with a maiden."}]},{"number":20,"lines":[{"text":"This is the way of an adulteress:","poem":1},{"text":"She eats and wipes her mouth","poem":2},{"text":"and says, ‘I have done nothing wrong.’","poem":2}]},{"number":21,"lines":[{"text":"Under three things the earth trembles, under four it cannot bear up:"}]},{"number":22,"lines":[{"text":"a servant who becomes king,"},{"text":"a fool who is filled with food,"}]},{"number":23,"lines":[{"text":"an unloved woman who marries,"},{"text":"and a maidservant who supplants her mistress."}]},{"number":24,"lines":[{"text":"Four things on earth are small, yet they are exceedingly wise:"}]},{"number":25,"lines":[{"text":"The ants are creatures of little strength, yet they store up their food in the summer;"}]},{"number":26,"lines":[{"text":"the rock badgers are creatures of little power, yet they make their homes in the rocks;"}]},{"number":27,"lines":[{"text":"the locusts have no king, yet they all advance in formation;"}]},{"number":28,"lines":[{"text":"and the lizard can be caught in one’s hands, yet it is found in the palaces of kings."}]},{"number":29,"lines":[{"text":"There are three things that are stately in their stride, and four that are impressive in their walk:"}]},{"number":30,"lines":[{"text":"a lion, mighty among beasts, refusing to retreat before anything;"}]},{"number":31,"lines":[{"text":"a strutting rooster;"},{"text":"a he-goat;"},{"text":"and a king with his army around him."}]},{"number":32,"lines":[{"text":"If you have foolishly exalted yourself","poem":1},{"text":"or if you have plotted evil,","poem":2},{"text":"put your hand over your mouth.","poem":2}]},{"number":33,"lines":[{"text":"For as the churning of milk yields butter,","poem":1},{"text":"and the twisting of the nose draws blood,","poem":2},{"text":"so the stirring of anger brings forth strife.”","poem":2}]}]},{"number":31,"lastVerse":31,"verses":[{"number":1,"lines":[{"text":"These are the words of King Lemuel—the burden that his mother taught him:"}]},{"number":2,"lines":[{"text":"What shall I say, O my son?","poem":1},{"text":"What, O son of my womb?","poem":2},{"text":"What, O son of my vows?","poem":2}]},{"number":3,"lines":[{"text":"Do not spend your strength on women","poem":1},{"text":"or your vigor on those who ruin kings.","poem":2}]},{"number":4,"lines":[{"text":"It is not for kings, O Lemuel,","poem":1},{"text":"it is not for kings to drink wine,","poem":2},{"text":"or for rulers to crave strong drink,","poem":2}]},{"number":5,"lines":[{"text":"lest they drink and forget what is decreed,","poem":1},{"text":"depriving all the oppressed of justice.","poem":2}]},{"number":6,"lines":[{"text":"Give strong drink to one who is perishing,","poem":1},{"text":"and wine to the bitter in soul.","poem":2}]},{"number":7,"lines":[{"text":"Let him drink and forget his poverty,","poem":1},{"text":"and remember his misery no more.","poem":2}]},{"number":8,"lines":[{"text":"Open your mouth for those with no voice,","poem":1},{"text":"for the cause of all the dispossessed.","poem":2}]},{"number":9,"lines":[{"text":"Open your mouth, judge righteously,","poem":1},{"text":"and defend the cause of the poor and needy.","poem":2}]},{"number":10,"lines":[{"text":"A wife of noble character, who can find?","poem":1},{"text":"She is far more precious than rubies.","poem":2}]},{"number":11,"lines":[{"text":"The heart of her husband trusts in her,","poem":1},{"text":"and he lacks nothing of value.","poem":2}]},{"number":12,"lines":[{"text":"She brings him good and not harm","poem":1},{"text":"all the days of her life.","poem":2}]},{"number":13,"lines":[{"text":"She selects wool and flax","poem":1},{"text":"and works with eager hands.","poem":2}]},{"number":14,"lines":[{"text":"She is like the merchant ships,","poem":1},{"text":"bringing her food from afar.","poem":2}]},{"number":15,"lines":[{"text":"She rises while it is still night","poem":1},{"text":"to provide food for her household","poem":2},{"text":"and portions for her maidservants.","poem":2}]},{"number":16,"lines":[{"text":"She appraises a field and buys it;","poem":1},{"text":"from her earnings she plants a vineyard.","poem":2}]},{"number":17,"lines":[{"text":"She girds herself with strength","poem":1},{"text":"and shows that her arms are strong.","poem":2}]},{"number":18,"lines":[{"text":"She sees that her gain is good,","poem":1},{"text":"and her lamp is not extinguished at night.","poem":2}]},{"number":19,"lines":[{"text":"She stretches out her hands to the distaff","poem":1},{"text":"and grasps the spindle with her fingers.","poem":2}]},{"number":20,"lines":[{"text":"She opens her arms to the poor","poem":1},{"text":"and reaches out her hands to the needy.","poem":2}]},{"number":21,"lines":[{"text":"When it snows, she has no fear for her household,","poem":1},{"text":"for they are all clothed in scarlet.","poem":2}]},{"number":22,"lines":[{"text":"She makes coverings for her bed;","poem":1},{"text":"her clothing is fine linen and purple.","poem":2}]},{"number":23,"lines":[{"text":"Her husband is known at the city gates,","poem":1},{"text":"where he sits among the elders of the land.","poem":2}]},{"number":24,"lines":[{"text":"She makes linen garments and sells them;","poem":1},{"text":"she delivers sashes to the merchants.","poem":2}]},{"number":25,"lines":[{"text":"Strength and honor are her clothing,","poem":1},{"text":"and she can laugh at the days to come.","poem":2}]},{"number":26,"lines":[{"text":"She opens her mouth with wisdom,","poem":1},{"text":"and faithful instruction is on her tongue.","poem":2}]},{"number":27,"lines":[{"text":"She watches over the affairs of her household","poem":1},{"text":"and does not eat the bread of idleness.","poem":2}]},{"number":28,"lines":[{"text":"Her children rise up and call her blessed;","poem":1},{"text":"her husband praises her as well:","poem":2}]},{"number":29,"lines":[{"text":"“Many daughters have done noble things,","poem":1},{"text":"but you surpass them all!”","poem":2}]},{"number":30,"lines":[{"text":"Charm is deceptive and beauty is fleeting,","poem":1},{"text":"but a woman who fears the LORD is to be praised.","poem":2}]},{"number":31,"lines":[{"text":"Give her the fruit of her hands,","poem":1},{"text":"and let her works praise her at the gates.","poem":2}]}]}]}
