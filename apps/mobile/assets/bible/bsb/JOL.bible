{"formatVersion":1,"translationId":"BSB","textDirection":"ltr","bookId":"JOL","bookName":"Joel","chapters":[{"number":1,"lastVerse":20,"verses":[{"number":1,"lines":[{"text":"This is the word of the LORD that came to Joel son of Pethuel:"}]},{"number":2,"lines":[{"text":"Hear this, O elders;","poem":1},{"text":"and give ear, all who dwell in the land.","poem":2},{"text":"Has anything like this ever happened in your days","poem":1},{"text":"or in the days of your fathers?","poem":2}]},{"number":3,"lines":[{"text":"Tell it to your children;","poem":1},{"text":"let your children tell it to their children,","poem":2},{"text":"and their children to the next generation.","poem":2}]},{"number":4,"lines":[{"text":"What the devouring locust has left,","poem":1},{"text":"the swarming locust has eaten;","poem":2},{"text":"what the swarming locust has left,","poem":1},{"text":"the young locust has eaten;","poem":2},{"text":"and what the young locust has left,","poem":1},{"text":"the destroying locust has eaten.","poem":2}]},{"number":5,"lines":[{"text":"Wake up, you drunkards, and weep;","poem":1},{"text":"wail, all you drinkers of wine,","poem":2},{"text":"because of the sweet wine,","poem":1},{"text":"for it has been cut off from your mouth.","poem":2}]},{"number":6,"lines":[{"text":"For a nation has invaded My land,","poem":1},{"text":"powerful and without number;","poem":2},{"text":"its teeth are the teeth of a lion,","poem":1},{"text":"and its fangs are the fangs of a lioness.","poem":2}]},{"number":7,"lines":[{"text":"It has laid waste My grapevine","poem":1},{"text":"and splintered My fig tree.","poem":2},{"text":"It has stripped off the bark and thrown it away;","poem":1},{"text":"the branches have turned white.","poem":2}]},{"number":8,"lines":[{"text":"Wail like a virgin dressed in sackcloth,","poem":1},{"text":"grieving for the husband of her youth.","poem":2}]},{"number":9,"lines":[{"text":"Grain and drink offerings have been cut off","poem":1},{"text":"from the house of the LORD;","poem":2},{"text":"the priests are in mourning,","poem":1},{"text":"those who minister before the LORD.","poem":2}]},{"number":10,"lines":[{"text":"The field is ruined;","poem":1},{"text":"the land mourns.","poem":2},{"text":"For the grain is destroyed,","poem":1},{"text":"the new wine is dried up, and the oil fails.","poem":2}]},{"number":11,"lines":[{"text":"Be dismayed, O farmers,","poem":1},{"text":"wail, O vinedressers,","poem":2},{"text":"over the wheat and barley,","poem":1},{"text":"because the harvest of the field has perished.","poem":2}]},{"number":12,"lines":[{"text":"The grapevine is dried up,","poem":1},{"text":"and the fig tree is withered;","poem":2},{"text":"the pomegranate, palm, and apple—","poem":1},{"text":"all the trees of the orchard—are withered.","poem":2},{"text":"Surely the joy of mankind has dried up.","poem":2}]},{"number":13,"lines":[{"text":"Put on sackcloth and lament, O priests;","poem":1},{"text":"wail, O ministers of the altar.","poem":2},{"text":"Come, spend the night in sackcloth,","poem":1},{"text":"O ministers of my God,","poem":2},{"text":"because the grain and drink offerings","poem":1},{"text":"are withheld from the house of your God.","poem":2}]},{"number":14,"lines":[{"text":"Consecrate a fast;","poem":1},{"text":"proclaim a solemn assembly!","poem":2},{"text":"Gather the elders","poem":1},{"text":"and all the residents of the land","poem":2},{"text":"to the house of the LORD your God,","poem":1},{"text":"and cry out to the LORD.","poem":2}]},{"number":15,"lines":[{"text":"Alas for the day!","poem":1},{"text":"For the Day of the LORD is near,","poem":2},{"text":"and it will come","poem":1},{"text":"as destruction from the Almighty.","poem":2}]},{"number":16,"lines":[{"text":"Has not the food been cut off","poem":1},{"text":"before our very eyes—","poem":2},{"text":"joy and gladness","poem":1},{"text":"from the house of our God?","poem":2}]},{"number":17,"lines":[{"text":"The seeds lie shriveled beneath the clods;","poem":1},{"text":"the storehouses are in ruins;","poem":2},{"text":"the granaries are broken down,","poem":1},{"text":"for the grain has withered away.","poem":2}]},{"number":18,"lines":[{"text":"How the cattle groan!","poem":1},{"text":"The herds wander in confusion","poem":2},{"text":"because they have no pasture.","poem":1},{"text":"Even the flocks of sheep are suffering.","poem":2}]},{"number":19,"lines":[{"text":"To You, O LORD, I call,","poem":1},{"text":"for fire has consumed the open pastures","poem":2},{"text":"and flames have scorched all the trees of the field.","poem":2}]},{"number":20,"lines":[{"text":"Even the beasts of the field pant for You,","poem":1},{"text":"for the streams of water have dried up,","poem":2},{"text":"and fire has consumed the open pastures.","poem":2}]}]},{"number":2,"lastVerse":32,"verses":[{"number":1,"lines":[{"text":"Blow the ram’s horn in Zion;","poem":1},{"text":"sound the alarm on My holy mountain!","poem":2},{"text":"Let all who dwell in the land tremble,","poem":1},{"text":"for the Day of the LORD is coming;","poem":2},{"text":"indeed, it is near—","poem":2}]},{"number":2,"lines":[{"text":"a day of darkness and gloom,","poem":1},{"text":"a day of clouds and blackness.","poem":2},{"text":"Like the dawn overspreading the mountains","poem":1},{"text":"a great and strong army appears,","poem":2},{"text":"such as never was of old,","poem":1},{"text":"nor will ever be in ages to come.","poem":2}]},{"number":3,"lines":[{"text":"Before them a fire devours,","poem":1},{"text":"and behind them a flame scorches.","poem":2},{"text":"The land before them is like the Garden of Eden,","poem":1},{"text":"but behind them, it is like a desert wasteland—","poem":2},{"text":"surely nothing will escape them.","poem":2}]},{"number":4,"lines":[{"text":"Their appearance is like that of horses,","poem":1},{"text":"and they gallop like swift steeds.","poem":2}]},{"number":5,"lines":[{"text":"With a sound like that of chariots","poem":1},{"text":"they bound over the mountaintops,","poem":2},{"text":"like the crackling of fire consuming stubble,","poem":1},{"text":"like a mighty army deployed for battle.","poem":2}]},{"number":6,"lines":[{"text":"Nations writhe in horror before them;","poem":1},{"text":"every face turns pale.","poem":2}]},{"number":7,"lines":[{"text":"They charge like mighty men;","poem":1},{"text":"they scale the walls like men of war.","poem":2},{"text":"Each one marches in formation,","poem":1},{"text":"not swerving from the course.","poem":2}]},{"number":8,"lines":[{"text":"They do not jostle one another;","poem":1},{"text":"each proceeds in his path.","poem":2},{"text":"They burst through the defenses,","poem":1},{"text":"never breaking ranks.","poem":2}]},{"number":9,"lines":[{"text":"They storm the city;","poem":1},{"text":"they run along the wall;","poem":2},{"text":"they climb into houses,","poem":1},{"text":"entering through windows like thieves.","poem":2}]},{"number":10,"lines":[{"text":"Before them the earth quakes;","poem":1},{"text":"the heavens tremble.","poem":2},{"text":"The sun and moon grow dark,","poem":1},{"text":"and the stars lose their brightness.","poem":2}]},{"number":11,"lines":[{"text":"The LORD raises His voice","poem":1},{"text":"in the presence of His army.","poem":2},{"text":"Indeed, His camp is very large,","poem":1},{"text":"for mighty are those who obey His command.","poem":2},{"text":"For the Day of the LORD is great and very dreadful.","poem":1},{"text":"Who can endure it?","poem":2}]},{"number":12,"lines":[{"text":"“Yet even now,”","poem":1},{"text":"declares the LORD,","poem":2},{"text":"“return to Me with all your heart,","poem":1},{"text":"with fasting, weeping, and mourning.”","poem":2}]},{"number":13,"lines":[{"text":"So rend your hearts and not your garments,","poem":1},{"text":"and return to the LORD your God.","poem":2},{"text":"For He is gracious and compassionate,","poem":1},{"text":"slow to anger, abounding in loving devotion.","poem":2},{"text":"And He relents from sending disaster.","poem":2}]},{"number":14,"lines":[{"text":"Who knows? He may turn and relent","poem":1},{"text":"and leave a blessing behind Him—","poem":2},{"text":"grain and drink offerings","poem":1},{"text":"for the LORD your God.","poem":2}]},{"number":15,"lines":[{"text":"Blow the ram’s horn in Zion,","poem":1},{"text":"consecrate a fast,","poem":2},{"text":"proclaim a sacred assembly.","poem":2}]},{"number":16,"lines":[{"text":"Gather the people, sanctify the congregation,","poem":1},{"text":"assemble the aged, gather the children,","poem":2},{"text":"even those nursing at the breast.","poem":2},{"text":"Let the bridegroom leave his room,","poem":1},{"text":"and the bride her chamber.","poem":2}]},{"number":17,"lines":[{"text":"Let the priests who minister before the LORD","poem":1},{"text":"weep between the portico and the altar,","poem":2},{"text":"saying, “Spare Your people, O LORD,","poem":1},{"text":"and do not make Your heritage a reproach,","poem":2},{"text":"an object of scorn among the nations.","poem":2},{"text":"Why should they say among the peoples,","poem":1},{"text":"‘Where is their God?’”","poem":2}]},{"number":18,"lines":[{"text":"Then the LORD became jealous for His land,","poem":1},{"text":"and He spared His people.","poem":2}]},{"number":19,"lines":[{"text":"And the LORD answered His people:","poem":1},{"text":"“Behold, I will send you","poem":1},{"text":"grain, new wine, and oil,","poem":2},{"text":"and by them you will be satisfied.","poem":2},{"text":"I will never again make you","poem":1},{"text":"a reproach among the nations.","poem":2}]},{"number":20,"lines":[{"text":"The northern army I will drive away from you,","poem":1},{"text":"banishing it to a barren and desolate land,","poem":2},{"text":"its front ranks into the Eastern Sea,","poem":1},{"text":"and its rear guard into the Western Sea.","poem":2},{"text":"And its stench will rise;","poem":1},{"text":"its foul odor will ascend.","poem":2},{"text":"For He has done great things.","poem":1}]},{"number":21,"lines":[{"text":"Do not be afraid, O land;","poem":1},{"text":"rejoice and be glad,","poem":2},{"text":"for the LORD has done great things.","poem":2}]},{"number":22,"lines":[{"text":"Do not be afraid, O beasts of the field,","poem":1},{"text":"for the open pastures have turned green,","poem":2},{"text":"the trees bear their fruit,","poem":1},{"text":"and the fig tree and vine yield their best.","poem":2}]},{"number":23,"lines":[{"text":"Be glad, O children of Zion,","poem":1},{"text":"and rejoice in the LORD your God,","poem":2},{"text":"for He has given you the autumn rains","poem":1},{"text":"for your vindication.","poem":2},{"text":"He sends you showers,","poem":1},{"text":"both autumn and spring rains, as before.","poem":2}]},{"number":24,"lines":[{"text":"The threshing floors will be full of grain,","poem":1},{"text":"and the vats will overflow with new wine and oil.","poem":2}]},{"number":25,"lines":[{"text":"I will repay you for the years eaten by locusts—","poem":1},{"text":"the swarming locust, the young locust,","poem":2},{"text":"the destroying locust, and the devouring locust —","poem":1},{"text":"My great army that I sent against you.","poem":2}]},{"number":26,"lines":[{"text":"You will have plenty to eat,","poem":1},{"text":"until you are satisfied.","poem":2},{"text":"You will praise the name of the LORD your God,","poem":1},{"text":"who has worked wonders for you.","poem":2},{"text":"My people will never again","poem":1},{"text":"be put to shame.","poem":2}]},{"number":27,"lines":[{"text":"Then you will know that I am present in Israel","poem":1},{"text":"and that I am the LORD your God,","poem":2},{"text":"and there is no other.","poem":2},{"text":"My people will never again","poem":1},{"text":"be put to shame.","poem":2}]},{"number":28,"lines":[{"text":"And afterward, I will pour out My Spirit on all people.","poem":1},{"text":"Your sons and daughters will prophesy,","poem":2},{"text":"your old men will dream dreams,","poem":1},{"text":"your young men will see visions.","poem":2}]},{"number":29,"lines":[{"text":"Even on My menservants and maidservants,","poem":1},{"text":"I will pour out My Spirit in those days.","poem":2}]},{"number":30,"lines":[{"text":"I will show wonders in the heavens and on the earth,","poem":1},{"text":"blood and fire and columns of smoke.","poem":2}]},{"number":31,"lines":[{"text":"The sun will be turned to darkness","poem":1},{"text":"and the moon to blood","poem":2},{"text":"before the coming of the great and awesome Day of the LORD.","poem":2}]},{"number":32,"lines":[{"text":"And everyone who calls on the name of the LORD","poem":1},{"text":"will be saved;","poem":2},{"text":"for on Mount Zion and in Jerusalem","poem":1},{"text":"there will be deliverance, as the LORD has promised,","poem":2},{"text":"among the remnant called by the LORD.","poem":2}]}]},{"number":3,"lastVerse":21,"verses":[{"number":1,"lines":[{"text":"“Yes, in those days and at that time,","poem":1},{"text":"when I restore Judah and Jerusalem from captivity,","poem":2}]},{"number":2,"lines":[{"text":"I will gather all the nations","poem":1},{"text":"and bring them down to the Valley of Jehoshaphat.","poem":2},{"text":"There I will enter into judgment against them","poem":1},{"text":"concerning My people, My inheritance, Israel,","poem":2},{"text":"whom they have scattered among the nations","poem":1},{"text":"as they divided up My land.","poem":2}]},{"number":3,"lines":[{"text":"They cast lots for My people;","poem":1},{"text":"they bartered a boy for a prostitute","poem":2},{"text":"and sold a girl for wine to drink.","poem":2}]},{"number":4,"lines":[{"text":"Now what do you have against Me, O Tyre, Sidon, and all the regions of Philistia? Are you rendering against Me a recompense? If you retaliate against Me, I will swiftly and speedily return your recompense upon your heads."}]},{"number":5,"lines":[{"text":"For you took My silver and gold and carried off My finest treasures to your temples."}]},{"number":6,"lines":[{"text":"You sold the people of Judah and Jerusalem to the Greeks, to send them far from their homeland."}]},{"number":7,"lines":[{"text":"Behold, I will rouse them from the places to which you sold them; I will return your recompense upon your heads."}]},{"number":8,"lines":[{"text":"I will sell your sons and daughters into the hands of the people of Judah, and they will sell them to the Sabeans—to a distant nation.”"},{"text":"Indeed, the LORD has spoken."}]},{"number":9,"lines":[{"text":"Proclaim this among the nations:"},{"text":"“Prepare for war;","poem":1},{"text":"rouse the mighty men;","poem":2},{"text":"let all the men of war","poem":1},{"text":"advance and attack!","poem":2}]},{"number":10,"lines":[{"text":"Beat your plowshares into swords","poem":1},{"text":"and your pruning hooks into spears.","poem":2},{"text":"Let the weak say, ‘I am strong!’","poem":2}]},{"number":11,"lines":[{"text":"Come quickly, all you surrounding nations,","poem":1},{"text":"and gather yourselves.","poem":2},{"text":"Bring down Your mighty ones,","poem":1},{"text":"O LORD.","poem":2}]},{"number":12,"lines":[{"text":"Let the nations be roused","poem":1},{"text":"and advance to the Valley of Jehoshaphat,","poem":2},{"text":"for there I will sit down","poem":1},{"text":"to judge all the nations on every side.","poem":2}]},{"number":13,"lines":[{"text":"Swing the sickle,","poem":1},{"text":"for the harvest is ripe.","poem":2},{"text":"Come, trample the grapes,","poem":1},{"text":"for the winepress is full;","poem":2},{"text":"the wine vats overflow","poem":1},{"text":"because their wickedness is great.","poem":2}]},{"number":14,"lines":[{"text":"Multitudes, multitudes","poem":1},{"text":"in the valley of decision!","poem":2},{"text":"For the Day of the LORD is near","poem":1},{"text":"in the valley of decision.","poem":2}]},{"number":15,"lines":[{"text":"The sun and moon will grow dark,","poem":1},{"text":"and the stars will no longer shine.","poem":2}]},{"number":16,"lines":[{"text":"The LORD will roar from Zion","poem":1},{"text":"and raise His voice from Jerusalem;","poem":2},{"text":"heaven and earth will tremble.","poem":2},{"text":"But the LORD will be a refuge for His people,","poem":1},{"text":"a stronghold for the people of Israel.","poem":2}]},{"number":17,"lines":[{"text":"Then you will know that I am the LORD your God,","poem":1},{"text":"who dwells in Zion, My holy mountain.","poem":2},{"text":"Jerusalem will be holy,","poem":1},{"text":"never again to be overrun by foreigners.","poem":2}]},{"number":18,"lines":[{"text":"And in that day the mountains will drip with sweet wine,","poem":1},{"text":"and the hills will flow with milk.","poem":2},{"text":"All the streams of Judah will run with water,","poem":1},{"text":"and a spring will flow from the house of the LORD","poem":2},{"text":"to water the Valley of Acacias.","poem":2}]},{"number":19,"lines":[{"text":"Egypt will become desolate,","poem":1},{"text":"and Edom a desert wasteland,","poem":2},{"text":"because of the violence done to the people of Judah,","poem":1},{"text":"in whose land they shed innocent blood.","poem":2}]},{"number":20,"lines":[{"text":"But Judah will be inhabited forever,","poem":1},{"text":"and Jerusalem from generation to generation.","poem":2}]},{"number":21,"lines":[{"text":"For I will avenge their blood,","poem":1},{"text":"which I have not yet avenged.”","poem":2},{"text":"For the LORD dwells in Zion."}]}]}]}
