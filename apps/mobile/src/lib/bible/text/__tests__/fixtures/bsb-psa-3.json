  "chapter": {
    "number": 3,
    "content": [
      { "type": "heading", "content": ["Deliver Me, O LORD!"] },
      {
        "type": "hebrew_subtitle",
        "content": ["A Psalm of David, when he fled from his son Absalom."]
      },
      { "type": "line_break" },
      {
        "type": "verse",
        "number": 1,
        "content": [
          { "text": "O LORD, how my foes have increased!", "poem": 1 },
          { "text": "How many rise up against me!", "poem": 2 }
        ]
      },
      {
        "type": "verse",
        "number": 2,
        "content": [
          { "text": "Many say of me,", "poem": 1 },
          { "text": "“God will not deliver him.”", "poem": 2 },
          "Selah",
          { "noteId": 5 }
        ]
      },
      {
        "type": "verse",
        "number": 3,
        "content": [
          { "text": "But You, O LORD, are a shield around me,", "poem": 1 },
          { "text": "my glory, and the One who lifts my head.", "poem": 2 }
        ]
      },
      {
        "type": "verse",
        "number": 4,
        "content": [
          { "text": "To the LORD I cry aloud,", "poem": 1 },
          { "text": "and He answers me from His holy mountain.", "poem": 2 },
          "Selah"
        ]
      },
      {
        "type": "verse",
        "number": 5,
        "content": [
          { "text": "I lie down and sleep;", "poem": 1 },
          { "text": "I wake again, for the LORD sustains me.", "poem": 2 }
        ]
      },
      {
        "type": "verse",
        "number": 6,
        "content": [
          { "text": "I will not fear the myriads", "poem": 1 },
          { "text": "set against me on every side.", "poem": 2 }
        ]
      },
      { "type": "line_break" },
      {
        "type": "verse",
        "number": 7,
        "content": [
          { "text": "Arise, O LORD!", "poem": 1 },
          { "text": "Save me, O my God!", "poem": 2 },
          { "text": "Strike all my enemies on the jaw;", "poem": 1 },
          { "text": "break the teeth of the wicked.", "poem": 2 }
        ]
      },
      {
        "type": "verse",
        "number": 8,
        "content": [
          { "text": "Salvation belongs to the LORD;", "poem": 1 },
          { "text": "may Your blessing be on Your people.", "poem": 2 },
          "Selah"
        ]
      }
    ],
    "footnotes": [
      {
        "noteId": 5,
        "caller": "+",
        "text": "Selah or Interlude is probably a musical or literary term; here and throughout the Psalms.",
        "reference": { "chapter": 3, "verse": 2 }
      }
    ]
