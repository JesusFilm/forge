{
  "name": "@forge/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "fetch-secrets": "rm -f .env && doppler secrets download --project forge-mobile --config dev --format env --no-file > .env.local.tmp && mv .env.local.tmp .env.local",
    "lint": "eslint .",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "echo 'Expo app has no production bundle step; use expo export or EAS when needed.'",
    "eas-build-pre-install": "bash scripts/eas-build-pre-install.sh",
    "eas-build-on-success": "bash scripts/eas-build-on-success.sh",
    "update:preview": "touch src/env.ts && EXPO_NO_DOTENV=1 eas update --channel preview --environment preview --message \"preview update\"",
    "update:production": "touch src/env.ts && EXPO_NO_DOTENV=1 eas update --channel production --environment production --message \"production update\"",
    "icons:generate": "node scripts/generate-app-icon.mjs"
  },
  "dependencies": {
    "@apollo/client": "^4.1.4",
    "@better-auth/expo": "1.6.2",
    "@datadog/mobile-react-native": "3.5.2",
    "@datadog/mobile-react-native-session-replay": "3.5.2",
    "@forge/admin-graphql": "workspace:*",
    "@forge/watch-url-policy": "workspace:*",
    "@hebcal/hdate": "^0.21.1",
    "@kesha-antonov/react-native-background-downloader": "^4.5.5",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@t3-oss/env-core": "^0.13.11",
    "better-auth": "1.6.2",
    "expo": "~55.0.28",
    "expo-blur": "~55.0.16",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-file-system": "~55.0.24",
    "expo-glass-effect": "~55.0.11",
    "expo-image": "~55.0.11",
    "expo-linear-gradient": "^55.0.16",
    "expo-linking": "~55.0.16",
    "expo-network": "~55.0.16",
    "expo-router": "~55.0.17",
    "expo-screen-orientation": "~55.0.18",
    "expo-secure-store": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.26",
    "expo-video": "~55.0.19",
    "expo-web-browser": "~55.0.18",
    "graphql": "16.13.1",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-webview": "13.16.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/runtime": "^7.28.0",
    "@expo/ngrok": "^4.1.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "^55.0.24",
    "eslint": ">=8.10",
    "eslint-config-expo": "~55.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.20",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|expo-glass-effect|@expo|react-navigation|@react-navigation|@hebcal|@t3-oss|zod|@datadog))"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "private": true
}
