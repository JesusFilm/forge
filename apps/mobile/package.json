{
  "name": "@forge/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "fetch-secrets": "doppler secrets download --project forge-mobile --config dev --format env --no-file > .env",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build": "echo 'Expo app has no production bundle step; use expo export or EAS when needed.'"
  },
  "dependencies": {
    "@apollo/client": "^4.1.4",
    "@forge/graphql": "workspace:*",
    "@hebcal/hdate": "^0.21.1",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "expo": "~54.0.33",
    "expo-linear-gradient": "^55.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "graphql": "^16.12.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "~4.16.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@babel/runtime": "^7.28.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "eslint": ">=10.0",
    "eslint-config-expo": "~55.0.0",
    "jest": "^30.3.0",
    "jest-expo": "~55.0.9",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "^react$": "<rootDir>/node_modules/react/index.js",
      "^react/jsx-runtime$": "<rootDir>/node_modules/react/jsx-runtime.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|@hebcal))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "private": true
}
