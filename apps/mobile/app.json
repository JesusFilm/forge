{
  "expo": {
    "name": "forge-watch",
    "slug": "jesus-film-forge-v2",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "forgemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/AppIcon.icon",
      "supportsTablet": true,
      "bundleIdentifier": "org.jesusfilm.forgewatch",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "The app uses your local network to find Cast devices, so you can play videos on your TV.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#191513"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.jesusfilm.forgewatch",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/e8e41dde-3482-4571-a499-3b82673cdb39"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "plugins": [
      "expo-router",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "@kesha-antonov/react-native-background-downloader",
      "./plugins/withMmkvSecureWipeFix",
      "./plugins/withBackgroundDownloaderAppDelegate",
      "./plugins/withCastOptionsVolume",
      "./plugins/withCastUIStyle",
      "./plugins/withAndroidCastTheme",
      "./plugins/withAndroidNavigationBar",
      [
        "react-native-google-cast",
        {
          "iosSuspendSessionsWhenBackgrounded": false,
          "iosStartDiscoveryAfterFirstTapOnCastButton": false,
          "androidPlayServicesCastFrameworkVersion": "22.3.1",
          "expandedController": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      [
        "expo-font",
        {
          "ios": {
            "fonts": ["./assets/fonts/NotoSerif-SemiBold.ttf"]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "NotoSerif-SemiBold",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/NotoSerif-SemiBold.ttf",
                    "weight": 600,
                    "style": "normal"
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "This lets the app save videos you export to your photo library, so you can keep them outside the app.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],

      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1c1917",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e8e41dde-3482-4571-a499-3b82673cdb39"
      }
    },
    "owner": "jesus-film-project"
  }
}
