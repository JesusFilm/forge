import {chromium} from '/home/tataihono/.codex/worktrees/8b33/forge/apps/shorts-worker/node_modules/playwright/index.mjs';
import {writeFile, unlink, symlink, readFile, open} from 'node:fs/promises';
import {spawn} from 'node:child_process';
import {randomInt} from 'node:crypto';
import os from 'node:os';
const scratch='/home/tataihono/.codex/worktrees/8b33/forge/.tmp/studio458-speech-feedback';
const host=()=>({at:new Date().toISOString(),load:os.loadavg(),cpus:os.cpus().map(c=>c.times),freeMemory:os.freemem()});
const first=randomInt(2);const order=Array.from({length:6},(_,i)=>(i+first)%2?'final':'baseline');
await writeFile(scratch+'/interleaved-plan.json',JSON.stringify({order,pairsPerBuild:3,created:new Date().toISOString(),noRepeat:true},null,2),{flag:'wx'});
let server;
async function stop(){if(server){process.kill(-server.pid,'SIGTERM');await new Promise(resolve=>server.once('exit',resolve));server=null;}}
async function start(variant,slot){await stop();await unlink('apps/manager/.next');await symlink(scratch+'/builds/'+variant+'-next','apps/manager/.next','dir');const log=await open(scratch+'/interleaved-server-'+slot+'.log','w');server=spawn(process.execPath,[scratch+'/runtime.mjs','manager'],{stdio:['ignore',log.fd,log.fd],detached:true});await log.close();for(let i=0;i<100;i++){try{await fetch('http://127.0.0.1:3588/');return;}catch{}await new Promise(r=>setTimeout(r,200));}throw new Error('Manager readiness failed');}


const port=3588, origin=`http://studio458.localhost:${port}`;
const browser=await chromium.launch({executablePath:'/usr/bin/google-chrome',headless:true});const samples=[];
try{for(let slot=0;slot<order.length;slot++){
 const variant=order[slot],pair=Math.floor(slot/2);await start(variant,slot);
 const context=await browser.newContext({viewport:{width:1440,height:1000},serviceWorkers:'allow'});
 await context.addInitScript(()=>{window.studioLoading={lcp:0,cls:0,longTasks:[]};new PerformanceObserver(list=>{for(const e of list.getEntries())window.studioLoading.lcp=e.startTime}).observe({type:'largest-contentful-paint',buffered:true});new PerformanceObserver(list=>{for(const e of list.getEntries())if(!e.hadRecentInput)window.studioLoading.cls+=e.value}).observe({type:'layout-shift',buffered:true});new PerformanceObserver(list=>{for(const e of list.getEntries())window.studioLoading.longTasks.push(e.duration)}).observe({type:'longtask',buffered:true});});
 const login=await context.request.get('http://studio458.localhost:3589/local-fixture-login',{maxRedirects:0});if(login.status()!==302)throw new Error('Fixture login failed');
 const page=await context.newPage();page.setDefaultTimeout(30000);const errors=[];page.on('pageerror',e=>errors.push(e.message));
 const cdp=await context.newCDPSession(page);await cdp.send('Network.enable');await cdp.send('Performance.enable');
 let requests=new Map(),waterfall=[];
 cdp.on('Network.requestWillBeSent',e=>{const url=new URL(e.request.url);requests.set(e.requestId,{path:url.pathname.replace(/\/s\/[a-f0-9]{64}/g,'/s/[capability]'),type:e.type,started:e.timestamp,bytes:0});});
 cdp.on('Network.responseReceived',e=>{const r=requests.get(e.requestId);if(r){r.status=e.response.status;r.mime=e.response.mimeType;r.fromDiskCache=e.response.fromDiskCache??false;}});
 cdp.on('Network.loadingFinished',e=>{const r=requests.get(e.requestId);if(r){r.bytes=e.encodedDataLength;r.durationMs=(e.timestamp-r.started)*1000;waterfall.push(r);}});
 for(const cache of ['cold','warm']){
  requests=new Map();waterfall=[];
  const hostBefore=host(),cpuBefore=await cdp.send('Performance.getMetrics');const started=performance.now();
  await page.goto(origin+'/dashboard/shorts/000458-browser-2',{waitUntil:'domcontentloaded'});
  await page.getByRole('button',{name:'Speech and production',exact:true}).count();
  await page.getByRole('button',{name:'Assistant',exact:true}).waitFor();const controlsMs=performance.now()-started;const controlsCpu=await cdp.send('Performance.getMetrics');const hostControls=host();
  await page.locator('.nle-preview[data-preview-ready="true"]').waitFor();const previewMs=performance.now()-started;
  await page.waitForTimeout(1000);
  const frontend=await page.evaluate(()=>({navigation:performance.getEntriesByType('navigation')[0].toJSON(),paint:performance.getEntriesByType('paint').map(e=>({name:e.name,startTime:e.startTime})),...window.studioLoading}));
  const sample={variant,pair,slot,cache,buildId:(await readFile(scratch+'/builds/'+variant+'-next/BUILD_ID','utf8')).trim(),hostBefore,hostControls,hostAfter:host(),cpuBefore,controlsCpu,cpuAfter:await cdp.send('Performance.getMetrics'),controlsMs,previewMs,frontend,pageErrors:[...errors],transferredBytes:waterfall.reduce((n,r)=>n+r.bytes,0),javascriptBytes:waterfall.filter(r=>r.type==='Script').reduce((n,r)=>n+r.bytes,0),waterfall};samples.push(sample);console.log(JSON.stringify({variant,pair,cache,controlsMs,previewMs,lcp:frontend.lcp,cls:frontend.cls,javascriptBytes:sample.javascriptBytes,pageErrors:errors}));
  if(errors.length)throw new Error('Page errors during loading sample');
  await page.locator('a[href="/dashboard/shorts"]').first().click();await page.waitForURL(url=>url.pathname==='/dashboard/shorts');
 }
 await context.close();
}}finally{await writeFile(`/home/tataihono/.codex/worktrees/8b33/forge/.tmp/studio458-speech-feedback/loading-interleaved.json`,JSON.stringify({browser:browser.version(),viewport:{width:1440,height:1000},serviceWorkers:'allow',samples},null,2));await browser.close();await stop();await unlink('apps/manager/.next');await symlink(scratch+'/builds/final-next','apps/manager/.next','dir');}
