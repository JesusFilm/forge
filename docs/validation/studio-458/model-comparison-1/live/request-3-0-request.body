description":"constraints: lower than or equal to 86400000, greater than 0"}},"required":["kind","itemId","startMs","endMs"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"insert-item"},"item":{"anyOf":[{"oneOf":[{"type":"object","properties":{"id":{"type":"string","description":"constraints: input must match this regex ^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,127}$"},"trackId":{"type":"string","description":"constraints: input must match this regex ^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,127}$"},"startFrame":{"type":"integer","description":"constraints: greater than or equal to 0, lower than or equal to 2592000"},"durationInFrames":{"type":"integer","description":"constraints: greater than or equal to 1, lower than or equal to 2592000"},"timingLocked":{"anyOf":[{"type":"boolean"},{"type":"null"}]},"linkedTo":{"description":"constraints: input must match this regex ^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,127}$","anyOf":[{"description":"constraints: input must match this regex ^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,127}$","type":"string"},{"type":"null"}]},"transform":{"properties":{"x":{"type":"number","description":"constraints: greater than or equal to -10000, lower than or equal to 10000"},"y":{"type":"number","description":"constraints: greater than or equal to -10000, lower than or equal to 10000"},"scaleX":{"type":"number","description":"constraints: lower than or equal to 100, greater than 0"},"scaleY":{"type":"number","description":"constraints: lower than or equal to 100, greater than 0"},"rotation":{"type":"number","description":"constraints: greater than or equal to -360, lower than or equal to 360"},"opacity":{"type":"number","description":"constraints: greater than or equal to 0, lower than or equal to 1"},"crop":{"properties":{"top":{"type":"number","description":"constraints: greater than or equal to 0, lower than or equal to 1"},"right":{"type":"number","description":"constraints: greater than or equal to 0, lower than or equal to 1"},"bottom":{"type":"number","description":"constraints: greater than or equal to 0, lower than or equal to 1"},"left":{"type":"number","description":"constraints: greater than or equal to 0, lower than or equal to 1"}},"required":["top","right","bottom","left"],"additionalProperties":false,"anyOf":[{"properties":{"top":{"type":"number","description":"constraints: greater than or equal to 0, lower than or equal to 1"},"right":{"type":"number","description":"constraints: greater than or equal to 0, lower than or equal to 1"},"bottom":{"type":"number","description":"constraints: greater than or equal to 0, lower than or equal to 1"},"left":{"type":"number","description":"constraints: greater than or equal to 0, lower than or equal to 1"}},"required":["top","right","bottom","left"],"additionalProperties":false,"type":"object"},{"type":"null"}]}},"required":["x","y","scaleX","scaleY","rotation","opacity","crop"],"additionalProperties":false,"x-optional":["crop"],"anyOf":[{"properties":{"x":{"type":"number","description":"constraints: greater than or equal to -10000, lower than or equal to 10000"},"y":{"type":"number","description":"constraints: greater than or equal to -10000, lower than or equal to 10000"},"scaleX":{"type":"number","description":"constraints: lower than or equal to 100, greater than 0"},"scaleY":{"type":"number","description":"constraints: lower than or equal to 100, greater than 0"},"rotation":{"type":"number","description":"constraints: greater than or equal to -360, lower than or equal to 360"},"opacity":{"type":"number","description":"constraints: greater than or equal to 0, lower than or equal to 1"},"crop":{"properties":{"top":{"type":"number","description":"constraints: greater than or equal to 0, lower than or equal to 1"},"right":{"type":"number","description":"constraints: greater than or equal to 0, lower than or equal to 1"},"bottom":{"type":"number","description":"constraints: greater than or equal to 0, lower than or equal to 1"},"left":{"type":