epth\": {\n      \"status\": \"pass\",\n      \"reason\": \"The script captures substantial interpretive depth from the source, including the critique of selfishness, the rejection of passive charity, and the emphasis on self-sacrifice in money, time, and trouble. It keeps the lesson concrete rather than abstract.\"\n    },\n    \"fidelity\": {\n      \"status\": \"pass\",\n      \"reason\": \"The script closely follows the source excerpt's meaning and sequence without introducing contrary theology or extra allegory. It preserves key claims such as the rarity of true brotherly love, the Samaritan's cross-boundary mercy, and the practical nature of Christian charity.\"\n    },\n    \"voice\": {\n      \"status\": \"pass\",\n      \"reason\": \"The tone is devotional and exhortational, matching the source's pastoral voice. It maintains the source's moral seriousness and direct address without sounding secular or detached.\"\n    },\n    \"causalTransitions\": {\n      \"status\": \"pass\",\n      \"reason\": \"The script uses clear causal and inferential transitions, especially from the parable's details to the lesson about human selfishness, and from the Samaritan's actions to the obligation for Christian practice.\"\n    },\n    \"repetition\": {\n      \"status\": \"pass\",\n      \"reason\": \"There is some intentional repetition of the central theme of practical love, but it functions as reinforcement rather than redundancy. It does not noticeably over-repeat phrases or ideas beyond the source's own rhetorical style.\"\n    },\n    \"sourceEvidence\": {\n      \"status\": \"pass\",\n      \"reason\": \"The saved script is strongly evidenced by the provided source excerpt. Specific anchors present in the source and retained in the script include the lawyer's question, the priest and Levite passing by, the Samaritan's compassion, and the command to 'Go and do likewise.'\"\n    }\n  },\n  \"not_checked\": [\n    {\n      \"item\": \"historic metadata equivalence\",\