                "search": {
                  "query": "service:forge-admin (env:prod OR @env:prod) \"event=recommendation.evidence\" \"reason=transaction_exhausted\""
                },
                "compute": {
                  "aggregation": "count"
                },
                "group_by": []
              }
            ],
