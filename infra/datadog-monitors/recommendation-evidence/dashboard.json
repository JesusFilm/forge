{
  "title": "Forge recommendation evidence transport",
  "description": "Fixed-field operational observations only; absence is unknown. Production acceptance requires complete HTTP/APM denominators and authorized durable evidence audit. See docs/operations/recommendation-evidence-transport.md.",
  "layout_type": "ordered",
  "widgets": [
    {
      "definition": {
        "type": "timeseries",
        "title": "Playback 5xx",
        "requests": [
          {
            "response_format": "timeseries",
            "display_type": "bars",
            "queries": [
              {
                "data_source": "logs",
                "name": "observations",
                "indexes": ["*"],
                "search": {
                  "query": "service:forge-web (env:prod OR @env:prod) \"event=recommendation.evidence\" (\"action=playback\" OR \"action=context\" OR \"action=claim\" OR \"action=facts\") (\"httpStatus=500\" OR \"httpStatus=502\" OR \"httpStatus=503\" OR \"httpStatus=504\")"
                },
                "compute": {
                  "aggregation": "count"
                },
                "group_by": []
              }
            ],
            "formulas": [
              {
                "formula": "observations"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Binding retry",
        "requests": [
          {
            "response_format": "timeseries",
            "display_type": "bars",
            "queries": [
              {
                "data_source": "logs",
                "name": "observations",
                "indexes": ["*"],
                "search": {
                  "query": "service:forge-web (env:prod OR @env:prod) \"event=recommendation.evidence\" \"reason=invalid_binding\" \"retryDisposition=retryable\""
                },
                "compute": {
                  "aggregation": "count"
                },
                "group_by": []
              }
            ],
            "formulas": [
              {
                "formula": "observations"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
