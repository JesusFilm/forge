# Datadog Agent service env for Railway production.
# Use the Datadog API key named "Forge-production".
DD_API_KEY=
DD_SITE=datadoghq.com
DD_HOSTNAME=${{RAILWAY_PRIVATE_DOMAIN}}

# Accept traces and DogStatsD/runtime metrics from other Railway services over
# the project/environment private network.
DD_APM_ENABLED=true
DD_APM_NON_LOCAL_TRAFFIC=true
DD_DOGSTATSD_NON_LOCAL_TRAFFIC=true

# Accept syslog-over-UDP application logs from Railway services and forward
# them to Datadog over HTTP.
DD_LOGS_ENABLED=true
DD_LOGS_CONFIG_CONTAINER_COLLECT_ALL=true
DD_BIND_HOST=::1

# Keep the Agent private; do not generate a public Railway domain.
